# ==============================================================================
# MR. TUMI GROCERY & GIFT — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to `.env` for local/server configuration.
# NEVER commit real passwords, API keys, tokens, or customer data to Git.
# ==============================================================================

# --- 1. Application & Runtime ---
NODE_ENV=development
APP_NAME="Mr. Tumi Grocery & Gift"
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000
# Local default only. Production must use the verified proxy-hop count/topology.
TRUST_PROXY=1

# --- 2. Localization, Timezone & Currency (Bangladesh) ---
TZ=Asia/Dhaka
DEFAULT_LOCALE=bn
SUPPORTED_LOCALES=bn,en
CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳

# --- 3. Security & Session Secrets ---
# REQUIRED in production (minimum 32 random characters; generate with `openssl rand -hex 32`)
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET
CSRF_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_CSRF_SECRET

# --- 4. Database Configuration ---
# PRODUCTION REQUIREMENT: DB_CLIENT MUST be `mysql` in production (SQLite is prohibited in production).
# Local sandbox/prototype fallback (`sqlite`) is allowed only in development/test when mysqld is absent.
DB_CLIENT=mysql

# MySQL Settings (production must use the host-confirmed values; these are examples only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_mrtumi
DB_USER=cpaneluser_app
DB_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
DB_CHARSET=utf8mb4
DB_TIMEZONE=+00:00
DB_CONNECTION_LIMIT=10

# Local Prototype / Sandbox SQLite Path (Non-Production Only)
SQLITE_PATH=./data/pholbazar.db

# --- 5. Persistent Storage Paths ---
# Non-production default. Production validation requires an absolute durable path outside app root.
# Confirm this account's persistent storage and URL mapping before using a host path.
UPLOAD_DIR=./public/uploads
# Recommended dedicated 32-byte key (openssl rand -base64 32). If unset, a stable key is derived from SESSION_SECRET.
VENDOR_PII_KEY=
# Optional writable private path; defaults to <app_root>/storage/vendor_docs. Never place under public/.
VENDOR_DOCUMENT_DIR=

# --- 6. Non-Production Bootstrap (Strictly disabled when NODE_ENV=production) ---
SEED_DEMO_DATA=true
BOOTSTRAP_ADMIN_EMAIL=admin@mrtumi.local
BOOTSTRAP_ADMIN_PASSWORD=

# --- 7. Courier Integrations (Phase 10 — leave blank until live/sandbox keys supplied) ---
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_SECRET=

PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_WEBHOOK_SECRET=

REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_ACCESS_TOKEN=
REDX_WEBHOOK_SECRET=

# --- 8. Payment Gateways (Bangladesh MFS: bKash, Nagad, Rocket) ---
BKASH_IS_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_MERCHANT_ID=
NAGAD_BASE_URL=https://sandbox.mynagad.com
NAGAD_CALLBACK_URL=http://localhost:3000/api/v1/payments/nagad/callback
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

ROCKET_MERCHANT_ID=
ROCKET_BASE_URL=https://sandbox.rocket.dutchbanglabank.com/api
ROCKET_CALLBACK_URL=http://localhost:3000/api/v1/payments/rocket/callback
ROCKET_APP_KEY=
ROCKET_APP_SECRET=

# --- 9. Fraud Checker API (Phase 12) ---
BDCOURIER_BASE_URL=https://bdcourier.com/api
BDCOURIER_API_KEY=

# --- 10. Bulk SMS BD Gateway (Phase 13) ---
BULKSMSBD_BASE_URL=http://bulksmsbd.net/api
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# Enable only after validating provider credentials, sender ID, response codes and balance.
# Defaults to disabled so unverified SMS settings never send messages automatically.
VENDOR_OTP_SMS_ENABLED=false

# --- 11. Pixels, CAPI & Tag Manager (Phase 14) ---
# First-party attribution capture is disabled until owner privacy-copy review/approval.
ANALYTICS_ATTRIBUTION_ENABLED=false
GTM_CONTAINER_ID=
META_PIXEL_ID=
FB_CAPI_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=

# --- 12. Transactional Email / SMTP (Phase 18) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mrtumi.com
SMTP_FROM_NAME="Mr. Tumi Grocery & Gift"
