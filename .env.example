# ==============================================================================
# MR. TUMI GROCERY & GIFT — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to `.env` for local/server configuration.
# NEVER commit real passwords, API keys, tokens, or customer data to Git.
# ==============================================================================

# --- 1. Application & Runtime ---
NODE_ENV=development
APP_NAME="Mr. Tumi Grocery & Gift"
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1

# --- 2. Localization, Timezone & Currency (Bangladesh) ---
TZ=Asia/Dhaka
DEFAULT_LOCALE=bn
SUPPORTED_LOCALES=bn,en
CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳

# --- 3. Security & Session Secrets ---
# REQUIRED in production (minimum 32 random characters; generate with `openssl rand -hex 32`)
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET
CSRF_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_CSRF_SECRET

# --- 4. Database Configuration (Provisional until BestWebHostBD package verified) ---
# Supported options planned for Phase 03: sqlite (local/dev/CI) | mysql (cPanel/VPS production)
DB_CLIENT=sqlite
SQLITE_PATH=./data/mrtumi.db

# MySQL / MariaDB settings (for BestWebHostBD cPanel / VPS production in Phase 03)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_mrtumi
DB_USER=cpaneluser_app
DB_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
DB_CONNECTION_LIMIT=10

# --- 5. Persistent Storage Paths ---
UPLOAD_DIR=./public/uploads

# --- 6. Non-Production Bootstrap (Ignored when NODE_ENV=production unless explicitly enabled) ---
SEED_DEMO_DATA=true
BOOTSTRAP_ADMIN_EMAIL=admin@mrtumi.local
BOOTSTRAP_ADMIN_PASSWORD=

# --- 7. Courier Integrations (Phase 10 — leave blank until live/sandbox keys supplied) ---
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_SECRET=

PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_WEBHOOK_SECRET=

REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_ACCESS_TOKEN=
REDX_WEBHOOK_SECRET=

# --- 8. Payment Gateways (Phase 11 — leave blank until sandbox/live keys supplied) ---
BKASH_SANDBOX=true
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

SHURJOPAY_SANDBOX=true
SHURJOPAY_BASE_URL=
SHURJOPAY_USERNAME=
SHURJOPAY_PASSWORD=
SHURJOPAY_PREFIX=

UDDOKTAPAY_SANDBOX=true
UDDOKTAPAY_BASE_URL=
UDDOKTAPAY_API_KEY=

# --- 9. Fraud Checker API (Phase 12) ---
BDCOURIER_BASE_URL=https://bdcourier.com/api
BDCOURIER_API_KEY=

# --- 10. Bulk SMS BD Gateway (Phase 13) ---
BULKSMSBD_BASE_URL=http://bulksmsbd.net/api
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# --- 11. Pixels, CAPI & Tag Manager (Phase 14) ---
GTM_CONTAINER_ID=
META_PIXEL_ID=
FB_CAPI_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=

# --- 12. Transactional Email / SMTP (Phase 18) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mrtumi.com
SMTP_FROM_NAME="Mr. Tumi Grocery & Gift"
