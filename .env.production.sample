# ==============================================================================
# MR. TUMI GROCERY & GIFT — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.sample)
# Copy this file to `.env` on the production server (e.g. BestWebHostBD cPanel / VPS).
# NEVER commit the filled `.env` with real credentials to source control!
# ==============================================================================

# --- 1. Node.js Runtime & Application ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME="Mr. Tumi Grocery & Gift"
APP_URL=https://mrtumi.com
TRUST_PROXY=1

# --- 2. Localization, Timezone & Currency (Bangladesh) ---
TZ=Asia/Dhaka
DEFAULT_LOCALE=bn
SUPPORTED_LOCALES=bn,en
CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳

# --- 3. Security, Encryption & Sessions (OWASP Hardening) ---
# Generate high-entropy 64-char hex strings with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_SESSION_SECRET_DO_NOT_SHARE
CSRF_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_CSRF_SECRET
VENDOR_PII_KEY=REPLACE_WITH_64_CHAR_HEX_ENCRYPTION_KEY_FOR_PII

# Absolute persistent storage paths outside the application root
UPLOAD_DIR=/home/cpaneluser/storage/uploads
VENDOR_DOCUMENT_DIR=/home/cpaneluser/storage/vendor_docs

# --- 4. Production MySQL Database (Connection Pool) ---
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_mrtumi
DB_USER=cpaneluser_app
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD
DB_CHARSET=utf8mb4
DB_TIMEZONE=+00:00
DB_CONNECTION_LIMIT=20

# Safety flag: Must be 'true' to execute `node scripts/migrate.js up` in production
CONFIRM_PRODUCTION_MIGRATION=true

# Demo seed guard: strictly disabled in production
ALLOW_PRODUCTION_DEMO_SEED=false
SEED_DEMO_DATA=false

# --- 5. Redis In-Memory Cache & Rate Limiting ---
# Set either REDIS_URL or host/port/password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_AUTH_PASSWORD
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# --- 6. Bangladesh MFS Gateway: bKash (Dual-Mode: Tokenized API & Manual) ---
BKASH_IS_SANDBOX=false
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=REPLACE_WITH_LIVE_BKASH_APP_KEY
BKASH_APP_SECRET=REPLACE_WITH_LIVE_BKASH_APP_SECRET
BKASH_USERNAME=REPLACE_WITH_LIVE_BKASH_USERNAME
BKASH_PASSWORD=REPLACE_WITH_LIVE_BKASH_PASSWORD

# --- 7. Bangladesh MFS Gateway: Nagad (Dual-Mode: Direct API & Manual) ---
NAGAD_MERCHANT_ID=REPLACE_WITH_LIVE_NAGAD_MERCHANT_ID
NAGAD_BASE_URL=https://api.mynagad.com
NAGAD_CALLBACK_URL=https://mrtumi.com/api/v1/payments/nagad/callback
# Nagad public/private keys formatted without line breaks or path to .pem files
NAGAD_PUBLIC_KEY=REPLACE_WITH_NAGAD_PG_PUBLIC_KEY
NAGAD_PRIVATE_KEY=REPLACE_WITH_MERCHANT_PRIVATE_KEY

# --- 8. Bangladesh MFS Gateway: DBBL Rocket (Dual-Mode: Direct API & Manual) ---
ROCKET_MERCHANT_ID=REPLACE_WITH_LIVE_ROCKET_MERCHANT_ID
ROCKET_BASE_URL=https://rocket.dutchbanglabank.com/api
ROCKET_CALLBACK_URL=https://mrtumi.com/api/v1/payments/rocket/callback
ROCKET_APP_KEY=REPLACE_WITH_LIVE_ROCKET_APP_KEY
ROCKET_APP_SECRET=REPLACE_WITH_LIVE_ROCKET_APP_SECRET

# --- 9. Logistics & Last-Mile Courier: Steadfast Courier ---
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=REPLACE_WITH_STEADFAST_API_KEY
STEADFAST_SECRET_KEY=REPLACE_WITH_STEADFAST_SECRET_KEY

# --- 10. Logistics & Last-Mile Courier: Pathao Courier ---
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=REPLACE_WITH_PATHAO_CLIENT_ID
PATHAO_CLIENT_SECRET=REPLACE_WITH_PATHAO_CLIENT_SECRET
PATHAO_USERNAME=REPLACE_WITH_PATHAO_ACCOUNT_EMAIL
PATHAO_PASSWORD=REPLACE_WITH_PATHAO_ACCOUNT_PASSWORD
PATHAO_STORE_ID=REPLACE_WITH_PATHAO_STORE_ID
