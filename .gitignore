# Dependencies
node_modules/

# Environment variables & secrets (NEVER commit real .env files)
.env
.env.*
!.env.example

# Local / runtime databases & backups
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.sql.gz
*.dump
backups/

# Runtime customer / staff uploads (keep directory placeholder only)
public/uploads/custom/*
!public/uploads/custom/.gitkeep

# Logs, test artifacts & coverage
logs/
*.log
npm-debug.log*
coverage/
.nyc_output/
tmp/

# Keys, certificates & Android signing keystores
*.pem
*.key
*.p12
*.jks
*.keystore
android/*/local.properties

# OS & Sandbox scratch directories
.DS_Store
Thumbs.db
Unselected files/
