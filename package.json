{
  "name": "mr-tumi-grocery-gift",
  "version": "0.3.0",
  "private": true,
  "description": "Mr. Tumi Grocery & Gift — Bilingual (Bangla/English) E-Commerce, Multi-Vendor, Reseller & POS Platform for Bangladesh",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings app.js",
    "dev": "node --no-warnings scripts/dev-server.js",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "reservations:expire": "node scripts/expire-reservations.js",
    "lint": "node scripts/check-foundation.js",
    "test": "NODE_ENV=test node --no-warnings --test --test-concurrency=1 tests/*.test.js",
    "verify": "npm run lint && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "multer": "^2.0.1",
    "mysql2": "^3.24.6"
  }
}
