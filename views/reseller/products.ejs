<%- include('partials/layout-top', { title: 'Wholesale Catalog' }) %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h4 class="fw-bold mb-0">📦 রিসেলার পাইকারি প্রোডাক্ট ক্যাটালগ (<%= products.length %>)</h4>
    <p class="text-muted small mb-0">যেকোনো পণ্যের বিবরণ কপি করে আপনার ফেসবুক পেজ/গ্রুপে পোস্ট করুন এবং অর্ডার আসলে সরাসরি প্লেস করুন</p>
  </div>
  <form action="/reseller/products" method="GET" class="d-flex gap-2">
    <input type="text" name="q" value="<%= searchQuery %>" class="form-control form-control-sm" placeholder="পণ্য খুঁজুন..." />
    <button type="submit" class="btn btn-sm btn-dark">খুঁজুন</button>
  </form>
</div>

<div class="row g-3">
  <% products.forEach(function(p) {
       const margin = Math.max(0, Number(p.new_price) - Number(p.reseller_cost));
  %>
    <div class="col-md-6 col-xl-4">
      <div class="tbl-card h-100 p-3 d-flex flex-column">
        <div class="d-flex gap-3 mb-3">
          <img src="<%= p.image %>" style="width:90px;height:90px;border-radius:12px;object-fit:cover;flex-shrink:0;" alt="" />
          <div>
            <span class="badge bg-light text-secondary border mb-1"><%= p.category_name || brand.defaultProductBrand %></span>
            <h6 class="fw-bold mb-1"><%= p.name %></h6>
            <div class="small text-muted">স্টক: <strong><%= p.stock %></strong> • কোড: <%= p.code %></div>
          </div>
        </div>

        <div class="bg-light rounded-3 p-2.5 border mb-3 small" style="padding:10px;">
          <div class="d-flex justify-content-between mb-1">
            <span>আপনার পাইকারি ক্রয়মূল্য:</span>
            <strong class="text-primary fs-6">৳<%= Number(p.reseller_cost).toLocaleString('en-IN') %></strong>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span>প্রস্তাবিত খুচরা বিক্রয়মূল্য:</span>
            <strong>৳<%= Number(p.new_price).toLocaleString('en-IN') %>+</strong>
          </div>
          <div class="d-flex justify-content-between border-top pt-1 text-success fw-bold">
            <span>প্রতি পিস সম্ভাব্য লাভ:</span>
            <span>৳<%= margin %>+ (ইচ্ছেমতো দাম বাড়াতে পারবেন)</span>
          </div>
        </div>

        <div class="mt-auto d-flex gap-2">
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm flex-grow-1 js-copy-fb"
            data-copy="<%= p.name %> — শতভাগ ফরমালিনমুক্ত তাজা ফল! অর্ডার করতে ইনবক্স করুন।"
          >
            📋 কপি পোস্ট টেক্সট
          </button>
          <a href="/reseller/orders/create?product_id=<%= p.id %>" class="btn btn-primary btn-sm flex-grow-1 fw-bold" style="background:#3730a3;border-color:#3730a3;">
            ⚡ অর্ডার তৈরি করুন
          </a>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<script>
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.js-copy-fb');
    if (!btn) return;
    navigator.clipboard.writeText(btn.getAttribute('data-copy') || '').then(function() {
      if (window.toastr) window.toastr.success('ফেসবুক পোস্ট টেক্সট কপি হয়েছে!');
    });
  });
</script>

<%- include('partials/layout-bottom') %>
