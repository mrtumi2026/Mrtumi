<% const L = (en, bn) => (typeof locale !== 'undefined' && locale === 'en' ? en : bn); %>
<%- include('partials/layout-top', { title: 'Wholesale Catalog' }) %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h4 class="fw-bold mb-0"><%= L('📦 Reseller wholesale product catalogue (', '📦 রিসেলার পাইকারি প্রোডাক্ট ক্যাটালগ (') %><%= products.length %>)</h4>
    <p class="text-muted small mb-0"><%= L('Copy any product\'s description, post it on your Facebook page/group, and place the order as soon as one comes in', 'যেকোনো পণ্যের বিবরণ কপি করে আপনার ফেসবুক পেজ/গ্রুপে পোস্ট করুন এবং অর্ডার আসলে সরাসরি প্লেস করুন') %></p>
  </div>
  <form action="/reseller/products" method="GET" class="d-flex gap-2">
    <input type="text" name="q" value="<%= searchQuery %>" class="form-control form-control-sm" placeholder="<%= L('Search products...', 'পণ্য খুঁজুন...') %>" />
    <button type="submit" class="btn btn-sm btn-dark"><%= L('Search', 'খুঁজুন') %></button>
  </form>
</div>

<div class="row g-3">
  <% products.forEach(function(p) {
       const canOrder = typeof allowOrderCreation !== 'undefined' && allowOrderCreation === true;
       const margin = Math.max(0, Number(p.new_price) - Number(p.reseller_cost));
  %>
    <div class="col-md-6 col-xl-4">
      <div class="tbl-card h-100 p-3 d-flex flex-column">
        <div class="d-flex gap-3 mb-3">
          <img src="<%= p.image %>" style="width:90px;height:90px;border-radius:12px;object-fit:cover;flex-shrink:0;" alt="" />
          <div>
            <span class="badge bg-light text-secondary border mb-1"><%= p.category_name || brand.defaultProductBrand %></span>
            <h6 class="fw-bold mb-1"><%= p.name %></h6>
            <div class="small text-muted"><%= L('Stock:', 'স্টক:') %> <strong><%= canonicalCatalog ? Number(p.available_stock||0) : p.stock %></strong> <%= L('• Code:', '• কোড:') %> <%= canonicalCatalog ? p.sku : p.code %></div>
          </div>
        </div>

        <div class="bg-light rounded-3 p-2.5 border mb-3 small" style="padding:10px;">
          <% if(canonicalCatalog && !canOrder){ %><div class="d-flex justify-content-between"><span><%= L('Available stock', 'উপলভ্য স্টক') %></span><strong><%= Number(p.available_stock||0) %></strong></div><p class="text-muted mb-0 mt-2"><%= L('Reseller price, profit or order fee is not set. No order can be created here.', 'রিসেলার মূল্য, লাভ বা অর্ডার ফি নির্ধারিত নয়। কোনো অর্ডার এখানে তৈরি করা যাবে না।') %></p><% } else { %>
          <div class="d-flex justify-content-between mb-1"><span><%= L('Your wholesale cost:', 'আপনার পাইকারি ক্রয়মূল্য:') %></span><strong class="text-primary fs-6">৳<%= Number(p.reseller_cost).toLocaleString('en-IN') %></strong></div><div class="d-flex justify-content-between mb-1"><span><%= L('Suggested retail price:', 'প্রস্তাবিত খুচরা বিক্রয়মূল্য:') %></span><strong>৳<%= Number(p.new_price).toLocaleString('en-IN') %>+</strong></div><div class="d-flex justify-content-between border-top pt-1 text-success fw-bold"><span><%= L('Possible profit per piece:', 'প্রতি পিস সম্ভাব্য লাভ:') %></span><span>৳<%= margin %>+</span></div><% } %>
        </div>

        <div class="mt-auto d-flex gap-2">
          <% if(!canonicalCatalog || canOrder){ %><button
            type="button"
            class="btn btn-outline-secondary btn-sm flex-grow-1 js-copy-fb"
            data-copy="<%= p.name %> — <%= L('Message us to order.', 'শতভাগ ফরমালিনমুক্ত তাজা ফল! অর্ডার করতে ইনবক্স করুন।') %>"
          >
            <%= L('📋 Copy post text', '📋 কপি পোস্ট টেক্সট') %>
          </button>
          <a href="/reseller/orders/create?product_id=<%= p.id %>" class="btn btn-primary btn-sm flex-grow-1 fw-bold"><%= L('⚡ Create order', '⚡ অর্ডার তৈরি করুন') %></a><% } else { %><span class="text-muted small"><%= L('Catalogue info', 'ক্যাটালগ তথ্য') %></span><% } %>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<script>
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.js-copy-fb');
    if (!btn) return;
    navigator.clipboard.writeText(btn.getAttribute('data-copy') || '').then(function() {
      if (window.toastr) window.toastr.success(<%- JSON.stringify(L('Facebook post text copied!', 'ফেসবুক পোস্ট টেক্সট কপি হয়েছে!')).replace(/</g, '\\u003c') %>);
    });
  });
</script>

<%- include('partials/layout-bottom') %>
