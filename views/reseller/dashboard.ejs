<% const L = (en, bn) => (typeof locale !== 'undefined' && locale === 'en' ? en : bn); %>
<% const formatPaisa = value => { const n=BigInt(String(value||0)); const whole=n/100n; const cents=(n%100n).toString().padStart(2,'0'); return whole.toLocaleString('en-IN')+'.'+cents; }; %>
<%- include('partials/layout-top', { title: 'Reseller Dashboard' }) %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h4 class="fw-bold mb-0">
      🤝 <%= reseller.name %> (<%= reseller.shop_name || 'Reseller Partner' %>)
      <% if (reseller.verified) { %>
        <span class="badge bg-success ms-1" style="font-size:11px;"><%= L('✓ Verified Partner', '✓ যাচাইকৃত পার্টনার') %></span>
      <% } else { %>
        <span class="badge bg-warning text-dark ms-1" style="font-size:11px;">⏳ Verification Pending</span>
      <% } %>
    </h4>
    <p class="text-muted small mb-0"><%= L('Send dropship orders straight to your customer at wholesale price and withdraw your profit', 'পাইকারি দামে কাস্টমারের ঠিকানায় সরাসরি ড্রপশিপ অর্ডার পাঠান এবং লাভ উত্তোলন করুন') %></p>
  </div>
  <div class="d-flex gap-2">
    <% if(typeof allowOrderCreation === 'undefined' || allowOrderCreation){ %><a href="/reseller/orders/create" class="btn btn-primary btn-sm fw-bold"><%= L('+ Create new customer order', '+ নতুন কাস্টমার অর্ডার তৈরি করুন') %></a><% } %>
    <a href="/reseller/products" class="btn btn-outline-dark btn-sm"><%= L('📦 Wholesale catalogue', '📦 পাইকারি ক্যাটালগ') %></a>
  </div>
</div>

<div class="stat-grid mb-4">
  <div class="sc">
    <div class="sc-ico" style="background:#f0fdf4;"><i class="fas fa-coins text-success"></i></div>
    <div>
      <div class="sc-label"><%= L('Commission wallet balance', 'কমিশন ওয়ালেট ব্যালেন্স') %></div>
      <div class="sc-val">৳<%= Number(reseller.balance || reseller.available_balance || 0).toLocaleString('en-IN') %></div>
      <div class="sc-note"><%= Number(reseller.pending_balance || 0) > 0 ? L('Pending: ৳', 'পেন্ডিং: ৳') + Number(reseller.pending_balance).toLocaleString('en-IN') : L('Withdrawable profit', 'উত্তোলনযোগ্য লাভ') %></div>
    </div>
  </div>
  <div class="sc">
    <div class="sc-ico" style="background:#eff6ff;"><i class="fas fa-shield-alt text-primary"></i></div>
    <div>
      <div class="sc-label"><%= L('Security deposit', 'সিকিউরিটি ডিপোজিট') %></div>
      <div class="sc-val">৳<%= Number(reseller.deposit_amount || 0).toLocaleString('en-IN') %></div>
      <div class="sc-note"><%= L('Active balance', 'অ্যাক্টিভ ব্যালেন্স') %></div>
    </div>
  </div>
  <div class="sc">
    <div class="sc-ico" style="background:#fffbeb;"><i class="fas fa-truck-fast text-warning"></i></div>
    <div>
      <div class="sc-label"><%= L('Total reseller orders', 'মোট রিসেলার অর্ডার') %></div>
      <div class="sc-val"><%= totalOrders %></div>
      <div class="sc-note"><%= deliveredCount %> <%= L('Delivered •', 'ডেলিভারড •') %> <%= pendingCount %> <%= L('In progress', 'চলমান') %></div>
    </div>
  </div>
  <div class="sc">
    <div class="sc-ico" style="background:#faf5ff;"><i class="fas fa-chart-line text-info"></i></div>
    <div>
      <div class="sc-label"><%= L('Total profit earned', 'মোট অর্জিত প্রফিট') %></div>
      <div class="sc-val">৳<%= Number(totalEstimatedProfit || 0).toLocaleString('en-IN') %></div>
      <div class="sc-note"><%= L('Delivered order margin', 'ডেলিভারড অর্ডার মার্জিন') %></div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="tbl-card">
      <div class="tbl-card-head">
        <h4><%= canonicalDashboard ? L('Popular products', 'জনপ্রিয় পণ্য') : L('Popular wholesale products (with reseller margin)', 'জনপ্রিয় পাইকারি প্রোডাক্ট (রিসেলার মার্জিনসহ)') %></h4>
        <a href="/reseller/products" class="link-green"><%= L('View all →', 'সব দেখুন →') %></a>
      </div>
      <div class="tbl-card-body">
        <table class="table clean mb-0 align-middle">
          <thead>
            <tr>
              <th><%= L('Product', 'পণ্য') %></th>
              <th><%= L('Available stock', 'উপলভ্য স্টক') %></th>
              <th><%= L('Price', 'মূল্য') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% hotProducts.forEach(function(p) { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <img src="<%= p.image %>" class="p-thumb" alt="" />
                    <span class="fw-semibold"><%= p.name %></span>
                  </div>
                </td>
                <td><span class="badge bg-secondary-subtle text-secondary"><%= Number(p.available_stock||p.stock||0) %><%= L('', ' টি') %></span></td>
                <td><span class="fw-bold text-primary">৳<%= Number(p.new_price || 0).toLocaleString('en-IN') %></span></td>
                <td class="text-end"><a href="/reseller/orders/create?product_id=<%= p.id %>" class="btn btn-sm btn-primary py-0 px-2"><%= L('Order', 'অর্ডার করুন') %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="tbl-card">
      <div class="tbl-card-head">
        <h4><%= L('Recent reseller orders', 'সাম্প্রতিক রিসেলার অর্ডার') %></h4>
        <a href="/reseller/orders" class="link-green"><%= L('All orders →', 'সব অর্ডার →') %></a>
      </div>
      <div class="tbl-card-body">
        <table class="table clean mb-0">
          <thead>
            <tr>
              <th><%= L('Invoice', 'ইনভয়েস') %></th>
              <th><%= L('Customer', 'কাস্টমার') %></th>
              <th><%= canonicalDashboard ? L('Order margin (not wallet)', 'অর্ডার মার্জিন (ওয়ালেট নয়)') : L('Your profit', 'আপনার লাভ') %></th>
              <th><%= L('Status', 'স্ট্যাটাস') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (!recentOrders.length) { %>
              <tr><td colspan="4" class="text-center py-4 text-muted"><%= L('No orders yet.', 'এখনো কোনো অর্ডার নেই।') %></td></tr>
            <% } %>
            <% recentOrders.forEach(function(o) { %>
              <tr>
                <td class="fw-bold"><% if(canonicalDashboard){ %><a href="/reseller/orders/<%= o.id %>">#<%= o.invoice_id %></a><% } else { %>#<%= o.invoice_id %><% } %></td>
                <td><%= o.customer_name %></td>
                <td class="fw-bold text-success"><%= canonicalDashboard ? '৳'+formatPaisa(o.reseller_margin_paisa) : '+৳'+Number(o.reseller_profit || 0).toLocaleString('en-IN') %></td>
                <td><span class="sb <%= o.badge_class %>"><%= o.status_label %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/layout-bottom') %>
