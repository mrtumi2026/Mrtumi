<% const formatPaisa = value => { const n=BigInt(String(value||0)); const whole=n/100n; const cents=(n%100n).toString().padStart(2,'0'); return whole.toLocaleString('en-IN')+'.'+cents; }; %>
<%- include('partials/layout-top', { title: 'Order ' + order.invoice_id }) %>
<div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold">অর্ডার #<%= order.invoice_id %></h4><a href="/reseller/orders" class="btn btn-outline-secondary btn-sm">← অর্ডারে ফিরুন</a></div>
<div class="row g-3"><div class="col-lg-5"><div class="tbl-card p-3"><h5>কাস্টমার ও ডেলিভারি</h5><p class="mb-1"><strong><%= order.customer_name %></strong></p><p class="mb-1"><%= order.phone %></p><p><%= order.address %></p><p>স্ট্যাটাস: <strong><%= order.status %></strong></p><p>তৈরি: <%= String(order.created_at).slice(0,19) %></p></div></div><div class="col-lg-7"><div class="tbl-card"><div class="tbl-card-body"><h5>অর্ডার আইটেম</h5><div class="table-responsive"><table class="table"><thead><tr><th>পণ্য</th><th>ভ্যারিয়েন্ট</th><th>পরিমাণ</th><th>একক মূল্য</th><th>লাইন মোট</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><%= item.product_name %></td><td><%= [item.size_label,item.color_label].filter(Boolean).join(' / ') || '—' %></td><td><%= item.qty %></td><td>৳<%= formatPaisa(item.unit_price_paisa) %></td><td>৳<%= formatPaisa(item.line_total_paisa) %></td></tr><% }) %></tbody></table></div><hr><div class="text-end"><div>মোট: ৳<%= formatPaisa(order.total_paisa) %></div><div>পরিশোধিত: ৳<%= formatPaisa(order.paid_paisa) %></div><div>COD বাকি: ৳<%= formatPaisa(order.cod_due_paisa) %></div></div></div></div></div></div>
<%- include('partials/layout-bottom') %>
