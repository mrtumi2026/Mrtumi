<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'bn' %>">
  <head>
    <meta charset="utf-8" />
    <meta name="pb-sid" content="<%= typeof sessionToken !== 'undefined' ? sessionToken : '' %>" />
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
    <title><%= typeof title !== 'undefined' ? title : t('reseller.portalName') %> — <%= siteSettings.site_name %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="<%= siteSettings.favicon || '/uploads/brand/mrtumi-placeholder-favicon.svg' %>" />
    <script src="/frontEnd/js/pb-session.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="/backEnd/css/ubold-admin.css" rel="stylesheet" />
    <link href="/shared/css/mrtumi-design-system.css" rel="stylesheet" />
  </head>
  <body data-theme="light" data-topbar-color="dark" data-leftbar-color="dark">
    <a href="#mainContent" class="mt-skip-link"><%= t('a11y.skipToContent') %></a>
    <div id="wrapper">
      <!-- Reseller Topbar -->
      <header class="navbar-custom" style="background: #1e1b4b;" role="banner">
        <div class="container-fluid">
          <ul class="list-unstyled topnav-menu float-end mb-0 d-flex align-items-center">
            <li class="d-flex align-items-center px-1 me-1">
              <%- include('../../partials/lang-switch', { variant: 'dark' }) %>
            </li>
            <li class="d-none d-md-flex align-items-center px-2 gap-2">
              <a href="/reseller/deposits" class="badge bg-info text-dark text-decoration-none px-3 py-2 rounded-pill fw-bold">
                🛡️ <%= fmt.bdt((resellerUser && resellerUser.deposit_amount) || 0) %>
              </a>
              <a href="/reseller/withdrawals" class="badge bg-warning text-dark text-decoration-none px-3 py-2 rounded-pill fw-bold">
                💰 <%= fmt.bdt((resellerUser && resellerUser.balance) || 0) %>
              </a>
            </li>
            <li class="dropdown notification-list topbar-dropdown">
              <a class="nav-link dropdown-toggle nav-user me-0" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                <img src="/uploads/default/user.svg" alt="<%= (resellerUser && resellerUser.name) || 'Reseller' %>" class="rounded-circle" />
                <span class="pro-user-name ms-1"><%= (resellerUser && resellerUser.name) || 'Reseller' %> <i class="fas fa-chevron-down ms-1" style="font-size:10px;"></i></span>
              </a>
              <div class="dropdown-menu dropdown-menu-end profile-dropdown">
                <a href="/reseller/profile" class="dropdown-item notify-item"><i class="fas fa-user-cog me-2"></i><%= locale === 'bn' ? 'প্রোফাইল' : 'Profile' %></a>
                <a href="/reseller/withdrawals" class="dropdown-item notify-item"><i class="fas fa-wallet me-2"></i><%= t('reseller.wallet') %></a>
                <div class="dropdown-divider"></div>
                <form action="/reseller/logout" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
                  <button type="submit" class="dropdown-item notify-item text-danger border-0 bg-transparent w-100 text-start">
                    <i class="fas fa-sign-out-alt me-2"></i><%= t('admin.logout') %>
                  </button>
                </form>
              </div>
            </li>
          </ul>

          <div class="logo-box" style="background: rgba(0,0,0,0.22);">
            <a
              href="/reseller/dashboard"
              class="logo logo-light text-center"
              data-brand-asset-status="<%= (typeof brand !== 'undefined' && brand && brand.isPlaceholderLogo) ? 'temporary-placeholder' : 'custom' %>"
            >
              <span class="logo-lg"><img src="<%= siteSettings.logo_light %>" alt="<%= siteSettings.site_name %>" height="42" /></span>
            </a>
          </div>

          <ul class="list-unstyled topnav-menu topnav-menu-left m-0">
            <li>
              <button class="button-menu-mobile" type="button" aria-label="<%= t('a11y.toggleSidebar') %>" aria-expanded="false"><i data-feather="menu"></i></button>
            </li>
            <li class="d-none d-sm-flex align-items-center">
              <span class="badge bg-primary-subtle text-primary ms-2 px-2.5 py-1 fw-bold">🤝 <%= t('reseller.portalName') %></span>
            </li>
            <li class="d-flex">
              <a class="nav-link" href="/" target="_blank" rel="noopener" aria-label="<%= t('admin.viewStore') %>"><i data-feather="globe" style="width:15px;height:15px;"></i><span><%= t('admin.viewStore') %></span></a>
            </li>
            <li class="d-none d-lg-flex">
              <a class="nav-link" href="/admin/dashboard" target="_blank" rel="noopener"><i data-feather="shield" style="width:15px;height:15px;"></i><span>Admin</span></a>
            </li>
            <li class="d-none d-lg-flex">
              <a class="nav-link" href="/vendor/dashboard" target="_blank" rel="noopener"><i data-feather="shopping-bag" style="width:15px;height:15px;"></i><span><%= t('admin.vendorPortal') %></span></a>
            </li>
          </ul>
        </div>
      </header>

      <!-- Reseller Left Sidebar -->
      <aside class="left-side-menu" style="background: #232056;" aria-label="<%= t('a11y.mainNavigation') %>">
        <div class="h-100 pt-2">
          <nav id="sidebar-menu" aria-label="<%= t('a11y.mainNavigation') %>">
            <ul id="side-menu">
              <li><a href="/reseller/dashboard"><i data-feather="airplay"></i><span><%= t('reseller.dashboard') %></span></a></li>
              <li><a href="/reseller/products"><i data-feather="grid"></i><span><%= t('reseller.catalog') %></span></a></li>
              <li><a href="/reseller/orders/create"><i data-feather="plus-circle"></i><span><%= locale === 'bn' ? 'নতুন অর্ডার প্লেস' : 'Place Reseller Order' %></span></a></li>
              <li><a href="/reseller/orders"><i data-feather="shopping-cart"></i><span><%= t('reseller.myOrders') %></span></a></li>
              <li><a href="/reseller/deposits"><i data-feather="credit-card"></i><span><%= locale === 'bn' ? 'ডিপোজিট যুক্ত করুন' : 'Add Deposit' %></span></a></li>
              <li><a href="/reseller/withdrawals"><i data-feather="dollar-sign"></i><span><%= t('reseller.wallet') %></span></a></li>
              <li><a href="/reseller/profile"><i data-feather="settings"></i><span><%= locale === 'bn' ? 'প্রোফাইল সেটিংস' : 'Shop Profile' %></span></a></li>
            </ul>
          </nav>
        </div>
      </aside>
      <div class="mt-sidebar-backdrop" id="mtSidebarBackdrop" aria-hidden="true"></div>

      <main id="mainContent" class="content-page">
        <div class="content">
