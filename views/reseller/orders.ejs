<% const formatPaisa = value => { const n=BigInt(String(value||0)); const whole=n/100n; const cents=(n%100n).toString().padStart(2,'0'); return whole.toLocaleString('en-IN')+'.'+cents; }; %>
<%- include('partials/layout-top', { title: 'My Reseller Orders' }) %>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="fw-bold mb-0">📋 আমার রিসেলার অর্ডার (<%= typeof total !== 'undefined' ? total : orders.length %>)</h4><p class="text-muted small mb-0">অর্ডারের অবস্থা ও বিবরণ দেখুন<% if (canonicalOrders) { %> — পৃষ্ঠা <%= page %> / <%= totalPages %><% } %></p></div><% if (!canonicalOrders) { %><a href="/reseller/orders/create" class="btn btn-primary btn-sm fw-bold">+ নতুন অর্ডার</a><% } %></div>
<% if (canonicalOrders) { %><form method="get" action="/reseller/orders" class="row g-2 mb-3"><div class="col-md-5"><input class="form-control" name="q" value="<%= search %>" placeholder="ইনভয়েস বা কাস্টমার খুঁজুন"></div><div class="col-md-4"><select class="form-select" name="status"><option value="">সব স্ট্যাটাস</option><% ['pending','confirmed','processing','shipped','delivered','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="col-md-3"><button class="btn btn-outline-primary">ফিল্টার</button> <a class="btn btn-link" href="/reseller/orders">মুছুন</a></div></form><% } %>
<div class="tbl-card"><div class="tbl-card-body"><div class="table-responsive"><table class="table clean mb-0 align-middle"><thead><tr><th>ইনভয়েস</th><th>কাস্টমার ও ঠিকানা</th><th>অর্ডার মূল্য</th><th>রেকর্ডকৃত মার্জিন</th><th>স্ট্যাটাস</th><th>তারিখ</th></tr></thead><tbody><% if (!orders.length) { %><tr><td colspan="6" class="text-center py-4 text-muted">কোনো অর্ডার পাওয়া যায়নি।</td></tr><% } %><% orders.forEach(function(o) { %><tr><td class="fw-bold"><% if(canonicalOrders){ %><a href="/reseller/orders/<%= o.id %>">#<%= o.invoice_id %></a><% } else { %>#<%= o.invoice_id %><% } %></td><td><div class="fw-semibold"><%= o.customer_name %> (<%= o.phone %>)</div><small class="text-muted"><%= o.address %></small></td><td>৳<%= canonicalOrders ? formatPaisa(o.amount_paisa) : Number(o.amount||0).toLocaleString('en-IN') %></td><td>৳<%= canonicalOrders ? formatPaisa(o.reseller_margin_paisa) : Number(o.reseller_profit||0).toLocaleString('en-IN') %></td><td><span class="sb <%= o.badge_class %>"><%= o.status_label %></span></td><td class="small text-muted"><%= String(o.created_at).slice(0,10) %></td></tr><% }) %></tbody></table></div></div></div>
<% if(canonicalOrders && totalPages>1){ %><nav class="mt-3" aria-label="Order pages"><ul class="pagination"><% if(page>1){ %><li class="page-item"><a class="page-link" href="?page=<%= page-1 %>&status=<%= encodeURIComponent(status) %>&q=<%= encodeURIComponent(search) %>">আগের</a></li><% } %><li class="page-item disabled"><span class="page-link"><%= page %> / <%= totalPages %></span></li><% if(page<totalPages){ %><li class="page-item"><a class="page-link" href="?page=<%= page+1 %>&status=<%= encodeURIComponent(status) %>&q=<%= encodeURIComponent(search) %>">পরের</a></li><% } %></ul></nav><% } %>
<%- include('partials/layout-bottom') %>
