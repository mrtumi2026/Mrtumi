<%- include('partials/header', { title: 'শপিং কার্ট' }) %>

<main class="container py-4">
  <!-- Progress Bar -->
  <div class="d-flex justify-content-center align-items-center gap-3 mb-4 small fw-bold">
    <span class="badge bg-dark rounded-pill px-3 py-2">১. কার্ট</span>
    <span>→</span>
    <a href="/customer/checkout" class="badge bg-secondary bg-opacity-25 text-dark rounded-pill px-3 py-2 text-decoration-none">২. চেকআউট</a>
    <span>→</span>
    <span class="badge bg-secondary bg-opacity-25 text-dark rounded-pill px-3 py-2">৩. কনফার্মেশন</span>
  </div>

  <% if (!cart || !cart.length) { %>
    <div class="bg-white rounded-4 border p-5 text-center shadow-sm">
      <div style="font-size: 54px;">🛒</div>
      <h4 class="fw-bold mt-2">আপনার শপিং কার্ট খালি!</h4>
      <p class="text-muted">বাগান তাজা ফল কার্টে যোগ করে অর্ডার সম্পন্ন করুন।</p>
      <a href="/all-products" class="btn btn-success px-4 py-2 rounded-pill fw-bold mt-2" style="background:#1b4332;">
        সকল প্রোডাক্ট দেখুন →
      </a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="bg-white rounded-4 border p-4 shadow-sm">
          <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
            <h5 class="fw-bold mb-0">🧺 কার্টের পণ্যসমূহ (<span class="js-cart-count"><%= cartCount %></span> টি)</h5>
            <form action="/cart/clear" method="POST">
              <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">সব মুছুন</button>
            </form>
          </div>

          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead class="table-light small">
                <tr>
                  <th>পণ্য</th>
                  <th class="text-center">একক মূল্য</th>
                  <th class="text-center">পরিমাণ</th>
                  <th class="text-end">মোট</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="cartPageTableBody">
                <% cart.forEach(function(it) { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <img src="<%= it.image %>" style="width:60px;height:60px;border-radius:10px;object-fit:cover;" alt="" />
                        <div>
                          <a href="/product/<%= it.slug %>" class="fw-bold text-dark text-decoration-none"><%= it.name %></a>
                          <div class="small text-muted">সাইজ: <%= it.size %><%= it.color ? (' • ' + it.color) : '' %></div>
                        </div>
                      </div>
                    </td>
                    <td class="text-center fw-semibold">৳<%= Number(it.price).toLocaleString('en-IN') %></td>
                    <td class="text-center">
                      <div class="input-group input-group-sm mx-auto" style="width: 115px;">
                        <button type="button" class="btn btn-outline-secondary" onclick="window.updateCartItemQty('<%= it.key %>', <%= Number(it.qty) - 1 %>)">−</button>
                        <input type="text" readonly class="form-control text-center fw-bold" value="<%= it.qty %>" />
                        <button type="button" class="btn btn-outline-secondary" onclick="window.updateCartItemQty('<%= it.key %>', <%= Number(it.qty) + 1 %>)">+</button>
                      </div>
                    </td>
                    <td class="text-end fw-bold text-success">৳<%= Number(it.price * it.qty).toLocaleString('en-IN') %></td>
                    <td class="text-end">
                      <button type="button" class="btn btn-sm btn-outline-danger" onclick="window.removeCartItem('<%= it.key %>')">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="bg-white rounded-4 border p-4 shadow-sm">
          <h5 class="fw-bold border-bottom pb-2 mb-3">🧾 অর্ডার সামারি</h5>
          <div class="d-flex justify-content-between py-2">
            <span>সাবটোটাল:</span>
            <strong class="fs-5 text-success">৳<span class="js-cart-subtotal"><%= Number(cartSubtotal).toLocaleString('en-IN') %></span></strong>
          </div>
          <p class="small text-muted mb-3">ডেলিভারি চার্জ ও কুপন কোড পরবর্তী ধাপে (চেকআউটে) যোগ হবে।</p>
          <a href="/customer/checkout" class="btn btn-success w-100 py-3 fw-bold rounded-3" style="background:#1b4332;">
            চেকআউট পেজে যান →
          </a>
          <a href="/all-products" class="btn btn-outline-secondary w-100 mt-2 rounded-3">← আরও কেনাকাটা করুন</a>
        </div>
      </div>
    </div>

    <script>
      window.onCartStateUpdated = function(state) {
        if (!state.cart || !state.cart.length) {
          window.location.reload();
          return;
        }
        var tbody = document.getElementById('cartPageTableBody');
        if (!tbody) return;
        tbody.innerHTML = state.cart.map(function(it) {
          return '<tr>' +
            '<td><div class="d-flex align-items-center gap-3">' +
              '<img src="' + it.image + '" style="width:60px;height:60px;border-radius:10px;object-fit:cover;" alt="" />' +
              '<div><div class="fw-bold text-dark">' + it.name + '</div><div class="small text-muted">সাইজ: ' + it.size + (it.color ? ' • ' + it.color : '') + '</div></div>' +
            '</div></td>' +
            '<td class="text-center fw-semibold">৳' + Number(it.price).toLocaleString('en-IN') + '</td>' +
            '<td class="text-center"><div class="input-group input-group-sm mx-auto" style="width:115px;">' +
              '<button type="button" class="btn btn-outline-secondary" onclick="window.updateCartItemQty(\'' + it.key + '\',' + (Number(it.qty) - 1) + ')">−</button>' +
              '<input type="text" readonly class="form-control text-center fw-bold" value="' + it.qty + '" />' +
              '<button type="button" class="btn btn-outline-secondary" onclick="window.updateCartItemQty(\'' + it.key + '\',' + (Number(it.qty) + 1) + ')">+</button>' +
            '</div></td>' +
            '<td class="text-end fw-bold text-success">৳' + Number(it.price * it.qty).toLocaleString('en-IN') + '</td>' +
            '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" onclick="window.removeCartItem(\'' + it.key + '\')"><i class="fas fa-trash-alt"></i></button></td>' +
          '</tr>';
        }).join('');
      };
    </script>
  <% } %>
</main>

<%- include('partials/footer') %>
