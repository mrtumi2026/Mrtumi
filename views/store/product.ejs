<%- include('partials/header', { title: product.name }) %>

<main id="mainContent" class="container py-4">
  <nav aria-label="breadcrumb" class="mb-3 small">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="/" class="text-success text-decoration-none"><%= t('common.home') %></a></li>
      <% if (product.category_name) { %>
        <li class="breadcrumb-item"><a href="/category/<%= product.category_slug %>" class="text-success text-decoration-none"><%= product.category_name %></a></li>
      <% } %>
      <li class="breadcrumb-item active"><%= product.name %></li>
    </ol>
  </nav>

  <div class="bg-white rounded-4 border p-4 mb-4">
    <div class="row g-4">
      <!-- Image Gallery -->
      <div class="col-lg-5">
        <div class="border rounded-4 overflow-hidden mb-2 bg-light">
          <img id="mainProdImg" src="<%= product.image %>" alt="<%= product.name %>" class="w-100" style="aspect-ratio: 1/1; object-fit: cover;" />
        </div>
        <div class="d-flex gap-2">
          <img src="<%= product.image %>" onclick="document.getElementById('mainProdImg').src=this.src" style="width:68px;height:68px;object-fit:cover;cursor:pointer;" class="rounded-3 border" alt="" />
          <img src="/uploads/product/lychee-box.jpg" onclick="document.getElementById('mainProdImg').src=this.src" style="width:68px;height:68px;object-fit:cover;cursor:pointer;" class="rounded-3 border" alt="" />
          <img src="/uploads/product/lychee-organic.jpg" onclick="document.getElementById('mainProdImg').src=this.src" style="width:68px;height:68px;object-fit:cover;cursor:pointer;" class="rounded-3 border" alt="" />
        </div>
      </div>

      <!-- Product Info & Order Form -->
      <div class="col-lg-7">
        <h1 class="fw-bold fs-3 mb-2"><%= product.name %></h1>
        <div class="d-flex flex-wrap gap-3 small text-muted mb-3">
          <span>⭐ (<%= reviews.length %> রিভিউ)</span>
          <span>• <%= locale === 'bn' ? 'ব্র্যান্ড' : 'Brand' %>: <strong class="text-dark"><%= replaceLegacyBrandTokens(product.brand_name) || brand.defaultProductBrand %></strong></span>
          <span>• কোড: <strong><%= product.code %></strong></span>
          <span>• স্টক: <span class="badge <%= product.stock > 0 ? 'bg-success' : 'bg-danger' %>"><%= product.stock > 0 ? ('স্টকে আছে (' + product.stock + ')') : 'স্টক আউট' %></span></span>
        </div>

        <div class="mb-3">
          <% if (product.old_price > product.new_price) { %>
            <span class="fs-5 text-muted text-decoration-line-through me-2">৳<%= Number(product.old_price).toLocaleString('en-IN') %></span>
          <% } %>
          <span class="display-6 fw-bold text-success">৳<%= Number(product.new_price).toLocaleString('en-IN') %></span>
        </div>

        <% if (product.wholesale_price > 0 && product.wholesale_min_qty > 0) { %>
          <div class="p-3 rounded-3 bg-light border mb-3" style="max-width: 440px;">
            <h6 class="fw-bold small mb-2">📦 পাইকারি মূল্য (Wholesale Tier)</h6>
            <table class="table table-sm mb-0 small">
              <thead><tr><th>পরিমাণ</th><th>ইউনিট মূল্য</th><th>সাশ্রয়</th></tr></thead>
              <tbody>
                <tr><td>১ – <%= product.wholesale_min_qty - 1 %> প্যাক</td><td>৳<%= product.new_price %></td><td>রেগুলার</td></tr>
                <tr class="table-success fw-semibold"><td><%= product.wholesale_min_qty %>+ প্যাক</td><td>৳<%= product.wholesale_price %></td><td>পাইকারি ছাড়</td></tr>
              </tbody>
            </table>
          </div>
        <% } %>

        <form action="/cart/add" method="POST" id="productCartForm">
          <input type="hidden" name="product_id" value="<%= product.id %>" />

          <% const sizeList = (product.sizes || '').split(',').map(s => s.trim()).filter(Boolean); %>
          <% if (sizeList.length) { %>
            <div class="mb-3">
              <label class="form-label fw-semibold small d-block">সাইজ / ভ্যারিয়েন্ট নির্বাচন করুন:</label>
              <div class="d-flex flex-wrap gap-2">
                <% sizeList.forEach(function(sz, idx) { %>
                  <input type="radio" class="btn-check" name="size" id="sz_<%= idx %>" value="<%= sz %>" <%= idx === 0 ? 'checked' : '' %> />
                  <label class="btn btn-outline-success btn-sm px-3" for="sz_<%= idx %>"><%= sz %></label>
                <% }) %>
              </div>
            </div>
          <% } %>

          <% const colorList = (product.colors || '').split(',').map(c => c.trim()).filter(Boolean); %>
          <% if (colorList.length) { %>
            <div class="mb-3">
              <label class="form-label fw-semibold small d-block">গ্রেড / রঙ বেছে নিন:</label>
              <div class="d-flex flex-wrap gap-2">
                <% colorList.forEach(function(cl, idx) { %>
                  <input type="radio" class="btn-check" name="color" id="cl_<%= idx %>" value="<%= cl %>" <%= idx === 0 ? 'checked' : '' %> />
                  <label class="btn btn-outline-secondary btn-sm px-3" for="cl_<%= idx %>"><%= cl %></label>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div class="d-flex align-items-center gap-3 mb-4">
            <label for="pQty" class="fw-semibold small"><%= t('common.quantity') %>:</label>
            <div class="input-group" style="width: 140px;">
              <button class="btn btn-outline-secondary" type="button" aria-label="<%= t('a11y.decreaseQty') %>" onclick="var q=document.getElementById('pQty');q.value=Math.max(1,parseInt(q.value||1)-1);">−</button>
              <input type="number" id="pQty" name="qty" value="1" min="1" class="form-control text-center fw-bold" />
              <button class="btn btn-outline-secondary" type="button" aria-label="<%= t('a11y.increaseQty') %>" onclick="var q=document.getElementById('pQty');q.value=parseInt(q.value||1)+1;">+</button>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 mb-4">
            <button type="submit" class="btn btn-outline-success px-4 py-2 fw-bold rounded-3 js-prod-add-btn" <%= product.stock <= 0 ? 'disabled' : '' %>>
              🛒 Add to Cart (কার্টে যোগ করুন)
            </button>
            <button type="submit" name="buy_now" value="1" class="btn btn-success px-4 py-2 fw-bold rounded-3" style="background:#1b4332;border-color:#1b4332;" <%= product.stock <= 0 ? 'disabled' : '' %>>
              ⚡ Buy Now (চেকআউটে যান)
            </button>
            <button
              type="button"
              class="btn btn-warning px-4 py-2 fw-bold rounded-3 js-quick-order"
              data-id="<%= product.id %>"
              data-name="<%= product.name %>"
              data-price="<%= product.new_price %>"
              data-old-price="<%= product.old_price || 0 %>"
              data-image="<%= product.image %>"
              data-sizes="<%= product.sizes || '১ কেজি' %>"
              data-colors="<%= product.colors || '' %>"
              <%= product.stock <= 0 ? 'disabled' : '' %>
            >
              🚀 ১-ক্লিক ক্যাশ অন ডেলিভারি
            </button>
          </div>
        </form>

        <div class="pt-3 border-top small text-muted d-flex flex-wrap gap-3">
          <span>📞 ফোনে অর্ডার করতে কল করুন: <strong class="text-dark"><%= siteSettings.site_phone %></strong></span>
          <span>🚚 সারা বাংলাদেশে দ্রুত হোম ডেলিভারি</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Description & Customer Reviews -->
  <div class="row g-4 mb-5">
    <div class="col-lg-7">
      <div class="bg-white rounded-4 border p-4 h-100">
        <h5 class="fw-bold border-bottom pb-2 mb-3">📋 পণ্যের বিস্তারিত বিবরণ (Description)</h5>
        <div style="white-space: pre-line; line-height: 1.8;"><%= product.description || product.short_desc %></div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="bg-white rounded-4 border p-4 h-100">
        <h5 class="fw-bold border-bottom pb-2 mb-3">⭐ গ্রাহক রিভিউ (<%= reviews.length %>)</h5>

        <% if (!reviews.length) { %>
          <p class="text-muted small">এখনো কোনো রিভিউ নেই। প্রথম রিভিউটি আপনিই লিখুন!</p>
        <% } else { %>
          <% reviews.forEach(function(rv) { %>
            <div class="border-bottom pb-2 mb-2">
              <div class="d-flex justify-content-between">
                <strong class="small"><%= rv.customer_name %></strong>
                <span class="text-warning small"><%= '★'.repeat(rv.rating) %></span>
              </div>
              <p class="small text-secondary mb-0 mt-1"><%= rv.comment %></p>
            </div>
          <% }) %>
        <% } %>

        <form action="/api/review" method="POST" class="mt-3 pt-2 border-top">
          <input type="hidden" name="product_id" value="<%= product.id %>" />
          <h6 class="fw-bold small mb-2">রিভিউ লিখুন</h6>
          <div class="row g-2">
            <div class="col-7">
              <input type="text" name="customer_name" class="form-control form-control-sm" placeholder="আপনার নাম *" required />
            </div>
            <div class="col-5">
              <select name="rating" class="form-select form-select-sm">
                <option value="5">5 ★ অসাধারণ</option>
                <option value="4">4 ★ খুব ভালো</option>
                <option value="3">3 ★ ভালো</option>
              </select>
            </div>
            <div class="col-12">
              <textarea name="comment" rows="2" class="form-control form-control-sm" placeholder="আপনার মতামত লিখুন..." required></textarea>
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-success btn-sm">রিভিউ জমা দিন</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Related Products -->
  <% if (relatedProducts && relatedProducts.length) { %>
    <section>
      <h4 class="fw-bold mb-3 fs-5">🍒 এ জাতীয় আরও পণ্য</h4>
      <div class="row g-3">
        <% relatedProducts.slice(0, 4).forEach(function(rp) { %>
          <div class="col-6 col-md-3">
            <%- include('partials/product-card', { p: rp, showStockMeta: false }) %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>
