<%- include('partials/header', { title: pageTitle }) %>

<main id="mainContent" class="container py-4">
  <%- include('../partials/filter-bar', {
    title: pageTitle + ' (' + fmt.number(products.length) + ')',
    subtitle: subtitle,
    actionUrl: '/all-products',
    searchName: 'q',
    searchValue: searchQuery,
    searchPlaceholder: t('store.searchPlaceholder'),
    sortName: 'sort',
    sortValue: sort,
    sortOptions: [
      { value: 'newest', label: t('store.sortNewest') },
      { value: 'price_asc', label: t('store.sortPriceAsc') },
      { value: 'price_desc', label: t('store.sortPriceDesc') }
    ]
  }) %>

  <% if (!products.length) { %>
    <%- include('../partials/empty-state', {
      icon: '🔍',
      title: t('store.emptyProductsTitle'),
      description: t('store.emptyProductsSub'),
      actionUrl: '/all-products',
      actionLabel: t('common.allProducts')
    }) %>
  <% } else { %>
    <div class="row g-3">
      <% products.forEach(function(p) { %>
        <div class="col-6 col-md-4 col-lg-3">
          <%- include('partials/product-card', { p: p, showStockMeta: true }) %>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
