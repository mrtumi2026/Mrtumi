<%- include('partials/header', { title: pageTitle }) %>

<main class="container py-4">
  <div class="bg-white rounded-4 border p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h2 class="fw-bold mb-1 fs-4"><%= pageTitle %> (<%= products.length %>)</h2>
      <p class="text-muted small mb-0"><%= subtitle %></p>
    </div>

    <form action="/all-products" method="GET" class="d-flex gap-2 align-items-center">
      <% if (searchQuery) { %><input type="hidden" name="q" value="<%= searchQuery %>" /><% } %>
      <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>নতুন প্রোডাক্ট আগে</option>
        <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>কম দাম থেকে বেশি</option>
        <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>বেশি দাম থেকে কম</option>
      </select>
    </form>
  </div>

  <% if (!products.length) { %>
    <div class="text-center py-5 bg-white rounded-4 border">
      <div style="font-size: 46px;">🍒</div>
      <h5 class="fw-bold mt-2">কোনো পণ্য খুঁজে পাওয়া যায়নি</h5>
      <a href="/all-products" class="btn btn-success btn-sm mt-2 rounded-pill px-4">সকল প্রোডাক্ট দেখুন</a>
    </div>
  <% } else { %>
    <div class="row g-3">
      <% products.forEach(function(p) { %>
        <div class="col-6 col-md-4 col-lg-3">
          <%- include('partials/product-card', { p: p, showStockMeta: true }) %>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
