<%- include('partials/header') %>

<main id="mainContent" class="container py-4">
  <!-- Hero Banner Slider -->
  <% if (heroBanners && heroBanners.length) { %>
    <div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
      <div class="carousel-inner">
        <% heroBanners.forEach(function(b, idx) { %>
          <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
            <div class="hero-slide">
              <img src="<%= b.image %>" alt="<%= b.title %>" />
              <div class="hero-caption">
                <span class="mt-hero-badge align-self-start mb-2">🛒 <%= t('store.heroBadge') %></span>
                <h1 class="fw-bold display-6 mb-2 text-white" style="max-width: 600px;">
                  <%= locale === 'en' ? t('store.heroTitle') : (replaceLegacyBrandTokens(b.title) || t('store.heroTitle')) %>
                </h1>
                <p class="mb-3 fs-6" style="max-width: 540px; color: #e2e8f0;">
                  <%= locale === 'en' ? t('store.heroSubtitle') : (replaceLegacyBrandTokens(b.subtitle) || t('store.heroSubtitle')) %>
                </p>
                <div class="d-flex flex-wrap gap-2">
                  <a href="<%= b.link || '/all-products' %>" class="btn btn-warning fw-bold px-4 py-2 rounded-pill shadow-sm">
                    <%= t('store.shopNowBtn') %> →
                  </a>
                  <a href="/hot-deals" class="btn btn-outline-light fw-bold px-4 py-2 rounded-pill">
                    🎁 <%= t('store.exploreGiftsBtn') %>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <% if (heroBanners.length > 1) { %>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Previous Slide">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Next Slide">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
      <% } %>
    </div>
  <% } %>

  <!-- Flash Sale Section -->
  <% if (flashProducts && flashProducts.length) { %>
    <section class="mb-5" aria-label="<%= t('store.flashSaleTitle') %>">
      <div class="sec-head bg-white p-3 rounded-4 border">
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <div>
            <h2 class="fw-bold mb-0 fs-4 text-danger">⚡ <%= t('store.flashSaleTitle') %></h2>
            <small class="text-muted"><%= t('store.flashSaleSub') %></small>
          </div>
          <div class="cd-box" data-countdown="<%= siteSettings.flash_sale_end || '2027-06-30T23:59:59' %>">
            <span class="small text-muted me-1"><%= t('store.endsIn') %>:</span>
            <div class="cd-pill"><strong class="cd-d">00</strong><span><%= locale === 'bn' ? 'দিন' : 'D' %></span></div>
            <div class="cd-pill"><strong class="cd-h">00</strong><span><%= locale === 'bn' ? 'ঘণ্টা' : 'H' %></span></div>
            <div class="cd-pill"><strong class="cd-m">00</strong><span><%= locale === 'bn' ? 'মিনিট' : 'M' %></span></div>
            <div class="cd-pill"><strong class="cd-s">00</strong><span><%= locale === 'bn' ? 'সেকেন্ড' : 'S' %></span></div>
          </div>
        </div>
        <a href="/flash-sales" class="btn btn-outline-success btn-sm rounded-pill px-3"><%= t('common.viewAll') %> →</a>
      </div>

      <div class="row g-3">
        <% flashProducts.forEach(function(p) { %>
          <div class="col-6 col-md-4 col-lg-3">
            <%- include('partials/product-card', { p: p, showStockMeta: true }) %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- Mid Promo Banner -->
  <% if (promoBanners && promoBanners.length) { %>
    <section class="mb-5" aria-label="Promotional Offer">
      <a href="<%= promoBanners[0].link || '/flash-sales' %>" class="text-decoration-none">
        <div class="hero-slide" style="min-height: 210px;">
          <img src="<%= promoBanners[0].image %>" alt="<%= promoBanners[0].title || 'Special Offer' %>" style="height: 220px;" />
          <div class="hero-caption">
            <h3 class="fw-bold mb-1 text-white"><%= replaceLegacyBrandTokens(promoBanners[0].title) %></h3>
            <p class="mb-2" style="color: #e2e8f0;"><%= replaceLegacyBrandTokens(promoBanners[0].subtitle) %></p>
            <span class="btn btn-light btn-sm fw-bold align-self-start rounded-pill px-3"><%= t('store.exploreGiftsBtn') %> →</span>
          </div>
        </div>
      </a>
    </section>
  <% } %>

  <!-- Hot Deal Section -->
  <% if (hotProducts && hotProducts.length) { %>
    <section class="mb-5" aria-label="<%= t('store.hotDealTitle') %>">
      <div class="sec-head bg-white p-3 rounded-4 border">
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <div>
            <h2 class="fw-bold mb-0 fs-4" style="color:#0d3b26;">🔥 <%= t('store.hotDealTitle') %></h2>
            <small class="text-muted"><%= t('store.hotDealBadge') %></small>
          </div>
          <div class="cd-box" data-countdown="<%= siteSettings.hot_deal_end || '2027-07-15T23:59:59' %>">
            <div class="cd-pill" style="background:#0d3b26;"><strong class="cd-d">00</strong><span><%= locale === 'bn' ? 'দিন' : 'D' %></span></div>
            <div class="cd-pill" style="background:#0d3b26;"><strong class="cd-h">00</strong><span><%= locale === 'bn' ? 'ঘণ্টা' : 'H' %></span></div>
            <div class="cd-pill" style="background:#0d3b26;"><strong class="cd-m">00</strong><span><%= locale === 'bn' ? 'মিনিট' : 'M' %></span></div>
            <div class="cd-pill" style="background:#0d3b26;"><strong class="cd-s">00</strong><span><%= locale === 'bn' ? 'সেকেন্ড' : 'S' %></span></div>
          </div>
        </div>
        <a href="/hot-deals" class="btn btn-outline-success btn-sm rounded-pill px-3"><%= t('common.viewAll') %> →</a>
      </div>

      <div class="row g-3">
        <% hotProducts.forEach(function(p) { %>
          <div class="col-6 col-md-4 col-lg-3">
            <%- include('partials/product-card', { p: p, showStockMeta: false }) %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- Category Sections -->
  <% categorySections.forEach(function(sec) { %>
    <section class="mb-5" aria-label="<%= sec.category.name %>">
      <div class="sec-head">
        <h2 class="fw-bold mb-0 fs-4"><span aria-hidden="true"><%= sec.category.icon || '🛒' %></span> <%= sec.category.name %></h2>
        <a href="/category/<%= sec.category.slug %>" class="btn btn-outline-success btn-sm rounded-pill px-3"><%= t('common.viewAll') %> →</a>
      </div>
      <div class="row g-3">
        <% sec.products.slice(0, 4).forEach(function(p) { %>
          <div class="col-6 col-md-4 col-lg-3">
            <%- include('partials/product-card', { p: p, showStockMeta: false }) %>
          </div>
        <% }) %>
      </div>
    </section>
  <% }) %>

  <!-- All Products -->
  <section class="mb-4" aria-label="<%= t('store.allProductsTitle') %>">
    <div class="sec-head">
      <h2 class="fw-bold mb-0 fs-4">🛒 <%= t('store.allProductsTitle') %></h2>
      <a href="/all-products" class="btn btn-outline-success btn-sm rounded-pill px-3"><%= t('common.viewAll') %> →</a>
    </div>
    <div class="row g-3">
      <% allProducts.forEach(function(p) { %>
        <div class="col-6 col-md-4 col-lg-3">
          <%- include('partials/product-card', { p: p, showStockMeta: false }) %>
        </div>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
