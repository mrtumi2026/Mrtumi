<%- include('partials/header', { title: policy.title }) %>
<main id="mainContent" class="container py-5" style="max-width:920px"><h1 class="h2"><%= policy.title %></h1><p class="text-muted"><%= isEn ? 'Version' : 'সংস্করণ' %> <%= policy.version %> · <%= policy.published_at %></p><div class="alert alert-warning"><%= isEn ? 'This operational notice is not legal advice or a compliance certification. Qualified legal review is outstanding.' : 'এই কার্যকরী নোটিশ আইনি পরামর্শ বা আইন মেনে চলার সনদ নয়। যোগ্য আইনজীবীর পর্যালোচনা বাকি।' %></div><div class="border rounded bg-white p-4" style="white-space:pre-wrap;line-height:1.8"><%= policy.content %></div><p class="mt-4"><a href="/customer/account/privacy-requests"><%= isEn ? 'Submit a privacy request' : 'গোপনীয়তা অনুরোধ জমা দিন' %></a></p></main>
<%- include('partials/footer') %>
