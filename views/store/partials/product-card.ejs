<%
  const hasDiscount = p.old_price && Number(p.old_price) > Number(p.new_price);
  const discPct = hasDiscount ? Math.round(((Number(p.old_price) - Number(p.new_price)) / Number(p.old_price)) * 100) : 0;
  const outOfStock = Number(p.stock || 0) <= 0;
%>
<article class="pb-card">
  <a href="/product/<%= p.slug %>" class="pb-card-img-wrap d-block">
    <% if (discPct > 0) { %>
      <span class="pb-disc-badge">-<%= fmt.number(discPct) %>%</span>
    <% } %>
    <% if (outOfStock) { %>
      <span class="badge bg-dark position-absolute top-0 end-0 m-2 z-2"><%= t('common.outOfStock') %></span>
    <% } %>
    <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" />
  </a>

  <div class="pb-card-body">
    <a href="/product/<%= p.slug %>" class="pb-card-title mb-1"><%= p.name %></a>

    <div class="mt-auto pt-1">
      <div class="mb-1">
        <% if (hasDiscount) { %>
          <span class="pb-price-old"><%= fmt.bdt(p.old_price) %></span>
        <% } %>
        <span class="pb-price-new"><%= fmt.bdt(p.new_price) %></span>
      </div>

      <% if (typeof showStockMeta !== 'undefined' && showStockMeta) { %>
        <div class="text-muted mb-2" style="font-size: 11.5px;">
          <%= locale === 'bn' ? 'স্টক:' : 'Stock:' %> <%= fmt.number(p.stock || 0) %>
        </div>
      <% } %>

      <div class="d-flex gap-1 mt-2">
        <button
          type="button"
          class="btn-add-cart-card js-add-to-cart"
          data-id="<%= p.id %>"
          data-size="<%= (p.sizes || 'Standard').split(',')[0].trim() %>"
          aria-label="<%= t('store.addToCart') %>: <%= p.name %>"
          title="<%= t('store.addToCart') %>"
          <%= outOfStock ? 'disabled' : '' %>
        >
          <i class="fas fa-cart-plus" aria-hidden="true"></i>
        </button>

        <button
          type="button"
          class="btn-order-now js-quick-order"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.new_price %>"
          data-old-price="<%= p.old_price || 0 %>"
          data-image="<%= p.image %>"
          data-sizes="<%= p.sizes || 'Standard' %>"
          data-colors="<%= p.colors || '' %>"
          data-stock="<%= p.stock %>"
          <%= outOfStock ? 'disabled' : '' %>
        >
          ⚡ <%= t('store.orderNow') %>
        </button>
      </div>
    </div>
  </div>
</article>
