<%
  const hasDiscount = p.old_price && Number(p.old_price) > Number(p.new_price);
  const discPct = hasDiscount ? Math.round(((Number(p.old_price) - Number(p.new_price)) / Number(p.old_price)) * 100) : 0;
  const outOfStock = Number(p.stock || 0) <= 0;
%>
<div class="pb-card">
  <a href="/product/<%= p.slug %>" class="pb-card-img-wrap d-block">
    <% if (discPct > 0) { %>
      <span class="pb-disc-badge"><%= discPct %>% ছাড়</span>
    <% } %>
    <% if (outOfStock) { %>
      <span class="badge bg-dark position-absolute top-0 end-0 m-2 z-2">স্টক আউট</span>
    <% } %>
    <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" />
  </a>

  <div class="pb-card-body">
    <a href="/product/<%= p.slug %>" class="pb-card-title mb-1"><%= p.name %></a>

    <div class="mt-auto pt-1">
      <div class="mb-1">
        <% if (hasDiscount) { %>
          <span class="pb-price-old">৳<%= Number(p.old_price).toLocaleString('en-IN') %></span>
        <% } %>
        <span class="pb-price-new">৳<%= Number(p.new_price).toLocaleString('en-IN') %></span>
      </div>

      <% if (typeof showStockMeta !== 'undefined' && showStockMeta) { %>
        <div class="text-muted mb-2" style="font-size: 11.5px;">
          বিক্রি <%= p.sold_count || 0 %> &bull; বাকি <%= p.stock %>
        </div>
      <% } %>

      <div class="d-flex gap-1 mt-2">
        <button
          type="button"
          class="btn-add-cart-card js-add-to-cart"
          data-id="<%= p.id %>"
          data-size="<%= (p.sizes || '১ কেজি').split(',')[0].trim() %>"
          title="কার্টে যোগ করুন"
          <%= outOfStock ? 'disabled' : '' %>
        >
          <i class="fas fa-cart-plus"></i>
        </button>

        <button
          type="button"
          class="btn-order-now js-quick-order"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.new_price %>"
          data-old-price="<%= p.old_price || 0 %>"
          data-image="<%= p.image %>"
          data-sizes="<%= p.sizes || '১ কেজি' %>"
          data-colors="<%= p.colors || '' %>"
          data-stock="<%= p.stock %>"
          <%= outOfStock ? 'disabled' : '' %>
        >
          ⚡ অর্ডার করুন
        </button>
      </div>
    </div>
  </div>
</div>
