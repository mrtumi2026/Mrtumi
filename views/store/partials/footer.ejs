    <!-- Trust Feature Strip -->
    <section class="container my-5">
      <div class="row g-3">
        <% storeFeatures.forEach(function(ft) { %>
          <div class="col-6 col-lg-3">
            <div class="feat-card">
              <div class="feat-ico"><i class="fas fa-check-circle"></i></div>
              <div>
                <h6 class="fw-bold mb-1" style="font-size: 15px;"><%= ft.title %></h6>
                <p class="text-muted small mb-0"><%= ft.subtitle %></p>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Main Footer -->
    <footer style="background: #11291e; color: #dcfce7;" class="pt-5 pb-4">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-4">
            <img src="<%= siteSettings.logo_light || '/uploads/settings/logo-light.svg' %>" alt="ফল বাজার" height="46" class="mb-3" />
            <p class="small text-white-50 mb-3">
              <%= siteSettings.site_tagline || 'দিনাজপুর ও রাজশাহীর বাগান থেকে সরাসরি সংগৃহীত শতভাগ কেমিক্যালমুক্ত তাজা ফল।' %>
            </p>
            <div class="small mb-1">📍 <%= siteSettings.site_address %></div>
            <div class="small mb-1">📞 হটলাইন: <strong><%= siteSettings.site_phone %></strong></div>
            <div class="small">✉️ ইমেইল: <%= siteSettings.site_email %></div>
          </div>

          <div class="col-6 col-lg-2">
            <h6 class="fw-bold text-white mb-3">ক্যাটাগরি</h6>
            <ul class="list-unstyled small">
              <% navCategories.slice(0, 5).forEach(function(c) { %>
                <li class="mb-2"><a href="/category/<%= c.slug %>" class="text-white-50 text-decoration-none"><%= c.name %></a></li>
              <% }) %>
            </ul>
          </div>

          <div class="col-6 col-lg-3">
            <h6 class="fw-bold text-white mb-3">গ্রাহক সেবা</h6>
            <ul class="list-unstyled small">
              <li class="mb-2"><a href="/cart" class="text-white-50 text-decoration-none">শপিং কার্ট দেখুন</a></li>
              <li class="mb-2"><a href="/track-order" class="text-white-50 text-decoration-none">অর্ডার ট্র্যাক করুন</a></li>
              <% footerPages.forEach(function(fp) { %>
                <li class="mb-2"><a href="/page/<%= fp.slug %>" class="text-white-50 text-decoration-none"><%= fp.title %></a></li>
              <% }) %>
              <li class="mb-2"><a href="/admin/dashboard" class="text-warning text-decoration-none">🔐 অ্যাডমিন প্যানেল লগইন</a></li>
              <li class="mb-2"><a href="/vendor/dashboard" class="text-warning text-decoration-none">🏪 ভেন্ডর / সেলার প্যানেল</a></li>
              <li class="mb-2"><a href="/reseller/dashboard" class="text-warning text-decoration-none">🤝 রিসেলার ও ড্রপশিপ প্যানেল</a></li>
            </ul>
          </div>

          <div class="col-lg-3">
            <h6 class="fw-bold text-white mb-3">অফার আপডেট পান</h6>
            <p class="small text-white-50">নতুন মৌসুমি ফলের ডিসকাউন্ট পেতে মোবাইল বা ইমেইল দিন:</p>
            <form action="/api/newsletter" method="POST" class="d-flex gap-2">
              <input type="text" name="email_or_phone" class="form-control form-control-sm" placeholder="মোবাইল বা ইমেইল..." required />
              <button type="submit" class="btn btn-success btn-sm px-3">যুক্ত হোন</button>
            </form>
          </div>
        </div>

        <div class="border-top border-secondary border-opacity-25 mt-4 pt-3 d-flex justify-content-between flex-wrap small text-white-50">
          <span>© <%= new Date().getFullYear() %> <%= siteSettings.site_name || 'ফল বাজার' %> — সর্বস্বত্ব সংরক্ষিত।</span>
          <span>SSL Secured &bull; Cash On Delivery &bull; Fast Courier</span>
        </div>
      </div>
    </footer>

    <!-- Slide-Over Mini Cart Offcanvas Drawer -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="miniCartDrawer" aria-labelledby="miniCartDrawerLabel" style="width: 390px; max-width: 94vw;">
      <div class="offcanvas-header border-bottom" style="background: #f0fdf4;">
        <h6 class="offcanvas-title fw-bold text-success mb-0" id="miniCartDrawerLabel">
          🛒 আপনার শপিং কার্ট (<span class="js-cart-count"><%= cartCount || 0 %></span>)
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body d-flex flex-column p-0">
        <div id="miniCartItemsWrap" class="flex-grow-1 p-3" style="overflow-y: auto;">
          <!-- Rendered dynamically and initialized from server cart -->
        </div>
        <div class="border-top p-3 bg-light">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-semibold text-secondary">সাবটোটাল:</span>
            <span class="fs-5 fw-bold text-success">৳<span class="js-cart-subtotal"><%= Number(cartSubtotal || 0).toLocaleString('en-IN') %></span></span>
          </div>
          <div class="d-grid gap-2">
            <a href="/customer/checkout" class="btn btn-success fw-bold py-2 rounded-3" style="background:#1b4332;border-color:#1b4332;">
              ⚡ অর্ডার সম্পন্ন করুন (চেকআউট) →
            </a>
            <div class="d-flex gap-2">
              <a href="/cart" class="btn btn-outline-success btn-sm flex-grow-1">কার্ট পেজ দেখুন</a>
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="offcanvas">আরও কিনুন</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Product Option & Direct Instant Order Modal -->
    <div class="modal fade" id="quickOptionModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
          <div class="modal-header border-bottom pb-2" style="background:#f0fdf4;">
            <h6 class="modal-title fw-bold text-success">🍒 পণ্য অপশন ও দ্রুত অর্ডার</h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" id="qoProdId" />
            <input type="hidden" id="qoUnitPriceVal" value="0" />

            <div class="d-flex align-items-center gap-3 mb-3">
              <img id="qoImg" src="/uploads/product/lychee-fresh.jpg" style="width:74px;height:74px;border-radius:12px;object-fit:cover;" alt="" />
              <div>
                <h6 class="fw-bold mb-1" id="qoTitle"></h6>
                <div class="d-flex align-items-center gap-2">
                  <span class="fs-5 fw-bold text-success" id="qoPrice"></span>
                  <span class="small text-muted text-decoration-line-through" id="qoOldPrice"></span>
                </div>
              </div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-sm-7">
                <label class="form-label small fw-semibold d-block mb-1">সাইজ / প্যাক নির্বাচন করুন:</label>
                <div id="qoSizesWrap"></div>
              </div>
              <div class="col-sm-5">
                <label class="form-label small fw-semibold d-block mb-1">পরিমাণ (Quantity):</label>
                <div class="input-group input-group-sm" style="max-width: 130px;">
                  <button class="btn btn-outline-secondary" type="button" onclick="changeQoQty(-1)">−</button>
                  <input type="number" id="qoQty" value="1" min="1" class="form-control text-center fw-bold" onchange="recalcQoTotal()" />
                  <button class="btn btn-outline-secondary" type="button" onclick="changeQoQty(1)">+</button>
                </div>
              </div>
            </div>

            <div id="qoColorsGroup" class="mb-3" style="display:none;">
              <label class="form-label small fw-semibold d-block mb-1">গ্রেড / ভ্যারিয়েন্ট:</label>
              <div id="qoColorsWrap"></div>
            </div>

            <!-- Action Tabs: Cart vs Direct 1-Click COD Order -->
            <div class="d-flex gap-2 mb-3">
              <button type="button" id="qoAddToCartBtn" class="btn btn-outline-success fw-bold flex-grow-1">
                🛒 কার্টে যোগ করুন
              </button>
              <button type="button" id="qoBuyNowCheckoutBtn" class="btn btn-success fw-bold flex-grow-1" style="background:#1b4332;">
                ⚡ চেকআউট পেজে যান
              </button>
            </div>

            <!-- Embedded Direct 1-Click Cash On Delivery Box -->
            <div class="border rounded-3 p-3 bg-light">
              <div class="fw-bold small text-success mb-2">🚀 অথবা এখানেই সরাসরি ক্যাশ অন ডেলিভারি অর্ডার করুন:</div>
              <form id="qoDirectOrderForm">
                <div class="row g-2">
                  <div class="col-sm-6">
                    <input type="text" name="customer_name" class="form-control form-control-sm" placeholder="আপনার পূর্ণ নাম *" required />
                  </div>
                  <div class="col-sm-6">
                    <input type="tel" name="phone" class="form-control form-control-sm" placeholder="মোবাইল নম্বর (01XXXXXXXXX) *" required />
                  </div>
                  <div class="col-sm-7">
                    <input type="text" name="address" class="form-control form-control-sm" placeholder="সম্পূর্ণ ঠিকানা (বাসা, থানা, জেলা) *" required />
                  </div>
                  <div class="col-sm-5">
                    <select name="shipping_area" id="qoShipArea" class="form-select form-select-sm" onchange="recalcQoTotal()">
                      <option value="ঢাকার ভিতরে" data-ship="<%= siteSettings.inside_dhaka_charge || 60 %>">ঢাকার ভিতরে (৳<%= siteSettings.inside_dhaka_charge || 60 %>)</option>
                      <option value="ঢাকার বাইরে" data-ship="<%= siteSettings.outside_dhaka_charge || 120 %>">ঢাকার বাইরে (৳<%= siteSettings.outside_dhaka_charge || 120 %>)</option>
                    </select>
                  </div>
                  <div class="col-12 mt-2">
                    <button type="submit" id="qoDirectSubmitBtn" class="btn btn-warning w-100 fw-bold py-2">
                      ✓ সরাসরি অর্ডার নিশ্চিত করুন — মোট ৳<span id="qoTotalPayable">0</span>
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Initial Cart State for JS -->
    <script>
      window.__INITIAL_CART = <%- JSON.stringify(cart || []) %>;
      window.__FREE_SHIP_MIN = <%= Number(siteSettings.free_shipping_min || 2500) %>;
    </script>

    <!-- Verified Order Social Proof Popup -->
    <div id="verifiedOrderToast" class="vo-toast">
      <img id="voImg" src="/uploads/product/lychee-fresh.jpg" style="width:52px;height:52px;border-radius:10px;object-fit:cover;" alt="" />
      <div class="small">
        <div class="text-muted" style="font-size:11px;"><span id="voCust" class="fw-bold text-dark"></span> এই মাত্র কিনেছেন</div>
        <a id="voLink" href="/all-products" class="fw-bold text-success text-decoration-none d-block text-truncate" style="max-width:195px;">
          <span id="voProd"></span>
        </a>
        <span class="badge bg-success-subtle text-success mt-1" style="font-size:10px;">🛡️ Verified Order</span>
      </div>
      <button type="button" class="btn-close ms-auto" style="font-size:10px;" onclick="document.getElementById('verifiedOrderToast').classList.remove('show')"></button>
    </div>

    <!-- Live Support Floating Chat ("লাইভ সহায়তা") -->
    <button type="button" id="lsFabBtn" class="ls-fab">
      <i class="fas fa-comments"></i> লাইভ সহায়তা
    </button>

    <div id="lsChatBox" class="ls-box">
      <div class="p-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1b4332, #15803d);">
        <div>
          <div class="fw-bold">ফল বাজার লাইভ সহায়তা</div>
          <div style="font-size:11px;opacity:0.85;">অনলাইন শপিং সহকারী</div>
        </div>
        <button type="button" id="lsCloseBtn" class="btn-close btn-close-white"></button>
      </div>

      <div class="px-2 py-2 bg-light border-bottom d-flex flex-wrap gap-1">
        <button type="button" class="btn btn-sm btn-white border rounded-pill py-0 px-2 ls-quick-btn" data-q="প্রোডাক্ট খুঁজুন" style="font-size:11px;">🔍 প্রোডাক্ট খুঁজুন</button>
        <button type="button" class="btn btn-sm btn-white border rounded-pill py-0 px-2 ls-quick-btn" data-q="অর্ডার ট্র্যাক" style="font-size:11px;">📦 অর্ডার ট্র্যাক</button>
        <button type="button" class="btn btn-sm btn-white border rounded-pill py-0 px-2 ls-quick-btn" data-action="complaint" style="font-size:11px;">📝 কমপ্লেইন</button>
        <button type="button" class="btn btn-sm btn-white border rounded-pill py-0 px-2 ls-quick-btn" data-q="রিফান্ড পলিসি" style="font-size:11px;">💰 রিফান্ড</button>
      </div>

      <div id="lsChatMsgs" class="p-3 flex-grow-1" style="overflow-y:auto;">
        <div class="p-2.5 rounded-3 bg-light small text-dark" style="padding:10px;">
          স্বাগতম ফল বাজার-এ! 😊 প্রোডাক্ট খুঁজতে, অর্ডার ট্র্যাক করতে (ইনভয়েস বা মোবাইল নম্বর দিন), অথবা রিফান্ড/কমপ্লেইন জানাতে মেসেজ করুন।
        </div>
      </div>

      <form id="lsChatForm" class="p-2 border-top d-flex gap-1 bg-white">
        <input type="text" id="lsChatInput" class="form-control form-control-sm" placeholder="বার্তা বা ইনভয়েস নম্বর লিখুন..." />
        <button type="submit" class="btn btn-success btn-sm px-3">➤</button>
      </form>
    </div>

    <!-- Complaint Modal ("কমপ্লেইন / সমস্যা জানান") -->
    <div class="modal fade" id="complaintModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form id="complaintForm" class="modal-content rounded-4">
          <div class="modal-header">
            <h6 class="modal-title fw-bold">📝 কমপ্লেইন / সমস্যা জানান</h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-2">
              <label class="form-label small fw-semibold">নাম *</label>
              <input type="text" name="name" class="form-control form-control-sm" required />
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold">মোবাইল *</label>
              <input type="text" name="phone" class="form-control form-control-sm" required />
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold">অর্ডার / ইনভয়েস নম্বর (ঐচ্ছিক)</label>
              <input type="text" name="invoice_id" class="form-control form-control-sm" />
            </div>
            <div class="mb-2">
              <label class="form-label small fw-semibold">বিস্তারিত বিবরণ *</label>
              <textarea name="details" rows="3" class="form-control form-control-sm" required></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">বাতিল</button>
            <button type="submit" class="btn btn-success btn-sm">জমা দিন</button>
          </div>
        </form>
      </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="/frontEnd/js/storefront.js"></script>
    <% if (flash && flash.message) { %>
      <script>
        toastr.options = { positionClass: 'toast-top-right', timeOut: 3500 };
        toastr["<%= flash.type === 'error' ? 'error' : 'success' %>"](<%- JSON.stringify(flash.message) %>);
      </script>
    <% } %>
  </body>
</html>
