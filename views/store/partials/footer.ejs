    <!-- Trust Feature Strip -->
    <section class="container my-5" aria-label="Store Highlights">
      <div class="mt-trust-strip">
        <div class="mt-trust-card">
          <div class="mt-trust-card__icon" aria-hidden="true"><i class="fas fa-certificate"></i></div>
          <div>
            <h6 class="fw-bold mb-0" style="font-size: 14.5px;"><%= t('store.trustGenuineTitle') %></h6>
            <p class="text-muted small mb-0"><%= t('store.trustGenuineSub') %></p>
          </div>
        </div>
        <div class="mt-trust-card">
          <div class="mt-trust-card__icon" aria-hidden="true"><i class="fas fa-truck-fast"></i></div>
          <div>
            <h6 class="fw-bold mb-0" style="font-size: 14.5px;"><%= t('store.trustDeliveryTitle') %></h6>
            <p class="text-muted small mb-0"><%= t('store.trustDeliverySub') %></p>
          </div>
        </div>
        <div class="mt-trust-card">
          <div class="mt-trust-card__icon" aria-hidden="true" style="background:#fef3c7;color:#92400e;"><i class="fas fa-gift"></i></div>
          <div>
            <h6 class="fw-bold mb-0" style="font-size: 14.5px;"><%= t('store.trustGiftTitle') %></h6>
            <p class="text-muted small mb-0"><%= t('store.trustGiftSub') %></p>
          </div>
        </div>
        <div class="mt-trust-card">
          <div class="mt-trust-card__icon" aria-hidden="true"><i class="fas fa-shield-halved"></i></div>
          <div>
            <h6 class="fw-bold mb-0" style="font-size: 14.5px;"><%= t('store.trustPaymentTitle') %></h6>
            <p class="text-muted small mb-0"><%= t('store.trustPaymentSub') %></p>
          </div>
        </div>
      </div>
    </section>

    <% if (typeof analyticsAttributionEnabled !== 'undefined' && analyticsAttributionEnabled) { %>
      <section class="container my-3" aria-labelledby="analyticsPreferenceTitle">
        <div class="border rounded-3 p-3 bg-light">
          <h2 class="h6 mb-1" id="analyticsPreferenceTitle"><%= locale === 'en' ? 'Optional campaign attribution' : 'ঐচ্ছিক ক্যাম্পেইন অ্যাট্রিবিউশন' %></h2>
          <p class="small mb-2"><%= locale === 'en' ? 'If enabled, campaign source, medium and campaign labels from links may be associated with an order. This setting does not send events to advertising platforms.' : 'চালু করলে লিংকের ক্যাম্পেইন সোর্স, মাধ্যম ও ক্যাম্পেইন লেবেল অর্ডারের সঙ্গে সংরক্ষিত হতে পারে। এই সেটিং বিজ্ঞাপন প্ল্যাটফর্মে কোনো ইভেন্ট পাঠায় না।' %></p>
          <% if (analyticsConsent) { %>
            <p class="small mb-2"><%= locale === 'en' ? 'Campaign attribution is enabled for this session.' : 'এই সেশনে ক্যাম্পেইন অ্যাট্রিবিউশন চালু আছে।' %></p>
            <form action="/analytics/consent" method="post" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
              <input type="hidden" name="choice" value="withdraw">
              <input type="hidden" name="return_to" value="<%= currentUrl || '/' %>">
              <button type="submit" class="btn btn-sm btn-outline-secondary"><%= locale === 'en' ? 'Withdraw for this session' : 'এই সেশনের সম্মতি প্রত্যাহার' %></button>
            </form>
          <% } else if (analyticsConsentChoice === 'rejected' || analyticsConsentChoice === 'withdrawn') { %>
            <p class="small mb-2"><%= locale === 'en' ? 'Campaign attribution is off for this session.' : 'এই সেশনে ক্যাম্পেইন অ্যাট্রিবিউশন বন্ধ আছে।' %></p>
            <form action="/analytics/consent" method="post" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
              <input type="hidden" name="choice" value="accept">
              <input type="hidden" name="return_to" value="<%= currentUrl || '/' %>">
              <button type="submit" class="btn btn-sm btn-outline-success"><%= locale === 'en' ? 'Enable campaign attribution' : 'ক্যাম্পেইন অ্যাট্রিবিউশন চালু করুন' %></button>
            </form>
          <% } else { %>
            <form action="/analytics/consent" method="post" class="d-inline-flex flex-wrap gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
              <input type="hidden" name="return_to" value="<%= currentUrl || '/' %>">
              <button type="submit" name="choice" value="accept" class="btn btn-sm btn-success"><%= locale === 'en' ? 'Allow campaign attribution' : 'ক্যাম্পেইন অ্যাট্রিবিউশনের অনুমতি দিন' %></button>
              <button type="submit" name="choice" value="reject" class="btn btn-sm btn-outline-secondary"><%= locale === 'en' ? 'No, thanks' : 'না, ধন্যবাদ' %></button>
            </form>
          <% } %>
        </div>
      </section>
    <% } %>

    <!-- Main Footer -->
    <footer style="background: #072618; color: #e2e8f0;" class="pb-footer pt-5 pb-4" role="contentinfo">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-4">
            <img
              src="<%= siteSettings.logo_light %>"
              alt="<%= siteSettings.site_name %>"
              height="44"
              class="mb-2"
              data-brand-asset-status="<%= (typeof brand !== 'undefined' && brand && brand.isPlaceholderLogo) ? 'temporary-placeholder' : 'custom' %>"
            />
            <% if (typeof brand !== 'undefined' && brand && brand.isPlaceholderLogo) { %>
              <div class="mb-2">
                <span class="badge rounded-pill" style="background:#451a03;color:#fde68a;border:1px dashed #f59e0b;font-size:10.5px;">
                  <%= brand.placeholderBadge %>
                </span>
              </div>
            <% } %>
            <p class="small mb-3" style="color: #cbd5e1;">
              <%= t('store.footerTagline') %>
            </p>
            <div class="small mb-1">📍 <%= siteSettings.site_address %></div>
            <div class="small mb-1">📞 <%= t('common.hotline') %>: <strong><%= siteSettings.site_phone %></strong></div>
            <div class="small mb-3">✉️ <%= siteSettings.site_email %></div>

            <% if (typeof socialLinks !== 'undefined' && socialLinks && socialLinks.length) { %>
              <div class="d-flex flex-wrap gap-2 mt-2">
                <% socialLinks.forEach(function(sl) { %>
                  <a
                    href="<%= sl.url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-sm btn-outline-light rounded-pill px-3"
                    aria-label="<%= sl.platform %>"
                  >
                    <%= sl.platform %>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="col-6 col-lg-2">
            <h6 class="fw-bold text-white mb-3"><%= t('store.footerCategories') %></h6>
            <ul class="list-unstyled small">
              <li class="mb-2"><a href="/all-products" style="color: #cbd5e1;" class="text-decoration-none"><%= t('common.allProducts') %></a></li>
              <li class="mb-2"><a href="/flash-sales" style="color: #cbd5e1;" class="text-decoration-none"><%= t('common.flashSale') %></a></li>
              <li class="mb-2"><a href="/hot-deals" style="color: #cbd5e1;" class="text-decoration-none"><%= t('common.hotDeal') %></a></li>
              <% navCategories.slice(0, 5).forEach(function(c) { %>
                <li class="mb-2"><a href="/category/<%= c.slug %>" style="color: #cbd5e1;" class="text-decoration-none"><%= c.name %></a></li>
              <% }) %>
            </ul>
          </div>

          <div class="col-6 col-lg-3">
            <h6 class="fw-bold text-white mb-3"><%= t('store.footerPolicies') %></h6>
            <ul class="list-unstyled small">
              <li class="mb-2"><a href="/about" style="color: #cbd5e1;" class="text-decoration-none"><%= t('store.aboutNav') %></a></li>
              <li class="mb-2"><a href="/faq" style="color: #cbd5e1;" class="text-decoration-none"><%= t('store.faqNav') %></a></li>
              <li class="mb-2"><a href="/contact" style="color: #cbd5e1;" class="text-decoration-none"><%= t('store.contactNav') %></a></li>
              <li class="mb-2"><a href="/blogs" style="color: #cbd5e1;" class="text-decoration-none"><%= t('common.blogs') %></a></li>
              <li class="mb-2"><a href="/track-order" style="color: #cbd5e1;" class="text-decoration-none"><%= t('common.trackOrder') %></a></li>
              <% footerPages.forEach(function(fp) { %>
                <% if (fp.slug !== 'about-us') { %>
                  <li class="mb-2"><a href="/page/<%= fp.slug %>" style="color: #cbd5e1;" class="text-decoration-none"><%= fp.title %></a></li>
                <% } %>
              <% }) %>
            </ul>
          </div>

          <div class="col-lg-3">
            <h6 class="fw-bold text-white mb-3"><%= t('store.subscribe') %></h6>
            <p class="small" style="color: #cbd5e1;"><%= locale === 'bn' ? 'নতুন গ্রোসারি ও গিফট অফারের আপডেট পান:' : 'Get updates on grocery & gift deals:' %></p>
            <form action="/api/newsletter" method="POST" class="d-flex gap-2 mb-3">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
              <label for="footerNewsletterInput" class="visually-hidden"><%= t('store.newsletterPlaceholder') %></label>
              <input type="text" id="footerNewsletterInput" name="email_or_phone" class="form-control form-control-sm" placeholder="<%= t('store.newsletterPlaceholder') %>" required />
              <button type="submit" class="btn btn-warning btn-sm fw-bold px-3"><%= t('store.subscribe') %></button>
            </form>

            <div class="pt-2 border-top border-secondary border-opacity-25 small">
              <div class="fw-semibold text-white mb-2"><%= t('store.footerPortals') %></div>
              <div class="d-flex flex-wrap gap-2">
                <a href="/admin/dashboard" class="badge bg-dark border text-warning text-decoration-none py-1.5 px-2">🔐 <%= t('admin.controlPanel') %></a>
                <a href="/vendor/dashboard" class="badge bg-dark border text-light text-decoration-none py-1.5 px-2">🏪 <%= t('vendor.portalName') %></a>
                <a href="/reseller/dashboard" class="badge bg-dark border text-light text-decoration-none py-1.5 px-2">🤝 <%= t('reseller.portalName') %></a>
              </div>
            </div>
          </div>
        </div>

        <div class="border-top border-secondary border-opacity-25 mt-4 pt-3 d-flex justify-content-between flex-wrap gap-2 small" style="color: #cbd5e1;">
          <span>© <%= new Date().getFullYear() %> <%= siteSettings.site_name %> — <%= t('store.copyrightRights') %></span>
          <span>BDT (৳) &bull; Cash On Delivery &bull; Nationwide Delivery</span>
        </div>
      </div>
    </footer>

    <!-- Slide-Over Mini Cart Offcanvas Drawer -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="miniCartDrawer" aria-labelledby="miniCartDrawerLabel" style="width: 390px; max-width: 94vw;">
      <div class="offcanvas-header border-bottom" style="background: #f0fdf4;">
        <h6 class="offcanvas-title fw-bold text-success mb-0" id="miniCartDrawerLabel">
          🛒 <%= t('common.cart') %> (<span class="js-cart-count"><%= cartCount || 0 %></span>)
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="<%= t('a11y.closeModal') %>"></button>
      </div>
      <div class="offcanvas-body d-flex flex-column p-0">
        <div id="miniCartItemsWrap" class="flex-grow-1 p-3" style="overflow-y: auto;"></div>
        <div class="border-top p-3 bg-light">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-semibold text-secondary"><%= t('common.subtotal') %>:</span>
            <span class="fs-5 fw-bold text-success">৳<span class="js-cart-subtotal"><%= Number(cartSubtotal || 0).toLocaleString('en-IN') %></span></span>
          </div>
          <div class="d-grid gap-2">
            <a href="/customer/checkout" class="btn btn-success fw-bold py-2 rounded-3" style="background:#0d3b26;border-color:#0d3b26;">
              ⚡ <%= t('store.proceedToCheckout') %> →
            </a>
            <div class="d-flex gap-2">
              <a href="/cart" class="btn btn-outline-success btn-sm flex-grow-1"><%= t('common.cart') %></a>
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="offcanvas"><%= t('common.continueShopping') %></button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Product Option & Direct Instant Order Modal -->
    <div class="modal fade" id="quickOptionModal" tabindex="-1" aria-labelledby="qoModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
          <div class="modal-header border-bottom pb-2" style="background:#f0fdf4;">
            <h6 class="modal-title fw-bold text-success" id="qoModalLabel">🛒 <%= t('store.quickViewTitle') %></h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('a11y.closeModal') %>"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" id="qoProdId" />
            <input type="hidden" id="qoUnitPriceVal" value="0" />

            <div class="d-flex align-items-center gap-3 mb-3">
              <img id="qoImg" src="/uploads/product/lychee-fresh.jpg" style="width:74px;height:74px;border-radius:12px;object-fit:cover;" alt="" />
              <div>
                <h6 class="fw-bold mb-1" id="qoTitle"></h6>
                <div class="d-flex align-items-center gap-2">
                  <span class="fs-5 fw-bold text-success" id="qoPrice"></span>
                  <span class="small text-muted text-decoration-line-through" id="qoOldPrice"></span>
                </div>
              </div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-sm-7">
                <span class="form-label small fw-semibold d-block mb-1"><%= t('store.selectSizeVariant') %></span>
                <div id="qoSizesWrap"></div>
              </div>
              <div class="col-sm-5">
                <label for="qoQty" class="form-label small fw-semibold d-block mb-1"><%= t('common.quantity') %>:</label>
                <div class="input-group input-group-sm" style="max-width: 130px;">
                  <button class="btn btn-outline-secondary" type="button" aria-label="<%= t('a11y.decreaseQty') %>" onclick="changeQoQty(-1)">−</button>
                  <input type="number" id="qoQty" value="1" min="1" class="form-control text-center fw-bold" onchange="recalcQoTotal()" />
                  <button class="btn btn-outline-secondary" type="button" aria-label="<%= t('a11y.increaseQty') %>" onclick="changeQoQty(1)">+</button>
                </div>
              </div>
            </div>

            <div id="qoColorsGroup" class="mb-3" style="display:none;">
              <span class="form-label small fw-semibold d-block mb-1"><%= t('store.selectColorGrade') %></span>
              <div id="qoColorsWrap"></div>
            </div>

            <div class="d-flex gap-2 mb-3">
              <button type="button" id="qoAddToCartBtn" class="btn btn-outline-success fw-bold flex-grow-1">
                🛒 <%= t('store.addToCart') %>
              </button>
              <button type="button" id="qoBuyNowCheckoutBtn" class="btn btn-success fw-bold flex-grow-1" style="background:#0d3b26;">
                ⚡ <%= t('common.checkout') %>
              </button>
            </div>

            <!-- Embedded Direct Cash On Delivery Box -->
            <div class="border rounded-3 p-3 bg-light">
              <div class="fw-bold small text-success mb-2">🚀 <%= t('store.confirmOrderNow') %> (COD):</div>
              <form id="qoDirectOrderForm">
                <div class="row g-2">
                  <div class="col-sm-6">
                    <label for="qoCustName" class="visually-hidden"><%= t('store.fullName') %></label>
                    <input type="text" id="qoCustName" name="customer_name" class="form-control form-control-sm" placeholder="<%= t('store.fullName') %> *" required />
                  </div>
                  <div class="col-sm-6">
                    <label for="qoCustPhone" class="visually-hidden"><%= t('store.mobileNumber') %></label>
                    <input type="tel" id="qoCustPhone" name="phone" class="form-control form-control-sm" placeholder="<%= t('store.mobilePlaceholder') %> *" required />
                  </div>
                  <div class="col-sm-7">
                    <label for="qoCustAddress" class="visually-hidden"><%= t('store.fullAddress') %></label>
                    <input type="text" id="qoCustAddress" name="address" class="form-control form-control-sm" placeholder="<%= t('store.fullAddress') %> *" required />
                  </div>
                  <div class="col-sm-5">
                    <label for="qoShipArea" class="visually-hidden"><%= t('store.shippingArea') %></label>
                    <select name="shipping_area" id="qoShipArea" class="form-select form-select-sm" onchange="recalcQoTotal()">
                      <option value="ঢাকার ভিতরে" data-ship="<%= siteSettings.inside_dhaka_charge || 60 %>"><%= t('common.insideDhaka') %> (৳<%= siteSettings.inside_dhaka_charge || 60 %>)</option>
                      <option value="ঢাকার বাইরে" data-ship="<%= siteSettings.outside_dhaka_charge || 120 %>"><%= t('common.outsideDhaka') %> (৳<%= siteSettings.outside_dhaka_charge || 120 %>)</option>
                    </select>
                  </div>
                  <div class="col-12 mt-2">
                    <button type="submit" id="qoDirectSubmitBtn" class="btn btn-warning w-100 fw-bold py-2">
                      ✓ <%= t('store.confirmOrderNow') %> — ৳<span id="qoTotalPayable">0</span>
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Initial Cart & Bilingual Client Strings for JS -->
    <script>
      window.__INITIAL_CART = <%- JSON.stringify(cart || []).replace(/</g, '\\u003c') %>;
      window.__FREE_SHIP_MIN = <%= Number(siteSettings.free_shipping_min || 2500) %>;
      window.__MT_I18N = <%- JSON.stringify({
        locale: locale,
        miniCartEmptyTitle: t('store.miniCartEmptyTitle'),
        miniCartEmptySub: t('store.miniCartEmptySub'),
        removedFromCartMsg: t('store.removedFromCartMsg'),
        networkErrorMsg: t('store.networkErrorMsg'),
        selectRequiredVariant: t('store.selectRequiredVariant'),
        removeLabel: t('a11y.removeItem'),
        inStockLabel: t('common.inStock'),
        outOfStockLabel: t('common.outOfStock'),
      }).replace(/</g, '\\u003c') %>;
    </script>

    <!-- Verified Order Social Proof Popup -->
    <div id="verifiedOrderToast" class="vo-toast" role="status" aria-live="polite">
      <img id="voImg" src="/uploads/product/lychee-fresh.jpg" style="width:52px;height:52px;border-radius:10px;object-fit:cover;" alt="" />
      <div class="small">
        <div class="text-muted" style="font-size:11px;"><span id="voCust" class="fw-bold text-dark"></span></div>
        <a id="voLink" href="/all-products" class="fw-bold text-success text-decoration-none d-block text-truncate" style="max-width:195px;">
          <span id="voProd"></span>
        </a>
        <span class="badge bg-success-subtle text-success mt-1" style="font-size:10px;">🛡️ Verified Order</span>
      </div>
      <button type="button" class="btn-close ms-auto" style="font-size:10px;" aria-label="<%= t('a11y.closeModal') %>" onclick="document.getElementById('verifiedOrderToast').classList.remove('show')"></button>
    </div>

    <!-- Live Support Floating Chat -->
    <button type="button" id="lsFabBtn" class="ls-fab" aria-label="<%= t('store.liveSupport') %>">
      <i class="fas fa-comments" aria-hidden="true"></i> <%= t('store.liveSupport') %>
    </button>

    <div id="lsChatBox" class="ls-box" role="dialog" aria-label="<%= t('store.aiAssistantTitle') %>">
      <div class="p-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0d3b26, #15803d);">
        <div>
          <div class="fw-bold"><%= t('store.aiAssistantTitle') %></div>
          <div style="font-size:11px;opacity:0.9;"><%= siteSettings.site_name %></div>
        </div>
        <button type="button" id="lsCloseBtn" class="btn-close btn-close-white" aria-label="<%= t('a11y.closeModal') %>"></button>
      </div>

      <div class="px-2 py-2 bg-light border-bottom d-flex flex-wrap gap-1">
        <button type="button" class="btn btn-sm btn-white border rounded-pill py-0 px-2 ls-quick-btn" data-q="<%= locale === 'en' ? 'Show products and prices' : 'প্রোডাক্ট খুঁজুন' %>" style="font-size:11px;">🔍 <%= t('common.search') %></button>
        <button type="button" class="btn btn-sm btn-white border rounded-pill py-0 px-2 ls-quick-btn" data-q="<%= locale === 'en' ? 'Track order' : 'অর্ডার ট্র্যাক' %>" style="font-size:11px;">📦 <%= t('common.trackOrder') %></button>
        <button type="button" class="btn btn-sm btn-white border rounded-pill py-0 px-2 ls-quick-btn" data-action="complaint" style="font-size:11px;">📝 <%= t('store.complaintBox') %></button>
      </div>

      <div id="lsChatMsgs" class="p-3 flex-grow-1" style="overflow-y:auto;">
        <div class="p-2.5 rounded-3 bg-light small text-dark" style="padding:10px;">
          <%= locale === 'bn'
            ? ('স্বাগতম ' + siteSettings.site_name + '-এ! প্রোডাক্ট খুঁজতে, অর্ডার ট্র্যাক করতে অথবা সহায়তা পেতে মেসেজ করুন।')
            : ('Welcome to ' + siteSettings.site_name + '! Ask about products, order tracking, or customer support.') %>
        </div>
      </div>

      <form id="lsChatForm" class="p-2 border-top d-flex gap-1 bg-white">
        <label for="lsChatInput" class="visually-hidden"><%= t('store.aiAssistantTitle') %></label>
        <input type="text" id="lsChatInput" class="form-control form-control-sm" placeholder="<%= t('store.trackInputPlaceholder') %>" />
        <button type="submit" class="btn btn-success btn-sm px-3" aria-label="Send">➤</button>
      </form>
    </div>

    <!-- Complaint Modal -->
    <div class="modal fade" id="complaintModal" tabindex="-1" aria-labelledby="complaintModalTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form id="complaintForm" class="modal-content rounded-4">
          <div class="modal-header">
            <h6 class="modal-title fw-bold" id="complaintModalTitle">📝 <%= t('store.complaintBox') %></h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('a11y.closeModal') %>"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <div class="mb-2">
              <label for="compName" class="form-label small fw-semibold"><%= t('store.yourName') %> *</label>
              <input type="text" id="compName" name="name" class="form-control form-control-sm" required />
            </div>
            <div class="mb-2">
              <label for="compPhone" class="form-label small fw-semibold"><%= t('store.mobileNumber') %> *</label>
              <input type="tel" id="compPhone" name="phone" class="form-control form-control-sm" required />
            </div>
            <div class="mb-2">
              <label for="compInvoice" class="form-label small fw-semibold">Invoice ID</label>
              <input type="text" id="compInvoice" name="invoice_id" class="form-control form-control-sm" />
            </div>
            <div class="mb-2">
              <label for="compDetails" class="form-label small fw-semibold"><%= t('store.yourMessage') %> *</label>
              <textarea id="compDetails" name="details" rows="3" class="form-control form-control-sm" required></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
            <button type="submit" class="btn btn-success btn-sm"><%= t('store.sendMessage') %></button>
          </div>
        </form>
      </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="/frontEnd/js/storefront.js"></script>
    <script src="/shared/js/mrtumi-ui.js"></script>
    <% if (flash && flash.message) { %>
      <script>
        toastr.options = { positionClass: 'toast-top-right', timeOut: 3500 };
        toastr["<%= flash.type === 'error' ? 'error' : 'success' %>"](<%- JSON.stringify(flash.message) %>);
      </script>
    <% } %>
  </body>
</html>
