<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="pb-sid" content="<%= typeof sessionToken !== 'undefined' ? sessionToken : '' %>" />
    <title><%= typeof title !== 'undefined' ? (title + ' | ') : '' %><%= siteSettings.seo_meta_title || siteSettings.site_name || 'ফল বাজার' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= siteSettings.seo_meta_description || '' %>" />
    <meta name="keywords" content="<%= siteSettings.seo_keywords || '' %>" />
    <link rel="shortcut icon" href="<%= siteSettings.favicon || '/uploads/settings/logo.svg' %>" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="/frontEnd/css/storefront.css" rel="stylesheet" />
    <script src="/frontEnd/js/pb-session.js"></script>
  </head>
  <body>
    <!-- Top Special Notice Marquee -->
    <% if (siteSettings.special_notice) { %>
      <div class="notice-bar">
        <div class="notice-track">
          <span class="badge bg-warning text-dark me-2">SPECIAL NOTICE</span>
          <%= siteSettings.special_notice %>
        </div>
      </div>
    <% } %>

    <!-- Sticky Main Header -->
    <header class="pb-header">
      <div class="container py-2">
        <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
          <a href="/" class="text-decoration-none d-flex align-items-center">
            <img src="<%= siteSettings.logo_dark || '/uploads/settings/logo.svg' %>" alt="ফল বাজার" height="46" />
          </a>

          <form action="/all-products" method="GET" class="pb-search-box order-3 order-lg-2 flex-grow-1 mx-lg-4">
            <input type="text" name="q" class="form-control" placeholder="লিচু, আম বা আপনার পছন্দের ফল খুঁজুন..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" />
            <button type="submit" aria-label="Search"><i class="fas fa-search"></i></button>
          </form>

          <div class="d-flex align-items-center gap-2 order-2 order-lg-3">
            <a href="/track-order" class="btn btn-outline-success btn-sm rounded-pill px-3 d-none d-md-inline-flex align-items-center gap-1">
              <i class="fas fa-truck-fast"></i> অর্ডার ট্র্যাক
            </a>
            <button
              type="button"
              class="btn btn-success btn-sm rounded-pill px-3 position-relative d-inline-flex align-items-center gap-2"
              style="background:#1b4332;border-color:#1b4332;"
              data-bs-toggle="offcanvas"
              data-bs-target="#miniCartDrawer"
            >
              <i class="fas fa-shopping-basket"></i>
              <span>কার্ট</span>
              <span class="badge bg-warning text-dark rounded-pill js-cart-count" id="headerCartBadge"><%= cartCount || 0 %></span>
            </button>
            <a href="/customer/checkout" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold d-none d-sm-inline-flex align-items-center gap-1">
              চেকআউট →
            </a>
            <div class="dropdown">
              <button class="btn btn-outline-dark btn-sm rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-th-large me-1"></i>প্যানেল সমূহ
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                <li><a class="dropdown-item fw-semibold" href="/admin/dashboard"><i class="fas fa-user-shield text-dark me-2"></i>🔐 অ্যাডমিন প্যানেল</a></li>
                <li><a class="dropdown-item fw-semibold" href="/vendor/dashboard"><i class="fas fa-store text-success me-2"></i>🏪 ভেন্ডর / সেলার প্যানেল</a></li>
                <li><a class="dropdown-item fw-semibold" href="/reseller/dashboard"><i class="fas fa-handshake text-primary me-2"></i>🤝 রিসেলার প্যানেল</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item small" href="/track-order"><i class="fas fa-truck-fast text-secondary me-2"></i>অর্ডার ট্র্যাক করুন</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Category Navigation Strip -->
      <nav class="pb-cat-nav">
        <div class="container d-flex align-items-center">
          <a href="/" class="pb-cat-link <%= currentPath === '/' ? 'active' : '' %>">🏠 হোম</a>
          <a href="/flash-sales" class="pb-cat-link <%= currentPath === '/flash-sales' ? 'active' : '' %> text-danger">⚡ Flash Sale</a>
          <a href="/hot-deals" class="pb-cat-link <%= currentPath === '/hot-deals' ? 'active' : '' %>">🔥 Hot Deal</a>
          <% navCategories.forEach(function(cat) { %>
            <a href="/category/<%= cat.slug %>" class="pb-cat-link <%= currentPath === ('/category/' + cat.slug) ? 'active' : '' %>">
              <span><%= cat.icon || '🍒' %></span> <%= cat.name %>
            </a>
          <% }) %>
          <a href="/all-products" class="pb-cat-link <%= currentPath === '/all-products' ? 'active' : '' %>">সকল প্রোডাক্ট</a>
          <a href="/blogs" class="pb-cat-link <%= currentPath === '/blogs' ? 'active' : '' %>">ব্লগ</a>
        </div>
      </nav>
    </header>

    <!-- Floating Right-Edge Sticky Mini Cart Pill -->
    <div class="pb-floating-cart" data-bs-toggle="offcanvas" data-bs-target="#miniCartDrawer" title="আপনার শপিং কার্ট দেখুন">
      <div class="pb-fc-top">
        <div style="font-size: 18px;">🛒</div>
        <div><span class="js-cart-count"><%= cartCount || 0 %></span> পণ্য</div>
      </div>
      <div class="pb-fc-bottom">
        ৳<span class="js-cart-subtotal"><%= Number(cartSubtotal || 0).toLocaleString('en-IN') %></span>
      </div>
    </div>
