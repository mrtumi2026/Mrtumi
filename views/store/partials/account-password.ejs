<%# Shown when confirming the order needs an account password: signed in, or the number has an account. %>
<% const pwEnglish = locale === 'en'; %>
<div class="<%= columnClass %> js-account-pw" hidden>
  <div class="border border-warning rounded-3 bg-warning-subtle p-2">
    <label for="<%= fieldId %>" class="form-label small fw-semibold mb-1"><%= pwEnglish ? 'Your account password *' : 'আপনার অ্যাকাউন্টের পাসওয়ার্ড *' %></label>
    <input type="password" name="account_password" id="<%= fieldId %>" class="form-control form-control-sm" maxlength="72" autocomplete="current-password">
    <div class="small mt-1 js-account-pw-message" role="alert"><%= pwEnglish ? 'This mobile number already has an account. Enter its password to place the order.' : 'এই মোবাইল নম্বরে আগে থেকে অ্যাকাউন্ট আছে। অর্ডার করতে অ্যাকাউন্টের পাসওয়ার্ড দিন।' %></div>
    <a class="small" href="/customer/recovery" target="_blank" rel="noopener"><%= pwEnglish ? 'Forgot password?' : 'পাসওয়ার্ড ভুলে গেছেন?' %></a>
  </div>
</div>
