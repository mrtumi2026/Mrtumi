<%- include('partials/header', { title: t('common.checkout') }) %>
<% const checkoutEnglish = typeof isEn !== 'undefined' ? Boolean(isEn) : Boolean(typeof isEnglish !== 'undefined' && isEnglish); %>

<main id="mainContent" class="container py-4">
  <!-- Checkout Progress Bar -->
  <nav aria-label="Checkout Steps" class="d-flex justify-content-center align-items-center gap-3 mb-4 small fw-bold flex-wrap">
    <a href="/cart" class="badge bg-success rounded-pill px-3 py-2 text-decoration-none"><%= t('store.cartStep1') %></a>
    <span aria-hidden="true">→</span>
    <span class="badge bg-dark rounded-pill px-3 py-2"><%= t('store.cartStep2') %></span>
    <span aria-hidden="true">→</span>
    <span class="badge bg-secondary bg-opacity-25 text-dark rounded-pill px-3 py-2"><%= t('store.cartStep3') %></span>
  </nav>

  <% if (!cart || !cart.length) { %>
    <%- include('../partials/empty-state', {
      icon: '🛒',
      title: t('store.emptyCartTitle'),
      description: t('store.emptyCartSub'),
      actionUrl: '/all-products',
      actionLabel: t('common.allProducts') + ' →'
    }) %>
  <% } else { %>
    <form action="/customer/checkout" method="POST" id="mainCheckoutForm">
      <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
      <% if (canonicalMysqlCheckout) { %>
        <input type="hidden" name="checkout_request_key" value="<%= checkoutRequestKey %>" />
        <input type="hidden" name="coupon_code" id="checkoutCouponCode" value="<%= appliedCoupon ? appliedCoupon.code : '' %>" />
      <% } else { %>
        <input type="hidden" name="cart_backup_json" id="ckCartBackupJson" value='<%= JSON.stringify(cart) %>' />
      <% } %>

      <div class="row g-4">
        <!-- Left Column: Delivery Info & Payment Gateways -->
        <div class="col-lg-7">
          <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
            <h1 class="h5 fw-bold mb-1"><%= t('store.deliveryInfoTitle') %></h1>
            <p class="text-muted small mb-3"><%= t('store.deliveryInfoSub') %></p>

            <div class="row g-3">
              <div class="col-md-6">
                <label for="ckName" class="form-label small fw-semibold"><%= t('store.fullName') %> *</label>
                <input type="text" name="customer_name" id="ckName" class="form-control" placeholder="<%= t('store.fullNamePlaceholder') %>" required value="<%= typeof checkoutCustomer !== 'undefined' && checkoutCustomer ? checkoutCustomer.name : '' %>" />
              </div>
              <div class="col-md-6">
                <label for="ckPhone" class="form-label small fw-semibold"><%= t('store.mobileNumber') %> *</label>
                <input type="tel" name="phone" id="ckPhone" class="form-control" placeholder="<%= t('store.mobilePlaceholder') %>" minlength="11" required value="<%= typeof checkoutCustomer !== 'undefined' && checkoutCustomer ? checkoutCustomer.phone : '' %>" />
              </div>
              <% if (canonicalMysqlCheckout && checkoutCustomer && savedAddresses && savedAddresses.length) { %>
                <div class="col-12">
                  <label for="savedAddressSelect" class="form-label small fw-semibold"><%= checkoutEnglish ? 'Use a saved address (optional)' : 'সংরক্ষিত ঠিকানা ব্যবহার করুন (ঐচ্ছিক)' %></label>
                  <select class="form-select" id="savedAddressSelect" name="address_id">
                    <option value=""><%= checkoutEnglish ? 'Enter a different address' : 'অন্য ঠিকানা লিখুন' %></option>
                    <% savedAddresses.forEach(function(address) { %>
                      <option value="<%= address.id %>" data-recipient="<%= address.recipient_name %>" data-phone="<%= address.recipient_phone %>" data-street="<%= address.street_address %>" data-upazila="<%= address.upazila || '' %>" data-district="<%= address.district %>" data-division="<%= address.division %>" <%= address.checkoutPhoneMatches ? '' : 'disabled' %> <%= address.is_default && address.checkoutPhoneMatches ? 'selected' : '' %>><%= address.label %> — <%= [address.street_address, address.district, address.division].filter(Boolean).join(', ') %><%= address.is_default ? (checkoutEnglish ? ' (Default)' : ' (ডিফল্ট)') : '' %><%= !address.checkoutPhoneMatches ? (checkoutEnglish ? ' (phone must match account)' : ' (ফোন অ্যাকাউন্টের সঙ্গে মিলতে হবে)') : '' %></option>
                    <% }) %>
                  </select>
                  <p class="form-text"><%= checkoutEnglish ? 'The server reloads the selected address from your account; edits here cannot change the saved record. The recipient phone must match your account phone.' : 'সার্ভার আপনার অ্যাকাউন্ট থেকে নির্বাচিত ঠিকানা পুনরায় পড়বে; এখানে লেখা বদলে সংরক্ষিত ঠিকানা পাল্টানো যাবে না। প্রাপকের ফোন অ্যাকাউন্টের ফোনের সঙ্গে মিলতে হবে।' %></p>
                </div>
              <% } %>
              <div class="col-12">
                <label for="ckAddress" class="form-label small fw-semibold"><%= t('store.fullAddress') %> *</label>
                <textarea name="address" id="ckAddress" rows="2" class="form-control" placeholder="<%= t('store.addressPlaceholder') %>" required></textarea>
              </div>
              <div class="col-md-6">
                <label for="ckShipping" class="form-label small fw-semibold"><%= t('store.shippingArea') %> *</label>
                <select name="<%= canonicalMysqlCheckout ? 'delivery_location_id' : 'shipping_area' %>" id="ckShipping" class="form-select" onchange="recalcCheckout()" required>
                  <option value="" data-charge="0"><%= checkoutEnglish ? 'Choose delivery area' : 'ডেলিভারি এলাকা নির্বাচন করুন' %></option>
                  <% 
                    const validLocations = (typeof deliveryLocations !== 'undefined' && Array.isArray(deliveryLocations)) ? deliveryLocations : [];
                    let matchedLocations = validLocations.filter(function(location) {
                      return location.division === 'Dhaka' || location.division === 'All' || location.division === 'ঢাকা' || !location.division;
                    });
                    if (matchedLocations.length === 0) {
                      matchedLocations = [
                        { id: 1, division: 'Dhaka', delivery_charge_paisa: (siteSettings.inside_dhaka_charge || 60) * 100 },
                        { id: 2, division: 'All', delivery_charge_paisa: (siteSettings.outside_dhaka_charge || 120) * 100 }
                      ];
                    }
                    matchedLocations.forEach(function(location) {
                      const charge = Number(location.delivery_charge_paisa || 6000) / 100;
                      const inside = location.division === 'Dhaka' || location.division === 'ঢাকা' || String(location.id) === '1';
                      const areaLabel = inside ? (checkoutEnglish ? 'Inside Dhaka' : 'ঢাকার ভিতরে') : (checkoutEnglish ? 'Outside Dhaka' : 'ঢাকার বাইরে');
                      const optVal = canonicalMysqlCheckout ? location.id : (inside ? 'ঢাকার ভিতরে' : 'ঢাকার বাইরে');
                  %>
                    <option value="<%= optVal %>" data-charge="<%= charge %>"><%= areaLabel %> (৳<%= charge.toLocaleString(checkoutEnglish ? 'en-IN' : 'bn-BD') %>)</option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label for="ckNote" class="form-label small fw-semibold"><%= t('store.orderNote') %></label>
                <input type="text" id="ckNote" name="note" class="form-control" placeholder="<%= t('store.orderNotePlaceholder') %>" />
              </div>
              <% if (canonicalMysqlCheckout) { %>
                <div class="col-12 form-check ms-2 mt-3">
                  <input class="form-check-input" type="checkbox" id="recoveryConsent" />
                  <label class="form-check-label small" for="recoveryConsent"><%= checkoutEnglish ? 'Optional: I consent to saving my phone number and cart so I can resume this checkout. I do not consent to messages.' : 'ঐচ্ছিক: পরে এই চেকআউট চালিয়ে যেতে আমার ফোন নম্বর ও কার্ট সংরক্ষণে সম্মতি দিচ্ছি। কোনো বার্তা পাঠানোর সম্মতি দিচ্ছি না।' %></label>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Step 2: Payment Methods -->
          <div class="bg-white rounded-4 border p-4 shadow-sm">
            <h2 class="h5 fw-bold mb-1"><%= t('store.paymentMethodTitle') %></h2>
            <p class="text-muted small mb-3"><%= t('store.paymentMethodSub') %></p>

            <div class="row g-2">
              <% if (canonicalMysqlCheckout && (!gateways || !gateways.length)) { %>
                <div class="col-12 alert alert-warning"><%= checkoutEnglish ? 'Checkout is unavailable: COD is not enabled in payment settings.' : 'চেকআউট করা যাচ্ছে না: পেমেন্ট সেটিংসে COD চালু নেই।' %></div>
              <% } else if (canonicalMysqlCheckout) { %>
                <% 
                    let displayGateways = (typeof gateways !== 'undefined' && Array.isArray(gateways)) ? [...gateways] : [];
                    const hasBkash = displayGateways.some(g => g.code === 'bkash' || g.code === 'bkash_manual' || g.code === 'bkash_api');
                    const hasNagad = displayGateways.some(g => g.code === 'nagad' || g.code === 'nagad_manual' || g.code === 'nagad_api');
                    const hasRocket = displayGateways.some(g => g.code === 'rocket' || g.code === 'rocket_manual' || g.code === 'rocket_api');
                    const fallbackPhone = (typeof siteSettings !== 'undefined' && siteSettings && (siteSettings.phone || siteSettings.site_phone)) || '01973437395';
                    if (!hasBkash) displayGateways.push({ code: 'bkash', name: 'bKash (বিকাশ Send Money)', gateway_type: 'manual', mode: 'manual', account_number: fallbackPhone, instructions: 'Send Money to our bKash number and enter TrxID below.', instructions_bn: 'আমাদের বিকাশ নম্বরে Send Money করুন এবং নিচে TrxID দিন।' });
                    if (!hasNagad) displayGateways.push({ code: 'nagad', name: 'Nagad (নগদ Send Money)', gateway_type: 'manual', mode: 'manual', account_number: fallbackPhone, instructions: 'Send Money to our Nagad number and enter TrxID below.', instructions_bn: 'আমাদের নগদ নম্বরে Send Money করুন এবং নিচে TrxID দিন।' });
                    if (!hasRocket) displayGateways.push({ code: 'rocket', name: 'Rocket (রকেট Send Money)', gateway_type: 'manual', mode: 'manual', account_number: fallbackPhone, instructions: 'Send Money to our Rocket number and enter TrxID below.', instructions_bn: 'আমাদের রকেট নম্বরে Send Money করুন এবং নিচে TrxID দিন।' });

                    /* gateways.forEach */
                    displayGateways.forEach(function(gateway, gatewayIndex) { 
                      const isManual = (gateway.mode === 'manual' || gateway.gateway_type === 'manual') && gateway.code !== 'cod';
                      const inst = checkoutEnglish ? (gateway.instructions || '') : (gateway.instructions_bn || gateway.instructions || '');
                    %>
                    <div class="col-md-6"><label class="pay-option <%= gateway.code === 'cod' ? 'active' : '' %> w-100 d-flex align-items-start gap-2" data-gateway-type="<%= isManual ? 'manual' : 'auto' %>" data-account="<%= gateway.account_number || '' %>" data-instructions="<%= inst %>" onclick="selectGateway(this)" style="cursor:pointer;">
                      <input type="radio" name="payment_method" value="<%= gateway.code %>" class="form-check-input mt-1" required <%= gateway.code === 'cod' ? 'checked' : '' %> onchange="selectGateway(this.closest('.pay-option'))" />
                      <div><div class="fw-bold small"><%= gateway.name %></div>
                        <% if (gateway.code === 'cod') { %><div class="text-muted" style="font-size:11.5px;"><%= checkoutEnglish ? 'Pay the configured COD due on delivery.' : 'ডেলিভারির সময় প্রদেয় অর্থ দিন।' %></div>
                        <% } else { %><% if (gateway.account_number) { %><div class="text-muted" style="font-size:11.5px;"><%= checkoutEnglish ? 'Wallet / Account' : 'ওয়ালেট নম্বর' %>: <%= gateway.account_number %></div><% } %><% if (inst) { %><div class="text-muted" style="font-size:11.5px;"><%= inst %></div><% } %><div class="text-muted" style="font-size:11.5px;"><%= isManual ? (checkoutEnglish ? 'Payment verified by staff after checking TrxID.' : 'TrxID যাচাই করার পর পেমেন্ট নিশ্চিত করা হবে।') : (checkoutEnglish ? 'Instant online automated payment.' : 'তাৎক্ষণিক অনলাইন স্বয়ংক্রিয় পেমেন্ট।') %></div><% } %>
                      </div>
                    </label></div>
                  <% }) %>
              <% } else { %>
                <div class="col-md-6"><label class="pay-option active w-100 d-flex align-items-start gap-2">
                  <input type="radio" name="payment_method" value="cod" class="form-check-input mt-1" checked />
                  <div><div class="fw-bold small"><%= checkoutEnglish ? 'Cash on delivery' : 'ক্যাশ অন ডেলিভারি' %></div><div class="text-muted" style="font-size:11.5px;"><%= checkoutEnglish ? 'Pay the configured COD due on delivery. No online payment is accepted.' : 'ডেলিভারির সময় প্রদেয় অর্থ দিন। অনলাইন পেমেন্ট বর্তমানে চালু নেই।' %></div></div>
                </label></div>
              <% } %>
            </div>

            <!-- Conditional Manual Payment TrxID Box -->
            <div id="manualPayFields" class="mt-3 p-3 rounded-3 bg-warning-subtle border border-warning" style="display: none;">
              <div class="fw-bold small mb-1" id="manualPayAcc"></div>
              <div class="small text-muted mb-2" id="manualPayInst"></div>
              <div class="row g-2">
                <div class="col-sm-6">
                  <label for="ckTrxId" class="form-label small fw-semibold mb-1"><%= checkoutEnglish ? 'Transaction ID (TrxID) *' : 'ট্রানজেকশন আইডি (TrxID) *' %></label>
                  <input type="text" name="trx_id" id="ckTrxId" class="form-control form-control-sm" placeholder="<%= checkoutEnglish ? 'Enter TrxID' : 'TrxID লিখুন' %>" maxlength="128" autocomplete="off" />
                </div>
                <div class="col-sm-6">
                  <label for="ckSenderNumber" class="form-label small fw-semibold mb-1"><%= checkoutEnglish ? 'Sender mobile number *' : 'প্রেরকের মোবাইল নম্বর *' %></label>
                  <input type="tel" name="sender_number" id="ckSenderNumber" class="form-control form-control-sm" placeholder="01XXXXXXXXX" maxlength="20" autocomplete="tel" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Order Summary & Live Editable Cart Items -->
        <div class="col-lg-5">
          <div class="checkout-order-summary bg-white rounded-4 border p-4 shadow-sm sticky-top" style="top: 90px;">
            <h5 class="fw-bold border-bottom pb-2 mb-3">🧾 অর্ডার সামারি (<span class="js-cart-count"><%= cartCount %></span> টি পণ্য)</h5>

            <div id="checkoutCartItemsList" class="mb-3" style="max-height: 280px; overflow-y: auto;">
              <% cart.forEach(function(it) { %>
                <div class="d-flex align-items-center justify-content-between border-bottom py-2 gap-2">
                  <div class="d-flex align-items-center gap-2">
                    <img src="<%= it.image %>" style="width:48px;height:48px;border-radius:8px;object-fit:cover;" alt="" />
                    <div>
                      <div class="fw-semibold small"><%= it.name %></div>
                      <div class="text-muted" style="font-size:11.5px;"><%= it.size %> • ৳<%= it.price %></div>
                      <div class="input-group input-group-sm mt-1" style="width:92px;">
                        <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="window.updateCartItemQty('<%= it.key %>', <%= Number(it.qty) - 1 %>)">−</button>
                        <span class="form-control text-center py-0 px-1 fw-bold" style="font-size:12px;"><%= it.qty %></span>
                        <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="window.updateCartItemQty('<%= it.key %>', <%= Number(it.qty) + 1 %>)">+</button>
                      </div>
                    </div>
                  </div>
                  <div class="text-end">
                    <div class="fw-bold small text-success">৳<%= Number(it.price * it.qty).toLocaleString('en-IN') %></div>
                    <button type="button" class="btn btn-link text-danger p-0 small text-decoration-none" style="font-size:11.5px;" onclick="window.removeCartItem('<%= it.key %>')">মুছুন</button>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- Coupon Code Box -->
            <div class="input-group input-group-sm mb-2">
              <input type="text" id="couponInput" class="form-control" placeholder="কুপন কোড (যেমন: FRESH10)" value="<%= appliedCoupon ? appliedCoupon.code : '' %>" />
              <button class="btn btn-outline-success fw-semibold" type="button" onclick="applyCouponCode()">প্রয়োগ</button>
            </div>
            <div id="couponMsg" class="small mb-2"></div>

            <div class="border-top pt-2">
              <div class="d-flex justify-content-between py-1 small">
                <span>সাবটোটাল:</span>
                <strong>৳<span id="ckSubtotal"><%= Number(cartSubtotal).toLocaleString('en-IN') %></span></strong>
              </div>
              <div class="d-flex justify-content-between py-1 small">
                <span>ডেলিভারি চার্জ:</span>
                <strong>৳<span id="ckShipVal"><%= siteSettings.inside_dhaka_charge || 60 %></span></strong>
              </div>
              <div class="d-flex justify-content-between py-1 small text-danger">
                <span>ডিসকাউন্ট ছাড়:</span>
                <strong>-৳<span id="ckDiscVal"><%= appliedCoupon ? appliedCoupon.discount : 0 %></span></strong>
              </div>
              <div class="d-flex justify-content-between py-2 border-top mt-1 fs-5 fw-bold text-success">
                <span>সর্বমোট প্রদেয়:</span>
                <span>৳<span id="ckGrandTotal">0</span></span>
              </div>
            </div>

            <% if (canonicalMysqlCheckout) { %>
              <div class="form-check small mb-2"><input class="form-check-input" type="checkbox" id="confirmOrder" name="confirm_order" value="yes" required /><label class="form-check-label" for="confirmOrder"><%= checkoutEnglish ? 'I reviewed the contact, delivery, items and total above and confirm this order.' : 'উপরের যোগাযোগ, ডেলিভারি, পণ্য ও মোট মূল্য যাচাই করে অর্ডারটি নিশ্চিত করছি।' %></label></div>
            <% } %>
            <button type="submit" <%= canonicalMysqlCheckout && !checkoutAvailable ? 'disabled' : '' %> class="btn btn-success w-100 py-3 fw-bold fs-6 rounded-3 mt-2 shadow-sm" style="background:#1b4332;border-color:#1b4332;">
              ✓ অর্ডার নিশ্চিত করুন
            </button>

            <div class="d-flex justify-content-around text-muted small mt-3 pt-2 border-top" style="font-size:11.5px;">
              <span>🔒 SSL Secured</span>
              <span>🛡️ ১০০% নিরাপদ</span>
              <span>↩️ Easy Return</span>
            </div>
          </div>
        </div>
      </div>
    </form>
  <% } %>

<!-- Order OTP Verification Modal -->
<div class="modal fade" id="orderOtpModal" tabindex="-1" aria-labelledby="orderOtpModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="orderOtpModalLabel">📱 মোবাইল ভেরিফিকেশন (OTP)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center py-4">
        <div class="mb-3">
          <i class="fas fa-shield-halved text-success fa-3x"></i>
        </div>
        <p class="text-muted small mb-3">
          অর্ডার সুরক্ষিত রাখতে <strong id="otpTargetPhone">017XXXXXXXX</strong> নম্বরে পাঠানো ৬ সংখ্যার ওটিপি (OTP) কোডটি লিখুন:
        </p>
        <div class="mb-3 d-flex justify-content-center">
          <input type="text" id="orderOtpInput" class="form-control form-control-lg text-center fw-bold fs-4" style="max-width: 220px; letter-spacing: 6px;" maxlength="6" placeholder="------" pattern="\d{6}" inputmode="numeric" autocomplete="one-time-code" />
        </div>
        <div id="otpErrorMessage" class="text-danger small mb-3" style="display:none;"></div>
        <button type="button" id="btnVerifyOtp" class="btn btn-success w-100 py-2.5 fw-bold rounded-3" style="background:#1b4332;">
          ✓ কোড যাচাই করে অর্ডার কনফার্ম করুন
        </button>
        <div class="mt-3 text-muted small">
          কোড পাননি? <button type="button" id="btnResendOtp" class="btn btn-link p-0 small text-decoration-none">পুনরায় কোড পাঠান</button>
          <span id="otpTimerSpan" class="text-muted ms-1"></span>
        </div>
      </div>
    </div>
  </div>
</div>

</main>

<script>
  var baseSubtotal = <%= Number(cartSubtotal || 0) %>;
  var currentDiscount = <%= Number(appliedCoupon ? appliedCoupon.discount : 0) %>;
  var freeShippingMin = <%= Number(siteSettings.free_shipping_min || 0) %>;
  var canonicalMysqlCheckout = <%= canonicalMysqlCheckout ? 'true' : 'false' %>;
  var checkoutIsEn = <%= checkoutEnglish ? 'true' : 'false' %>;

  function recalcCheckout() {
    var sel = document.getElementById('ckShipping');
    if (!sel) return;
    var opt = sel.options[sel.selectedIndex];
    var ship = Number(opt.getAttribute('data-charge') || (canonicalMysqlCheckout ? 0 : 60));
    if (freeShippingMin > 0 && baseSubtotal >= freeShippingMin) ship = 0;
    document.getElementById('ckSubtotal').textContent = baseSubtotal.toLocaleString('en-IN');
    document.getElementById('ckShipVal').textContent = ship;
    document.getElementById('ckDiscVal').textContent = currentDiscount;
    document.getElementById('ckGrandTotal').textContent = Math.max(0, baseSubtotal + ship - currentDiscount).toLocaleString('en-IN');
  }

  // Live callback when user changes quantity or removes an item right on Checkout!
  window.onCartStateUpdated = function(state) {
    if (!state.cart || !state.cart.length) {
      window.location.href = window.__withPbSid ? window.__withPbSid('/cart') : '/cart';
      return;
    }
    baseSubtotal = Number(state.cartSubtotal || 0);
    if (typeof state.discount === 'number') {
      currentDiscount = state.discount;
    }
    var backupEl = document.getElementById('ckCartBackupJson');
    if (backupEl) backupEl.value = JSON.stringify(state.cart);

    var listEl = document.getElementById('checkoutCartItemsList');
    if (listEl) {
      listEl.innerHTML = state.cart.map(function(it) {
        return '<div class="d-flex align-items-center justify-content-between border-bottom py-2 gap-2">' +
          '<div class="d-flex align-items-center gap-2">' +
            '<img src="' + it.image + '" style="width:48px;height:48px;border-radius:8px;object-fit:cover;" alt="" />' +
            '<div>' +
              '<div class="fw-semibold small">' + it.name + '</div>' +
              '<div class="text-muted" style="font-size:11.5px;">' + it.size + ' • ৳' + it.price + '</div>' +
              '<div class="input-group input-group-sm mt-1" style="width:92px;">' +
                '<button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="window.updateCartItemQty(\'' + it.key + '\',' + (Number(it.qty) - 1) + ')">−</button>' +
                '<span class="form-control text-center py-0 px-1 fw-bold" style="font-size:12px;">' + it.qty + '</span>' +
                '<button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="window.updateCartItemQty(\'' + it.key + '\',' + (Number(it.qty) + 1) + ')">+</button>' +
              '</div>' +
            '</div>' +
          '</div>' +
          '<div class="text-end">' +
            '<div class="fw-bold small text-success">৳' + Number(it.price * it.qty).toLocaleString('en-IN') + '</div>' +
            '<button type="button" class="btn btn-link text-danger p-0 small text-decoration-none" style="font-size:11.5px;" onclick="window.removeCartItem(\'' + it.key + '\')">মুছুন</button>' +
          '</div>' +
        '</div>';
      }).join('');
    }
    recalcCheckout();
  };

  function selectGateway(labelEl) {
    document.querySelectorAll('.pay-option').forEach(function(el) { el.classList.remove('active'); });
    if (labelEl) labelEl.classList.add('active');
    var manual = Boolean(labelEl && labelEl.dataset.gatewayType === 'manual');
    var box = document.getElementById('manualPayFields');
    var trx = document.getElementById('ckTrxId');
    var sender = document.getElementById('ckSenderNumber');
    if (manual) {
      box.style.display = 'block';
      document.getElementById('manualPayAcc').textContent = (checkoutIsEn ? 'Account: ' : 'অ্যাকাউন্ট নম্বর: ') + (labelEl.dataset.account || (checkoutIsEn ? 'Not configured' : 'কনফিগার করা হয়নি'));
      document.getElementById('manualPayInst').textContent = labelEl.dataset.instructions || (checkoutIsEn ? 'Send the exact order amount, then enter your sender number and TrxID.' : 'অর্ডারের সঠিক পরিমাণ পাঠিয়ে প্রেরকের নম্বর ও TrxID দিন।');
      trx.required = true;
      sender.required = true;
    } else {
      box.style.display = 'none';
      trx.required = false;
      sender.required = false;
      trx.value = '';
      sender.value = '';
    }
  }

  document.querySelectorAll('input[name="payment_method"]').forEach(function(input) {
    input.addEventListener('change', function() { selectGateway(input.closest('.pay-option')); });
  });
  var initialPaymentMethod = document.querySelector('input[name="payment_method"]:checked');
  if (initialPaymentMethod) selectGateway(initialPaymentMethod.closest('.pay-option'));

  function applyCouponCode() {
    var code = document.getElementById('couponInput').value.trim();
    var msg = document.getElementById('couponMsg');
    if (!code) return;
    fetch('/checkout/apply-coupon', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': '<%= csrfToken || "" %>' },
      body: JSON.stringify({ code: code })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      msg.textContent = d.message;
      msg.className = 'small mb-2 ' + (d.success ? 'text-success fw-semibold' : 'text-danger');
      if (d.success) {
        currentDiscount = Number(d.discount || 0);
        var couponCode = document.getElementById('checkoutCouponCode');
        if (couponCode) couponCode.value = d.code || code;
        recalcCheckout();
      }
    });
  }

  // Recovery capture is opt-in only. No capture or notification occurs on the default path.
  var recoveryRecordId = null;
  var recoveryConsentEl = document.getElementById('recoveryConsent');
  if (recoveryConsentEl) recoveryConsentEl.addEventListener('change', function() {
    if (!this.checked && recoveryRecordId) {
      fetch('/checkout/withdraw-recovery-consent', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': '<%= csrfToken || "" %>' }, body: JSON.stringify({ record_id: recoveryRecordId }) })
        .then(function(r) { if (r.ok) recoveryRecordId = null; }).catch(function() {});
    }
  });
  var ckPhoneEl = document.getElementById('ckPhone');
  if (ckPhoneEl) {
    ckPhoneEl.addEventListener('blur', function() {
      var recoveryConsent = document.getElementById('recoveryConsent');
      if (this.value.trim().length >= 10 && (!canonicalMysqlCheckout || (recoveryConsent && recoveryConsent.checked))) {
        fetch('/checkout/save-incomplete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': '<%= csrfToken || "" %>' },
          body: JSON.stringify({
            name: document.getElementById('ckName').value,
            phone: this.value,
            address: document.getElementById('ckAddress').value,
            consent: 'true', notification_consent: 'false'
          })
        }).then(function(r) { return r.json(); }).then(function(d) { if (d.ok && d.id) recoveryRecordId = d.id; }).catch(function() {});
      }
    });
  }

  var savedAddressSelect = document.getElementById('savedAddressSelect');
  if (savedAddressSelect) {
    var savedAddressFields = {
      name: document.getElementById('ckName'),
      phone: document.getElementById('ckPhone'),
      address: document.getElementById('ckAddress')
    };
    var manualAddressValues = { name: savedAddressFields.name.value, phone: savedAddressFields.phone.value, address: savedAddressFields.address.value };
    function applySavedAddress() {
      var option = savedAddressSelect.options[savedAddressSelect.selectedIndex];
      var useSaved = Boolean(savedAddressSelect.value && option);
      if (useSaved) {
        savedAddressFields.name.value = option.dataset.recipient || '';
        savedAddressFields.phone.value = option.dataset.phone || '';
        savedAddressFields.address.value = [option.dataset.street, option.dataset.upazila, option.dataset.district, option.dataset.division].filter(Boolean).join(', ');
      } else {
        savedAddressFields.name.value = manualAddressValues.name;
        savedAddressFields.phone.value = manualAddressValues.phone;
        savedAddressFields.address.value = manualAddressValues.address;
      }
      Object.keys(savedAddressFields).forEach(function(key) { savedAddressFields[key].readOnly = useSaved; });
    }
    savedAddressSelect.addEventListener('change', applySavedAddress);
    applySavedAddress();
  }

  document.addEventListener('DOMContentLoaded', recalcCheckout);
</script>


  var otpModeEnabled = <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.otp_mode === 'on') ? 'true' : 'false' %>;
  var otpVerifiedInSession = false;

  document.addEventListener('DOMContentLoaded', function() {
    var checkoutForm = document.getElementById('checkoutForm') || document.querySelector('form[action="/customer/checkout"]');
    if (!checkoutForm) return;

    checkoutForm.addEventListener('submit', function(e) {
      if (!otpModeEnabled || otpVerifiedInSession) return;

      e.preventDefault();
      var phoneInput = document.getElementById('customerPhone') || document.querySelector('input[name="phone"]');
      var rawPhone = phoneInput ? phoneInput.value.trim() : '';
      if (!rawPhone || rawPhone.length < 11) {
        if (typeof toastr !== 'undefined') toastr.error('অনুগ্রহ করে ১১ সংখ্যার সঠিক মোবাইল নম্বর লিখুন।');
        return;
      }

      var csrfMeta = document.querySelector('meta[name="csrf-token"]');
      var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';

      var submitBtn = checkoutForm.querySelector('button[type="submit"]');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'ওটিপি পাঠানো হচ্ছে...'; }

      fetch('/api/checkout/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ phone: rawPhone, _csrf: csrfToken })
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = '✓ অর্ডার নিশ্চিত করুন'; }
        if (data.success) {
          document.getElementById('otpTargetPhone').textContent = data.phone || rawPhone;
          var otpModalEl = document.getElementById('orderOtpModal');
          var modal = bootstrap.Modal.getOrCreateInstance(otpModalEl);
          modal.show();
          document.getElementById('orderOtpInput').value = '';
          document.getElementById('orderOtpInput').focus();
          document.getElementById('otpErrorMessage').style.display = 'none';
          startOtpCountdown(60);
          if (data.devCode) {
            console.log('DEV / TEST OTP CODE:', data.devCode);
          }
        } else {
          if (typeof toastr !== 'undefined') toastr.error(data.message || 'ওটিপি পাঠানো যায়নি।');
        }
      })
      .catch(function() {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = '✓ অর্ডার নিশ্চিত করুন'; }
        if (typeof toastr !== 'undefined') toastr.error('নেটওয়ার্ক ত্রুটি! অনুগ্রহ করে পুনরায় চেষ্টা করুন।');
      });
    });

    var verifyBtn = document.getElementById('btnVerifyOtp');
    if (verifyBtn) {
      verifyBtn.addEventListener('click', function() {
        var code = document.getElementById('orderOtpInput').value.trim();
        var phoneInput = document.getElementById('customerPhone') || document.querySelector('input[name="phone"]');
        var rawPhone = phoneInput ? phoneInput.value.trim() : '';
        var csrfMeta = document.querySelector('meta[name="csrf-token"]');
        var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';

        if (!/^\d{6}$/.test(code)) {
          var errDiv = document.getElementById('otpErrorMessage');
          errDiv.textContent = '৬ সংখ্যার সঠিক ওটিপি কোড লিখুন।';
          errDiv.style.display = 'block';
          return;
        }

        verifyBtn.disabled = true;
        verifyBtn.textContent = 'যাচাই করা হচ্ছে...';

        fetch('/api/checkout/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ phone: rawPhone, code: code, _csrf: csrfToken })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          verifyBtn.disabled = false;
          verifyBtn.textContent = '✓ কোড যাচাই করে অর্ডার কনফার্ম করুন';
          if (data.success) {
            otpVerifiedInSession = true;
            var modal = bootstrap.Modal.getInstance(document.getElementById('orderOtpModal'));
            if (modal) modal.hide();
            if (typeof toastr !== 'undefined') toastr.success('ওটিপি সফলভাবে যাচাই হয়েছে!');
            checkoutForm.submit();
          } else {
            var errDiv = document.getElementById('otpErrorMessage');
            errDiv.textContent = data.message || 'ভুল ওটিপি কোড!';
            errDiv.style.display = 'block';
          }
        })
        .catch(function() {
          verifyBtn.disabled = false;
          verifyBtn.textContent = '✓ কোড যাচাই করে অর্ডার কনফার্ম করুন';
          var errDiv = document.getElementById('otpErrorMessage');
          errDiv.textContent = 'যাচাইকরণে সমস্যা হয়েছে। পুনরায় চেষ্টা করুন।';
          errDiv.style.display = 'block';
        });
      });
    }

    var resendBtn = document.getElementById('btnResendOtp');
    if (resendBtn) {
      resendBtn.addEventListener('click', function() {
        if (resendBtn.disabled) return;
        var phoneInput = document.getElementById('customerPhone') || document.querySelector('input[name="phone"]');
        var rawPhone = phoneInput ? phoneInput.value.trim() : '';
        var csrfMeta = document.querySelector('meta[name="csrf-token"]');
        var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';

        fetch('/api/checkout/send-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ phone: rawPhone, _csrf: csrfToken })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            if (typeof toastr !== 'undefined') toastr.success('নতুন ওটিপি কোড পাঠানো হয়েছে।');
            startOtpCountdown(60);
          } else {
            if (typeof toastr !== 'undefined') toastr.error(data.message || 'কোড পাঠানো যায়নি।');
          }
        });
      });
    }

    var countdownTimer = null;
    function startOtpCountdown(sec) {
      var resendBtn = document.getElementById('btnResendOtp');
      var timerSpan = document.getElementById('otpTimerSpan');
      if (!resendBtn) return;
      resendBtn.disabled = true;
      resendBtn.classList.add('text-muted');
      if (countdownTimer) clearInterval(countdownTimer);
      var rem = sec;
      timerSpan.textContent = '(' + rem + 's)';
      countdownTimer = setInterval(function() {
        rem--;
        if (rem <= 0) {
          clearInterval(countdownTimer);
          resendBtn.disabled = false;
          resendBtn.classList.remove('text-muted');
          timerSpan.textContent = '';
        } else {
          timerSpan.textContent = '(' + rem + 's)';
        }
      }, 1000);
    }
  });

<%- include('partials/footer') %>
