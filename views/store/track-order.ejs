<%- include('partials/header', { title: t('common.trackOrder') }) %>

<main id="mainContent" class="container py-5">
  <div class="bg-white rounded-4 border p-4 p-md-5 mx-auto shadow-sm" style="max-width: 760px;">
    <div class="text-center mb-4">
      <h1 class="fw-bold fs-4 mb-1">📦 <%= t('store.trackHeading') %></h1>
      <p class="text-muted small"><%= t('store.trackSub') %></p>
    </div>

    <div class="alert alert-info mb-4 mx-auto" style="max-width: 620px;">
      <%= locale === 'en' ? 'For your privacy, order details are available only after signing in to the customer account that placed the order.' : 'আপনার গোপনীয়তার জন্য, অর্ডারকারী কাস্টমার অ্যাকাউন্টে সাইন ইন করার পরেই অর্ডারের তথ্য দেখা যাবে।' %>
    </div>
    <div class="text-center"><a class="mt-btn mt-btn-primary" href="/customer/login"><%= locale === 'en' ? 'Sign in to your account' : 'আপনার অ্যাকাউন্টে সাইন ইন করুন' %></a></div>

    <% if (query && (!orders || !orders.length)) { %>
      <%- include('../partials/alert-banner', { type: 'warning', message: t('store.trackNotFound') }) %>
    <% } %>

    <% if (orders && orders.length) { %>
      <% const steps = locale === 'en'
        ? [
            { key: 'pending', label: 'Pending' },
            { key: 'processing', label: 'Processing' },
            { key: 'in-courier', label: 'In Courier' },
            { key: 'on-the-way', label: 'On The Way' },
            { key: 'completed', label: 'Delivered' }
          ]
        : [
            { key: 'pending', label: 'পেন্ডিং' },
            { key: 'processing', label: 'প্রসেসিং' },
            { key: 'in-courier', label: 'কুরিয়ারে প্রেরিত' },
            { key: 'on-the-way', label: 'পথে আছে' },
            { key: 'completed', label: 'ডেলিভারি সম্পন্ন' }
          ];
      %>

      <% orders.forEach(function(ord) { %>
        <% const curIdx = steps.findIndex(s => s.key === ord.status); %>
        <div class="border rounded-4 p-4 mb-3 bg-light bg-opacity-50">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
              <h2 class="h5 fw-bold mb-0">#<%= ord.invoice_id %></h2>
              <small class="text-muted"><%= fmt.dateTime(ord.created_at) %> &bull; <%= ord.customer_name %></small>
            </div>
            <span class="badge px-3 py-2 rounded-pill" style="background:<%= ord.status_color %>;"><%= ord.status_label %></span>
          </div>

          <% if (ord.status !== 'cancelled') { %>
            <div class="d-flex justify-content-between text-center my-4 position-relative">
              <% steps.forEach(function(st, i) { %>
                <% const done = curIdx >= i || ord.status === 'completed'; %>
                <div class="flex-fill">
                  <div
                    class="mx-auto rounded-circle d-flex align-items-center justify-content-center fw-bold mb-1"
                    style="width:34px;height:34px;background:<%= done ? '#15803d' : '#e2e8f0' %>;color:<%= done ? '#fff' : '#475569' %>;"
                  >
                    <%= done ? '✓' : fmt.number(i + 1) %>
                  </div>
                  <div style="font-size: 11.5px;" class="<%= done ? 'fw-bold text-success' : 'text-muted' %>"><%= st.label %></div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <%- include('../partials/alert-banner', { type: 'error', message: locale === 'en' ? 'This order has been cancelled.' : 'এই অর্ডারটি বাতিল করা হয়েছে।' }) %>
          <% } %>

          <% if (ord.courier_name || ord.courier_tracking_id) { %>
            <div class="rounded-3 bg-white border small mb-3" style="padding:10px 14px;">
              🚚 <strong>Courier:</strong> <%= ord.courier_name || 'Steadfast Courier' %>
              <% if (ord.courier_tracking_id) { %>
                &bull; <strong>Tracking:</strong> <span class="text-primary fw-bold"><%= ord.courier_tracking_id %></span>
              <% } %>
            </div>
          <% } %>

          <div class="small">
            <% (ord.items || []).forEach(function(it) { %>
              <div class="d-flex justify-content-between py-1 border-bottom">
                <span><%= it.product_name %> (<%= it.size %> × <%= fmt.number(it.qty) %>)</span>
                <strong><%= fmt.bdt(it.price * it.qty) %></strong>
              </div>
            <% }) %>
            <div class="d-flex justify-content-between pt-2 fw-bold text-success fs-6">
              <span><%= t('common.grandTotal') %> (<%= ord.payment_method %>):</span>
              <span><%= fmt.bdt(ord.amount) %></span>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
