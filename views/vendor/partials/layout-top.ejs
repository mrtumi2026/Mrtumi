<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="pb-sid" content="<%= typeof sessionToken !== 'undefined' ? sessionToken : '' %>" />
    <title><%= typeof title !== 'undefined' ? title : 'Vendor Panel' %> - <%= siteSettings.site_name || 'ফল বাজার' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/uploads/settings/logo.svg" />
    <script src="/frontEnd/js/pb-session.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="/backEnd/css/ubold-admin.css" rel="stylesheet" />
  </head>
  <body data-theme="light" data-topbar-color="dark" data-leftbar-color="dark">
    <div id="wrapper">
      <!-- Vendor Topbar -->
      <div class="navbar-custom" style="background: #14291f;">
        <div class="container-fluid">
          <ul class="list-unstyled topnav-menu float-end mb-0">
            <li class="d-none d-sm-flex align-items-center px-2">
              <a href="/vendor/withdrawals" class="badge bg-warning text-dark text-decoration-none px-3 py-2 rounded-pill fw-bold">
                💰 ওয়ালেট: ৳<%= Number((vendorUser && vendorUser.balance) || 0).toLocaleString('en-IN') %>
              </a>
            </li>
            <li class="dropdown notification-list topbar-dropdown">
              <a class="nav-link dropdown-toggle nav-user me-0" data-bs-toggle="dropdown" href="#">
                <img src="/uploads/default/user.svg" alt="vendor" class="rounded-circle" />
                <span class="pro-user-name ms-1"><%= (vendorUser && vendorUser.shop_name) || 'Vendor' %> <i class="fas fa-chevron-down ms-1" style="font-size:10px;"></i></span>
              </a>
              <div class="dropdown-menu dropdown-menu-end profile-dropdown">
                <a href="/vendor/profile" class="dropdown-item notify-item"><i class="fas fa-store me-2"></i>শপ প্রোফাইল</a>
                <a href="/vendor/withdrawals" class="dropdown-item notify-item"><i class="fas fa-wallet me-2"></i>উইথড্রয়াল</a>
                <div class="dropdown-divider"></div>
                <form action="/vendor/logout" method="POST">
                  <button type="submit" class="dropdown-item notify-item text-danger border-0 bg-transparent w-100 text-start">
                    <i class="fas fa-sign-out-alt me-2"></i>লগআউট
                  </button>
                </form>
              </div>
            </li>
          </ul>

          <div class="logo-box" style="background: rgba(0,0,0,0.2);">
            <a href="/vendor/dashboard" class="logo logo-light text-center">
              <span class="logo-lg"><img src="/uploads/settings/logo-light.svg" alt="Logo" height="44" /></span>
            </a>
          </div>

          <ul class="list-unstyled topnav-menu topnav-menu-left m-0">
            <li>
              <button class="button-menu-mobile" type="button"><i data-feather="menu"></i></button>
            </li>
            <li>
              <span class="badge bg-success-subtle text-success ms-2 px-2.5 py-1 fw-bold">🏪 Seller / Vendor Panel</span>
            </li>
            <li class="d-none d-md-flex">
              <a class="nav-link" href="/" target="_blank"><i data-feather="globe" style="width:15px;height:15px;"></i><span>Storefront</span></a>
            </li>
            <li class="d-none d-lg-flex">
              <a class="nav-link" href="/admin/dashboard" target="_blank"><i data-feather="shield" style="width:15px;height:15px;"></i><span>Admin Panel</span></a>
            </li>
            <li class="d-none d-lg-flex">
              <a class="nav-link" href="/reseller/dashboard" target="_blank"><i data-feather="users" style="width:15px;height:15px;"></i><span>Reseller Panel</span></a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Vendor Left Sidebar -->
      <div class="left-side-menu" style="background: #183024;">
        <div class="h-100 pt-2">
          <div id="sidebar-menu">
            <ul id="side-menu">
              <li><a href="/vendor/dashboard"><i data-feather="airplay"></i><span>Dashboard</span></a></li>
              <li><a href="/vendor/products"><i data-feather="package"></i><span>My Products</span></a></li>
              <li><a href="/vendor/products/create"><i data-feather="plus-circle"></i><span>Add New Product</span></a></li>
              <li><a href="/vendor/orders"><i data-feather="shopping-cart"></i><span>Vendor Orders</span></a></li>
              <li><a href="/vendor/withdrawals"><i data-feather="dollar-sign"></i><span>Wallet &amp; Withdrawals</span></a></li>
              <li><a href="/vendor/profile"><i data-feather="settings"></i><span>Shop Profile</span></a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="content-page">
        <div class="content">
