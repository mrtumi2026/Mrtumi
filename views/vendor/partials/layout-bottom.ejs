        </div>
      </main>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="/backEnd/js/admin-core.js"></script>
    <script src="/shared/js/mrtumi-ui.js"></script>
    <% if (flash && flash.message) { %>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          toastr.options = { positionClass: 'toast-top-right', timeOut: 3500 };
          toastr["<%= flash.type === 'error' ? 'error' : 'success' %>"](<%- JSON.stringify(flash.message) %>);
        });
      </script>
    <% } %>
  </body>
</html>
