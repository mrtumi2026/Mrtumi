<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="pb-sid" content="<%= typeof sessionToken !== 'undefined' ? sessionToken : '' %>" />
    <title>Vendor Portal - <%= siteSettings.site_name || 'ফল বাজার' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="/frontEnd/js/pb-session.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Hind Siliguri', sans-serif;
        min-height: 100vh;
        background: radial-gradient(circle at top left, #dcfce7 0%, #f1f5f9 60%, #e2e8f0 100%);
        display: flex; align-items: center; justify-content: center; padding: 20px;
      }
      .auth-card { width: 100%; max-width: 470px; background: #fff; border-radius: 18px; box-shadow: 0 20px 50px rgba(15,23,42,0.09); overflow: hidden; border: 1px solid #e5e7eb; }
      .auth-head { background: linear-gradient(135deg, #14532d, #1b4332); color: #fff; padding: 26px; text-align: center; }
    </style>
  </head>
  <body>
    <div class="auth-card">
      <div class="auth-head">
        <img src="/uploads/settings/logo-light.svg" height="46" alt="ফল বাজার" class="mb-2" />
        <h5 class="fw-bold mb-1">🏪 ভেন্ডর / সেলার প্যানেল</h5>
        <p class="small text-white-50 mb-0">আপনার বাগানের বা শপের পণ্য সরাসরি ফল বাজারে বিক্রি করুন</p>
      </div>

      <div class="p-4">
        <div class="nav nav-pills nav-fill bg-light rounded-pill p-1 mb-3">
          <a href="/vendor/login" class="nav-link rounded-pill py-1 small fw-bold <%= mode === 'login' ? 'active bg-success' : 'text-dark' %>">ভেন্ডর লগইন</a>
          <a href="/vendor/register" class="nav-link rounded-pill py-1 small fw-bold <%= mode === 'register' ? 'active bg-success' : 'text-dark' %>">নতুন শপ রেজিস্ট্রেশন</a>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger py-2 small"><%= error %></div>
        <% } %>

        <% if (mode === 'login') { %>
          <form action="/vendor/login" method="POST">
            <div class="mb-3">
              <label class="form-label small fw-semibold">মোবাইল নম্বর অথবা ইমেইল *</label>
              <input type="text" name="identifier" id="vLoginId" class="form-control" placeholder="01XXXXXXXXX / email" autocomplete="username" required />
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold">পাসওয়ার্ড *</label>
              <input type="password" name="password" id="vLoginPass" class="form-control" placeholder="••••••••" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-success w-100 py-2 fw-bold" style="background:#14532d;">ভেন্ডর ড্যাশবোর্ডে প্রবেশ করুন →</button>
          </form>
        <% } else { %>
          <form action="/vendor/register" method="POST">
            <div class="row g-2">
              <div class="col-sm-6">
                <label class="form-label small fw-semibold">শপ / বাগানের নাম *</label>
                <input type="text" name="shop_name" class="form-control form-control-sm" placeholder="যেমন: রাজশাহী আম বাগান" required />
              </div>
              <div class="col-sm-6">
                <label class="form-label small fw-semibold">মালিকের নাম *</label>
                <input type="text" name="owner_name" class="form-control form-control-sm" required />
              </div>
              <div class="col-sm-6">
                <label class="form-label small fw-semibold">মোবাইল নম্বর *</label>
                <input type="tel" name="phone" class="form-control form-control-sm" placeholder="017XXXXXXXX" required />
              </div>
              <div class="col-sm-6">
                <label class="form-label small fw-semibold">ইমেইল (ঐচ্ছিক)</label>
                <input type="email" name="email" class="form-control form-control-sm" />
              </div>
              <div class="col-12">
                <label class="form-label small fw-semibold">ঠিকানা *</label>
                <input type="text" name="address" class="form-control form-control-sm" placeholder="থানা ও জেলা" required />
              </div>
              <div class="col-12">
                <label class="form-label small fw-semibold">পাসওয়ার্ড *</label>
                <input type="password" name="password" class="form-control form-control-sm" minlength="6" required />
              </div>
            </div>
            <button type="submit" class="btn btn-success w-100 py-2 fw-bold mt-3" style="background:#14532d;">ভেন্ডর শপ তৈরি করুন →</button>
          </form>
        <% } %>

        <div class="d-flex justify-content-between small mt-3 pt-2 border-top">
          <a href="/" class="text-success text-decoration-none fw-semibold">← কাস্টমার শপ</a>
          <a href="/reseller/login" class="text-primary text-decoration-none fw-semibold">রিসেলার প্যানেল →</a>
          <a href="/admin/login" class="text-dark text-decoration-none fw-semibold">অ্যাডমিন →</a>
        </div>
      </div>
    </div>
  </body>
</html>
