<%- include('partials/layout-top', { title: 'My Products' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="fw-bold mb-0">📦 আমার সকল প্রোডাক্ট (<%= products.length %>)</h4>
    <p class="text-muted small mb-0">আপনার শপের প্রোডাক্ট আপলোড, স্টক ও মূল্য পরিবর্তন করুন</p>
  </div>
  <a href="/vendor/products/create" class="btn btn-forest btn-sm">+ নতুন পণ্য যোগ করুন</a>
</div>

<div class="tbl-card">
  <div class="tbl-card-body">
    <table class="table clean mb-0 align-middle">
      <thead>
        <tr>
          <th>পণ্য</th>
          <th>ক্যাটাগরি</th>
          <th>রেগুলার / বিক্রয় মূল্য</th>
          <th>স্টক</th>
          <th>বিক্রি</th>
          <th>অ্যাপ্রুভাল</th>
          <th class="text-end">অ্যাকশন</th>
        </tr>
      </thead>
      <tbody>
        <% if (!products.length) { %>
          <tr><td colspan="7" class="text-center py-4 text-muted">আপনি এখনো কোনো পণ্য যোগ করেননি।</td></tr>
        <% } %>
        <% products.forEach(function(p) { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <img src="<%= p.image %>" class="p-thumb" alt="" />
                <div>
                  <div class="fw-semibold"><%= p.name %></div>
                  <small class="text-muted">SKU: <%= p.sku || p.code %></small><br><span class="badge <%= Number(p.status) ? 'bg-success' : 'bg-secondary' %>"><%= Number(p.status) ? 'Active' : 'Inactive' %></span>
                </div>
              </div>
            </td>
            <td><%= p.category_name || '—' %></td>
            <td>
              <% if (p.old_price > p.new_price) { %>
                <span class="text-muted text-decoration-line-through small me-1">৳<%= p.old_price %></span>
              <% } %>
              <strong class="text-success">৳<%= p.new_price %></strong>
            </td>
            <td><span class="sb <%= p.stock > 10 ? 'sb-6' : 'sb-7' %>"><%= p.stock %></span><form action="/vendor/products/<%= p.id %>/inventory" method="POST" class="d-flex gap-1 mt-1"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input name="quantity" type="number" min="0" value="<%= p.stock %>" class="form-control form-control-sm" aria-label="Inventory quantity"><input name="reason" type="hidden" value="Vendor portal stock count"><button class="btn btn-sm btn-outline-success" type="submit">Save stock</button></form></td>
            <td><%= p.sold_count || 0 %></td>
            <td>
              <span class="sb <%= p.approval_status === 'approved' ? 'sb-6' : 'sb-1' %>">
                <%= p.approval_status === 'approved' ? 'Approved (Live)' : 'Pending Approval' %>
              </span>
            </td>
            <td class="text-end">
              <a href="/product/<%= p.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary py-1 px-2" title="View on Storefront"><i class="fas fa-external-link-alt"></i></a>
              <a href="/vendor/products/edit/<%= p.id %>" class="btn btn-sm btn-outline-primary py-1 px-2"><i class="fas fa-edit"></i></a>
              <form action="/vendor/products/<%= p.id %>/status" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><input type="hidden" name="status" value="<%= Number(p.status) ? 0 : 1 %>">
                <button type="submit" class="btn btn-sm <%= Number(p.status) ? 'btn-outline-danger' : 'btn-outline-success' %> py-1 px-2"><%= Number(p.status) ? 'Deactivate' : 'Activate' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/layout-bottom') %>
