<%- include('partials/layout-top', { title: product ? 'Edit Product' : 'Add Product' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="fw-bold mb-0"><%= product ? 'পণ্য সম্পাদনা করুন' : 'নতুন পণ্য যোগ করুন' %></h4>
    <p class="text-muted small mb-0">সঠিক ছবি, মূল্য ও স্টক তথ্য প্রদান করুন</p>
  </div>
  <a href="/vendor/products" class="btn btn-outline-secondary btn-sm">← ফিরে যান</a>
</div>

<form action="<%= product ? ('/vendor/products/edit/' + product.id) : '/vendor/products/create' %>" method="POST" enctype="multipart/form-data" class="tbl-card p-4">
  <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label fw-semibold small">পণ্যের নাম *</label>
      <input type="text" name="name" value="<%= product ? product.name : '' %>" class="form-control" required />
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold small">ক্যাটাগরি *</label>
      <select name="category_id" class="form-select">
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold small">ব্র্যান্ড</label>
      <select name="brand_id" class="form-select">
        <% brands.forEach(function(b) { %>
          <option value="<%= b.id %>" <%= product && product.brand_id === b.id ? 'selected' : '' %>><%= b.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-3">
      <label class="form-label fw-semibold small">পূর্বের মূল্য / MRP (৳)</label>
      <input type="number" name="old_price" value="<%= product ? product.old_price : 1500 %>" class="form-control" />
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold small">বিক্রয় মূল্য (৳) *</label>
      <input type="number" name="new_price" value="<%= product ? product.new_price : 1250 %>" class="form-control" required />
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold small">পাইকারি মূল্য (৳)</label>
      <input type="number" name="wholesale_price" value="<%= product ? product.wholesale_price : 1100 %>" class="form-control" />
    </div>
    <div class="col-md-3">
      <label class="form-label fw-semibold small">স্টক সংখ্যা *</label>
      <input type="number" name="stock" value="<%= product ? product.stock : 100 %>" class="form-control" required />
    </div>

    <div class="col-md-4">
      <label class="form-label fw-semibold small">সাইজ / ভ্যারিয়েন্ট (কমা দিয়ে)</label>
      <input type="text" name="sizes" value="<%= product ? product.sizes : '৫০০ গ্রাম,১ কেজি,২ কেজি' %>" class="form-control" />
    </div>
    <div class="col-md-4">
      <label class="form-label fw-semibold small">গ্রেড / কালার</label>
      <input type="text" name="colors" value="<%= product ? product.colors : 'প্রিমিয়াম লাল' %>" class="form-control" />
    </div>
    <div class="col-md-4">
      <label class="form-label fw-semibold small">পণ্যের ছবি আপলোড</label>
      <input type="file" name="image" accept="image/*" class="form-control" />
    </div>

    <div class="col-12">
      <label class="form-label fw-semibold small">বিস্তারিত বিবরণ</label>
      <textarea name="description" rows="4" class="form-control"><%= product ? product.description : '' %></textarea>
    </div>

    <div class="col-12 pt-2">
      <button type="submit" class="btn btn-forest px-5 py-2 fw-bold">✓ সংরক্ষণ করুন</button>
    </div>
  </div>
</form>

    <% if (product && typeof variants !== 'undefined') { %>
      <div class="col-12"><hr><h5 class="fw-bold">Variants</h5>
        <% variants.forEach(function(v) { %>
          <form action="/vendor/products/<%= product.id %>/variants/<%= v.id %>" method="POST" class="row g-2 mb-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <div class="col-md-3"><input class="form-control" name="variant_sku" value="<%= v.variant_sku %>" required maxlength="80" aria-label="Variant SKU"></div>
            <div class="col-md-2"><input class="form-control" name="size_label" value="<%= v.size_label %>" maxlength="80" aria-label="Size"></div>
            <div class="col-md-2"><input class="form-control" name="color_label" value="<%= v.color_label %>" maxlength="80" aria-label="Option"></div>
            <div class="col-md-2"><input class="form-control" name="price_bdt" type="number" min="0" step="0.01" value="<%= (Number(v.price_paisa)/100).toFixed(2) %>" required aria-label="Variant price BDT"></div>
            <div class="col-md-2"><input class="form-control" name="stock_on_hand" type="number" min="0" value="<%= v.stock_on_hand %>" required aria-label="Variant stock"></div>
            <div class="col-md-1"><button class="btn btn-outline-primary" type="submit">Save</button></div>
          </form>
        <% }) %>
        <form action="/vendor/products/<%= product.id %>/variants" method="POST" class="row g-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
          <div class="col-md-3"><input class="form-control" name="variant_sku" placeholder="Variant SKU" required maxlength="80"></div>
          <div class="col-md-2"><input class="form-control" name="size_label" placeholder="Size" maxlength="80"></div>
          <div class="col-md-2"><input class="form-control" name="color_label" placeholder="Option" maxlength="80"></div>
          <div class="col-md-2"><input class="form-control" name="price_bdt" type="number" min="0" step="0.01" placeholder="Price BDT" required></div>
          <div class="col-md-2"><input class="form-control" name="stock_on_hand" type="number" min="0" value="0" required></div>
          <div class="col-md-1"><button class="btn btn-outline-success" type="submit">Add</button></div>
        </form>
      </div>
    <% } %>

<%- include('partials/layout-bottom') %>
