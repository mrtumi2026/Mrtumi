<%- include('partials/layout-top', { title: t('vendorFulfillment.subOrder') }) %>

<div class="mb-3">
  <h4 class="fw-bold mb-0">🛒 <%= t('vendorFulfillment.subOrder') %> (<%= orderLines.length %>)</h4>
  <p class="text-muted small mb-0"><%= t('vendorFulfillment.pageIntro') %></p>
</div>

<div class="tbl-card">
  <div class="tbl-card-body">
    <div class="table-responsive">
      <table class="table clean mb-0 align-middle">
        <thead><tr>
          <th><%= t('vendorFulfillment.invoice') %></th><th><%= t('vendorFulfillment.customerAddress') %></th><th><%= t('vendorFulfillment.productPack') %></th><th><%= t('vendorFulfillment.salePrice') %></th>
          <th><%= t('vendorFulfillment.netIncome') %> (<%= 100 - Number(vendor.commission_rate || 10) %>%)</th><th><%= t('vendorFulfillment.parentOrder') %></th>
          <th><%= t('vendorFulfillment.subOrder') %></th><th class="text-end">অ্যাকশন</th>
        </tr></thead>
        <tbody>
          <% if (!orderLines.length) { %><tr><td colspan="8" class="text-center py-4 text-muted"><%= t('vendorFulfillment.noOrders') %></td></tr><% } %>
          <% orderLines.forEach(function(ol) {
               const gross=Number(ol.price)*Number(ol.qty);
               const net=Math.round(gross*(1-Number(vendor.commission_rate||10)/100));
               const parentLabel=t('orderStatus.'+String(ol.order_status||''),{},t('vendorFulfillment.unknownStatus'));
               const subKey=String(ol.vendor_sub_order_status||'');
               const subLabel=t('vendorFulfillment.'+subKey,{},t('vendorFulfillment.unknownStatus'));
               const nextActions={order_placed:['vendor_accepted'],vendor_accepted:['processing'],processing:['packed'],packed:['ready_for_pickup'],failed_delivery:['ready_for_pickup']}[subKey]||[];
               const actionLabels={vendor_accepted:t('vendorFulfillment.acceptOrder'),processing:t('vendorFulfillment.startPacking'),packed:t('vendorFulfillment.finishPacking'),ready_for_pickup:t('vendorFulfillment.readyPickup')};
               const legacyKey=String(ol.fulfillment_status||'');
               const legacyLabels={pending:t('vendorFulfillment.legacyPending'),processing:t('vendorFulfillment.legacyProcessing'),ready:t('vendorFulfillment.legacyReady'),dispatched:t('vendorFulfillment.legacyDispatched')};
          %>
            <tr>
              <td><div class="fw-bold">#<%= ol.invoice_id %></div><small class="text-muted"><%= String(ol.created_at).slice(0,10) %></small></td>
              <td><div class="small text-muted"><%= t('vendorFulfillment.customerPrivacy') %></div></td>
              <td><%= ol.product_name %> <span class="badge bg-light text-dark border"><%= ol.size %> × <%= ol.qty %></span></td>
              <td>৳<%= gross.toLocaleString('en-IN') %></td><td class="fw-bold text-success">৳<%= net.toLocaleString('en-IN') %></td>
              <td><span class="sb <%= ['delivered','completed'].includes(ol.order_status)?'sb-6':'sb-1' %>"><%= parentLabel %></span></td>
              <td>
                <% if (ol.vendor_sub_order_id) { %>
                  <span class="sb <%= subKey==='delivered'?'sb-6':subKey==='cancelled'?'sb-7':'sb-1' %>"><%= subLabel %></span>
                  <% if (ol.delivery_mode) { %><div class="small text-muted mt-1"><%= t('vendorFulfillment.'+ol.delivery_mode,{},t('vendorFulfillment.unknownStatus')) %></div><% } else { %><div class="small text-warning mt-1"><%= t('vendorFulfillment.deliveryModeUnknown') %></div><% } %>
                  <% if (ol.booking_status) { %><div class="small mt-1"><%= t('vendorFulfillment.booking') %>: <%= t('vendorFulfillment.booking_'+ol.booking_status,{},t('vendorFulfillment.unknownStatus')) %></div><% if(ol.shipment_carrier){ %><div class="small"><%= t('vendorFulfillment.courier') %>: <%= ol.shipment_carrier %></div><% } %><% if(ol.tracking_code){ %><div class="small"><%= t('vendorFulfillment.trackingLabel') %>: <%= ol.tracking_code %></div><% } %><% } else if (subKey==='ready_for_pickup') { %><div class="small text-muted mt-1"><%= t('vendorFulfillment.notBooked') %></div><% } %>
                  <% if (ol.picked_up_at) { %><span class="badge bg-success mt-1"><%= t('vendorFulfillment.handoverRecorded') %></span><% } else if (subKey==='ready_for_pickup') { %><div class="small text-muted mt-1"><%= t('vendorFulfillment.notHandedOver') %></div><% } %>
                <% } else if (ol.fulfillment_status) { %>
                  <span class="badge bg-secondary"><%= legacyLabels[legacyKey]||t('vendorFulfillment.unknownStatus') %></span>
                <% } else { %><span class="small text-muted"><%= t('vendorFulfillment.unknownStatus') %></span><% } %>
              </td>
              <td class="text-end">
                <div class="d-flex flex-column align-items-end gap-2">
                  <% if (ol.vendor_sub_order_id && nextActions.length) { nextActions.forEach(function(target) { %>
                    <form action="/vendor/sub-orders/<%= ol.vendor_sub_order_id %>/status" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>" />
                      <input type="hidden" name="to_status" value="<%= target %>" />
                      <button type="submit" class="btn btn-sm btn-success"><%= actionLabels[target] %></button>
                    </form>
                  <% }); } %>
                  <% if (ol.vendor_sub_order_id && subKey==='ready_for_pickup' && ol.delivery_mode==='vendor_managed' && ol.booking_status!=='succeeded') { %>
                    <button type="button" class="btn btn-sm btn-primary" onclick="openCourierCompareModal('<%= ol.vendor_sub_order_id %>')">
                      <i class="fas fa-truck-fast me-1"></i><%= t('vendorFulfillment.compareAndBookCourier') %>
                    </button>
                    <details class="mt-1 text-end" style="font-size:11px;">
                      <summary class="text-muted cursor-pointer"><%= t('vendorFulfillment.manualBookingEntry') %></summary>
                      <form action="/vendor/sub-orders/<%= ol.vendor_sub_order_id %>/booking-result" method="POST" class="d-flex flex-wrap gap-1 justify-content-end mt-1">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>" />
                        <input class="form-control form-control-sm" style="font-size:11px;width:110px;" name="courier_code" maxlength="48" required placeholder="<%= t('vendorFulfillment.courierCode') %>" aria-label="<%= t('vendorFulfillment.courierCode') %>" />
                        <input class="form-control form-control-sm" style="font-size:11px;width:120px;" name="tracking_reference" maxlength="120" placeholder="<%= t('vendorFulfillment.trackingReference') %>" aria-label="<%= t('vendorFulfillment.trackingReference') %>" />
                        <select class="form-select form-select-sm" style="font-size:11px;width:110px;" name="result_code" required aria-label="<%= t('vendorFulfillment.bookingResult') %>"><option value="succeeded"><%= t('vendorFulfillment.bookingSucceeded') %></option><option value="failed"><%= t('vendorFulfillment.bookingFailed') %></option></select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary" style="font-size:11px;"><%= t('vendorFulfillment.recordBooking') %></button>
                      </form>
                    </details>
                  <% } %>
                  <% if (ol.vendor_sub_order_id && subKey==='ready_for_pickup' && ol.delivery_mode==='vendor_managed' && ol.booking_status==='succeeded' && !ol.picked_up_at) { %>
                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                      <form action="/vendor/sub-orders/<%= ol.vendor_sub_order_id %>/track-sync" method="POST" class="d-inline"><input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>" /><button type="submit" class="btn btn-sm btn-outline-info" title="<%= t('vendorFulfillment.syncTracking') %>"><i class="fas fa-arrows-rotate me-1"></i><%= t('vendorFulfillment.syncTracking') %></button></form>
                      <form action="/vendor/sub-orders/<%= ol.vendor_sub_order_id %>/handover" method="POST" class="d-inline"><input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>" /><button type="submit" class="btn btn-sm btn-outline-success"><%= t('vendorFulfillment.confirmHandover') %></button></form>
                    </div>
                  <% } %>
                  <% if (ol.vendor_sub_order_id && ol.booking_status==='unknown_timeout') { %>
                    <form action="/vendor/sub-orders/<%= ol.vendor_sub_order_id %>/reconcile-booking" method="POST" class="d-inline mt-1"><input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>" /><button type="submit" class="btn btn-sm btn-outline-warning" title="<%= t('vendorFulfillment.reconcileBooking') %>"><i class="fas fa-rotate me-1"></i><%= t('vendorFulfillment.reconcileBooking') %></button></form>
                  <% } %>
                  <% if (ol.vendor_sub_order_id && subKey==='ready_for_pickup' && ol.delivery_mode==='platform_managed') { %><span class="small text-muted"><%= t('vendorFulfillment.platformAwaiting') %></span><% } %>
                  <% if (!ol.vendor_sub_order_id && ol.fulfillment_status) { %>
                    <% const legacyNext=({pending:'processing',processing:'ready',ready:'dispatched'})[legacyKey]; if(legacyNext && !['cancelled','delivered'].includes(ol.order_status)) { %>
                      <form action="/vendor/order-items/<%= ol.order_item_id %>/fulfillment" method="POST" class="d-inline"><input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>" /><input type="hidden" name="fulfillment_status" value="<%= legacyNext %>" /><button type="submit" class="btn btn-sm btn-outline-secondary"><%= t('vendorFulfillment.legacyNext') %></button></form>
                    <% } %>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Multi-Courier Quote Comparison & One-Click Booking Modal -->
<div class="modal fade" id="courierCompareModal" tabindex="-1" aria-labelledby="courierCompareModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="courierCompareModalLabel">
          <i class="fas fa-truck-fast text-primary me-2"></i><%= t('vendorFulfillment.compareAndBookCourier') %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4" id="courierModalBody">
        <div id="courierLoadingState" class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading quotes...</span>
          </div>
          <p class="mt-2 text-muted small">কুরিয়ার সার্ভিসগুলোর লাইভ রেট ও সার্ভিসেবিলিটি যাচাই করা হচ্ছে...</p>
        </div>
        <div id="courierContentState" style="display:none;">
          <!-- Content dynamically rendered via openCourierCompareModal -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function openCourierCompareModal(subOrderId) {
  const modalEl = document.getElementById('courierCompareModal');
  const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  const loading = document.getElementById('courierLoadingState');
  const content = document.getElementById('courierContentState');

  loading.style.display = 'block';
  content.style.display = 'none';
  modal.show();

  fetch('/vendor/sub-orders/' + encodeURIComponent(subOrderId) + '/courier-quotes')
    .then(r => r.json())
    .then(res => {
      loading.style.display = 'none';
      content.style.display = 'block';

      if (!res.success || !res.data) {
        content.innerHTML = '<div class="alert alert-danger">কুরিয়ার তথ্য লোড করতে সমস্যা হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।</div>';
        return;
      }

      const d = res.data;
      const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
      const idempotencyKey = 'book-' + d.subOrderId + '-' + Date.now();

      let html = '';

      // Header summary
      html += '<div class="alert alert-secondary py-2 px-3 small d-flex justify-content-between flex-wrap gap-2 mb-3">';
      html += '<div><strong>ইনভয়েস:</strong> #' + (d.invoiceId || d.subOrderId) + ' &bull; <strong>গ্রাহক:</strong> ' + (d.customerName || 'N/A') + '</div>';
      html += '<div><strong>গন্তব্য:</strong> ' + (d.destinationArea || d.address || 'ঢাকা') + ' &bull; <strong>ওজন:</strong> ~' + (d.weightGrams/1000).toFixed(1) + ' কেজি</div>';
      html += '</div>';

      // Recommended Courier Box
      if (d.recommendation) {
        const rec = d.recommendation;
        const totalBdt = (rec.chargePaisa + (rec.codFeePaisa || 0)) / 100;
        const isLive = rec.isLiveQuote;

        html += '<div class="card border-success shadow-sm mb-4">';
        html += '  <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-2">';
        html += '    <span class="fw-bold"><i class="fas fa-award me-1"></i><%= t("vendorFulfillment.recommendedCourier") %></span>';
        html += '    <span class="badge ' + (isLive ? 'bg-light text-success' : 'bg-secondary') + '">' + (isLive ? '<%= t("vendorFulfillment.liveQuote") %>' : '<%= t("vendorFulfillment.tariffSchedule") %>') + '</span>';
        html += '  </div>';
        html += '  <div class="card-body p-3">';
        html += '    <div class="row align-items-center">';
        html += '      <div class="col-md-7">';
        html += '        <h5 class="fw-bold text-dark mb-1">' + rec.providerName + '</h5>';
        html += '        <div class="text-success small fw-semibold mb-2"><i class="fas fa-check-circle me-1"></i>' + (d.reasonBn || d.reasonEn) + '</div>';
        html += '        <div class="d-flex gap-3 small text-muted">';
        html += '          <span><strong>ডেলিভারি চার্জ:</strong> ৳' + (rec.chargePaisa/100) + '</span>';
        if (rec.codFeePaisa > 0) html += '<span><strong>COD ফি:</strong> ৳' + (rec.codFeePaisa/100) + '</span>';
        html += '          <span><strong>সময়:</strong> ' + rec.estimatedDaysMin + '-' + rec.estimatedDaysMax + ' দিন</span>';
        html += '        </div>';
        html += '      </div>';
        html += '      <div class="col-md-5 text-md-end mt-3 mt-md-0">';
        html += '        <div class="h4 fw-bold text-success mb-2">৳' + totalBdt.toLocaleString('en-IN') + '</div>';
        html += '        <form method="POST" action="/vendor/sub-orders/' + encodeURIComponent(d.subOrderId) + '/one-click-book">';
        html += '          <input type="hidden" name="_csrf" value="' + csrfToken + '" />';
        html += '          <input type="hidden" name="courier_code" value="' + rec.providerCode + '" />';
        html += '          <input type="hidden" name="idempotency_key" value="' + idempotencyKey + '" />';
        html += '          <button type="submit" class="btn btn-success fw-bold px-3 shadow-sm">';
        html += '            <i class="fas fa-bolt me-1"></i><%= t("vendorFulfillment.bookNow") %>';
        html += '          </button>';
        html += '        </form>';
        html += '      </div>';
        html += '    </div>';
        html += '  </div>';
        html += '</div>';
      } else {
        html += '<div class="alert alert-warning">' + (d.reasonBn || d.reasonEn || 'কোন কুরিয়ার অপশন পাওয়া যায়নি।') + '</div>';
      }

      // Alternative Couriers
      if (d.alternatives && d.alternatives.length > 0) {
        html += '<h6 class="fw-bold text-muted mb-2"><i class="fas fa-arrows-split-up-and-left me-1"></i><%= t("vendorFulfillment.alternativeCouriers") %></h6>';
        html += '<div class="table-responsive">';
        html += '<table class="table table-sm align-middle table-bordered mb-0">';
        html += '<thead class="table-light"><tr><th>কুরিয়ার</th><th>মোট চার্জ</th><th>আনুমানিক সময়</th><th>তুলনা ও পার্থক্য</th><th class="text-end">অ্যাকশন</th></tr></thead>';
        html += '<tbody>';
        d.alternatives.forEach(alt => {
          html += '<tr>';
          html += '<td><strong>' + alt.providerName + '</strong> ' + (alt.isLiveQuote ? '<span class="badge bg-info-subtle text-info" style="font-size:10px;">Live</span>' : '') + '</td>';
          html += '<td class="fw-bold">৳' + alt.totalCostBdt + '</td>';
          html += '<td>' + alt.estimatedDaysMin + '-' + alt.estimatedDaysMax + ' দিন</td>';
          html += '<td class="small text-muted">' + (alt.tradeOffBn || alt.tradeOffEn) + '</td>';
          html += '<td class="text-end">';
          html += '  <form method="POST" action="/vendor/sub-orders/' + encodeURIComponent(d.subOrderId) + '/one-click-book" class="d-inline">';
          html += '    <input type="hidden" name="_csrf" value="' + csrfToken + '" />';
          html += '    <input type="hidden" name="courier_code" value="' + alt.providerCode + '" />';
          html += '    <input type="hidden" name="idempotency_key" value="' + idempotencyKey + '" />';
          html += '    <button type="submit" class="btn btn-sm btn-outline-primary">বুক করুন</button>';
          html += '  </form>';
          html += '</td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
      }

      content.innerHTML = html;
    })
    .catch(err => {
      loading.style.display = 'none';
      content.style.display = 'block';
      content.innerHTML = '<div class="alert alert-danger">নেটওয়ার্ক এরর: ' + err.message + '</div>';
    });
}
</script>

<%- include('partials/layout-bottom') %>
