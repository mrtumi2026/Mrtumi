<%- include('partials/layout-top', { title: 'Vendor onboarding | Mrtumi' }) %>
<main class="container py-4"><h1 class="h3">Vendor workspace · <%= vendor.shop_name || vendor.owner_name || 'Application' %></h1>
<% const state=vendor.lifecycle_status||'pending'; const stateLabel={pending:'Pending',under_review:'Under review',action_required:'Information requested',approved:'Approved',active:'Active',rejected:'Rejected',suspended:'Suspended',deactivated:'Deactivated'}[state]||state; %>
<div class="alert <%= state==='active'?'alert-success':(['rejected','suspended','deactivated'].includes(state)?'alert-danger':'alert-warning') %>"><strong>Status: <%= stateLabel %></strong><% if(state!=='active'){ %><p class="mb-0">Only active vendors can publish products, manage inventory, or request withdrawals. Approval requires verified identity, completed onboarding, assigned commission and verified payout setup.</p><% } %></div>
<% if (application && application.resubmission_count) { %><p>Resubmissions: <%= application.resubmission_count %></p><% } %>
<% if (['action_required','rejected'].includes(state)) { %><div class="mb-3"><a class="btn btn-outline-primary" href="/vendor/onboarding/resubmit">Update and resubmit application</a></div><% } %>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card p-3"><strong>Phone</strong><span><%= vendor.phone_verified_at?'Verified':'Not verified' %></span><% if(!vendor.phone_verified_at){ %><a href="/vendor/verify-phone">Verify phone</a><% } %></div></div><div class="col-md-3"><div class="card p-3"><strong>Identity</strong><span><%= vendor.identity_verified_at?'Verified by review':'Awaiting review' %></span></div></div><div class="col-md-3"><div class="card p-3"><strong>Commission</strong><span><%= vendor.commission_configured_at?Number(vendor.commission_rate_bps/100).toFixed(2)+'%':'Not assigned' %></span></div></div><div class="col-md-3"><div class="card p-3"><strong>Payout</strong><span><%= vendor.payout_verified_at?'Verified':'Not verified' %></span></div></div></div>
<div class="row g-3"><section class="col-lg-6"><div class="card p-3 h-100"><h2 class="h5">Complete onboarding</h2><p>Review the vendor terms. Activation is not automatic when you submit.</p><form method="post" action="/vendor/onboarding/complete"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="onboard-terms" name="terms_accepted" value="1" required><label class="form-check-label" for="onboard-terms">I have reviewed and accept the vendor onboarding requirements.</label></div><button class="btn btn-primary" type="submit">Save onboarding completion</button></form></div></section>
<section class="col-lg-6"><div class="card p-3 h-100"><h2 class="h5">Payout setup</h2><p>Account details are encrypted and visible only to authorized reviewers. No transfer is triggered here.</p><form method="post" action="/vendor/onboarding/payout"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="mb-2"><label for="method" class="form-label">Method</label><select id="method" name="method" class="form-select" required><option value="">Select</option><option value="bank">Bank</option><option value="bkash">bKash</option><option value="nagad">Nagad</option></select></div><div class="mb-2"><label for="holder_name" class="form-label">Account holder</label><input id="holder_name" name="holder_name" class="form-control" maxlength="191" required></div><div class="mb-2"><label for="account_number" class="form-label">Account / mobile number</label><input id="account_number" name="account_number" class="form-control" maxlength="64" autocomplete="off" required></div><div id="bank-fields" hidden><div class="mb-2"><label for="bank_name" class="form-label">Bank name</label><input id="bank_name" name="bank_name" class="form-control" maxlength="191"></div><div class="mb-2"><label for="branch" class="form-label">Branch</label><input id="branch" name="branch" class="form-control" maxlength="191"></div><div class="mb-2"><label for="routing_number" class="form-label">Routing number (optional)</label><input id="routing_number" name="routing_number" class="form-control" maxlength="32"></div></div><button class="btn btn-outline-primary" type="submit">Submit for verification</button></form>
<% if (payouts && payouts.length) { %><hr><h3 class="h6">Saved accounts</h3><ul><% payouts.forEach(function(p){ %><li><%= p.method %> · <%= p.masked_account %> · <%= p.verification_status %></li><% }) %></ul><% } %></div></section></div>
<section class="card p-3 mt-3"><h2 class="h5">Status history</h2><div class="table-responsive"><table class="table"><thead><tr><th>From</th><th>To</th><th>Reason</th><th>Date</th></tr></thead><tbody><% (history||[]).forEach(function(h){ %><tr><td><%= h.from_status||'—' %></td><td><%= h.to_status %></td><td><%= h.reason %></td><td><%= String(h.created_at).slice(0,19) %></td></tr><% }) %></tbody></table></div></section>
</main><script>document.getElementById('method').addEventListener('change',e=>{document.getElementById('bank-fields').hidden=e.target.value!=='bank'});</script><%- include('partials/layout-bottom') %>
