<% const L = (en, bn) => (typeof locale !== 'undefined' && locale === 'en' ? en : bn); %>
<%- include('partials/layout-top', { title: L('Vendor onboarding | Mrtumi','ভেন্ডর অ্যাকাউন্ট | Mrtumi') }) %>
<main class="container py-4"><h1 class="h3"><%= L('Vendor workspace', 'ভেন্ডর প্যানেল') %> · <%= vendor.shop_name || vendor.owner_name || 'Application' %></h1>
<% const state=vendor.lifecycle_status||'pending'; const stateLabel={pending:L('Pending','অপেক্ষমাণ'),under_review:L('Under review','পর্যালোচনা চলছে'),action_required:L('Information requested','আরও তথ্য দরকার'),approved:L('Approved','অনুমোদিত'),active:L('Active','সক্রিয়'),rejected:L('Rejected','বাতিল'),suspended:L('Suspended','স্থগিত'),deactivated:L('Deactivated','নিষ্ক্রিয়')}[state]||state; %>
<div class="alert <%= state==='active'?'alert-success':(['rejected','suspended','deactivated'].includes(state)?'alert-danger':'alert-warning') %>"><strong><%= L('Status:', 'অবস্থা:') %> <%= stateLabel %></strong><% if(state!=='active'){ %><p class="mb-0"><%= L('Only active vendors can publish products, manage inventory, or request withdrawals. Approval requires verified identity, completed onboarding, assigned commission and verified payout setup.', 'শুধু সক্রিয় ভেন্ডর পণ্য প্রকাশ, স্টক ব্যবস্থাপনা ও টাকা তোলার অনুরোধ করতে পারেন। অনুমোদনের জন্য পরিচয় যাচাই, তথ্য পূরণ, কমিশন নির্ধারণ ও টাকা পাওয়ার অ্যাকাউন্ট যাচাই দরকার।') %></p><% } %></div>
<% if (application && application.resubmission_count) { %><p><%= L('Resubmissions:', 'আবার জমা:') %> <%= application.resubmission_count %></p><% } %>
<% if (['action_required','rejected'].includes(state)) { %><div class="mb-3"><a class="btn btn-outline-primary" href="/vendor/onboarding/resubmit"><%= L('Update and resubmit application', 'তথ্য ঠিক করে আবার আবেদন করুন') %></a></div><% } %>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card p-3"><strong><%= L('Phone', 'ফোন') %></strong><span><%= vendor.phone_verified_at?L('Verified','যাচাই হয়েছে'):L('Not verified','যাচাই হয়নি') %></span><% if(!vendor.phone_verified_at){ %><a href="/vendor/verify-phone"><%= L('Verify phone', 'ফোন যাচাই করুন') %></a><% } %></div></div><div class="col-md-3"><div class="card p-3"><strong><%= L('Identity', 'পরিচয়') %></strong><span><%= vendor.identity_verified_at?L('Verified by review','যাচাই হয়েছে'):L('Awaiting review','যাচাইয়ের অপেক্ষায়') %></span></div></div><div class="col-md-3"><div class="card p-3"><strong><%= L('Commission', 'কমিশন') %></strong><span><%= vendor.commission_configured_at?Number(vendor.commission_rate||0).toFixed(2)+'%':L('Not assigned','নির্ধারণ হয়নি') %></span></div></div><div class="col-md-3"><div class="card p-3"><strong><%= L('Payout', 'টাকা পাওয়ার অ্যাকাউন্ট') %></strong><span><%= vendor.payout_verified_at?L('Verified','যাচাই হয়েছে'):L('Not verified','যাচাই হয়নি') %></span></div></div></div>
<% if (state==='active') { %>
<nav class="row g-2 mb-3" aria-label="<%= L('Vendor menu', 'ভেন্ডর মেনু') %>">
<% [['/vendor/products',L('📦 My products','📦 আমার পণ্য')],['/vendor/products/create',L('➕ New product','➕ নতুন পণ্য')],['/vendor/orders',L('🧾 Orders','🧾 অর্ডার')],['/vendor/withdrawals',L('💰 Wallet & withdrawals','💰 ওয়ালেট ও টাকা তোলা')],['/vendor/profile',L('⚙️ Shop profile','⚙️ দোকানের প্রোফাইল')]].forEach(function(l){ %>
<div class="col-6 col-md"><a class="btn btn-outline-success w-100 py-3" href="<%= l[0] %>"><%= l[1] %></a></div>
<% }) %>
</nav>
<% const s = typeof sales !== 'undefined' ? sales : {}; const money = v => '৳' + Number(v||0).toLocaleString('en-IN'); %>
<section class="row g-2 mb-3" aria-label="<%= L('Sales summary', 'বিক্রির হিসাব') %>">
<% [[L('Total orders (without cancelled)', 'মোট অর্ডার (বাতিল বাদে)'), Number((typeof orders !== 'undefined' && orders.totalOrders) || 0)],[L('Open orders', 'চলমান অর্ডার'), s.openOrders||0],[L('Delivered', 'ডেলিভারি সম্পন্ন'), s.deliveredOrders||0],[L('Total product sales (taka)', 'মোট পণ্য বিক্রি (টাকা)'), money(typeof orders !== 'undefined' ? orders.grossSales : 0)],[L('Your earnings from deliveries', 'ডেলিভারি থেকে আপনার আয়'), money(s.deliveredEarnings)],[L('Earnings from deliveries, last 30 days', 'গত ৩০ দিনের ডেলিভারি থেকে আয়'), money(s.recentEarnings)],[L('Pending balance', 'অপেক্ষমাণ ব্যালেন্স'), money(s.pendingBalance)],[L('Withdrawable balance', 'তোলার মতো ব্যালেন্স'), money(s.availableBalance)]].forEach(function(c){ %>
<div class="col-6 col-md-3"><div class="card p-3 h-100"><span class="small text-muted"><%= c[0] %></span><strong class="h5 mb-0"><%= c[1] %></strong></div></div>
<% }) %>
</section>
<% if (typeof counts !== 'undefined') { %><p class="mb-2"><%= L('Products: total', 'পণ্য: মোট') %> <%= counts.totalProducts %> · <%= L('approved', 'অনুমোদিত') %> <%= counts.approvedProducts %> · <%= L('pending', 'অপেক্ষমাণ') %> <%= counts.pendingProducts %></p><% } %>
<% if (vendor.slug) { %><p class="mb-3"><%= L('Your shop link:', 'আপনার দোকানের লিংক:') %> <a href="/<%= vendor.slug %>">/<%= vendor.slug %></a> · <a href="/vendor/profile"><%= L('Change link', 'লিংক বদলান') %></a></p><% } %>
<% } %>
<div class="row g-3"><% if (state!=='active') { %><section class="col-lg-6"><div class="card p-3 h-100"><h2 class="h5"><%= L('Complete onboarding', 'অ্যাকাউন্টের তথ্য সম্পূর্ণ করুন') %></h2><p><%= L('Review the vendor terms. Submitting does not switch the account on by itself.', 'ভেন্ডরের শর্ত পড়ুন। জমা দিলেই অ্যাকাউন্ট নিজে নিজে চালু হয় না।') %></p><form method="post" action="/vendor/onboarding/complete"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="onboard-terms" name="terms_accepted" value="1" required><label class="form-check-label" for="onboard-terms"><%= L('I have read and accept the vendor requirements.', 'আমি ভেন্ডরের শর্তগুলো পড়েছি এবং মেনে নিচ্ছি।') %></label></div><button class="btn btn-primary" type="submit"><%= L('Save onboarding completion', 'সংরক্ষণ করুন') %></button></form></div></section><% } %>
<section class="col-lg-6"><div class="card p-3 h-100"><h2 class="h5"><%= L('Payout setup', 'টাকা পাওয়ার অ্যাকাউন্ট') %></h2><p><%= L('Account details are encrypted and seen only by authorised reviewers. No money is sent from here.', 'অ্যাকাউন্টের তথ্য এনক্রিপ্ট করা থাকে, শুধু অনুমোদিত যাচাইকারী দেখতে পান। এখান থেকে কোনো টাকা পাঠানো হয় না।') %></p><form method="post" action="/vendor/onboarding/payout"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div class="mb-2"><label for="method" class="form-label"><%= L('Method', 'মাধ্যম') %></label><select id="method" name="method" class="form-select" required><option value=""><%= L('Select', 'বেছে নিন') %></option><option value="bank"><%= L('Bank', 'ব্যাংক') %></option><option value="bkash">bKash</option><option value="nagad">Nagad</option></select></div><div class="mb-2"><label for="holder_name" class="form-label"><%= L('Account holder', 'অ্যাকাউন্টধারীর নাম') %></label><input id="holder_name" name="holder_name" class="form-control" maxlength="191" required></div><div class="mb-2"><label for="account_number" class="form-label"><%= L('Account / mobile number', 'অ্যাকাউন্ট / মোবাইল নম্বর') %></label><input id="account_number" name="account_number" class="form-control" maxlength="64" autocomplete="off" required></div><div id="bank-fields" hidden><div class="mb-2"><label for="bank_name" class="form-label"><%= L('Bank name', 'ব্যাংকের নাম') %></label><input id="bank_name" name="bank_name" class="form-control" maxlength="191"></div><div class="mb-2"><label for="branch" class="form-label"><%= L('Branch', 'শাখা') %></label><input id="branch" name="branch" class="form-control" maxlength="191"></div><div class="mb-2"><label for="routing_number" class="form-label"><%= L('Routing number (optional)', 'রাউটিং নম্বর (ঐচ্ছিক)') %></label><input id="routing_number" name="routing_number" class="form-control" maxlength="32"></div></div><button class="btn btn-outline-primary" type="submit"><%= L('Submit for verification', 'যাচাইয়ের জন্য জমা দিন') %></button></form>
<% if (payouts && payouts.length) { %><hr><h3 class="h6"><%= L('Saved accounts', 'সংরক্ষিত অ্যাকাউন্ট') %></h3><ul><% payouts.forEach(function(p){ %><li><%= p.method %> · <%= p.masked_account %> · <%= p.verification_status %></li><% }) %></ul><% } %></div></section></div>
<section class="card p-3 mt-3"><h2 class="h5"><%= L('Status history', 'অবস্থার ইতিহাস') %></h2><div class="table-responsive"><table class="table"><thead><tr><th><%= L('From', 'আগে') %></th><th><%= L('To', 'পরে') %></th><th><%= L('Reason', 'কারণ') %></th><th><%= L('Date', 'তারিখ') %></th></tr></thead><tbody><% (history||[]).forEach(function(h){ %><tr><td><%= h.from_status||'—' %></td><td><%= h.to_status %></td><td><%= h.reason %></td><td><%= String(h.created_at).slice(0,19) %></td></tr><% }) %></tbody></table></div></section>
</main><script>document.getElementById('method').addEventListener('change',e=>{document.getElementById('bank-fields').hidden=e.target.value!=='bank'});</script><%- include('partials/layout-bottom') %>
