<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'bn' %>">
  <head>
    <meta charset="utf-8" />
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
    <title><%= typeof title !== 'undefined' ? title : 'এফিলিয়েট পোর্টাল' %> — <%= typeof siteSettings !== 'undefined' ? siteSettings.site_name : 'Mr. Tumi' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon) || '/uploads/brand/mrtumi-placeholder-favicon.svg' %>" />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="/backEnd/css/ubold-admin.css" rel="stylesheet" />
    <link href="/shared/css/mrtumi-design-system.css" rel="stylesheet" />
  </head>
  <body data-theme="light" data-topbar-color="dark" data-leftbar-color="dark">
    <div id="wrapper">
      <header class="navbar-custom" style="background: #111827;" role="banner">
        <div class="container-fluid">
          <ul class="list-unstyled topnav-menu float-end mb-0 d-flex align-items-center">
            <li class="d-none d-sm-flex align-items-center px-2">
              <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                💰 ৳<%= typeof balanceBdt !== 'undefined' ? balanceBdt.toLocaleString('en-IN') : '0' %>
              </span>
            </li>
            <li class="dropdown notification-list topbar-dropdown">
              <a class="nav-link dropdown-toggle nav-user me-0" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                <img src="/uploads/default/user.svg" alt="Affiliate" class="rounded-circle" />
                <span class="pro-user-name ms-1"><%= (typeof affiliate !== 'undefined' && affiliate.name) || 'Affiliate' %> <i class="fas fa-chevron-down ms-1" style="font-size:10px;"></i></span>
              </a>
              <div class="dropdown-menu dropdown-menu-end profile-dropdown">
                <a href="/affiliate/dashboard" class="dropdown-item notify-item"><i class="fas fa-chart-line me-2"></i>ড্যাশবোর্ড</a>
                <a href="/affiliate/withdrawals" class="dropdown-item notify-item"><i class="fas fa-wallet me-2"></i>উইথড্রয়াল</a>
                <div class="dropdown-divider"></div>
                <form action="/affiliate/logout" method="POST">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <button type="submit" class="dropdown-item notify-item text-danger border-0 bg-transparent w-100 text-start">
                    <i class="fas fa-sign-out-alt me-2"></i>লগআউট
                  </button>
                </form>
              </div>
            </li>
          </ul>

          <div class="logo-box" style="background: rgba(0,0,0,0.2);">
            <a href="/affiliate/dashboard" class="logo logo-light text-center">
              <span class="logo-lg"><img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_light) || '/uploads/brand/mrtumi-placeholder-logo.svg' %>" alt="Mr. Tumi" height="42" /></span>
            </a>
          </div>

          <ul class="list-unstyled topnav-menu topnav-menu-left m-0">
            <li>
              <button class="button-menu-mobile" type="button" aria-label="Toggle Sidebar"><i class="fas fa-bars"></i></button>
            </li>
            <li class="d-none d-sm-flex align-items-center">
              <span class="badge bg-primary-subtle text-primary ms-2 px-2.5 py-1 fw-bold">💼 এফিলিয়েট পার্টনার পোর্টাল</span>
            </li>
            <li class="d-flex">
              <a class="nav-link" href="/" target="_blank" rel="noopener"><i class="fas fa-external-link-alt me-1"></i><span>মেইন স্টোর</span></a>
            </li>
          </ul>
        </div>
      </header>

      <aside class="left-side-menu" style="background: #1f2937;" aria-label="Affiliate Navigation">
        <div class="h-100 pt-2">
          <nav id="sidebar-menu">
            <ul id="side-menu">
              <li><a href="/affiliate/dashboard"><i class="fas fa-tachometer-alt me-2"></i><span>ড্যাশবোর্ড</span></a></li>
              <li><a href="/affiliate/links"><i class="fas fa-link me-2"></i><span>এফিলিয়েট লিংক ও প্রমোশন</span></a></li>
              <li><a href="/affiliate/commissions"><i class="fas fa-coins me-2"></i><span>কমিশন হিস্ট্রি</span></a></li>
              <li><a href="/affiliate/withdrawals"><i class="fas fa-hand-holding-usd me-2"></i><span>টাকা উত্তোলন (Withdraw)</span></a></li>
            </ul>
          </nav>
        </div>
      </aside>

      <main id="mainContent" class="content-page">
        <div class="content py-3 px-3 px-md-4">
