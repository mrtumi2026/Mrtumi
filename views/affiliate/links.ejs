<% const L = (en, bn) => (typeof locale !== 'undefined' && locale === 'en' ? en : bn); %>
<%- include('partials/layout-top', { title: L('Affiliate links and promotion', 'এফিলিয়েট লিংক ও প্রমোশন') }) %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <h4 class="fw-bold mb-0"><%= L('🔗 Affiliate link generator and promotion', '🔗 এফিলিয়েট লিংক জেনারেটর ও প্রমোশন') %></h4>
    <p class="text-muted small mb-0"><%= L('Make your personal affiliate link from any product or offer link', 'যেকোনো পণ্য বা অফারের লিংক দিয়ে মুহূর্তেই আপনার পার্সোনাল এফিলিয়েট লিংক তৈরি করুন') %></p>
  </div>
  <a href="/affiliate/dashboard" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i><%= L('Dashboard', 'ড্যাশবোর্ড') %></a>
</div>

<!-- Link Generator Form -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-header bg-white py-3 border-0">
    <h5 class="card-title h6 mb-0 fw-bold"><i class="fas fa-magic text-primary me-2"></i><%= L('Create a custom affiliate link', 'কাস্টম এফিলিয়েট লিংক তৈরি করুন') %></h5>
  </div>
  <div class="card-body">
    <form action="/affiliate/links/create" method="POST" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      
      <div class="col-md-8">
        <label class="form-label small fw-semibold"><%= L('Target web link (product or campaign URL)', 'টার্গেট ওয়েব লিংক (পণ্য বা ক্যাম্পেইন URL)') %></label>
        <input type="text" name="target_url" class="form-control" placeholder="<%= L('e.g. https://mrtumi.com/product/mango-fresh or /campaign/summer-fest', 'যেমন: https://mrtumi.com/product/mango-fresh বা /campaign/summer-fest') %>" required>
        <small class="text-muted"><%= L('You can paste the link of any page, category or product of the store.', 'আপনি স্টোরের যেকোনো পেজ, ক্যাটাগরি বা পণ্যের লিংক পেস্ট করতে পারেন।') %></small>
      </div>

      <div class="col-md-4">
        <label class="form-label small fw-semibold"><%= L('Link type', 'লিংকের ধরন') %></label>
        <select name="target_type" class="form-select">
          <option value="product"><%= L('Product', 'পণ্য (Product)') %></option>
          <option value="campaign"><%= L('Campaign', 'ক্যাম্পেইন (Campaign)') %></option>
          <option value="storefront"><%= L('Home page / general (Storefront)', 'হোমপেজ / সাধারণ (Storefront)') %></option>
        </select>
      </div>

      <div class="col-12 text-end">
        <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="fas fa-link me-1"></i><%= L('Generate affiliate link', 'এফিলিয়েট লিংক জেনারেট করুন') %></button>
      </div>
    </form>
  </div>
</div>

<!-- All Created Links Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-header bg-white py-3 border-0">
    <h5 class="card-title h6 mb-0 fw-bold"><i class="fas fa-list text-success me-2"></i><%= L('Your active promotion links', 'আপনার সক্রিয় প্রমোশনাল লিংকসমূহ') %></h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th><%= L('Type', 'ধরন') %></th>
            <th><%= L('Affiliate link', 'এফিলিয়েট লিংক') %></th>
            <th><%= L('Total clicks', 'মোট ক্লিক') %></th>
            <th><%= L('Total sales', 'মোট বিক্রয় (Sales)') %></th>
            <th><%= L('Action', 'অ্যাকশন') %></th>
          </tr>
        </thead>
        <tbody>
          <% links.forEach(function(l, idx) { %>
            <tr>
              <td><span class="badge bg-light text-dark border text-uppercase"><%= l.target_type %></span></td>
              <td>
                <span class="d-inline-block text-truncate fw-semibold" style="max-width: 420px;">
                  <%= l.target_url %>
                </span>
                <input type="hidden" id="fullLinkVal<%= idx %>" value="<%= l.target_url %>">
              </td>
              <td><span class="badge bg-secondary px-2.5 py-1"><%= l.clicks_count %></span></td>
              <td><span class="badge bg-success px-2.5 py-1"><%= l.conversions_count %><%= L('', ' টি') %></span></td>
              <td>
                <div class="d-flex gap-1">
                  <button class="btn btn-sm btn-outline-primary" onclick="copyDirect('fullLinkVal<%= idx %>')">
                    <i class="far fa-copy me-1"></i><%= L('Copy', 'কপি') %>
                  </button>
                  <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(L('Shop at the best price on Mr. Tumi: ', 'Mr. Tumi তে সেরা দামে কেনাকাটা করুন: ') + l.target_url) %>" target="_blank" rel="noopener" class="btn btn-sm btn-success" style="background:#25D366; border-color:#25D366;">
                    <i class="fab fa-whatsapp"></i>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
function copyDirect(id) {
  const el = document.getElementById(id);
  if (!el) return;
  navigator.clipboard.writeText(el.value).then(() => {
    alert(<%- JSON.stringify(L('Affiliate link copied to the clipboard!', 'এফিলিয়েট লিংকটি ক্লিপবোর্ডে কপি করা হয়েছে!')).replace(/</g, '\\u003c') %>);
  });
}
</script>

<%- include('partials/layout-bottom') %>
