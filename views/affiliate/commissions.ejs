<%- include('partials/layout-top', { title: 'কমিশন হিস্ট্রি' }) %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <h4 class="fw-bold mb-0">🪙 এফিলিয়েট কমিশন হিস্ট্রি</h4>
    <p class="text-muted small mb-0">আপনার ডিরেক্ট সেলস (Tier 1) এবং সাব-এফিলিয়েট টিম বিক্রয় (Tier 2) থেকে অর্জিত কমিশন</p>
  </div>
  <a href="/affiliate/dashboard" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>ড্যাশবোর্ড</a>
</div>

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-header bg-white py-3 border-0">
    <h5 class="card-title h6 mb-0 fw-bold"><i class="fas fa-list-alt text-primary me-2"></i>কমিশন ট্রানজ্যাকশন লেজার</h5>
  </div>
  <div class="card-body p-0">
    <% if (!commissions || commissions.length === 0) { %>
      <div class="p-5 text-center text-muted">
        <i class="fas fa-coins fa-3x text-muted mb-3 opacity-25"></i>
        <h6>এখনও কোনো কমিশন রেকর্ড নেই</h6>
        <p class="small text-muted mb-0">আপনার এফিলিয়েট লিংক ও সাব-এফিলিয়েট ইনভাইট লিংক শেয়ার করুন।</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>তারিখ</th>
              <th>অর্ডার আইডি</th>
              <th>টিয়ার লেভেল</th>
              <th>অর্ডারের মোট মূল্য</th>
              <th>কমিশন রেট</th>
              <th>অর্জিত কমিশন</th>
              <th>অবস্থা</th>
            </tr>
          </thead>
          <tbody>
            <% commissions.forEach(function(c) { %>
              <tr>
                <td><%= new Date(c.created_at).toLocaleDateString('bn-BD') %></td>
                <td><strong>#<%= c.order_id %></strong></td>
                <td>
                  <% if (c.tier === 2) { %>
                    <span class="badge bg-info-subtle text-info border border-info-subtle">Tier-2 (Team Override)</span>
                  <% } else { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Tier-1 (Direct Sale)</span>
                  <% } %>
                </td>
                <td>৳<%= Math.round(Number(c.sale_amount_paisa || 0) / 100).toLocaleString('en-IN') %></td>
                <td><%= (Number(c.rate_bps || 500) / 100).toFixed(1) %>%</td>
                <td>
                  <strong class="text-success">+৳<%= Math.round(Number(c.commission_paisa || 0) / 100).toLocaleString('en-IN') %></strong>
                </td>
                <td>
                  <% if (c.status === 'approved') { %>
                    <span class="badge bg-success-subtle text-success">✓ অ্যাকাউন্টে জমা</span>
                  <% } else if (c.status === 'rejected') { %>
                    <span class="badge bg-danger-subtle text-danger">বাতিল</span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning">⏳ ডেলিভারি অপেক্ষমাণ</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/layout-bottom') %>
