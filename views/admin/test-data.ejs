<%- include('partials/head',{title:locale==='bn'?'টেস্ট ডেটা ব্যবস্থাপনা':'Test Data Management'}) %><%- include('partials/topbar') %><%- include('partials/sidebar') %>
<div class="content-page"><div class="content"><div class="container-fluid py-3">
<h1 class="h4"><%= locale==='bn'?'টেস্ট ডেটা ব্যবস্থাপনা':'Test Data Management' %></h1>
<p class="text-muted"><%= locale==='bn'?'শুধু স্পষ্টভাবে চিহ্নিত রেকর্ড এখানে আসবে। পুরোনো রেকর্ড নাম বা ইমেইল দেখে টেস্ট হিসেবে ধরা হয় না।':'Only explicitly marked records appear here. Existing records are never inferred to be test data from names or email patterns.' %></p>
<div class="card p-3 mb-3"><h2 class="h6"><%= locale==='bn'?'নতুন টেস্ট গ্রুপ':'Create a test-data group' %></h2><form method="post" action="/admin/test-data/groups" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="col-md-4"><label class="form-label" for="group-label"><%= locale==='bn'?'গ্রুপের নাম':'Group label' %></label><input id="group-label" class="form-control" name="label" maxlength="191" required></div><div class="col-md-6"><label class="form-label" for="group-desc"><%= locale==='bn'?'বর্ণনা':'Description' %></label><input id="group-desc" class="form-control" name="description" maxlength="500"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100"><%= locale==='bn'?'গ্রুপ তৈরি':'Create group' %></button></div></form></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><label class="visually-hidden" for="group-search">Search groups</label><input id="group-search" class="form-control" name="q" value="<%= query %>" placeholder="<%= locale==='bn'?'গ্রুপ খুঁজুন':'Search group key or label' %>"></div><div class="col-md-3"><label class="visually-hidden" for="group-status">Status</label><select id="group-status" name="status" class="form-select"><option value=""><%= locale==='bn'?'সব অবস্থা':'All statuses' %></option><% ['active','cleaned','partially_cleaned'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="col-md-2"><button class="btn btn-outline-primary"><%= locale==='bn'?'ফিল্টার':'Filter' %></button></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>ID / Key</th><th><%= locale==='bn'?'গ্রুপ':'Group' %></th><th><%= locale==='bn'?'উৎস / অবস্থা':'Source / Status' %></th><th><%= locale==='bn'?'রেকর্ড সংখ্যা':'Marked records' %></th><th><%= locale==='bn'?'তৈরি':'Created' %></th><th></th></tr></thead><tbody><% if(!groups.length){ %><tr><td colspan="6" class="text-center text-muted p-4"><%= locale==='bn'?'কোনো টেস্ট গ্রুপ নেই':'No test-data groups' %></td></tr><% } groups.forEach(g=>{ %><tr><td>#<%= g.id %><br><small><code><%= g.group_key %></code></small></td><td><strong><%= g.label %></strong><br><small><%= g.description||'' %></small></td><td><span class="badge bg-secondary"><%= g.source %></span> <span class="badge <%= g.status==='active'?'bg-warning text-dark':'bg-success' %>"><%= g.status %></span></td><td>Customers <%= g.customers %> · Vendors <%= g.vendors %> · Products <%= g.products %> · Categories <%= g.categories %> · Orders <%= g.orders %></td><td><%= g.created_at %></td><td><a class="btn btn-sm btn-outline-primary" href="/admin/test-data/groups/<%= g.id %>"><%= locale==='bn'?'পরিদর্শন':'Inspect' %></a></td></tr><% }) %></tbody></table></div></div>
<p class="small text-muted mt-3"><%= locale==='bn'?'আর্থিক ও অর্ডার-ইতিহাসযুক্ত রেকর্ড স্বয়ংক্রিয়ভাবে মোছা হয় না; প্রিভিউতে সুরক্ষিত নির্ভরতা দেখানো হয়।':'Order, financial, return and audit history is not silently deleted; protected dependencies are shown in the preview.' %></p>
</div></div><%- include('partials/footer') %>
