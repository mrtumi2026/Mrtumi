<%- include('partials/head', { title: 'Payment Gateways' }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>
<div class="content-page">
  <div class="content">
    <div class="container-fluid py-3">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
          <h1 class="h3 fw-bold mb-1">Payment Gateways</h1>
          <p class="text-muted mb-0">Manage COD and manual MFS receiving details shown to customers at checkout.</p>
        </div>
        <span class="badge bg-light text-dark border"><%= rows.length %> gateways</span>
      </div>

      <% if (!rows.length) { %>
        <div class="alert alert-info">No payment gateways are configured yet.</div>
      <% } %>

      <div class="row g-3">
        <% rows.forEach(function(gateway) {
          const isManual = gateway.gateway_type === 'manual';
          const brand = String(gateway.code || '').replace(/^manual_/, '').toLowerCase();
          const isMfs = isManual && ['bkash', 'nagad', 'rocket'].includes(brand);
          const heading = gateway.code === 'cod' ? 'Cash on Delivery (COD)' : (isMfs ? (brand === 'bkash' ? 'bKash' : brand.charAt(0).toUpperCase() + brand.slice(1)) : gateway.name);
        %>
          <div class="col-12 col-xl-6">
            <section class="card h-100 shadow-sm border-0">
              <div class="card-header bg-white d-flex align-items-center justify-content-between gap-2">
                <div>
                  <h2 class="h5 fw-bold mb-1"><%= heading %></h2>
                  <div class="small text-muted">Code: <code><%= gateway.code %></code> · <%= isManual ? 'Manual payment' : 'Automatic / COD' %></div>
                </div>
                <span class="badge <%= Number(gateway.status) === 1 ? 'bg-success' : 'bg-secondary' %>"><%= Number(gateway.status) === 1 ? 'Active' : 'Inactive' %></span>
              </div>
              <div class="card-body">
                <form method="POST" action="/admin/payment-gateways/<%= gateway.id %>/update" class="gateway-update-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="mb-3">
                    <label class="form-label fw-semibold" for="gateway-account-<%= gateway.id %>">Receiving Account Number</label>
                    <input id="gateway-account-<%= gateway.id %>" name="account_number" type="text" class="form-control" maxlength="100" value="<%= gateway.account_number || '' %>" placeholder="017XXXXXXXX" autocomplete="off" <%= isMfs ? 'aria-describedby="gateway-account-help-' + gateway.id + '"' : '' %>>
                    <% if (isMfs) { %><div id="gateway-account-help-<%= gateway.id %>" class="form-text">Customers will see this account after selecting <%= heading %>.</div><% } else if (gateway.code === 'cod') { %><div class="form-text">Optional for Cash on Delivery.</div><% } %>
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold" for="gateway-instructions-<%= gateway.id %>">Customer Instructions</label>
                    <textarea id="gateway-instructions-<%= gateway.id %>" name="instructions" class="form-control" rows="3" maxlength="4000" placeholder="Send Money (Personal) to 017XXXXXXXX and enter your sender number and TrxID."><%= gateway.instructions || '' %></textarea>
                    <% if (isMfs) { %><div class="form-text">Instructions and account details are displayed when this method is selected at checkout.</div><% } %>
                  </div>
                  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="flex-grow-1" style="max-width:220px;">
                      <label class="form-label fw-semibold" for="gateway-status-<%= gateway.id %>">Status</label>
                      <select id="gateway-status-<%= gateway.id %>" name="status" class="form-select" required>
                        <option value="1" <%= Number(gateway.status) === 1 ? 'selected' : '' %>>Active</option>
                        <option value="0" <%= Number(gateway.status) !== 1 ? 'selected' : '' %>>Inactive</option>
                      </select>
                    </div>
                    <button type="submit" class="btn btn-success mt-auto">Save Changes</button>
                  </div>
                </form>
              </div>
            </section>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
