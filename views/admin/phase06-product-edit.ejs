<%- include('partials/head', { title: pageTitle }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>
<div class="content-page"><main class="content container-fluid py-3" id="mainContent">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><h1 class="h3 mb-1"><%= pageTitle %></h1><p class="text-muted mb-0"><%= locale === 'en' ? 'Edit catalog metadata without changing stock, identifiers, or existing variant rows.' : 'স্টক, পরিচিতি বা বিদ্যমান ভ্যারিয়েন্ট না বদলে পণ্যের তথ্য সম্পাদনা করুন।' %></p></div>
    <a href="/admin/phase06#products" class="btn btn-outline-secondary"><%= locale === 'en' ? 'Back to inventory' : 'ইনভেন্টরিতে ফিরুন' %></a>
  </div>
  <% if (Number(product.is_archived)) { %><div class="alert alert-warning"><%= locale === 'en' ? 'This product is archived. Restore it before editing.' : 'পণ্যটি আর্কাইভ করা। সম্পাদনার আগে পুনরুদ্ধার করুন।' %></div><% } %>
  <div class="alert alert-info"><%= locale === 'en' ? 'SKU/barcode, warehouse/vendor stock, reservations, approval state, and variant rows are intentionally read-only here. Price edits update only the parent product; variant-specific prices remain unchanged.' : 'SKU/barcode, গুদাম/বিক্রেতার স্টক, রিজার্ভেশন, অনুমোদন অবস্থা এবং ভ্যারিয়েন্ট এখানে অপরিবর্তিত থাকবে। মূল পণ্যের দাম বদলালেও ভ্যারিয়েন্টের আলাদা দাম বদলাবে না।' %></div>
  <section class="card shadow-sm"><div class="card-header"><h2 class="h5 mb-0"><%= locale === 'en' ? 'Catalog details' : 'ক্যাটালগের বিবরণ' %></h2></div><div class="card-body">
    <form method="post" action="/admin/phase06/products/<%= product.id %>" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-3"><label class="form-label" for="edit-sku">SKU</label><input class="form-control" id="edit-sku" value="<%= product.sku %>" readonly></div>
      <div class="col-md-3"><label class="form-label" for="edit-barcode"><%= locale === 'en' ? 'Barcode' : 'বারকোড' %></label><input class="form-control" id="edit-barcode" value="<%= product.barcode || '' %>" readonly></div>
      <div class="col-md-3"><label class="form-label" for="edit-stock"><%= locale === 'en' ? 'Warehouse stock (read-only)' : 'গুদামের স্টক (শুধু দেখুন)' %></label><input class="form-control" id="edit-stock" value="<%= product.stock_on_hand %>" readonly></div>
      <div class="col-md-3"><label class="form-label" for="edit-vendor-stock"><%= locale === 'en' ? 'Vendor stock (read-only)' : 'বিক্রেতার স্টক (শুধু দেখুন)' %></label><input class="form-control" id="edit-vendor-stock" value="<%= product.vendor_stock_on_hand %>" readonly></div>
      <div class="col-md-6"><label class="form-label" for="edit-name-bn"><%= locale === 'en' ? 'Name (Bangla)' : 'পণ্যের নাম (বাংলা)' %> *</label><input class="form-control" id="edit-name-bn" name="name_bn" maxlength="255" required value="<%= product.name_bn %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-name-en"><%= locale === 'en' ? 'Name (English)' : 'পণ্যের নাম (ইংরেজি)' %></label><input class="form-control" id="edit-name-en" name="name_en" maxlength="255" value="<%= product.name_en || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-slug">Slug *</label><input class="form-control" id="edit-slug" name="slug" maxlength="191" required value="<%= product.slug %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-type"><%= locale === 'en' ? 'Product type' : 'পণ্যের ধরন' %></label><input class="form-control" id="edit-type" name="product_type" maxlength="32" required value="<%= product.product_type || 'grocery' %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-category"><%= locale === 'en' ? 'Active category' : 'সক্রিয় ক্যাটাগরি' %> *</label><select class="form-select" id="edit-category" name="category_id" required><% if (!categories.some(function(c) { return Number(c.id) === Number(product.category_id); })) { %><option value="__current_inactive__" selected><%= locale === 'en' ? 'Current category is inactive or unavailable; choose an active category' : 'বর্তমান ক্যাটাগরি নিষ্ক্রিয়/অনুপলব্ধ; সক্রিয় ক্যাটাগরি বাছুন' %></option><% } %><% categories.forEach(function(c) { %><option value="<%= c.id %>" <%= Number(c.id) === Number(product.category_id) ? 'selected' : '' %>><%= c.name_bn %><%= c.name_en ? ` / ${c.name_en}` : '' %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label" for="edit-subcategory"><%= locale === 'en' ? 'Active subcategory (optional)' : 'সক্রিয় সাব-ক্যাটাগরি (ঐচ্ছিক)' %></label><select class="form-select" id="edit-subcategory" name="subcategory_id" aria-describedby="edit-taxonomy-help"><option value="" <%= !product.subcategory_id ? 'selected' : '' %>><%= locale === 'en' ? 'No subcategory' : 'সাব-ক্যাটাগরি নেই' %></option><% subcategories.forEach(function(c) { %><option value="<%= c.id %>" data-category-id="<%= c.category_id %>" <%= Number(c.id) === Number(product.subcategory_id) ? 'selected' : '' %>><%= c.name_bn %><%= c.name_en ? ` / ${c.name_en}` : '' %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label" for="edit-childcategory"><%= locale === 'en' ? 'Active child category (optional)' : 'সক্রিয় চাইল্ড ক্যাটাগরি (ঐচ্ছিক)' %></label><select class="form-select" id="edit-childcategory" name="childcategory_id" aria-describedby="edit-taxonomy-help"><option value="" <%= !product.childcategory_id ? 'selected' : '' %>><%= locale === 'en' ? 'No child category' : 'চাইল্ড ক্যাটাগরি নেই' %></option><% childcategories.forEach(function(c) { %><option value="<%= c.id %>" data-subcategory-id="<%= c.subcategory_id %>" <%= Number(c.id) === Number(product.childcategory_id) ? 'selected' : '' %>><%= c.name_bn %><%= c.name_en ? ` / ${c.name_en}` : '' %></option><% }) %></select></div>
      <p id="edit-taxonomy-help" class="form-text"><%= locale === 'en' ? 'Choose parents in order; changing a parent clears invalid descendants.' : 'ধাপে ধাপে প্যারেন্ট বাছুন; প্যারেন্ট বদলালে অনুপযুক্ত অধীন নির্বাচন মুছে যাবে।' %></p>
      <div class="col-md-6"><label class="form-label" for="edit-brand"><%= locale === 'en' ? 'Brand (optional)' : 'ব্র্যান্ড (ঐচ্ছিক)' %></label><select class="form-select" id="edit-brand" name="brand_id"><% if (product.brand_id && !brands.some(function(b) { return Number(b.id) === Number(product.brand_id); })) { %><option value="__current_inactive__" selected><%= locale === 'en' ? 'Current brand is inactive or unavailable; choose a replacement or No brand' : 'বর্তমান ব্র্যান্ড নিষ্ক্রিয়/অনুপলব্ধ; নতুন ব্র্যান্ড অথবা ব্র্যান্ড নেই বাছুন' %></option><% } %><option value="" <%= !product.brand_id ? 'selected' : '' %>><%= locale === 'en' ? 'No brand' : 'ব্র্যান্ড নেই' %></option><% brands.forEach(function(b) { %><option value="<%= b.id %>" <%= Number(b.id) === Number(product.brand_id) ? 'selected' : '' %>><%= b.name_bn %><%= b.name_en ? ` / ${b.name_en}` : '' %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label" for="edit-unit"><%= locale === 'en' ? 'Unit label' : 'এককের নাম' %> *</label><input class="form-control" id="edit-unit" name="unit_label" maxlength="50" required value="<%= product.unit_label || '' %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-regular"><%= locale === 'en' ? 'Regular price (BDT)' : 'নিয়মিত দাম (টাকা)' %> *</label><input class="form-control" id="edit-regular" name="regular_price_bdt" type="number" min="0" step="0.01" required value="<%= paisaToBdtString(Number(product.regular_price_paisa || 0)) %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-sale"><%= locale === 'en' ? 'Sale price (BDT)' : 'বিক্রয় দাম (টাকা)' %> *</label><input class="form-control" id="edit-sale" name="sale_price_bdt" type="number" min="0" step="0.01" required value="<%= paisaToBdtString(Number(product.sale_price_paisa || 0)) %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-cost"><%= locale === 'en' ? 'Cost price (BDT)' : 'ক্রয় দাম (টাকা)' %> *</label><input class="form-control" id="edit-cost" name="cost_price_bdt" type="number" min="0" step="0.01" required value="<%= paisaToBdtString(Number(product.cost_price_paisa || 0)) %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-wholesale"><%= locale === 'en' ? 'Wholesale price (BDT)' : 'পাইকারি দাম (টাকা)' %></label><input class="form-control" id="edit-wholesale" name="wholesale_price_bdt" type="number" min="0" step="0.01" value="<%= paisaToBdtString(Number(product.wholesale_price_paisa || 0)) %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-min"><%= locale === 'en' ? 'Wholesale minimum quantity' : 'পাইকারি ন্যূনতম পরিমাণ' %></label><input class="form-control" id="edit-min" name="wholesale_min_qty" type="number" min="0" step="1" value="<%= product.wholesale_min_qty || 0 %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-threshold"><%= locale === 'en' ? 'Low-stock alert threshold' : 'কম স্টকের সতর্কতা সীমা' %></label><input class="form-control" id="edit-threshold" name="low_stock_threshold" type="number" min="0" step="1" value="<%= product.low_stock_threshold || 0 %>"></div>
      <div class="col-md-8"><label class="form-label" for="edit-image"><%= locale === 'en' ? 'Primary image URL/path' : 'প্রধান ছবির URL/পাথ' %></label><input class="form-control" id="edit-image" name="image_url" maxlength="500" value="<%= product.image_url || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-short-bn"><%= locale === 'en' ? 'Short description (Bangla)' : 'সংক্ষিপ্ত বিবরণ (বাংলা)' %></label><textarea class="form-control" id="edit-short-bn" name="short_desc_bn" maxlength="2000" rows="3"><%= product.short_desc_bn || '' %></textarea></div>
      <div class="col-md-6"><label class="form-label" for="edit-short-en"><%= locale === 'en' ? 'Short description (English)' : 'সংক্ষিপ্ত বিবরণ (ইংরেজি)' %></label><textarea class="form-control" id="edit-short-en" name="short_desc_en" maxlength="2000" rows="3"><%= product.short_desc_en || '' %></textarea></div>
      <div class="col-md-6"><label class="form-label" for="edit-desc-bn"><%= locale === 'en' ? 'Description (Bangla)' : 'বিস্তারিত (বাংলা)' %></label><textarea class="form-control" id="edit-desc-bn" name="description_bn" maxlength="20000" rows="6"><%= product.description_bn || '' %></textarea></div>
      <div class="col-md-6"><label class="form-label" for="edit-desc-en"><%= locale === 'en' ? 'Description (English)' : 'বিস্তারিত (ইংরেজি)' %></label><textarea class="form-control" id="edit-desc-en" name="description_en" maxlength="20000" rows="6"><%= product.description_en || '' %></textarea></div>
      <div class="col-12 d-flex gap-2"><button class="btn btn-success" type="submit" <%= Number(product.is_archived) ? 'disabled' : '' %>><%= locale === 'en' ? 'Save catalog changes' : 'পরিবর্তন সংরক্ষণ' %></button><a class="btn btn-outline-secondary" href="/admin/phase06"><%= locale === 'en' ? 'Cancel' : 'বাতিল' %></a></div>
    </form>
  </div></section>
  <section class="card shadow-sm mt-4" id="gallery"><div class="card-header"><h2 class="h5 mb-0"><%= locale === 'en' ? 'Product gallery order' : 'পণ্যের গ্যালারির ক্রম' %></h2></div><div class="card-body">
    <p class="text-muted"><%= locale === 'en' ? 'Upload safe raster images to this product’s gallery. The upload is assigned only after validation and the database/audit transaction succeed. Existing or shared files are never deleted.' : 'নিরাপদ raster ছবি এই পণ্যের গ্যালারিতে আপলোড করুন। যাচাই এবং ডেটাবেস/অডিট লেনদেন সফল হলেই ছবি যুক্ত হবে। বিদ্যমান বা শেয়ার করা ফাইল কখনো মুছে ফেলা হয় না।' %></p>
    <% if (!galleryBlockedCount && !Number(product.is_archived)) { %><form method="post" enctype="multipart/form-data" action="/admin/phase06/products/<%= product.id %>/gallery/upload" class="row g-2 align-items-end border rounded p-3 mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-9"><label class="form-label" for="gallery-upload-files"><%= locale==='en'?'Raster images (JPEG, PNG, WebP, GIF; up to 6)':'Raster ছবি (JPEG, PNG, WebP, GIF; সর্বোচ্চ ৬টি)' %></label><input class="form-control" id="gallery-upload-files" type="file" name="gallery_images" accept="image/jpeg,image/png,image/webp,image/gif" multiple required></div><div class="col-md-3"><button class="btn btn-primary" type="submit"><%= locale==='en'?'Upload and assign':'আপলোড ও যুক্ত করুন' %></button></div><p class="small text-muted mb-0"><%= locale==='en'?'SVG and executable files are rejected. The first uploaded image becomes the primary image when none exists.':'SVG ও executable ফাইল প্রত্যাখ্যান করা হয়। আগে প্রধান ছবি না থাকলে প্রথম আপলোড করা ছবি প্রধান হবে।' %></p></form><% } %>
    <% if (galleryBlockedCount) { %><div class="alert alert-warning"><%= locale === 'en' ? `${galleryBlockedCount} existing gallery reference(s) are outside the editable safe-image set or missing. Paths are hidden; no change is allowed until reviewed.` : `${galleryBlockedCount}টি গ্যালারি রেফারেন্স নিরাপদ সম্পাদনযোগ্য ছবির তালিকার বাইরে বা অনুপস্থিত। পাথ দেখানো হচ্ছে না; পর্যালোচনা না হওয়া পর্যন্ত পরিবর্তন বন্ধ।` %></div>
    <% } else if (!galleryPaths.length) { %><div class="alert alert-secondary"><%= locale === 'en' ? 'No existing approved gallery images are available to reorder yet. Upload safe raster files above to assign gallery images.' : 'ক্রম সাজানোর মতো অনুমোদিত গ্যালারি ছবি নেই। উপরে নিরাপদ raster ফাইল আপলোড করে ছবি যুক্ত করুন।' %></div>
    <% } else { %><form method="post" action="/admin/phase06/products/<%= product.id %>/gallery" class="vstack gap-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="form-label" for="gallery-paths"><%= locale === 'en' ? 'Existing image paths (one per line; keep the complete list)' : 'বিদ্যমান ছবির পাথ (প্রতি লাইনে একটি; সম্পূর্ণ তালিকা রাখুন)' %></label>
      <textarea class="form-control font-monospace" id="gallery-paths" name="gallery_paths" rows="<%= Math.min(8, Math.max(2, galleryPaths.length)) %>" required <%= Number(product.is_archived) ? 'disabled' : '' %>><%= galleryPaths.join('\n') %></textarea>
      <small class="text-muted"><%= locale === 'en' ? 'Only the product’s current existing raster files under /uploads/product/ or /uploads/custom/ are accepted, exactly once. No new/cross-product path is accepted.' : 'শুধু এই পণ্যের বর্তমান বিদ্যমান raster ফাইল /uploads/product/ অথবা /uploads/custom/ থেকে ঠিক একবার গ্রহণযোগ্য। নতুন বা অন্য পণ্যের পাথ গ্রহণ করা হয় না।' %></small>
      <div><button class="btn btn-outline-success" type="submit" <%= Number(product.is_archived) ? 'disabled' : '' %>><%= locale === 'en' ? 'Save gallery order' : 'গ্যালারির ক্রম সংরক্ষণ' %></button></div>
    </form><% } %>
  </div></section>
  <section class="card shadow-sm mt-4" id="variants"><div class="card-header"><h2 class="h5 mb-0"><%= locale === 'en' ? 'Product variants' : 'পণ্যের ভ্যারিয়েন্ট' %></h2></div><div class="card-body">
    <p class="alert alert-info"><%= locale === 'en' ? 'Variant SKU is globally unique and immutable after creation. This schema has no variant barcode field. New variants start with zero stock; stock and reservations are read-only here. Deactivation preserves cart, order, reservation and ledger references; it only prevents new storefront selection.' : 'ভ্যারিয়েন্ট SKU পুরো সিস্টেমে অনন্য এবং তৈরির পর অপরিবর্তনীয়। এই স্কিমায় ভ্যারিয়েন্ট বারকোড ফিল্ড নেই। নতুন ভ্যারিয়েন্টের স্টক শূন্য; স্টক ও রিজার্ভেশন এখানে শুধু দেখা যাবে। নিষ্ক্রিয় করলেও কার্ট, অর্ডার, রিজার্ভেশন ও লেজার রেফারেন্স অক্ষত থাকে; শুধু নতুন storefront নির্বাচন বন্ধ হয়।' %></p>
    <% if (!Number(product.is_archived)) { %>
    <form method="post" action="/admin/phase06/products/<%= product.id %>/variants" class="row g-2 align-items-end border rounded p-3 mb-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-3"><label class="form-label" for="new-variant-sku"><%= locale === 'en' ? 'Variant SKU' : 'ভ্যারিয়েন্ট SKU' %> *</label><input class="form-control" id="new-variant-sku" name="variant_sku" maxlength="80" required></div>
      <div class="col-md-2"><label class="form-label" for="new-variant-size"><%= locale === 'en' ? 'Size / option' : 'সাইজ / অপশন' %></label><input class="form-control" id="new-variant-size" name="size_label" maxlength="80"></div>
      <div class="col-md-2"><label class="form-label" for="new-variant-color"><%= locale === 'en' ? 'Color / option' : 'রং / অপশন' %></label><input class="form-control" id="new-variant-color" name="color_label" maxlength="80"></div>
      <div class="col-md-2"><label class="form-label" for="new-variant-price"><%= locale === 'en' ? 'Price override (BDT; zero uses product price)' : 'দামের বিকল্প (টাকা; শূন্য হলে পণ্যের দাম)' %></label><input class="form-control" id="new-variant-price" name="price_bdt" type="number" min="0" step="0.01" value="0.00" required></div>
      <div class="col-md-3"><button class="btn btn-success" type="submit"><%= locale === 'en' ? 'Add variant (zero stock)' : 'ভ্যারিয়েন্ট যোগ করুন (স্টক শূন্য)' %></button></div>
    </form>
    <% } %>
    <% if (!variants.length) { %><p class="text-muted"><%= locale === 'en' ? 'No variants have been created.' : 'এখনো কোনো ভ্যারিয়েন্ট তৈরি হয়নি।' %></p><% } else { %>
    <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr>
      <th><%= locale === 'en' ? 'SKU' : 'SKU' %></th><th><%= locale === 'en' ? 'Size / option' : 'সাইজ / অপশন' %></th><th><%= locale === 'en' ? 'Color / option' : 'রং / অপশন' %></th>
      <th><%= locale === 'en' ? 'Price override (BDT)' : 'দামের বিকল্প (টাকা)' %></th><th><%= locale === 'en' ? 'On hand / reserved' : 'মজুত / রিজার্ভ' %></th><th><%= locale === 'en' ? 'Status' : 'অবস্থা' %></th><th><%= locale === 'en' ? 'Action' : 'কাজ' %></th>
    </tr></thead><tbody><% variants.forEach(function(v) { %><tr><td colspan="7"><form method="post" action="/admin/phase06/products/<%= product.id %>/variants/<%= v.id %>" class="row g-2 align-items-center">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-2"><input class="form-control" value="<%= v.variant_sku %>" readonly aria-label="Variant SKU"></div>
        <div class="col-md-2"><input class="form-control" name="size_label" maxlength="80" value="<%= v.size_label || '' %>" aria-label="Size or option" <%= Number(product.is_archived) ? 'disabled' : '' %>></div>
        <div class="col-md-2"><input class="form-control" name="color_label" maxlength="80" value="<%= v.color_label || '' %>" aria-label="Color or option" <%= Number(product.is_archived) ? 'disabled' : '' %>></div>
        <div class="col-md-2"><input class="form-control" name="price_bdt" type="number" min="0" step="0.01" value="<%= paisaToBdtString(Number(v.price_paisa || 0)) %>" aria-label="Variant price in BDT" <%= Number(product.is_archived) ? 'disabled' : '' %>></div>
        <div class="col-md-1 small"><%= Number(v.stock_on_hand || 0) %> / <%= Number(v.stock_reserved || 0) %></div>
        <div class="col-md-1"><select class="form-select" name="status" aria-label="Variant status" <%= Number(product.is_archived) ? 'disabled' : '' %>><option value="1" <%= Number(v.status) ? 'selected' : '' %>><%= locale === 'en' ? 'Active' : 'সক্রিয়' %></option><option value="0" <%= !Number(v.status) ? 'selected' : '' %>><%= locale === 'en' ? 'Inactive' : 'নিষ্ক্রিয়' %></option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-success btn-sm" type="submit" <%= Number(product.is_archived) ? 'disabled' : '' %>><%= locale === 'en' ? 'Save' : 'সংরক্ষণ' %></button></div>
      </form><form method="post" action="/admin/phase06/products/<%= product.id %>/variants/<%= v.id %>/stock" class="row g-2 align-items-center mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-2"><label class="visually-hidden" for="variant-stock-delta-<%= v.id %>"><%= locale==='en'?'Variant stock adjustment':'ভ্যারিয়েন্ট স্টক সমন্বয়' %></label><input id="variant-stock-delta-<%= v.id %>" class="form-control form-control-sm" type="number" name="qty_delta" step="1" required placeholder="<%= locale==='en'?'± quantity':'± পরিমাণ' %>" <%= Number(product.is_archived) ? 'disabled' : '' %>></div><div class="col-md-8"><label class="visually-hidden" for="variant-stock-reason-<%= v.id %>"><%= locale==='en'?'Reason':'কারণ' %></label><input id="variant-stock-reason-<%= v.id %>" class="form-control form-control-sm" name="reason" maxlength="255" required placeholder="<%= locale==='en'?'Required reason':'কারণ আবশ্যক' %>" <%= Number(product.is_archived) ? 'disabled' : '' %>></div><div class="col-md-2"><button class="btn btn-outline-warning btn-sm" type="submit" <%= Number(product.is_archived) ? 'disabled' : '' %>><%= locale==='en'?'Adjust stock':'স্টক সমন্বয়' %></button></div></form></td></tr><% }) %></tbody></table></div>
    <% } %>
  </div></section>
</main></div>
<script>
(function(){var category=document.getElementById('edit-category'),sub=document.getElementById('edit-subcategory'),child=document.getElementById('edit-childcategory');if(!category||!sub||!child)return;function filter(select,parentValue,parentKey){Array.from(select.options).forEach(function(o){if(!o.value)return;var matches=!!parentValue&&o.dataset[parentKey]===parentValue;o.hidden=!matches;o.disabled=!matches;});}function refreshChild(clear){if(clear)child.value='';filter(child,sub.value,'subcategoryId');}function refreshSub(clear){if(clear)sub.value='';filter(sub,category.value,'categoryId');refreshChild(clear);}category.addEventListener('change',function(){refreshSub(true);});sub.addEventListener('change',function(){refreshChild(true);});refreshSub(false);}
());
</script>
<%- include('partials/footer') %>
