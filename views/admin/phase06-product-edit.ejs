<%- include('partials/head', { title: pageTitle }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>
<div class="content-page"><main class="content container-fluid py-3" id="mainContent">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><h1 class="h3 mb-1"><%= pageTitle %></h1><p class="text-muted mb-0"><%= locale === 'en' ? 'Edit catalog metadata without changing stock, identifiers, or existing variant rows.' : 'স্টক, পরিচিতি বা বিদ্যমান ভ্যারিয়েন্ট না বদলে পণ্যের তথ্য সম্পাদনা করুন।' %></p></div>
    <a href="/admin/phase06#products" class="btn btn-outline-secondary"><%= locale === 'en' ? 'Back to inventory' : 'ইনভেন্টরিতে ফিরুন' %></a>
  </div>
  <% if (Number(product.is_archived)) { %><div class="alert alert-warning"><%= locale === 'en' ? 'This product is archived. Restore it before editing.' : 'পণ্যটি আর্কাইভ করা। সম্পাদনার আগে পুনরুদ্ধার করুন।' %></div><% } %>
  <div class="alert alert-info"><%= locale === 'en' ? 'SKU/barcode, warehouse/vendor stock, reservations, approval state, and variant rows are intentionally read-only here. Price edits update only the parent product; variant-specific prices remain unchanged.' : 'SKU/barcode, গুদাম/বিক্রেতার স্টক, রিজার্ভেশন, অনুমোদন অবস্থা এবং ভ্যারিয়েন্ট এখানে অপরিবর্তিত থাকবে। মূল পণ্যের দাম বদলালেও ভ্যারিয়েন্টের আলাদা দাম বদলাবে না।' %></div>
  <section class="card shadow-sm"><div class="card-header"><h2 class="h5 mb-0"><%= locale === 'en' ? 'Catalog details' : 'ক্যাটালগের বিবরণ' %></h2></div><div class="card-body">
    <form method="post" action="/admin/phase06/products/<%= product.id %>" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-3"><label class="form-label" for="edit-sku">SKU</label><input class="form-control" id="edit-sku" value="<%= product.sku %>" readonly></div>
      <div class="col-md-3"><label class="form-label" for="edit-barcode"><%= locale === 'en' ? 'Barcode' : 'বারকোড' %></label><input class="form-control" id="edit-barcode" value="<%= product.barcode || '' %>" readonly></div>
      <div class="col-md-3"><label class="form-label" for="edit-stock"><%= locale === 'en' ? 'Warehouse stock (read-only)' : 'গুদামের স্টক (শুধু দেখুন)' %></label><input class="form-control" id="edit-stock" value="<%= product.stock_on_hand %>" readonly></div>
      <div class="col-md-3"><label class="form-label" for="edit-vendor-stock"><%= locale === 'en' ? 'Vendor stock (read-only)' : 'বিক্রেতার স্টক (শুধু দেখুন)' %></label><input class="form-control" id="edit-vendor-stock" value="<%= product.vendor_stock_on_hand %>" readonly></div>
      <div class="col-md-6"><label class="form-label" for="edit-name-bn"><%= locale === 'en' ? 'Name (Bangla)' : 'পণ্যের নাম (বাংলা)' %> *</label><input class="form-control" id="edit-name-bn" name="name_bn" maxlength="255" required value="<%= product.name_bn %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-name-en"><%= locale === 'en' ? 'Name (English)' : 'পণ্যের নাম (ইংরেজি)' %></label><input class="form-control" id="edit-name-en" name="name_en" maxlength="255" value="<%= product.name_en || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-slug">Slug *</label><input class="form-control" id="edit-slug" name="slug" maxlength="191" required value="<%= product.slug %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-type"><%= locale === 'en' ? 'Product type' : 'পণ্যের ধরন' %></label><input class="form-control" id="edit-type" name="product_type" maxlength="32" required value="<%= product.product_type || 'grocery' %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-category"><%= locale === 'en' ? 'Active category' : 'সক্রিয় ক্যাটাগরি' %> *</label><select class="form-select" id="edit-category" name="category_id" required><% if (!categories.some(function(c) { return Number(c.id) === Number(product.category_id); })) { %><option value="__current_inactive__" selected><%= locale === 'en' ? 'Current category is inactive or unavailable; choose an active category' : 'বর্তমান ক্যাটাগরি নিষ্ক্রিয়/অনুপলব্ধ; সক্রিয় ক্যাটাগরি বাছুন' %></option><% } %><% categories.forEach(function(c) { %><option value="<%= c.id %>" <%= Number(c.id) === Number(product.category_id) ? 'selected' : '' %>><%= c.name_bn %><%= c.name_en ? ` / ${c.name_en}` : '' %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label" for="edit-brand"><%= locale === 'en' ? 'Brand (optional)' : 'ব্র্যান্ড (ঐচ্ছিক)' %></label><select class="form-select" id="edit-brand" name="brand_id"><% if (product.brand_id && !brands.some(function(b) { return Number(b.id) === Number(product.brand_id); })) { %><option value="__current_inactive__" selected><%= locale === 'en' ? 'Current brand is inactive or unavailable; choose a replacement or No brand' : 'বর্তমান ব্র্যান্ড নিষ্ক্রিয়/অনুপলব্ধ; নতুন ব্র্যান্ড অথবা ব্র্যান্ড নেই বাছুন' %></option><% } %><option value="" <%= !product.brand_id ? 'selected' : '' %>><%= locale === 'en' ? 'No brand' : 'ব্র্যান্ড নেই' %></option><% brands.forEach(function(b) { %><option value="<%= b.id %>" <%= Number(b.id) === Number(product.brand_id) ? 'selected' : '' %>><%= b.name_bn %><%= b.name_en ? ` / ${b.name_en}` : '' %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label" for="edit-unit"><%= locale === 'en' ? 'Unit label' : 'এককের নাম' %> *</label><input class="form-control" id="edit-unit" name="unit_label" maxlength="50" required value="<%= product.unit_label || '' %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-regular"><%= locale === 'en' ? 'Regular price (BDT)' : 'নিয়মিত দাম (টাকা)' %> *</label><input class="form-control" id="edit-regular" name="regular_price_bdt" type="number" min="0" step="0.01" required value="<%= paisaToBdtString(Number(product.regular_price_paisa || 0)) %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-sale"><%= locale === 'en' ? 'Sale price (BDT)' : 'বিক্রয় দাম (টাকা)' %> *</label><input class="form-control" id="edit-sale" name="sale_price_bdt" type="number" min="0" step="0.01" required value="<%= paisaToBdtString(Number(product.sale_price_paisa || 0)) %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-cost"><%= locale === 'en' ? 'Cost price (BDT)' : 'ক্রয় দাম (টাকা)' %> *</label><input class="form-control" id="edit-cost" name="cost_price_bdt" type="number" min="0" step="0.01" required value="<%= paisaToBdtString(Number(product.cost_price_paisa || 0)) %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-wholesale"><%= locale === 'en' ? 'Wholesale price (BDT)' : 'পাইকারি দাম (টাকা)' %></label><input class="form-control" id="edit-wholesale" name="wholesale_price_bdt" type="number" min="0" step="0.01" value="<%= paisaToBdtString(Number(product.wholesale_price_paisa || 0)) %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-min"><%= locale === 'en' ? 'Wholesale minimum quantity' : 'পাইকারি ন্যূনতম পরিমাণ' %></label><input class="form-control" id="edit-min" name="wholesale_min_qty" type="number" min="0" step="1" value="<%= product.wholesale_min_qty || 0 %>"></div>
      <div class="col-md-4"><label class="form-label" for="edit-threshold"><%= locale === 'en' ? 'Low-stock alert threshold' : 'কম স্টকের সতর্কতা সীমা' %></label><input class="form-control" id="edit-threshold" name="low_stock_threshold" type="number" min="0" step="1" value="<%= product.low_stock_threshold || 0 %>"></div>
      <div class="col-md-8"><label class="form-label" for="edit-image"><%= locale === 'en' ? 'Primary image URL/path' : 'প্রধান ছবির URL/পাথ' %></label><input class="form-control" id="edit-image" name="image_url" maxlength="500" value="<%= product.image_url || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="edit-short-bn"><%= locale === 'en' ? 'Short description (Bangla)' : 'সংক্ষিপ্ত বিবরণ (বাংলা)' %></label><textarea class="form-control" id="edit-short-bn" name="short_desc_bn" maxlength="2000" rows="3"><%= product.short_desc_bn || '' %></textarea></div>
      <div class="col-md-6"><label class="form-label" for="edit-short-en"><%= locale === 'en' ? 'Short description (English)' : 'সংক্ষিপ্ত বিবরণ (ইংরেজি)' %></label><textarea class="form-control" id="edit-short-en" name="short_desc_en" maxlength="2000" rows="3"><%= product.short_desc_en || '' %></textarea></div>
      <div class="col-md-6"><label class="form-label" for="edit-desc-bn"><%= locale === 'en' ? 'Description (Bangla)' : 'বিস্তারিত (বাংলা)' %></label><textarea class="form-control" id="edit-desc-bn" name="description_bn" maxlength="20000" rows="6"><%= product.description_bn || '' %></textarea></div>
      <div class="col-md-6"><label class="form-label" for="edit-desc-en"><%= locale === 'en' ? 'Description (English)' : 'বিস্তারিত (ইংরেজি)' %></label><textarea class="form-control" id="edit-desc-en" name="description_en" maxlength="20000" rows="6"><%= product.description_en || '' %></textarea></div>
      <div class="col-12 d-flex gap-2"><button class="btn btn-success" type="submit" <%= Number(product.is_archived) ? 'disabled' : '' %>><%= locale === 'en' ? 'Save catalog changes' : 'পরিবর্তন সংরক্ষণ' %></button><a class="btn btn-outline-secondary" href="/admin/phase06"><%= locale === 'en' ? 'Cancel' : 'বাতিল' %></a></div>
    </form>
  </div></section>
</main></div>
<%- include('partials/footer') %>
