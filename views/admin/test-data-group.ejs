<%- include('partials/head',{title:locale==='bn'?'টেস্ট ডেটা গ্রুপ পরিদর্শন':'Inspect Test Data Group'}) %><%- include('partials/topbar') %><%- include('partials/sidebar') %>
<div class="content-page"><div class="content"><div class="container-fluid py-3"><a href="/admin/test-data">← <%= locale==='bn'?'সব গ্রুপ':'All groups' %></a>
<h1 class="h4 mt-3"><%= group.label %> <small class="text-muted">#<%= group.id %></small></h1><p><code><%= group.group_key %></code> · <span class="badge bg-secondary"><%= group.source %></span> · <span class="badge bg-info text-dark"><%= group.status %></span></p><p class="text-muted"><%= group.description||'' %></p>
<% if(cleanupResult){ const result=cleanupResult; %><div class="alert <%= result.status==='completed'?'alert-success':'alert-warning' %>" role="status"><strong><%= result.status==='completed'?(locale==='bn'?'পরিষ্কার সম্পন্ন':'Cleanup completed'):(locale==='bn'?'কোনো রেকর্ড মোছা হয়নি':'No records deleted') %></strong><pre class="mb-0"><%= JSON.stringify(result,null,2) %></pre></div><% } %>
<div class="card p-3 mb-3"><h2 class="h6"><%= locale==='bn'?'গ্রুপে রেকর্ড চিহ্নিত করুন':'Explicitly mark records into this group' %></h2><p class="small text-muted"><%= locale==='bn'?'অনুসন্ধান করে নির্দিষ্ট রেকর্ড নির্বাচন করুন। কোনো নাম বা ইমেইল প্যাটার্ন নিজে থেকে চিহ্নিত করে না।':'Search and mark one exact record at a time. Names and email patterns never mark records automatically.' %></p><form method="get" class="row g-2 mb-3"><div class="col-md-3"><label for="entity-type" class="form-label"><%= locale==='bn'?'রেকর্ডের ধরন':'Entity type' %></label><select id="entity-type" class="form-select" name="type"><% types.forEach(type=>{ %><option value="<%= type %>" <%= searchType===type?'selected':'' %>><%= type %></option><% }) %></select></div><div class="col-md-6"><label for="record-search" class="form-label"><%= locale==='bn'?'অনুসন্ধান':'Search unmarked records' %></label><input id="record-search" name="q" value="<%= search %>" class="form-control" maxlength="100"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary"><%= locale==='bn'?'খুঁজুন':'Search' %></button></div></form>
<div class="table-responsive"><table class="table table-sm"><thead><tr><th><%= locale==='bn'?'আইডি':'ID' %></th><th><%= locale==='bn'?'রেকর্ড':'Record' %></th><th><%= locale==='bn'?'অ্যাকশন':'Action' %></th></tr></thead><tbody><% candidates.forEach(row=>{ %><tr><td>#<%= row.id %></td><td><%= row.label %> <span class="badge bg-light text-dark">Test data candidate · unmarked</span></td><td><form method="post" action="/admin/test-data/groups/<%= group.id %>/mark" onsubmit="return confirm('Mark only this exact record as test data?');"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><input type="hidden" name="entity_type" value="<%= searchType %>"><input type="hidden" name="entity_id" value="<%= row.id %>"><button class="btn btn-sm btn-warning" <%= group.status!=='active'?'disabled':'' %>><%= locale==='bn'?'টেস্ট হিসেবে চিহ্নিত':'Mark as test data' %></button></form></td></tr><% }) %><% if(search&&!candidates.length){ %><tr><td colspan="3" class="text-muted"><%= locale==='bn'?'কোনো অচিহ্নিত মিল পাওয়া যায়নি':'No unmarked matches' %></td></tr><% } %></tbody></table></div></div>
<div class="card p-3 mb-3"><h2 class="h6"><%= locale==='bn'?'চিহ্নিত মূল রেকর্ড':'Marked root records' %></h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th><%= locale==='bn'?'ধরন':'Type' %></th><th>ID</th><th><%= locale==='bn'?'রেকর্ড':'Record' %></th><th><%= locale==='bn'?'চিহ্ন':'Indicator' %></th></tr></thead><tbody><% Object.entries(markedRecords).forEach(([type,rows])=>rows.forEach(row=>{ %><tr><td><%= type %></td><td>#<%= row.id %></td><td><%= row.label %></td><td><span class="badge bg-warning text-dark">Explicit test-data marker</span></td></tr><% })) %><% if(!Object.values(markedRecords).some(rows=>rows.length)){ %><tr><td colspan="4" class="text-muted">No marked root records</td></tr><% } %></tbody></table></div></div>
<div class="card p-3 mb-3"><h2 class="h6"><%= locale==='bn'?'পরিষ্কারের প্রিভিউ':'Cleanup preview' %></h2><p class="small text-muted"><%= locale==='bn'?'সংখ্যা চিহ্নিত মূল রেকর্ড ও তাদের সম্পর্কিত রেকর্ড দেখায়। আর্থিক/অডিট ইতিহাস মোছা হয় না।':'Counts include marked roots and related rows. Financial, lifecycle, return and audit history is retained.' %></p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Entity</th><th>Count</th></tr></thead><tbody><% Object.entries(counts).forEach(([k,v])=>{ %><tr><td><%= k.replaceAll('_',' ') %></td><td><%= v %></td></tr><% }) %></tbody></table></div>
<% if(blockers.length){ %><div class="alert alert-warning"><strong><%= locale==='bn'?'নিরাপদে মোছা যাবে না':'Protected dependencies — cleanup blocked' %></strong><ul class="mb-0"><% blockers.forEach(b=>{ %><li><%= b.message %> (<%= b.count %>)</li><% }) %></ul></div><% } else if(!canClean){ %><p class="text-muted"><%= locale==='bn'?'পরিষ্কারের জন্য কোনো চিহ্নিত রেকর্ড নেই অথবা গ্রুপ ইতিমধ্যে পরিষ্কার।':'No marked records to clean, or this group has already been cleaned.' %></p><% } else { %><div class="alert alert-danger"><%= locale==='bn'?'নিচের রেকর্ডগুলো একটি ট্রানজ্যাকশনে মোছা হবে। এগিয়ে যাওয়ার আগে তালিকা ও নির্ভরতা যাচাই করুন।':'The eligible marked records above will be deleted in one transaction. Review the exact scope before continuing.' %></div><form method="post" action="/admin/test-data/groups/<%= group.id %>/cleanup" class="row g-2" onsubmit="return confirm('This permanently deletes the previewed test-only records. Continue?');"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="col-md-8"><label class="form-label" for="cleanup-confirm"><%= locale==='bn'?'নিশ্চিত করতে লিখুন:':'Type to confirm:' %> <code>CLEAN <%= group.group_key %></code></label><input id="cleanup-confirm" class="form-control" name="confirmation" autocomplete="off" required></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-danger" <%= group.status!=='active'?'disabled':'' %>><%= locale==='bn'?'নির্বাচিত টেস্ট ডেটা পরিষ্কার':'Clean eligible test data' %></button></div></form><% } %></div>
<div class="card p-3"><h2 class="h6"><%= locale==='bn'?'পরিষ্কারের অডিট ইতিহাস':'Cleanup audit history' %></h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>ID</th><th>Actor</th><th>Result</th><th>Scope / Detail</th><th>Time</th></tr></thead><tbody><% cleanupRuns.forEach(r=>{ %><tr><td><%= r.id %></td><td><%= r.actor_user_id||'—' %></td><td><%= r.result %></td><td><code><%= r.scope_json %></code><br><%= r.detail %></td><td><%= r.created_at %></td></tr><% }) %><% if(!cleanupRuns.length){ %><tr><td colspan="5" class="text-muted"><%= locale==='bn'?'এখনও কোনো পরিষ্কার কার্যক্রম নেই':'No cleanup attempts recorded' %></td></tr><% } %></tbody></table></div></div>
</div></div><%- include('partials/footer') %>
