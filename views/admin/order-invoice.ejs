<% const L = (en, bn) => (typeof locale !== 'undefined' && locale === 'en' ? en : bn); %>
<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <title>Invoice #<%= order.invoice_id %> - <%= siteSettings.site_name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Hind Siliguri', sans-serif; background: #f8fafc; padding: 24px; }
      .inv-box { max-width: 780px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 32px; }
      @media print {
        body { background: #fff; padding: 0; }
        .inv-box { border: none; padding: 0; }
        .no-print { display: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="text-center mb-3 no-print">
      <button onclick="window.print()" class="btn btn-success px-4">🖨️ <%= typeof locale !== 'undefined' && locale === 'en' ? 'Print invoice' : 'ইনভয়েস প্রিন্ট করুন' %></button>
      <a href="/admin/order/view/<%= order.id %>" class="btn btn-outline-secondary ms-2"><%= L('← Back', '← ফিরে যান') %></a>
    </div>

    <div class="inv-box">
      <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
        <div>
          <img src="<%= siteSettings.logo_dark || '/uploads/settings/logo.svg' %>" height="48" alt="Logo" />
          <div class="small text-muted mt-1"><%= siteSettings.site_address %></div>
          <div class="small text-muted"><%= L('Hotline:', 'হটলাইন:') %> <%= siteSettings.site_phone %></div>
        </div>
        <div class="text-end">
          <h4 class="fw-bold mb-1">INVOICE #<%= order.invoice_id %></h4>
          <div class="small text-muted">Date: <%= order.created_at %></div>
          <span class="badge bg-dark mt-1"><%= order.status_label %></span>
        </div>
      </div>

      <div class="row mb-4">
        <div class="col-6">
          <h6 class="fw-bold text-uppercase text-muted small"><%= L('Recipient details (Bill To)', 'প্রাপকের তথ্য (Bill To)') %></h6>
          <div class="fw-bold fs-6"><%= order.customer_name %></div>
          <div><%= L('Mobile:', 'মোবাইল:') %> <strong><%= order.phone %></strong></div>
          <div><%= L('Address:', 'ঠিকানা:') %> <%= order.address %></div>
        </div>
        <div class="col-6 text-end">
          <h6 class="fw-bold text-uppercase text-muted small"><%= L('Payment and courier', 'পেমেন্ট ও কুরিয়ার') %></h6>
          <div><%= L('Method:', 'মাধ্যম:') %> <strong><%= order.payment_method %></strong></div>
          <div><%= L('Status:', 'স্ট্যাটাস:') %> <%= order.payment_status.toUpperCase() %></div>
          <% if (order.courier_name) { %><div><%= L('Courier:', 'কুরিয়ার:') %> <%= order.courier_name %> (<%= order.courier_tracking_id %>)</div><% } %>
        </div>
      </div>

      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th><%= L('Product description', 'পণ্যের বিবরণ') %></th>
            <th><%= L('Variant', 'ভ্যারিয়েন্ট') %></th>
            <th class="text-center"><%= L('Quantity', 'পরিমাণ') %></th>
            <th class="text-end"><%= L('Rate', 'দর') %></th>
            <th class="text-end"><%= L('Total', 'মোট') %></th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function(it, idx) { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><%= it.product_name %></td>
              <td><%= it.size || '—' %></td>
              <td class="text-center"><%= it.qty %></td>
              <td class="text-end">৳<%= it.price %></td>
              <td class="text-end fw-semibold">৳<%= it.price * it.qty %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="row justify-content-end">
        <div class="col-sm-5">
          <div class="d-flex justify-content-between py-1"><span><%= L('Subtotal:', 'সাবটোটাল:') %></span><span>৳<%= order.subtotal %></span></div>
          <div class="d-flex justify-content-between py-1"><span><%= L('Delivery charge:', 'ডেলিভারি চার্জ:') %></span><span>৳<%= order.shipping_charge %></span></div>
          <div class="d-flex justify-content-between py-1"><span><%= L('Discount:', 'ডিসকাউন্ট:') %></span><span>-৳<%= order.wallet_used > 0 ? order.other_discount : order.discount %></span></div>
          <% if (order.wallet_used > 0) { %><div class="d-flex justify-content-between py-1"><span><%= L('Paid from wallet:', 'ওয়ালেট থেকে পরিশোধ:') %></span><span>-৳<%= order.wallet_used %></span></div><% } %>
          <div class="d-flex justify-content-between py-2 border-top fw-bold fs-5 text-success">
            <span><%= L('Total payable:', 'সর্বমোট প্রদেয়:') %></span><span>৳<%= Number(order.amount).toLocaleString('en-IN') %></span>
          </div>
        </div>
      </div>

      <div class="text-center text-muted small border-top pt-3 mt-4">
        <%= siteSettings.site_name %> <%= L('— thank you for shopping with us! Your trusted source for daily grocery and gift delivery.', 'থেকে কেনাকাটার জন্য আন্তরিক ধন্যবাদ! নিত্যপ্রয়োজনীয় গ্রোসারি ও উপহার ডেলিভারির বিশ্বস্ত ঠিকানা।') %>
      </div>
    </div>
  </body>
</html>
