<%- include('partials/layout-top', { title: 'Vendor Trust Levels' }) %>
<div class="container-fluid py-3">
  <h1 class="h3"><%= locale === 'bn' ? 'ভেন্ডর ও Trust Level' : 'Vendors & Trust Levels' %></h1>
  <p class="text-muted">
    New vendors need manual product approval. Verified vendors are identity/shop verified. Trusted vendors' new products publish immediately.
  </p>
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Shop / Store Identity</th>
            <th>Phone</th>
            <th>Lifecycle</th>
            <th>Commission</th>
            <th>Wallet</th>
            <th>Trust level</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="8" class="text-center p-4 text-muted">No vendors found.</td></tr>
          <% } %>
          <% rows.forEach(function(v) { %>
            <tr>
              <td>#<%= v.id %></td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <% if (v.logo_url) { %>
                    <img src="<%= v.logo_url %>" alt="<%= v.shop_name %>" class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;" />
                  <% } else { %>
                    <div class="rounded-circle bg-light text-secondary border d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 13px;">
                      <%= (v.shop_name || 'V').charAt(0).toUpperCase() %>
                    </div>
                  <% } %>
                  <div>
                    <strong><%= v.shop_name %></strong>
                    <% if (v.owner_name) { %>
                      <div class="small text-muted"><%= v.owner_name %></div>
                    <% } %>
                    <% if (v.slug) { %>
                      <div class="small">
                        <a href="/store/<%= v.slug %>" target="_blank" class="text-success text-decoration-none d-inline-flex align-items-center gap-1">
                          <code>/store/<%= v.slug %></code> <i class="fas fa-external-link-alt fa-xs"></i>
                        </a>
                      </div>
                    <% } %>
                  </div>
                </div>
              </td>
              <td><%= v.phone %></td>
              <td>
                <span class="badge <%= v.lifecycle_status === 'active' ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%= v.lifecycle_status || 'active' %>
                </span>
              </td>
              <td><%= Number(v.commission_rate).toFixed(2) %>%</td>
              <td>৳<%= Number(v.balance).toLocaleString('en-IN') %></td>
              <td>
                <span class="badge <%= v.trust_level === 'trusted' ? 'bg-success' : v.trust_level === 'verified' ? 'bg-info text-dark' : 'bg-secondary' %>">
                  <%= v.trust_level %>
                </span>
              </td>
              <td>
                <form method="post" action="/admin/vendors/<%= v.id %>/trust-level" class="d-flex gap-1">
                  <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
                  <label class="visually-hidden" for="trust-<%= v.id %>">Trust level for <%= v.shop_name %></label>
                  <select class="form-select form-select-sm" id="trust-<%= v.id %>" name="trust_level">
                    <option value="new" <%= v.trust_level === 'new' ? 'selected' : '' %>>new</option>
                    <option value="verified" <%= v.trust_level === 'verified' ? 'selected' : '' %>>verified</option>
                    <option value="trusted" <%= v.trust_level === 'trusted' ? 'selected' : '' %>>trusted</option>
                  </select>
                  <button class="btn btn-sm btn-primary" type="submit">Save</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <p class="mt-3">
    <a href="/admin/vendor-applications?status=pending">Review vendor applications →</a>
  </p>
</div>
<%- include('partials/layout-bottom') %>
