<%- include('partials/head', { title: isEn ? 'Consented checkout recovery' : 'সম্মতিসহ চেকআউট রিকভারি' }) %><%- include('partials/topbar') %><%- include('partials/sidebar') %>
<div class="content-page"><div class="content container-fluid py-3"><h1 class="h3"><%=isEn?'Consented incomplete checkout records':'সম্মতিসহ অসম্পূর্ণ চেকআউট'%></h1><div class="alert alert-warning"><%=isEn?'Only records with explicit consent are listed. Viewing or changing a recovery status does not send a message. Withdrawal erases identifying fields.':'শুধু স্পষ্ট সম্মতিসহ রেকর্ড দেখানো হচ্ছে। স্ট্যাটাস দেখা বা বদলালে কোনো বার্তা যায় না। সম্মতি প্রত্যাহার করলে পরিচয়-সংক্রান্ত তথ্য মুছে যায়।'%></div>
<form class="row g-2 mb-3"><div class="col-md-4"><input class="form-control" name="q" value="<%=query%>" placeholder="Phone or name"></div><div class="col-md-3"><select name="status" class="form-select"><option value=""><%=isEn?'All statuses':'সব স্ট্যাটাস'%></option><%['abandoned','contacted','recovery_started','recovered','withdrawn'].forEach(s=>{%><option value="<%=s%>" <%=status===s?'selected':''%>><%=s%></option><%})%></select></div><button class="btn btn-outline-primary col-auto"><%=isEn?'Search':'খুঁজুন'%></button></form>
<div class="table-responsive card"><table class="table table-striped mb-0"><thead><tr><th>#</th><th><%=isEn?'Customer details':'গ্রাহক তথ্য'%></th><th><%=isEn?'Cart':'কার্ট'%></th><th><%=isEn?'Status / notification consent':'স্ট্যাটাস / বার্তা সম্মতি'%></th><th><%=isEn?'Management':'ব্যবস্থাপনা'%></th></tr></thead><tbody><%rows.forEach(r=>{%><tr><td><%=r.id%></td><td><%if(r.status!=='withdrawn'){%><%=r.customer_name||'—'%><br><%=r.phone%><%}else{%><%=isEn?'Identity withdrawn':'পরিচয় প্রত্যাহার করা হয়েছে'%><%}%></td><td><%=r.cartCount||0%> items<br><small>BDT estimate not retained</small></td><td><%=r.status%><br><small><%=r.notification_allowed?'opt-in':'no notification consent'%></small></td><td><%if(r.status!=='withdrawn'&&r.status!=='recovered'){%><form method="post" action="/admin/phase08/incomplete/<%=r.id%>/status" class="d-flex flex-wrap gap-1"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select class="form-select form-select-sm" name="status"><% (transitions[r.status]||[]).forEach(s=>{%><option value="<%=s%>"><%=s%></option><%})%></select><input class="form-control form-control-sm" name="reason" required minlength="3" maxlength="255" placeholder="Reason"><input class="form-control form-control-sm" name="recovered_order_id" type="number" min="1" placeholder="Order ID if recovered"><button class="btn btn-sm btn-primary"><%=isEn?'Save':'সংরক্ষণ'%></button></form><%}%></td></tr><%})%><%if(!rows.length){%><tr><td colspan="5" class="text-center text-muted py-4"><%=isEn?'No consented records.':'সম্মতিসহ কোনো রেকর্ড নেই।'%></td></tr><%}%></tbody></table></div><p class="mt-3"><%=total%> records · <%=page%>/<%=totalPages||1%></p></div></div><%-include('partials/footer')%>
