<%- include('partials/head', { title: locale === 'bn' ? 'রিসেলার কমার্স' : 'Reseller Commerce' }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>
<div class="content-page"><div class="content container-fluid py-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h4 class="fw-bold mb-1"><%= locale === 'bn' ? 'রিসেলার কমার্স অপারেশনস' : 'Reseller Commerce Operations' %></h4><p class="text-muted mb-0">Pricing, fulfillment, COD, partner balances, and immutable financial history.</p></div><span class="badge bg-info">Admin-only · MySQL</span></div>
  <% if (flash) { %><div class="alert alert-<%= flash.type === 'success' ? 'success' : 'danger' %> alert-dismissible"><%= flash.message %><button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div><% } %>
  <ul class="nav nav-tabs flex-nowrap overflow-auto" id="commerceTabs" role="tablist">
    <% [['pricing','Pricing & eligibility'],['partners','Resellers & branding'],['orders','Vendor sub-orders'],['cod','COD reconciliation'],['wallets','Wallets & withdrawals'],['ledger','Immutable search']].forEach(([id,label],i)=>{ %><li class="nav-item" role="presentation"><button class="nav-link <%= i===0?'active':'' %>" id="<%= id %>-tab" data-bs-toggle="tab" data-bs-target="#<%= id %>" type="button" role="tab" aria-controls="<%= id %>" aria-selected="<%= i===0?'true':'false' %>"><%= label %></button></li><% }); %>
  </ul>
  <div class="tab-content border border-top-0 bg-white p-3 rounded-bottom">
    <section class="tab-pane fade show active" id="pricing" role="tabpanel" aria-labelledby="pricing-tab" tabindex="0">
      <form method="post" action="/admin/reseller-commerce/settings" class="row g-3 mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-3 form-check form-switch ms-2"><input type="hidden" name="reseller_price_mode_enabled" value="0"><input class="form-check-input" type="checkbox" name="reseller_price_mode_enabled" value="1" id="modeA" <%= Number(settings.reseller_price_mode_enabled)?'checked':'' %>><label class="form-check-label" for="modeA">Enable mode A · reseller sets customer price</label></div>
        <div class="col-md-3 form-check form-switch ms-2"><input type="hidden" name="official_price_mode_enabled" value="0"><input class="form-check-input" type="checkbox" name="official_price_mode_enabled" value="1" id="modeB" <%= Number(settings.official_price_mode_enabled)?'checked':'' %>><label class="form-check-label" for="modeB">Enable mode B · official price</label></div>
        <div class="col-md-2"><label class="form-label" for="feeType">Platform fee type</label><select class="form-select" id="feeType" name="platform_fee_type"><option value="fixed" <%= settings.platform_fee_type==='fixed'?'selected':'' %>>Fixed BDT</option><option value="percent" <%= settings.platform_fee_type==='percent'?'selected':'' %>>Percent</option></select></div>
        <div class="col-md-2"><label class="form-label" for="feeValue">Fee value</label><input class="form-control" id="feeValue" name="platform_fee_value" type="number" min="0" step="0.01" value="<%= settings.platform_fee_type==='percent' ? Number(settings.platform_fee_bps)/100 : Number(settings.platform_fee_paisa)/100 %>" required></div>
        <div class="col-md-2"><label class="form-label" for="commission">Official commission (bps)</label><input class="form-control" id="commission" name="official_commission_bps" type="number" min="0" max="10000" value="<%= settings.official_commission_bps %>" required></div>
        <div class="col-md-2"><label class="form-label" for="minPrice">Minimum price (BDT)</label><input class="form-control" id="minPrice" name="minimum_price_bdt" type="number" min="0" step="0.01" value="<%= Number(settings.minimum_price_paisa)/100 %>" required></div>
        <div class="col-md-2"><label class="form-label" for="maxPrice">Maximum price (BDT, optional)</label><input class="form-control" id="maxPrice" name="maximum_price_bdt" type="number" min="0" step="0.01" value="<%= settings.maximum_price_paisa==null?'':Number(settings.maximum_price_paisa)/100 %>"></div>
        <div class="col-md-2"><label class="form-label" for="returnWindow">Return window (days)</label><input class="form-control" id="returnWindow" name="return_window_days" type="number" min="0" max="365" value="<%= settings.return_window_days %>" required></div>
        <div class="col-12"><button class="btn btn-primary">Save pricing policy</button><span class="small text-muted ms-2">Values are validated and audited. Wholesale costs and reseller margins are not displayed.</span></div>
      </form>
      <div class="table-responsive"><table class="table table-sm table-hover align-middle"><caption class="caption-top">Per-product mode eligibility and customer price bounds</caption><thead><tr><th>Product</th><th>Mode A</th><th>Mode B</th><th>Min BDT</th><th>Max BDT</th><th>Vendor entitlement BDT · admin only</th><th></th></tr></thead><tbody>
      <% products.forEach(p=>{ %><tr><td><%= p.name_en || p.name_bn || p.sku %> <small class="text-muted">#<%= p.id %></small></td><td colspan="6"><form method="post" action="/admin/reseller-commerce/products/<%= p.id %>/eligibility" class="row g-2 align-items-center"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-auto form-check"><input type="hidden" name="reseller_price_mode_enabled" value="0"><input class="form-check-input" type="checkbox" name="reseller_price_mode_enabled" value="1" aria-label="Mode A eligible" <%= Number(p.reseller_price_mode_enabled)?'checked':'' %>></div><div class="col-auto form-check"><input type="hidden" name="official_price_mode_enabled" value="0"><input class="form-check-input" type="checkbox" name="official_price_mode_enabled" value="1" aria-label="Mode B eligible" <%= Number(p.official_price_mode_enabled)?'checked':'' %>></div><div class="col"><input class="form-control form-control-sm" type="number" name="minimum_price_bdt" min="0" step="0.01" placeholder="Min" value="<%= p.minimum_price_paisa==null?'':Number(p.minimum_price_paisa)/100 %>" aria-label="Product minimum price BDT"></div><div class="col"><input class="form-control form-control-sm" type="number" name="maximum_price_bdt" min="0" step="0.01" placeholder="Max" value="<%= p.maximum_price_paisa==null?'':Number(p.maximum_price_paisa)/100 %>" aria-label="Product maximum price BDT"></div><div class="col"><input class="form-control form-control-sm" type="number" name="vendor_entitlement_bdt" min="0" step="0.01" placeholder="Entitlement" value="<%= p.vendor_entitlement_paisa==null?'':Number(p.vendor_entitlement_paisa)/100 %>" aria-label="Admin-only vendor entitlement BDT"></div><div class="col-auto"><button class="btn btn-sm btn-outline-primary">Save</button></div></form></td></tr><% }); %>
      <% if(!products.length){ %><tr><td colspan="7" class="text-center text-muted">No active products found.</td></tr><% } %></tbody></table></div>
    </section>
    <section class="tab-pane fade" id="partners" role="tabpanel" aria-labelledby="partners-tab" tabindex="0"><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Reseller</th><th>Status</th><th>Co-branding preview</th><th>Review actions</th></tr></thead><tbody><% resellers.forEach(r=>{ %><tr><td><strong><%= r.shop_name || r.name %></strong><br><small><%= r.email %> · #<%= r.id %></small></td><td><%= r.status %> · <%= Number(r.verified)?'verified':'unverified' %></td><td><div class="d-flex align-items-center gap-2"><% if(r.logo_url){ %><img src="<%= r.logo_url %>" alt="<%= r.shop_name || r.name %> logo preview" style="max-width:64px;max-height:48px;object-fit:contain"><% } %><span><%= r.shop_name || r.name %><br><small><%= r.branding_status || 'pending' %></small></span></div></td><td><div class="d-flex flex-wrap gap-2"><% ['approve','suspend','reactivate'].forEach(action=>{ %><form method="post" action="/admin/reseller-commerce/resellers/<%= r.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= action %>"><button class="btn btn-sm btn-outline-secondary"><%= action %></button></form><% }); %><form method="post" action="/admin/reseller-commerce/resellers/<%= r.id %>/branding" class="d-flex flex-wrap gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="approve"><input class="form-control form-control-sm" name="shop_name" value="<%= r.shop_name || r.name %>" maxlength="120" aria-label="Approved shop name"><input class="form-control form-control-sm" name="logo_url" value="<%= r.logo_url || '' %>" maxlength="500" placeholder="https:// logo URL" aria-label="Logo URL"><button class="btn btn-sm btn-success">Approve branding</button></form><form method="post" action="/admin/reseller-commerce/resellers/<%= r.id %>/branding" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="reject"><input class="form-control form-control-sm" name="note" maxlength="500" placeholder="Reason" aria-label="Branding rejection reason"><button class="btn btn-sm btn-outline-danger">Reject branding</button></form></div></td></tr><% }); %></tbody></table></div></section>
    <section class="tab-pane fade" id="orders" role="tabpanel" aria-labelledby="orders-tab" tabindex="0"><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Order / vendor</th><th>Sub-order state</th><th>COD due</th><th>Price snapshots</th><th>Shipment / tracking history</th></tr></thead><tbody><% subOrders.forEach(o=>{ %><tr><td><%= o.invoice_no %> · <%= o.vendor_name %><br><small><%= o.vendor_order_no %></small></td><td><%= o.status %></td><td><%= o.cod_due_paisa %> paisa</td><td><% (o.items||[]).forEach(i=>{ %><div><%= i.product_name %> · customer <%= i.customer_unit_price_paisa %>p × <%= i.quantity %> · entitlement snapshot <%= i.vendor_entitlement_unit_paisa %>p</div><% }); %></td><td><% (o.shipments||[]).forEach(s=>{ %><div><%= s.courier_name || s.courier %>: <%= s.tracking_number || '—' %> · <%= s.status %><% (s.history||[]).forEach(h=>{ %><div class="small text-muted">↳ <%= h.status %> · <%= h.created_at %></div><% }); %></div><% }); %></td></tr><% }); %></tbody></table></div></section>
    <section class="tab-pane fade" id="cod" role="tabpanel" aria-labelledby="cod-tab"><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Order</th><th>Courier / tracking</th><th>Shipment</th><th>Expected COD</th><th>Collected</th><th>Reference</th><th>Discrepancy</th></tr></thead><tbody><% codShipments.forEach(s=>{ %><tr><td><%= s.invoice_no %> · <%= s.vendor_name || 'Warehouse' %></td><td><%= s.courier_name %><br><%= s.tracking_number %></td><td><%= s.shipment_status %></td><td><%= s.expected_paisa %></td><td><%= s.collected_paisa==null?'—':s.collected_paisa %></td><td><%= s.reconciliation_reference || '—' %></td><td><span class="badge bg-<%= s.discrepancy_paisa ? 'warning text-dark':'success' %>"><%= s.discrepancy_paisa==null?'Not reconciled':s.discrepancy_paisa+' paisa' %></span></td></tr><% }); %></tbody></table></div></section>
    <section class="tab-pane fade" id="wallets" role="tabpanel" aria-labelledby="wallets-tab"><div class="row g-3 mb-3"><% wallets.forEach(w=>{ %><div class="col-md-4"><div class="card"><div class="card-body"><strong><%= w.partner_type %> wallet</strong><div>Pending: <%= w.pending_paisa %> paisa</div><div>Available: <%= w.available_paisa %> paisa</div></div></div></div><% }); %></div><h5>Matured settlement preview</h5><p class="text-muted">Release uses one atomic MySQL transaction and a return-window/COD reconciliation eligibility check.</p><form method="post" action="/admin/reseller-commerce/settlements/release-matured" class="mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-warning" <%= settlements.reduce((n,s)=>n+Number(s.record_count||0),0)===0?'disabled':'' %>>Release all matured settlements</button></form><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Partner</th><th>Matured amount</th><th>Eligible records</th><th>Return window</th></tr></thead><tbody><% settlements.forEach(s=>{ %><tr><td><%= s.partner_type %> #<%= s.partner_id %></td><td><%= s.amount_paisa %> paisa</td><td><%= s.record_count %></td><td><%= s.return_window_days %> days</td></tr><% }); %></tbody></table></div><h5 class="mt-4">Withdrawal review</h5><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Partner</th><th>Amount</th><th>Destination</th><th>Status</th><th>Decision</th></tr></thead><tbody><% withdrawals.forEach(w=>{ %><tr><td><%= w.partner_type %> #<%= w.partner_id %></td><td><%= w.amount_paisa %> paisa</td><td><%= w.destination %></td><td><%= w.status %></td><td><% if(w.status==='pending'){ %><form method="post" action="/admin/reseller-commerce/withdrawals/<%= w.partner_type %>/<%= w.id %>" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control form-control-sm" name="reason" maxlength="300" placeholder="Review note" aria-label="Withdrawal review note"><button class="btn btn-sm btn-success" name="decision" value="approve">Approve / pay</button><button class="btn btn-sm btn-outline-danger" name="decision" value="reject">Reject</button></form><% } %></td></tr><% }); %></tbody></table></div></section>
    <section class="tab-pane fade" id="ledger" role="tabpanel" aria-labelledby="ledger-tab"><form class="row g-2 mb-3" method="get" action="/admin/reseller-commerce"><div class="col-sm-3"><label class="form-label" for="filterOrder">Order ID</label><input id="filterOrder" class="form-control" name="orderId" value="<%= query.orderId || '' %>"></div><div class="col-sm-3"><label class="form-label" for="filterReseller">Reseller ID</label><input id="filterReseller" class="form-control" name="resellerId" value="<%= query.resellerId || '' %>"></div><div class="col-sm-4"><label class="form-label" for="filterRef">Reference</label><input id="filterRef" class="form-control" name="reference" maxlength="120" value="<%= query.reference || '' %>"></div><div class="col-sm-2 align-self-end"><button class="btn btn-outline-primary">Search</button></div></form><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Type</th><th>Order</th><th>Partner</th><th>Reference</th><th>Event</th><th>Amount</th><th>When</th></tr></thead><tbody><% audit.forEach(a=>{ %><tr><td><%= a.ledger_type %></td><td><%= a.order_id || a.sub_order_id || '—' %></td><td><%= a.reseller_id || 'Vendor' %></td><td><code><%= a.reference %></code></td><td><%= a.transaction_type %></td><td><%= a.amount_paisa %> paisa</td><td><%= a.created_at %></td></tr><% }); %></tbody></table></div></section>
  </div>
</div></div>
<%- include('partials/footer') %>
