<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="pb-sid" content="<%= typeof sessionToken !== 'undefined' ? sessionToken : '' %>" />
    <title>Admin Login - <%= siteSettings.site_name || 'ফল বাজার' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/uploads/settings/logo.svg" />
    <script src="/frontEnd/js/pb-session.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Inter', 'Hind Siliguri', sans-serif;
        min-height: 100vh;
        background: radial-gradient(circle at top left, #dcfce7 0%, #f1f5f9 55%, #e2e8f0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .login-card {
        width: 100%;
        max-width: 430px;
        background: #ffffff;
        border-radius: 18px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        overflow: hidden;
      }
      .login-head {
        background: linear-gradient(135deg, #243b22 0%, #166534 100%);
        padding: 28px 28px 24px;
        text-align: center;
        color: #fff;
      }
      .btn-login {
        background: #243b22;
        color: #fff;
        font-weight: 600;
        padding: 11px;
        border-radius: 10px;
        border: none;
        width: 100%;
      }
      .btn-login:hover {
        background: #1a2c19;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <div class="login-card">
      <div class="login-head">
        <img src="/uploads/settings/logo-light.svg" alt="ফল বাজার" height="48" class="mb-2" />
        <h5 class="mb-1 fw-bold">Admin Control Panel</h5>
        <p class="mb-0 small text-white-50">অ্যাডমিন ড্যাশবোর্ডে প্রবেশ করতে লগইন করুন</p>
      </div>
      <div class="p-4">
        <% if (error) { %>
          <div class="alert alert-danger py-2 small"><%= error %></div>
        <% } %>

        <form action="/admin/login" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="admin@mrtumi.local" autocomplete="username" required />
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Password</label>
            <input type="password" name="password" class="form-control" placeholder="••••••••" autocomplete="current-password" required />
          </div>
          <button type="submit" class="btn-login mt-2">লগইন করুন (Sign In)</button>
        </form>

        <div class="mt-3 p-2.5 rounded-3 bg-light border text-center small text-muted" style="padding:10px;">
          <div class="d-flex justify-content-around pt-1">
            <a href="/" class="text-success fw-semibold text-decoration-none">← শপ</a>
            <a href="/vendor/login" class="text-success fw-semibold text-decoration-none">🏪 ভেন্ডর লগইন</a>
            <a href="/reseller/login" class="text-primary fw-semibold text-decoration-none">🤝 রিসেলার লগইন</a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
