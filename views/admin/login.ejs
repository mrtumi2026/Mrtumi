<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'bn' %>">
  <head>
    <meta charset="utf-8" />
    <meta name="pb-sid" content="<%= typeof sessionToken !== 'undefined' ? sessionToken : '' %>" />
    <title><%= t('admin.controlPanel') %> — <%= siteSettings.site_name %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="<%= siteSettings.favicon || '/uploads/brand/mrtumi-placeholder-favicon.svg' %>" />
    <script src="/frontEnd/js/pb-session.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="/shared/css/mrtumi-design-system.css" rel="stylesheet" />
    <style>
      body {
        font-family: var(--mt-font-sans);
        min-height: 100vh;
        background: radial-gradient(circle at top left, #dcfce7 0%, #f8fafc 55%, #e2e8f0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .login-card {
        width: 100%;
        max-width: 445px;
        background: #ffffff;
        border-radius: 18px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.09);
        overflow: hidden;
      }
      .login-head {
        background: linear-gradient(135deg, #072618 0%, #0d3b26 60%, #14532d 100%);
        padding: 24px 26px 22px;
        text-align: center;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <a href="#mainContent" class="mt-skip-link"><%= t('a11y.skipToContent') %></a>

    <main id="mainContent" class="login-card">
      <div class="login-head">
        <div class="d-flex justify-content-end mb-2">
          <%- include('../partials/lang-switch', { variant: 'dark' }) %>
        </div>
        <img
          src="<%= siteSettings.logo_light %>"
          alt="<%= siteSettings.site_name %>"
          height="46"
          class="mb-2"
          data-brand-asset-status="<%= (typeof brand !== 'undefined' && brand && brand.isPlaceholderLogo) ? 'temporary-placeholder' : 'custom' %>"
        />
        <h1 class="h5 mb-1 fw-bold text-white"><%= t('admin.loginTitle') %></h1>
        <p class="mb-0 small" style="color: #cbd5e1;"><%= t('admin.loginSub') %></p>
      </div>

      <div class="p-4">
        <%- include('../partials/alert-banner', { type: 'error', message: error }) %>

        <form action="/admin/login" method="POST" novalidate>
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <% } %>
          <div class="mb-3">
            <label for="adminLoginEmail" class="form-label small fw-semibold text-dark"><%= t('admin.emailOrUsername') %> *</label>
            <input
              type="email"
              id="adminLoginEmail"
              name="email"
              class="form-control"
              placeholder="admin@mrtumi.local"
              autocomplete="username"
              required
            />
          </div>
          <div class="mb-3">
            <label for="adminLoginPassword" class="form-label small fw-semibold text-dark"><%= t('admin.password') %> *</label>
            <input
              type="password"
              id="adminLoginPassword"
              name="password"
              class="form-control"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />
          </div>
          <button type="submit" class="mt-btn mt-btn-primary w-100 py-2.5 mt-1"><%= t('admin.signInBtn') %> →</button>
        </form>

        <nav aria-label="Portal switch" class="mt-3 p-2.5 rounded-3 bg-light border text-center small" style="padding:10px;">
          <div class="d-flex justify-content-around flex-wrap gap-2 pt-1">
            <a href="/" class="text-success fw-semibold text-decoration-none">← <%= t('admin.backToStore') %></a>
            <a href="/vendor/login" class="text-success fw-semibold text-decoration-none">🏪 <%= t('admin.vendorPortal') %></a>
            <a href="/reseller/login" class="text-primary fw-semibold text-decoration-none">🤝 <%= t('admin.resellerPortal') %></a>
          </div>
        </nav>
      </div>
    </main>
    <script src="/shared/js/mrtumi-ui.js"></script>
  </body>
</html>
