<%- include('partials/layout-top', { title: 'Review vendor application' }) %>
<div class="container-fluid py-3"><p><a href="/admin/vendor-applications">← Applications</a></p><h1 class="h3"><%= vendor.shop_name %> <small class="text-muted">#<%= vendor.id %></small></h1><div class="alert alert-info"><strong>Lifecycle: <%= vendor.lifecycle_status %></strong> · Phone <%= vendor.phone_verified_at?'verified':'unverified' %> · Identity <%= vendor.identity_verified_at?'verified':'unverified' %> · Onboarding <%= vendor.onboarding_completed_at?'complete':'incomplete' %> · Payout <%= vendor.payout_verified_at?'verified':'unverified' %></div>
<div class="row g-3"><section class="col-xl-6"><div class="card p-3"><h2 class="h5">Private application data</h2><dl class="row mb-0"><dt class="col-sm-4">Owner</dt><dd class="col-sm-8"><%= vendor.owner_name %></dd><dt class="col-sm-4">Phone</dt><dd class="col-sm-8"><%= vendor.phone %> · <%= vendor.phone_verified_at?'Verified':'Not verified' %></dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8"><%= vendor.email %></dd><dt class="col-sm-4">Address</dt><dd class="col-sm-8"><%= vendor.address %></dd><dt class="col-sm-4">Location</dt><dd class="col-sm-8"><%= vendor.district %>, <%= vendor.upazila %></dd><dt class="col-sm-4">Business</dt><dd class="col-sm-8"><%= vendor.business_type %> · <%= vendor.business_category %></dd><dt class="col-sm-4">NID</dt><dd class="col-sm-8"><%= vendor.nid_number %></dd></dl><hr><h3 class="h6">Restricted document previews</h3><div class="row g-2"><% [['nid_front','NID front'],['nid_back','NID back'],['trade_license','Trade license'],['shop_logo','Shop logo']].forEach(function(pair){if(vendor.documents[pair[0]]){ %><div class="col-md-6"><a href="/admin/vendor-applications/<%= vendor.id %>/documents/<%= pair[0] %>" target="_blank" rel="noopener"><%= pair[1] %></a><br><img src="/admin/vendor-applications/<%= vendor.id %>/documents/<%= pair[0] %>" alt="<%= pair[1] %> private preview" class="img-fluid border rounded mt-1" style="max-height:220px"></div><% }}) %></div></div></section>
<section class="col-xl-6"><div class="card p-3 mb-3"><h2 class="h5">Status decision</h2><form method="post" action="/admin/vendor-applications/<%= vendor.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><label for="action" class="form-label">Action</label><select id="action" name="action" class="form-select mb-2" required><option value="">Select</option><% const options={pending:[['start_review','Move to review'],['request_info','Request information'],['approve','Approve after identity review'],['reject','Reject'],['deactivate','Deactivate']],under_review:[['request_info','Request information'],['approve','Approve after identity review'],['reject','Reject'],['deactivate','Deactivate']],action_required:[['start_review','Resume review'],['approve','Approve after identity review'],['reject','Reject'],['deactivate','Deactivate']],approved:[['reactivate','Activate (check gates)'],['request_info','Request information'],['suspend','Suspend'],['deactivate','Deactivate']],active:[['suspend','Suspend'],['deactivate','Deactivate']],rejected:[['start_review','Reopen for review'],['deactivate','Deactivate']],suspended:[['reactivate','Reactivate (check gates)'],['deactivate','Deactivate']],deactivated:[['start_review','Reopen for review']]};(options[vendor.lifecycle_status]||[]).forEach(function(o){ %><option value="<%= o[0] %>"><%= o[1] %></option><% }) %></select><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm_identity" value="1" id="confirm-identity"><label class="form-check-label" for="confirm-identity">I personally reviewed the identity documents and confirm identity verification. Required for approval.</label></div><label class="form-label" for="reason">Reason (mandatory for request-info, reject, suspend)</label><textarea id="reason" name="reason" class="form-control mb-2" rows="3" maxlength="1000"></textarea><button class="btn btn-primary" type="submit">Record decision</button></form></div>
<div class="card p-3 mb-3"><h2 class="h5">Individual commission and publishing</h2><form method="post" action="/admin/vendor-applications/<%= vendor.id %>/commission"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><label class="form-label" for="commission">Commission (%)</label><input id="commission" name="commission_percent" type="number" min="0.01" max="100" step="0.01" value="<%= (vendor.commission_rate_bps/100).toFixed(2) %>" class="form-control mb-2" required><div class="form-check mb-2"><input class="form-check-input" id="auto-publish" type="checkbox" name="trusted_auto_publish" value="1" <%= vendor.trusted_auto_publish?'checked':'' %>><label class="form-check-label" for="auto-publish">Trusted vendor: automatically publish new products</label></div><button class="btn btn-outline-primary">Save commission</button></form></div>
<div class="card p-3"><h2 class="h5">Payout account verification</h2><% if(!payouts.length){ %><p>No payout accounts submitted.</p><% } %><% payouts.forEach(function(p){ %><div class="border rounded p-2 mb-2"><strong><%= p.method %></strong> · <%= p.masked_account %> · <%= p.verification_status %><dl class="row small mt-2"><dt class="col-4">Holder</dt><dd class="col-8"><%= p.details.holder_name %></dd><dt class="col-4">Account</dt><dd class="col-8"><%= p.details.account_number %></dd><% if(p.method==='bank'){ %><dt class="col-4">Bank / branch</dt><dd class="col-8"><%= p.details.bank_name %> / <%= p.details.branch %></dd><dt class="col-4">Routing</dt><dd class="col-8"><%= p.details.routing_number||'—' %></dd><% } %></dl><form method="post" action="/admin/vendor-payout-accounts/<%= p.id %>/decision" class="d-flex gap-2 align-items-end"><input type="hidden" name="_csrf" value="<%= csrfToken || '' %>"><div><label class="form-label" for="reason-<%= p.id %>">Reason (required if rejected)</label><input class="form-control" id="reason-<%= p.id %>" name="reason" maxlength="1000"></div><button name="status" value="verified" class="btn btn-success">Verify</button><button name="status" value="rejected" class="btn btn-outline-danger">Reject</button></form></div><% }) %></div></section></div>
<section class="card p-3 mt-3"><h2 class="h5">Lifecycle history</h2><div class="table-responsive"><table class="table"><thead><tr><th>From</th><th>To</th><th>Reason</th><th>Actor</th><th>Date</th></tr></thead><tbody><% history.forEach(function(h){ %><tr><td><%= h.from_status||'—' %></td><td><%= h.to_status %></td><td><%= h.reason %></td><td><%= h.actor_type %> <%= h.actor_id||'' %></td><td><%= String(h.created_at).slice(0,19) %></td></tr><% }) %></tbody></table></div></section></div>
<%- include('partials/layout-bottom') %>
