<%- include('partials/layout-top', { title: 'Vendor applications' }) %>
<div class="container-fluid py-3"><h1 class="h3">Vendor applications</h1><nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Filter vendor applications"><% statuses.forEach(function(s){ %><a class="btn btn-sm <%= status===s?'btn-primary':'btn-outline-secondary' %>" href="/admin/vendor-applications?status=<%= encodeURIComponent(s) %>"><%= s.replaceAll('_',' ') %></a><% }) %></nav><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Shop</th><th>Owner</th><th>District / Upazila</th><th>Category</th><th>Status</th><th>Submitted</th><th></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="7" class="text-center p-4">No applications in this status.</td></tr><% } %><% rows.forEach(function(v){ %><tr><td><%= v.shop_name %></td><td><%= v.owner_name %></td><td><%= v.district %> / <%= v.upazila %></td><td><%= v.business_category %></td><td><%= v.lifecycle_status %></td><td><%= String(v.created_at).slice(0,10) %></td><td><a class="btn btn-sm btn-primary" href="/admin/vendor-applications/<%= v.id %>">Review</a></td></tr><% }) %></tbody></table></div></div><p class="text-muted mt-2"><%= total %> application(s) · Page <%= page %></p></div>
<%- include('partials/layout-bottom') %>
