<%- include('partials/head', { title: isEn ? 'Refund review' : 'রিফান্ড পর্যালোচনা' }) %><%- include('partials/topbar') %><%- include('partials/sidebar') %>
<div class="content-page"><div class="content container-fluid py-3"><h1 class="h3"><%=isEn?'Internal refund requests':'অভ্যন্তরীণ রিফান্ড অনুরোধ'%></h1><div class="alert alert-warning"><%=isEn?'Approval is an internal decision only. No provider refund is sent or marked successful here.':'অনুমোদন কেবল অভ্যন্তরীণ সিদ্ধান্ত। এখানে কোনো পেমেন্ট প্রদানকারীর মাধ্যমে টাকা ফেরত পাঠানো বা সফল দেখানো হয় না।'%></div>
<form class="row g-2 mb-3"><div class="col-md-4"><input class="form-control" name="q" value="<%=query%>" placeholder="Invoice or phone"></div><div class="col-md-3"><select class="form-select" name="status"><option value=""><%=isEn?'All statuses':'সব স্ট্যাটাস'%></option><% ['requested','pending','approved','processing','succeeded','failed','rejected','completed'].forEach(s=>{%><option value="<%=s%>" <%=status===s?'selected':''%>><%=s%></option><%})%></select></div><button class="btn btn-outline-primary col-auto"><%=isEn?'Filter':'ফিল্টার'%></button></form>
<div class="table-responsive card"><table class="table table-striped mb-0"><thead><tr><th># / Invoice</th><th><%=isEn?'Customer':'গ্রাহক'%></th><th><%=isEn?'Amount / status':'পরিমাণ / অবস্থা'%></th><th><%=isEn?'Reason':'কারণ'%></th><th><%=isEn?'Review':'পর্যালোচনা'%></th></tr></thead><tbody><%rows.forEach(r=>{%><tr><td><%=r.id%> / <%=r.invoice_no%></td><td><%=r.customer_name%><br><small><%=r.customer_phone%></small></td><td>৳<%=(Number(r.amount_paisa)/100).toFixed(2)%><br><%=r.status%></td><td><%=r.reason%></td><td><%if(r.status==='requested'||r.status==='pending'){%><form method="post" action="/admin/phase08/refunds/<%=r.id%>/decision" class="d-flex flex-wrap gap-1"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="request_key" value="<%=r.decisionKey%>"><input class="form-control form-control-sm" name="reason" required minlength="3" maxlength="255" placeholder="Decision reason"><button class="btn btn-sm btn-success" name="status" value="approved"><%=isEn?'Approve':'অনুমোদন'%></button><button class="btn btn-sm btn-outline-danger" name="status" value="rejected"><%=isEn?'Reject':'বাতিল'%></button></form><%}%><a class="small" href="/admin/phase08/refunds?id=<%=r.id%>"><%=isEn?'History':'ইতিহাস'%></a></td></tr><%})%><%if(!rows.length){%><tr><td colspan="5" class="text-center text-muted py-4"><%=isEn?'No refund requests.':'কোনো রিফান্ড অনুরোধ নেই।'%></td></tr><%}%></tbody></table></div>
<%if(history.length){%><section class="card mt-4"><div class="card-header"><%=isEn?'Selected refund history':'নির্বাচিত রিফান্ড ইতিহাস'%></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>From</th><th>To</th><th>Reason</th><th>Actor</th><th>Date</th></tr></thead><tbody><%history.forEach(h=>{%><tr><td><%=h.from_status%></td><td><%=h.to_status%></td><td><%=h.reason%></td><td><%=h.actor_name||'System'%></td><td><%=h.created_at%></td></tr><%})%></tbody></table></div></section><%}%>
<p class="mt-3"><%=total%> records · <%=page%>/<%=totalPages||1%></p></div></div><%-include('partials/footer')%>
