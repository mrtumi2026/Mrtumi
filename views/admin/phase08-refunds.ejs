<%- include('partials/head', { title: isEn ? 'Refund review' : 'রিফান্ড পর্যালোচনা' }) %><%- include('partials/topbar') %><%- include('partials/sidebar') %>
<div class="content-page"><div class="content container-fluid py-3"><h1 class="h3"><%=isEn?'Refunds to customer wallet':'ক্রেতার ওয়ালেটে রিফান্ড'%></h1><div class="alert alert-warning"><%=isEn?'When you approve a refund, the money is added to the customer wallet at once. Nothing is sent to bKash, Nagad or a bank. The customer uses the wallet on later orders. Reseller orders are settled with the reseller yourself.':'রিফান্ড অনুমোদন করলে টাকা সাথে সাথে ক্রেতার ওয়ালেটে যোগ হয়। বিকাশ, নগদ বা ব্যাংকে কিছু পাঠানো হয় না। ক্রেতা পরের অর্ডারে ওয়ালেট ব্যবহার করবেন। রিসেলার অর্ডারের হিসাব রিসেলারের সাথে আপনাকে নিজে করতে হবে।'%></div>
<%if(walletDue.length){%><section class="card mb-4"><div class="card-header"><strong><%=isEn?'Returned or cancelled orders with money not yet returned':'রিটার্ন বা বাতিল অর্ডার, যার টাকা এখনও ফেরত হয়নি'%></strong><div class="small text-muted"><%=isEn?'You decide the amount. Reduce it if you keep the delivery charge.':'পরিমাণ আপনি ঠিক করবেন। ডেলিভারি চার্জ কাটতে চাইলে পরিমাণ কমিয়ে দিন।'%></div></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th><%=isEn?'Invoice':'ইনভয়েস'%></th><th><%=isEn?'Customer':'গ্রাহক'%></th><th><%=isEn?'Received / delivery charge':'পাওয়া টাকা / ডেলিভারি চার্জ'%></th><th><%=isEn?'Add to wallet':'ওয়ালেটে যোগ করুন'%></th></tr></thead><tbody><%walletDue.forEach(o=>{%><tr><td><%=o.invoice_no%><br><small><%=o.order_status%></small></td><td><%=o.customer_name%><br><small><%=o.customer_phone%></small></td><td>৳<%=(Number(o.paid_paisa)/100).toFixed(2)%> / ৳<%=(Number(o.shipping_paisa)/100).toFixed(2)%></td><td><form method="post" action="/admin/phase08/refunds/order/<%=o.id%>/wallet" class="d-flex flex-wrap gap-1"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="request_key" value="<%=o.requestKey%>"><input class="form-control form-control-sm" style="max-width:120px" type="number" name="amount_taka" min="0.01" step="0.01" max="<%=(Number(o.due_paisa)/100).toFixed(2)%>" value="<%=(Number(o.due_paisa)/100).toFixed(2)%>" required aria-label="<%=isEn?'Amount in taka':'পরিমাণ (টাকা)'%>"><input class="form-control form-control-sm" style="max-width:220px" name="reason" required minlength="3" maxlength="255" placeholder="<%=isEn?'Reason':'কারণ'%>"><button class="btn btn-sm btn-success"><%=isEn?'Add to wallet':'ওয়ালেটে দিন'%></button></form></td></tr><%})%></tbody></table></div></section><%}%>
<form class="row g-2 mb-3"><div class="col-md-4"><input class="form-control" name="q" value="<%=query%>" placeholder="<%=isEn?'Invoice or phone':'ইনভয়েস বা ফোন'%>"></div><div class="col-md-3"><select class="form-select" name="status"><option value=""><%=isEn?'All statuses':'সব স্ট্যাটাস'%></option><% ['requested','pending','approved','processing','succeeded','failed','rejected','completed'].forEach(s=>{%><option value="<%=s%>" <%=status===s?'selected':''%>><%=s%></option><%})%></select></div><button class="btn btn-outline-primary col-auto"><%=isEn?'Filter':'ফিল্টার'%></button></form>
<div class="table-responsive card"><table class="table table-striped mb-0"><thead><tr><th># / <%=isEn?'Invoice':'ইনভয়েস'%></th><th><%=isEn?'Customer':'গ্রাহক'%></th><th><%=isEn?'Amount / status':'পরিমাণ / অবস্থা'%></th><th><%=isEn?'Reason':'কারণ'%></th><th><%=isEn?'Review':'পর্যালোচনা'%></th></tr></thead><tbody><%rows.forEach(r=>{%><tr><td><%=r.id%> / <%=r.invoice_no%></td><td><%=r.customer_name%><br><small><%=r.customer_phone%></small></td><td>৳<%=(Number(r.amount_paisa)/100).toFixed(2)%><br><%=r.status%></td><td><%=r.reason%></td><td><%if(r.status==='requested'||r.status==='pending'){%><form method="post" action="/admin/phase08/refunds/<%=r.id%>/decision" class="d-flex flex-wrap gap-1"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="request_key" value="<%=r.decisionKey%>"><input class="form-control form-control-sm" name="reason" required minlength="3" maxlength="255" placeholder="<%=isEn?'Decision reason':'সিদ্ধান্তের কারণ'%>"><button class="btn btn-sm btn-success" name="status" value="approved"><%=isEn?'Approve → wallet':'অনুমোদন → ওয়ালেট'%></button><button class="btn btn-sm btn-outline-danger" name="status" value="rejected"><%=isEn?'Reject':'বাতিল'%></button></form><%}%><a class="small" href="/admin/phase08/refunds?id=<%=r.id%>"><%=isEn?'History':'ইতিহাস'%></a></td></tr><%})%><%if(!rows.length){%><tr><td colspan="5" class="text-center text-muted py-4"><%=isEn?'No refund requests.':'কোনো রিফান্ড অনুরোধ নেই।'%></td></tr><%}%></tbody></table></div>
<%if(history.length){%><section class="card mt-4"><div class="card-header"><%=isEn?'Selected refund history':'নির্বাচিত রিফান্ড ইতিহাস'%></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th><%=isEn?'From':'আগে'%></th><th><%=isEn?'To':'পরে'%></th><th><%=isEn?'Reason':'কারণ'%></th><th><%=isEn?'By':'কে'%></th><th><%=isEn?'Date':'তারিখ'%></th></tr></thead><tbody><%history.forEach(h=>{%><tr><td><%=h.from_status%></td><td><%=h.to_status%></td><td><%=h.reason%></td><td><%=h.actor_name||'System'%></td><td><%=h.created_at%></td></tr><%})%></tbody></table></div></section><%}%>
<p class="mt-3"><%=total%> <%=isEn?'records':'টি রেকর্ড'%> · <%=page%>/<%=totalPages||1%></p></div></div><%-include('partials/footer')%>
