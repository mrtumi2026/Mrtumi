<%- include('partials/head', { title: locale === 'bn' ? 'অমীমাংসিত কুরিয়ার শিপমেন্ট' : 'Ambiguous Courier Shipments' }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>

<div class="content-page">
  <div class="content container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <div>
        <h4 class="fw-bold mb-1"><%= locale === 'bn' ? 'অমীমাংসিত কুরিয়ার শিপমেন্ট মনিটরিং' : 'Ambiguous Courier Shipments Monitoring' %></h4>
        <p class="text-muted mb-0"><%= locale === 'bn' ? 'নেটওয়ার্ক টাইমআউট বা অস্পষ্ট পার্সেল বুকিংয়ের অবস্থা, বয়স ও নিরাপদ রিকনসিলিয়েশন' : 'Track and safely reconcile parcels left in ambiguous states after courier network timeouts' %></p>
      </div>
      <div class="d-flex gap-2">
        <a href="/admin/reseller-commerce" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> <%= locale === 'bn' ? 'রিসেলার কমার্স' : 'Reseller Commerce' %>
        </a>
      </div>
    </div>

    <% if (flash && flash.message) { %>
      <div class="alert alert-<%= flash.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Filter Bar -->
    <div class="card mb-3 shadow-sm border-0">
      <div class="card-body p-3">
        <form method="get" action="/admin/fulfillment/ambiguous-shipments" class="row g-2 align-items-end">
          <div class="col-md-2 col-sm-6">
            <label class="form-label small fw-semibold" for="filterStatus"><%= locale === 'bn' ? 'স্ট্যাটাস' : 'Status' %></label>
            <select class="form-select form-select-sm" id="filterStatus" name="status">
              <option value=""><%= locale === 'bn' ? 'সকল অমীমাংসিত' : 'All Ambiguous' %></option>
              <option value="unknown_timeout" <%= (filters && filters.status === 'unknown_timeout') ? 'selected' : '' %>>unknown_timeout</option>
              <option value="in_review" <%= (filters && filters.status === 'in_review') ? 'selected' : '' %>>in_review</option>
            </select>
          </div>
          <div class="col-md-2 col-sm-6">
            <label class="form-label small fw-semibold" for="filterCourier"><%= locale === 'bn' ? 'কুরিয়ার প্রোভাইডার' : 'Courier Provider' %></label>
            <select class="form-select form-select-sm" id="filterCourier" name="courier">
              <option value=""><%= locale === 'bn' ? 'সকল প্রোভাইডার' : 'All Providers' %></option>
              <option value="steadfast" <%= (filters && filters.courier === 'steadfast') ? 'selected' : '' %>>Steadfast</option>
              <option value="pathao" <%= (filters && filters.courier === 'pathao') ? 'selected' : '' %>>Pathao</option>
              <option value="redx" <%= (filters && filters.courier === 'redx') ? 'selected' : '' %>>RedX</option>
              <option value="mock_courier" <%= (filters && filters.courier === 'mock_courier') ? 'selected' : '' %>>Mock Courier</option>
            </select>
          </div>
          <div class="col-md-2 col-sm-6">
            <label class="form-label small fw-semibold" for="filterAge"><%= locale === 'bn' ? 'ন্যূনতম বয়স' : 'Minimum Age' %></label>
            <select class="form-select form-select-sm" id="filterAge" name="olderThanMinutes">
              <option value="0"><%= locale === 'bn' ? 'সকল সময়' : 'Any age' %></option>
              <option value="15" <%= (filters && Number(filters.olderThanMinutes) === 15) ? 'selected' : '' %>>15+ minutes</option>
              <option value="30" <%= (filters && Number(filters.olderThanMinutes) === 30) ? 'selected' : '' %>>30+ minutes (Stalled)</option>
              <option value="60" <%= (filters && Number(filters.olderThanMinutes) === 60) ? 'selected' : '' %>>60+ minutes (Critical)</option>
            </select>
          </div>
          <div class="col-md-4 col-sm-6">
            <label class="form-label small fw-semibold" for="filterSearch"><%= locale === 'bn' ? 'অনুসন্ধান' : 'Search' %></label>
            <input type="text" class="form-control form-control-sm" id="filterSearch" name="search" placeholder="Invoice #, Customer, Phone..." value="<%= (filters && filters.search) || '' %>">
          </div>
          <div class="col-md-2 col-sm-12 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
              <i class="bi bi-filter"></i> <%= locale === 'bn' ? 'ফিল্টার' : 'Filter' %>
            </button>
            <a href="/admin/fulfillment/ambiguous-shipments" class="btn btn-sm btn-outline-secondary" title="Reset">
              <i class="bi bi-arrow-counterclockwise"></i>
            </a>
          </div>
        </form>
      </div>
    </div>

    <!-- Shipments Table -->
    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small text-muted">
              <tr>
                <th scope="col">#Shipment / Order</th>
                <th scope="col">Customer / Delivery</th>
                <th scope="col">Vendor</th>
                <th scope="col">Courier Provider</th>
                <th scope="col">Status & Age</th>
                <th scope="col">Reconciliations</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (shipments && shipments.length > 0) { %>
                <% shipments.forEach(function(s) { %>
                  <tr class="<%= s.is_stalled ? 'table-warning' : '' %>">
                    <td>
                      <span class="fw-bold">#<%= s.shipment_id %></span>
                      <div class="small text-muted"><%= s.invoice_no %></div>
                      <div class="small font-monospace text-secondary"><%= s.vendor_order_no %></div>
                    </td>
                    <td>
                      <div class="fw-medium"><%= s.customer_name %></div>
                      <div class="small text-muted"><%= s.customer_phone %></div>
                      <div class="small text-truncate" style="max-width: 220px;" title="<%= s.shipping_address %>"><%= s.shipping_address %></div>
                    </td>
                    <td>
                      <div><%= s.vendor_shop_name || '—' %></div>
                      <small class="text-muted"><%= s.vendor_phone || '' %></small>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border font-monospace text-uppercase">
                        <%= s.courier_code || 'Unassigned' %>
                      </span>
                      <% if (s.tracking_id) { %>
                        <div class="small font-monospace text-primary mt-1"><%= s.tracking_id %></div>
                      <% } %>
                    </td>
                    <td>
                      <div>
                        <% if (s.booking_status === 'unknown_timeout') { %>
                          <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> unknown_timeout</span>
                        <% } else if (s.booking_status === 'in_review') { %>
                          <span class="badge bg-info text-dark"><i class="bi bi-search"></i> in_review</span>
                        <% } else { %>
                          <span class="badge bg-secondary"><%= s.booking_status %></span>
                        <% } %>
                      </div>
                      <div class="small mt-1 <%= s.is_stalled ? 'text-danger fw-bold' : 'text-muted' %>">
                        <%= s.age_minutes %> min ago
                        <% if (s.is_stalled) { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1">Stalled</span>
                        <% } %>
                      </div>
                    </td>
                    <td>
                      <span class="badge bg-secondary-subtle text-secondary border">
                        <%= s.reconciliation_attempts %> attempts
                      </span>
                      <% if (s.last_reconciled_at) { %>
                        <div class="small text-muted mt-1"><%= new Date(s.last_reconciled_at).toLocaleTimeString() %></div>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <div class="d-inline-flex gap-1">
                        <!-- Reconcile Now -->
                        <form method="post" action="/admin/fulfillment/sub-orders/<%= s.vendor_sub_order_id %>/reconcile-booking" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="redirect" value="/admin/fulfillment/ambiguous-shipments">
                          <button type="submit" class="btn btn-sm btn-outline-primary" title="Reconcile with carrier API">
                            <i class="bi bi-arrow-repeat"></i> <%= locale === 'bn' ? 'রিকনসাইল' : 'Reconcile' %>
                          </button>
                        </form>

                        <!-- Audit History Modal Trigger -->
                        <button type="button" class="btn btn-sm btn-outline-info" onclick="openAuditModal(<%= s.shipment_id %>)" title="View Audit Trail">
                          <i class="bi bi-journal-text"></i>
                        </button>

                        <!-- Super Admin Override Modal Trigger -->
                        <button type="button" class="btn btn-sm btn-outline-warning" onclick="openOverrideModal(<%= s.shipment_id %>, '<%= s.invoice_no %>', '<%= s.courier_code %>')" title="Super Admin Override">
                          <i class="bi bi-shield-lock"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">
                    <i class="bi bi-check2-circle fs-2 text-success d-block mb-1"></i>
                    <%= locale === 'bn' ? 'কোনো অমীমাংসিত শিপমেন্ট পাওয়া যায়নি।' : 'No ambiguous or timed-out courier shipments found.' %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <% if (pagination && pagination.totalPages > 1) { %>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
          <small class="text-muted">
            Total <%= pagination.total %> shipments · Page <%= pagination.page %> of <%= pagination.totalPages %>
          </small>
          <ul class="pagination pagination-sm mb-0">
            <% if (pagination.page > 1) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= pagination.page - 1 %>&status=<%= (filters && filters.status) || '' %>&courier=<%= (filters && filters.courier) || '' %>&olderThanMinutes=<%= (filters && filters.olderThanMinutes) || '' %>&search=<%= (filters && filters.search) || '' %>">Prev</a>
              </li>
            <% } %>
            <li class="page-item active"><span class="page-link"><%= pagination.page %></span></li>
            <% if (pagination.page < pagination.totalPages) { %>
              <li class="page-item">
                <a class="page-link" href="?page=<%= pagination.page + 1 %>&status=<%= (filters && filters.status) || '' %>&courier=<%= (filters && filters.courier) || '' %>&olderThanMinutes=<%= (filters && filters.olderThanMinutes) || '' %>&search=<%= (filters && filters.search) || '' %>">Next</a>
              </li>
            <% } %>
          </ul>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal: Super Admin Manual Override -->
<div class="modal fade" id="overrideModal" tabindex="-1" aria-labelledby="overrideModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="overrideForm" method="post" action="">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="redirect" value="/admin/fulfillment/ambiguous-shipments">
        <div class="modal-header bg-warning-subtle">
          <h5 class="modal-title text-dark fw-bold" id="overrideModalLabel">
            <i class="bi bi-shield-exclamation text-warning me-1"></i> Super Admin Manual Override
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-warning small py-2 mb-3">
            <i class="bi bi-info-circle-fill me-1"></i>
            <strong>Policy Enforcement:</strong> Manual override requires verified evidence from the carrier merchant portal and Super Admin approval. Retrying or overriding without carrier evidence is strictly prohibited.
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold" for="overrideResolution">Resolution Action <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" id="overrideResolution" name="resolution" required onchange="toggleTrackingField()">
              <option value="confirm_parcel_exists">Carrier Confirmed: Parcel Exists (Mark Succeeded)</option>
              <option value="confirm_parcel_absent">Carrier Confirmed: No Parcel Created (Mark Failed & Unlock Safe Retry)</option>
            </select>
          </div>

          <div class="mb-3" id="trackingRefGroup">
            <label class="form-label small fw-semibold" for="overrideTracking">Carrier Tracking Reference <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm font-monospace" id="overrideTracking" name="tracking_reference" placeholder="e.g. SF-TRK-98765 or Consignment ID">
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold" for="overrideEvidence">Carrier / Provider Evidence Reference <span class="text-danger">*</span></label>
            <textarea class="form-control form-control-sm" id="overrideEvidence" name="provider_evidence" rows="2" minlength="5" placeholder="e.g. Steadfast Merchant Portal Ticket #45123, Agent Fahim confirmed parcel cancelled" required></textarea>
            <div class="form-text small">Mandatory minimum 5 characters documenting carrier proof.</div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold" for="overrideNote">Internal Audit Note (Optional)</label>
            <input type="text" class="form-control form-control-sm" id="overrideNote" name="note" placeholder="Additional escalation details">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-warning fw-semibold">
            <i class="bi bi-check-circle"></i> Confirm Super Admin Override
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Audit Trail -->
<div class="modal fade" id="auditModal" tabindex="-1" aria-labelledby="auditModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="auditModalLabel">
          <i class="bi bi-journal-text me-1"></i> Shipment Audit Trail & History
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="auditModalBody">
        <div class="text-center py-4">
          <div class="spinner-border spinner-border-sm text-primary" role="status"></div> Loading audit trail...
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
function openOverrideModal(shipmentId, invoiceNo, courierCode) {
  const form = document.getElementById('overrideForm');
  form.action = '/admin/fulfillment/shipments/' + shipmentId + '/manual-override';
  document.getElementById('overrideTracking').value = '';
  document.getElementById('overrideEvidence').value = '';
  document.getElementById('overrideNote').value = '';
  toggleTrackingField();
  new bootstrap.Modal(document.getElementById('overrideModal')).show();
}

function toggleTrackingField() {
  const res = document.getElementById('overrideResolution').value;
  const group = document.getElementById('trackingRefGroup');
  const input = document.getElementById('overrideTracking');
  if (res === 'confirm_parcel_exists') {
    group.style.display = 'block';
    input.required = true;
  } else {
    group.style.display = 'none';
    input.required = false;
  }
}

async function openAuditModal(shipmentId) {
  const modalBody = document.getElementById('auditModalBody');
  modalBody.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"></div> Loading audit history...</div>';
  new bootstrap.Modal(document.getElementById('auditModal')).show();

  try {
    const res = await fetch('/admin/fulfillment/shipments/' + shipmentId + '/audit-trail', {
      headers: { 'Accept': 'application/json' }
    });
    const json = await res.json();
    if (!json.success || !json.data) {
      modalBody.innerHTML = '<div class="alert alert-danger">Failed to load audit history.</div>';
      return;
    }

    const { shipment, events } = json.data;
    let html = '<div class="mb-3 p-2 bg-light rounded small">';
    html += '<div class="row g-2">';
    html += '<div class="col-6"><strong>Invoice:</strong> ' + (shipment.invoiceNo || '—') + '</div>';
    html += '<div class="col-6"><strong>Sub-Order:</strong> ' + (shipment.vendorOrderNo || '—') + '</div>';
    html += '<div class="col-6"><strong>Courier:</strong> ' + (shipment.courierCode || '—') + '</div>';
    html += '<div class="col-6"><strong>Tracking:</strong> ' + (shipment.trackingId || '—') + '</div>';
    html += '<div class="col-6"><strong>Status:</strong> <span class="badge bg-warning text-dark">' + (shipment.bookingStatus || '—') + '</span></div>';
    html += '<div class="col-6"><strong>Idempotency Key:</strong> <code class="small">' + (shipment.bookingIdempotencyKey || '—') + '</code></div>';
    html += '</div></div>';

    html += '<h6 class="fw-bold mb-2">Event Timeline</h6>';
    if (!events || events.length === 0) {
      html += '<p class="text-muted small">No recorded audit events.</p>';
    } else {
      html += '<ul class="list-group list-group-flush border rounded small">';
      events.forEach(function(e) {
        html += '<li class="list-group-item d-flex justify-content-between align-items-start">';
        html += '<div>';
        html += '<div class="fw-bold">' + e.eventType + ' <span class="badge bg-secondary-subtle text-secondary ms-1">' + e.resultCode + '</span></div>';
        html += '<div class="text-secondary">' + (e.note || '') + '</div>';
        html += '<small class="text-muted">Actor: ' + e.actorType + ' (' + e.userName + ')</small>';
        html += '</div>';
        html += '<div class="text-muted font-monospace" style="font-size:0.75rem;">' + new Date(e.createdAt).toLocaleString() + '</div>';
        html += '</li>';
      });
      html += '</ul>';
    }

    modalBody.innerHTML = html;
  } catch (err) {
    modalBody.innerHTML = '<div class="alert alert-danger">Error loading audit trail: ' + err.message + '</div>';
  }
}
</script>

<%- include('partials/footer') %>
