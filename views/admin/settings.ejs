<%- include('partials/head', { title: pageTitle }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>

<div class="content-page">
  <div class="content">
    <div class="db-heading">
      <h1>⚙️ <%= pageTitle %></h1>
      <p>সকল পরিবর্তন তাৎক্ষণিক ডাটাবেসে সংরক্ষিত হবে এবং কাস্টমার সাইটে কার্যকর হবে</p>
    </div>

    <% if (section === 'custom_sms') { %>
      <div class="row g-3">
        <div class="col-lg-5">
          <form action="/admin/sms/custom-send" method="POST" class="tbl-card p-4">
            <h6 class="fw-bold mb-3">Send Instant SMS (BulkSMSBD)</h6>
            <div class="mb-3">
              <label class="form-label small fw-semibold">Recipient Phone Numbers (comma separated) *</label>
              <input type="text" name="recipient" id="smsRecipients" class="form-control" placeholder="01711..., 01815..." required />
              <div class="form-text">নিচের কাস্টমার তালিকা থেকে ক্লিক করে যোগ করতে পারেন।</div>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold">SMS Message *</label>
              <textarea name="message" rows="4" class="form-control" required placeholder="প্রিয় গ্রাহক, মি. তুমি গ্রোসারি অ্যান্ড গিফট-এ চলছে বিশেষ অফার!"></textarea>
            </div>
            <button type="submit" class="btn btn-forest w-100">📨 Send SMS Now</button>

            <div class="mt-3 pt-2 border-top">
              <small class="fw-bold text-muted d-block mb-1">Quick Add Customer:</small>
              <div class="d-flex flex-wrap gap-1">
                <% customers.slice(0, 8).forEach(function(c) { %>
                  <button type="button" class="btn btn-sm btn-light border py-0 px-2" onclick="var el=document.getElementById('smsRecipients');el.value = el.value ? (el.value + ', ' + '<%= c.phone %>') : '<%= c.phone %>';">
                    + <%= c.name %>
                  </button>
                <% }) %>
              </div>
            </div>
          </form>
        </div>
        <div class="col-lg-7">
          <div class="tbl-card">
            <div class="tbl-card-head"><h4>Recent Sent SMS Logs (<%= logs.length %>)</h4></div>
            <div class="tbl-card-body">
              <table class="table clean mb-0">
                <thead><tr><th>Recipient</th><th>Message</th><th>Status</th><th>Date</th></tr></thead>
                <tbody>
                  <% if (!logs.length) { %><tr><td colspan="4" class="text-center py-4 text-muted">কোনো SMS পাঠানো হয়নি।</td></tr><% } %>
                  <% logs.forEach(function(l) { %>
                    <tr>
                      <td class="fw-semibold"><%= l.recipient %></td>
                      <td><%= l.message %></td>
                      <td><span class="sb sb-6"><%= l.status %></span></td>
                      <td class="small text-muted"><%= l.created_at %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    <% } else if (section === 'sitemap') { %>
      <div class="tbl-card p-4">
        <h6 class="fw-bold mb-2">Live XML Sitemap</h6>
        <p class="small text-muted">আপনার স্টোরের সকল ক্যাটাগরি ও প্রোডাক্ট নিয়ে স্বয়ংক্রিয়ভাবে Sitemap তৈরি হচ্ছে:</p>
        <div class="d-flex gap-2 align-items-center">
          <code class="p-2 bg-light border rounded">/sitemap.xml</code>
          <a href="/sitemap.xml" target="_blank" class="btn btn-forest btn-sm">↗ View Live Sitemap.xml</a>
        </div>
      </div>

    <% } else if (section === 'cron_jobs') { %>
      <div class="tbl-card p-4">
        <h6 class="fw-bold mb-3">Scheduled Cron Jobs</h6>
        <div class="mb-3 p-3 bg-light rounded border">
          <div class="fw-semibold">1. Steadfast &amp; Pathao Courier Status Auto-Sync</div>
          <code class="small">*/15 * * * * curl -s https://yourdomain.com/admin/steadfast/dashboard-widget</code>
        </div>
        <div class="p-3 bg-light rounded border">
          <div class="fw-semibold">2. Abandoned Checkout Reminder</div>
          <code class="small">0 * * * * node scripts/abandoned-reminder.js</code>
        </div>
      </div>

    <% } else if (section === 'license' || section === 'updates') { %>
      <div class="tbl-card p-4">
        <span class="badge bg-success mb-2">Mr. Tumi Grocery &amp; Gift Platform</span>
        <h5 class="fw-bold"><%= siteSettings.site_name %> — Node.js + Express + MySQL Ready</h5>
        <p class="text-muted small mb-2">
          সকল মডিউল, অর্ডার, ইনভেন্টরি ও সেটিংস পূর্ণ নিয়ন্ত্রণে রয়েছে।
        </p>
        <% if (typeof brand !== 'undefined' && brand && brand.isPlaceholderLogo) { %>
          <div class="mt-copy-review-banner mt-3">
            <span class="mt-copy-review-banner__badge"><%= brand.placeholderBadge %></span>
            <div class="small"><%= brand.placeholderNotice %></div>
          </div>
        <% } %>
      </div>

    <% } else { %>
      <form action="/admin/settings/save" method="POST" enctype="multipart/form-data" class="tbl-card p-4">
        <input type="hidden" name="_redirect" value="<%= currentPath %>" />

        <div class="row g-3">
          <% if (section === 'general' || section === 'contact') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Store Name (বাংলা / English)</label>
              <input type="text" name="site_name" value="<%= siteSettings.site_name || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Tagline</label>
              <input type="text" name="site_tagline" value="<%= siteSettings.site_tagline || '' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Hotline Phone</label>
              <input type="text" name="site_phone" value="<%= siteSettings.site_phone || '' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">WhatsApp Number</label>
              <input type="text" name="site_whatsapp" value="<%= siteSettings.site_whatsapp || '' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Support Email</label>
              <input type="email" name="site_email" value="<%= siteSettings.site_email || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Office / Orchard Address</label>
              <input type="text" name="site_address" value="<%= siteSettings.site_address || '' %>" class="form-control" />
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Inside Dhaka Shipping (৳)</label>
              <input type="number" name="inside_dhaka_charge" value="<%= siteSettings.inside_dhaka_charge || '60' %>" class="form-control" />
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Outside Dhaka Shipping (৳)</label>
              <input type="number" name="outside_dhaka_charge" value="<%= siteSettings.outside_dhaka_charge || '120' %>" class="form-control" />
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Top Notice Bar Text (হোমপেজ স্ক্রলিং নোটিশ)</label>
              <textarea name="special_notice" rows="2" class="form-control"><%= siteSettings.special_notice || '' %></textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Upload New Logo (Optional)</label>
              <input type="file" name="logo_file" accept="image/*" class="form-control" />
            </div>

          <% } else if (section === 'sale_notification' || section === 'popup_offer') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Verified Order Social Proof Toast</label>
              <select name="sale_notification_enabled" class="form-select">
                <option value="1" <%= siteSettings.sale_notification_enabled !== '0' ? 'selected' : '' %>>Enabled (Show on Storefront)</option>
                <option value="0" <%= siteSettings.sale_notification_enabled === '0' ? 'selected' : '' %>>Disabled</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Promotional Welcome Popup</label>
              <select name="popup_offer_enabled" class="form-select">
                <option value="1" <%= siteSettings.popup_offer_enabled === '1' ? 'selected' : '' %>>Enabled</option>
                <option value="0" <%= siteSettings.popup_offer_enabled !== '1' ? 'selected' : '' %>>Disabled</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Popup Offer Headline</label>
              <input type="text" name="popup_offer_title" value="<%= siteSettings.popup_offer_title || '' %>" class="form-control" />
            </div>

          <% } else if (section === 'sms_gateway') { %>
            <div class="col-md-5">
              <label class="form-label small fw-semibold">BulkSMSBD API Key *</label>
              <input type="password" name="bulksms_api_key" value="<%= siteSettings.bulksms_api_key || '' %>" class="form-control" placeholder="API Key বসান..." />
              <div class="form-text">BulkSMSBD ড্যাশবোর্ড থেকে প্রাপ্ত API Key।</div>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Approved Sender ID *</label>
              <input type="text" name="bulksms_sender_id" value="<%= siteSettings.bulksms_sender_id || '' %>" class="form-control" placeholder="যেমন: 8809612... বা Non-masking ID" />
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">SMS Gateway Status</label>
              <select name="bulksms_enabled" class="form-select">
                <option value="1" <%= siteSettings.bulksms_enabled !== '0' ? 'selected' : '' %>>সক্রিয় (Active)</option>
                <option value="0" <%= siteSettings.bulksms_enabled === '0' ? 'selected' : '' %>>নিষ্ক্রিয় (Disabled)</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Current Account Balance</label>
              <div class="input-group">
                <span class="input-group-text">৳</span>
                <input type="text" name="bulksms_balance" value="<%= siteSettings.bulksms_balance || '0.00' %>" class="form-control" readonly />
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">অর্ডার হলে কাস্টমারকে অটো SMS</label>
              <select name="sms_order_customer_enabled" class="form-select">
                <option value="1" <%= siteSettings.sms_order_customer_enabled !== '0' ? 'selected' : '' %>>চালু (Send on New Order)</option>
                <option value="0" <%= siteSettings.sms_order_customer_enabled === '0' ? 'selected' : '' %>>বন্ধ (Disabled)</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">অর্ডার হলে এডমিনকে অটো SMS</label>
              <select name="sms_order_admin_enabled" class="form-select">
                <option value="1" <%= siteSettings.sms_order_admin_enabled !== '0' ? 'selected' : '' %>>চালু (Alert Admin)</option>
                <option value="0" <%= siteSettings.sms_order_admin_enabled === '0' ? 'selected' : '' %>>বন্ধ (Disabled)</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">এডমিন নোটিফিকেশন মোবাইল নম্বর</label>
              <input type="text" name="sms_admin_phone" value="<%= siteSettings.sms_admin_phone || siteSettings.site_phone || '' %>" class="form-control" placeholder="যেমন: 01711223344" />
              <div class="form-text">এই নম্বরে নতুন অর্ডার আসলে তাৎক্ষণিক SMS যাবে।</div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">কুইক অ্যাকশন</label>
              <div class="pt-1">
                <a href="/admin/sms/custom-send" class="btn btn-outline-secondary btn-sm">📨 ম্যানুয়াল SMS পাঠান</a>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">কাস্টমার অর্ডার নিশ্চিতকরণ SMS টেমপ্লেট</label>
              <textarea name="sms_customer_template" rows="2" class="form-control"><%= siteSettings.sms_customer_template || 'প্রিয় {customer_name}, {site_name}-এ আপনার অর্ডার #{invoice_no} সফলভাবে গৃহীত হয়েছে। সর্বমোট: ৳{total_amount}। অর্ডার ট্র্যাক করুন: {tracking_url}' %></textarea>
              <div class="form-text">উপলব্ধ ট্যাগ: {customer_name}, {invoice_no}, {total_amount}, {site_name}, {tracking_url}</div>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">এডমিন নোটিফিকেশন SMS টেমপ্লেট</label>
              <textarea name="sms_admin_template" rows="2" class="form-control"><%= siteSettings.sms_admin_template || 'নতুন অর্ডার! #{invoice_no}, গ্রাহক: {customer_name} ({phone}), মোট: ৳{total_amount}। এরিয়া: {delivery_area} - {site_name}' %></textarea>
              <div class="form-text">উপলব্ধ ট্যাগ: {customer_name}, {phone}, {invoice_no}, {total_amount}, {delivery_area}, {site_name}</div>
            </div>

          <% } else if (section === 'fraud_api' || section === 'order_restriction') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">BD Courier API Key *</label>
              <input type="password" name="bdcourier_api_key" value="<%= siteSettings.bdcourier_api_key || '' %>" class="form-control" placeholder="BD Courier API Key বসান..." />
              <div class="form-text">BD Courier (bdcourier.com) অ্যাকাউন্ট থেকে প্রাপ্ত API Key।</div>
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Courier Fraud Checker</label>
              <select name="bdcourier_enabled" class="form-select">
                <option value="1" <%= siteSettings.bdcourier_enabled !== '0' ? 'selected' : '' %>>সক্রিয় (Active)</option>
                <option value="0" <%= siteSettings.bdcourier_enabled === '0' ? 'selected' : '' %>>নিষ্ক্রিয় (Disabled)</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">BD Courier Plan</label>
              <input type="text" name="bdcourier_plan" value="<%= siteSettings.bdcourier_plan || 'Enterprise / Standard' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">অটো অর্ডার সীমা নিয়ন্ত্রণ (Anti-Spam)</label>
              <select name="order_restriction_enabled" class="form-select">
                <option value="1" <%= siteSettings.order_restriction_enabled !== '0' ? 'selected' : '' %>>সক্রিয় (Active)</option>
                <option value="0" <%= siteSettings.order_restriction_enabled === '0' ? 'selected' : '' %>>নিষ্ক্রিয় (Disabled)</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Max Orders Per Hour (প্রতি ফোন/আইপি)</label>
              <input type="number" name="max_orders_per_hour" value="<%= siteSettings.max_orders_per_hour || '5' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">ডুপ্লিকেট অর্ডার ব্লক সময় (মিনিট)</label>
              <input type="number" name="duplicate_order_block_minutes" value="<%= siteSettings.duplicate_order_block_minutes || '10' %>" class="form-control" />
            </div>
            <div class="col-12 mt-2">
              <a href="/admin/manual-fraud-check" class="btn btn-forest btn-sm">🛡️ ম্যানুয়াল কুরিয়ার ফ্রড চেক পেজে যান</a>
            </div>

          <% } else if (section === 'email') { %>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">SMTP Host</label>
              <input type="text" name="smtp_host" value="<%= siteSettings.smtp_host || '' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">SMTP Port</label>
              <input type="text" name="smtp_port" value="<%= siteSettings.smtp_port || '587' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">SMTP Username</label>
              <input type="text" name="smtp_user" value="<%= siteSettings.smtp_user || '' %>" class="form-control" />
            </div>

          <% } else if (section === 'seo') { %>
            <div class="col-12">
              <label class="form-label small fw-semibold">Meta Title</label>
              <input type="text" name="seo_meta_title" value="<%= siteSettings.seo_meta_title || '' %>" class="form-control" />
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Meta Description</label>
              <textarea name="seo_meta_description" rows="3" class="form-control"><%= siteSettings.seo_meta_description || '' %></textarea>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Meta Keywords</label>
              <input type="text" name="seo_keywords" value="<%= siteSettings.seo_keywords || '' %>" class="form-control" />
            </div>

          <% } else if (section === 'gemini_ai') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Gemini API Key</label>
              <input type="password" name="gemini_api_key" value="<%= siteSettings.gemini_api_key || '' %>" class="form-control" placeholder="AIzaSy..." />
              <div class="form-text">Google AI Studio থেকে প্রাপ্ত API কী।</div>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Gemini Model</label>
              <input type="text" name="gemini_model" value="<%= siteSettings.gemini_model || 'gemini-2.5-flash' %>" class="form-control" />
              <div class="form-text">ডিফল্ট: gemini-2.5-flash বা gemini-1.5-pro</div>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Assistant System Instructions (প্রম্পট)</label>
              <textarea name="gemini_prompt" rows="3" class="form-control" placeholder="আপনি Mr. Tumi ই-কমার্স প্ল্যাটফর্মের একজন বিনয়ী ও সহায়ক সহকারী..."><%= siteSettings.gemini_prompt || '' %></textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">AI Assistant Status</label>
              <select name="gemini_enabled" class="form-select">
                <option value="1" <%= siteSettings.gemini_enabled !== '0' ? 'selected' : '' %>>সক্রিয় (Active)</option>
                <option value="0" <%= siteSettings.gemini_enabled === '0' ? 'selected' : '' %>>নিষ্ক্রিয় (Disabled)</option>
              </select>
            </div>

          <% } else if (section === 'fb_page') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Facebook Page ID</label>
              <input type="text" name="fb_page_id" value="<%= siteSettings.fb_page_id || '' %>" class="form-control" placeholder="1029384756..." />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Facebook Page Access Token</label>
              <input type="password" name="fb_page_access_token" value="<%= siteSettings.fb_page_access_token || '' %>" class="form-control" placeholder="EAAB..." />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Auto-Post on New Product</label>
              <select name="fb_page_auto_post" class="form-select">
                <option value="1" <%= siteSettings.fb_page_auto_post === '1' ? 'selected' : '' %>>Enabled (নতুন পণ্য যুক্ত হলে অটো পোস্ট হবে)</option>
                <option value="0" <%= siteSettings.fb_page_auto_post !== '1' ? 'selected' : '' %>>Disabled (অটো পোস্ট বন্ধ)</option>
              </select>
            </div>

          <% } else if (section === 'social_login') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Google Client ID</label>
              <input type="text" name="google_client_id" value="<%= siteSettings.google_client_id || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Google Client Secret</label>
              <input type="password" name="google_client_secret" value="<%= siteSettings.google_client_secret || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Facebook App ID</label>
              <input type="text" name="facebook_app_id" value="<%= siteSettings.facebook_app_id || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Facebook App Secret</label>
              <input type="password" name="facebook_app_secret" value="<%= siteSettings.facebook_app_secret || '' %>" class="form-control" />
            </div>

          <% } else if (section === 'gtm') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Google Tag Manager Container ID</label>
              <input type="text" name="gtm_id" value="<%= siteSettings.gtm_id || '' %>" class="form-control" placeholder="GTM-XXXXXXX" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">GTM Status</label>
              <select name="gtm_enabled" class="form-select">
                <option value="1" <%= siteSettings.gtm_enabled !== '0' ? 'selected' : '' %>>Active (হেডারে ট্যাগ চালু)</option>
                <option value="0" <%= siteSettings.gtm_enabled === '0' ? 'selected' : '' %>>Disabled</option>
              </select>
            </div>

          <% } else if (section === 'fb_pixel') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Facebook Pixel ID</label>
              <input type="text" name="fb_pixel_id" value="<%= siteSettings.fb_pixel_id || '' %>" class="form-control" placeholder="123456789012345" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Pixel Status</label>
              <select name="fb_pixel_enabled" class="form-select">
                <option value="1" <%= siteSettings.fb_pixel_enabled !== '0' ? 'selected' : '' %>>Active</option>
                <option value="0" <%= siteSettings.fb_pixel_enabled === '0' ? 'selected' : '' %>>Disabled</option>
              </select>
            </div>

          <% } else if (section === 'tiktok_pixel') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">TikTok Pixel ID</label>
              <input type="text" name="tiktok_pixel_id" value="<%= siteSettings.tiktok_pixel_id || '' %>" class="form-control" placeholder="CXXXXXXX..." />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">TikTok Pixel Status</label>
              <select name="tiktok_pixel_enabled" class="form-select">
                <option value="1" <%= siteSettings.tiktok_pixel_enabled !== '0' ? 'selected' : '' %>>Active</option>
                <option value="0" <%= siteSettings.tiktok_pixel_enabled === '0' ? 'selected' : '' %>>Disabled</option>
              </select>
            </div>

          <% } else if (section === 'fb_capi') { %>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Facebook Pixel ID</label>
              <input type="text" name="fb_pixel_id" value="<%= siteSettings.fb_pixel_id || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Conversion API Access Token</label>
              <input type="password" name="fb_capi_token" value="<%= siteSettings.fb_capi_token || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Test Event Code (Optional)</label>
              <input type="text" name="fb_capi_test_code" value="<%= siteSettings.fb_capi_test_code || '' %>" class="form-control" placeholder="TEST12345" />
            </div>

          <% } else { %>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Google Tag Manager ID</label>
              <input type="text" name="gtm_id" value="<%= siteSettings.gtm_id || '' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Facebook Pixel ID</label>
              <input type="text" name="fb_pixel_id" value="<%= siteSettings.fb_pixel_id || '' %>" class="form-control" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">TikTok Pixel ID</label>
              <input type="text" name="tiktok_pixel_id" value="<%= siteSettings.tiktok_pixel_id || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Facebook CAPI Access Token</label>
              <input type="text" name="fb_capi_token" value="<%= siteSettings.fb_capi_token || '' %>" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Gemini AI Model</label>
              <input type="text" name="gemini_model" value="<%= siteSettings.gemini_model || 'gemini-2.5-flash' %>" class="form-control" />
            </div>
          <% } %>
        </div>

        <div class="mt-4 pt-3 border-top">
          <button type="submit" class="btn btn-forest px-4">💾 Save Settings</button>
        </div>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
