<%- include('partials/head', { title: isEn ? 'Order lifecycle' : 'অর্ডার ব্যবস্থাপনা' }) %><%- include('partials/topbar') %><%- include('partials/sidebar') %>
<div class="content-page"><div class="content container-fluid py-3"><h1 class="h3"><%= isEn?'Order lifecycle':'অর্ডার লাইফসাইকেল' %></h1><div class="alert alert-info"><%= isEn?'Confirming an order reserves only available stock; shipping consumes an active reservation. Cancellation releases only reservations actually held.':'অর্ডার নিশ্চিত করলে কেবল উপলভ্য স্টক রিজার্ভ হয়; পাঠানোর সময় সক্রিয় রিজার্ভেশন থেকে স্টক খরচ হয়। বাতিলে কেবল বাস্তবে রাখা রিজার্ভেশন ছাড়া হয়।' %></div>
<form class="row g-2 mb-3"><div class="col-md-4"><input class="form-control" name="q" value="<%= query %>" placeholder="Invoice, customer or phone"></div><div class="col-md-3"><select name="status" class="form-select"><option value=""><%= isEn?'All statuses':'সব স্ট্যাটাস' %></option><% Object.keys(require('../src/repositories/phase08Repository').TRANSITIONS).forEach((s)=>{ %><option value="<%=s%>" <%= status===s?'selected':'' %>><%=s%></option><% }) %></select></div><button class="btn btn-outline-primary col-auto"><%= isEn?'Filter':'ফিল্টার' %></button></form>
<div class="table-responsive card"><table class="table table-striped mb-0"><thead><tr><th>ID / Invoice</th><th><%=isEn?'Customer':'গ্রাহক'%></th><th><%=isEn?'Total / paid':'মোট / পরিশোধ'%></th><th><%=isEn?'Status':'স্ট্যাটাস'%></th><th><%=isEn?'Transition':'পরিবর্তন'%></th></tr></thead><tbody><% rows.forEach((o)=>{ %><tr><td>#<%=o.id%> · <%=o.invoice_no%></td><td><%=o.customer_name%><br><small><%=o.customer_phone%></small></td><td>৳<%= (Number(o.total_paisa||0)/100).toFixed(2) %> / ৳<%= (Number(o.paid_paisa||0)/100).toFixed(2) %><br><small>COD ৳<%= (Number(o.cod_due_paisa||0)/100).toFixed(2) %></small></td><td><%=o.order_status%> · OTP <%=o.otp_status%><br><a class="small" href="/admin/phase08/orders?id=<%=o.id%>"><%=isEn?'History':'ইতিহাস'%></a></td><td><form method="post" action="/admin/phase08/orders/<%=o.id%>/status" class="d-flex flex-wrap gap-1"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="request_key" value="<%=o.requestKey%>"><select class="form-select form-select-sm" name="status" required><option value=""><%=isEn?'Choose':'নির্বাচন'%></option><% (transitions[o.order_status]||[]).forEach((s)=>{ %><option value="<%=s%>"><%=s%></option><% }) %></select><input class="form-control form-control-sm" name="reason" placeholder="<%=isEn?'Reason':'কারণ'%>" minlength="3" maxlength="255" required><button class="btn btn-sm btn-primary"><%=isEn?'Apply':'প্রয়োগ'%></button></form></td></tr><% }) %><% if(!rows.length){%><tr><td colspan="5" class="text-center text-muted py-4"><%=isEn?'No matching orders.':'কোনো অর্ডার নেই।'%></td></tr><%}%></tbody></table></div>
<%if(history.length){%><section class="card mt-4"><div class="card-header"><%=isEn?'Selected order history':'নির্বাচিত অর্ডার ইতিহাস'%></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>From</th><th>To</th><th>Note</th><th>Actor</th><th>Date</th></tr></thead><tbody><%history.forEach(h=>{%><tr><td><%=h.from_status%></td><td><%=h.to_status%></td><td><%=h.note%></td><td><%=h.actor_name||'System'%></td><td><%=h.created_at%></td></tr><%})%></tbody></table></div></section><%}%><p class="mt-3"><%=isEn?'Page':'পৃষ্ঠা'%> <%=page%> / <%=totalPages||1%> · <%=total%> <%=isEn?'orders':'অর্ডার'%></p></div></div><%- include('partials/footer') %>
