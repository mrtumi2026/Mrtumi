<!doctype html><html lang="<%= isEn?'en':'bn' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>D7 Returns</title><link rel="stylesheet" href="/shared/css/mrtumi-design-system.css"><link rel="stylesheet" href="/shared/css/d7-workflows.css"></head><body><main class="container py-4"><h1 class="h3"><%= isEn?'Returns review':'রিটার্ন পর্যালোচনা' %></h1><p><a href="/admin/d7/settings">D7 settings</a> · <a href="/admin/d7/settlements">Settlements</a></p><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Request</th><th>Customer / order</th><th>Claim</th><th>Reason / evidence</th><th>Items and inspection</th><th>Review</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td>#<%= row.id %><br><small><%= row.status %></small></td><td><%= row.customer_name %><br><%= row.invoice_no %></td><td><%= row.claim_type %></td><td><%= row.reason %><% if(row.evidence_path){ %><br><a href="<%= row.evidence_path %>" target="_blank" rel="noopener">Evidence image</a><% } %></td><td><% row.items.forEach(item=>{ %><div class="border rounded p-2 mb-2"><%= item.product_name %> × <%= item.qty %> · <%= item.disposition %><% if(row.status==='approved'&&item.disposition==='pending_inspection'){ %><form method="post" action="/admin/d7/returns/<%= row.id %>/items/<%= item.id %>/inspect" class="d-flex gap-2 flex-wrap mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="disposition" class="form-select form-select-sm" aria-label="Disposition"><option value="restock">Restock (inspected)</option><option value="damaged">Damaged</option><option value="expired">Expired</option><option value="disposal">Disposal</option></select><button class="btn btn-sm btn-outline-primary">Record inspection</button></form><% } %></div><% }) %></td><td><% if(row.status==='requested'||row.status==='escalated'){ %><form method="post" action="/admin/d7/returns/<%= row.id %>/decision" class="d-flex flex-column gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control form-control-sm" name="note" minlength="3" maxlength="500" placeholder="Decision note" required><div class="d-flex gap-1"><button class="btn btn-sm btn-success" name="status" value="approved">Approve</button><button class="btn btn-sm btn-danger" name="status" value="rejected">Reject</button><button class="btn btn-sm btn-warning" name="status" value="escalated">Escalate</button></div></form><% } %></td></tr><% }) %></tbody></table></div></main></body></html>
