<!doctype html><html lang="<%= isEn?'en':'bn' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vendor settlements</title><link rel="stylesheet" href="/shared/css/mrtumi-design-system.css"><link rel="stylesheet" href="/shared/css/d7-workflows.css"></head><body><main class="container py-4"><h1 class="h3">Vendor settlement snapshots</h1><p><a href="/admin/d7/settings">D7 settings</a></p><div class="alert alert-info">Preparation uses delivered order item gross, vendor-configured commission and available settled COD shipment records. Adjustments/refund deductions remain zero unless a supported, reconciled source is implemented. Approval records an internal decision only; no payout is sent.</div><form method="post" action="/admin/d7/settlements/prepare" class="card card-body mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Vendor<select class="form-select" name="vendor_id" required><% vendors.forEach(v=>{ %><option value="<%= v.id %>"><%= v.shop_name %></option><% }) %></select></label><label class="form-label">Period start<input class="form-control" type="date" name="period_start" required></label><label class="form-label">Period end<input class="form-control" type="date" name="period_end" required></label><button class="btn btn-primary align-self-start mt-2">Prepare snapshot</button></form><h2 class="h5">Vendor adjustment (requires independent approval)</h2><form method="post" action="/admin/d7/settlements/adjustments" class="card card-body mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">Vendor<select class="form-select" name="vendor_id" required><% vendors.forEach(v=>{ %><option value="<%= v.id %>"><%= v.shop_name %></option><% }) %></select></label><label class="form-label">Effective date<input class="form-control" type="date" name="effective_date" required></label><label class="form-label">Direction<select class="form-select" name="direction"><option value="credit">Credit</option><option value="debit">Debit (deduction)</option></select></label><label class="form-label">Amount (paisa)<input class="form-control" type="number" min="1" step="1" name="amount_paisa" required></label><label class="form-label">Documented reason<input class="form-control" name="reason" minlength="5" maxlength="255" required></label><button class="btn btn-outline-primary align-self-start">Submit for approval</button></form><h2 class="h5">Adjustment review</h2><div class="table-responsive"><table class="table"><tbody><% adjustments.forEach(a=>{ %><tr><td><%= a.shop_name %></td><td><%= a.effective_date %></td><td><%= a.direction %> · <%= a.amount_paisa %> paisa</td><td><%= a.reason %></td><td><%= a.status %></td><td><% if(a.status==='pending'){ %><form method="post" action="/admin/d7/settlements/adjustments/<%= a.id %>/decision" class="d-flex gap-2 flex-wrap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control" name="note" placeholder="Review note" minlength="3" maxlength="255" required><button class="btn btn-sm btn-success" name="status" value="approved">Approve</button><button class="btn btn-sm btn-danger" name="status" value="rejected">Reject</button></form><% } %></td></tr><% }) %></tbody></table></div><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Vendor / period</th><th>Gross</th><th>Commission</th><th>Adjustments</th><th>Refunds</th><th>COD collected</th><th>Net payable</th><th>Status / approval</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.shop_name %><br><small><%= r.period_start %>–<%= r.period_end %></small></td><td><%= r.gross_paisa %> paisa</td><td><%= r.commission_paisa %> paisa</td><td><%= r.adjustments_paisa %> paisa</td><td><%= r.refunds_paisa %> paisa</td><td><%= r.cod_collection_paisa %> paisa</td><td><%= r.net_payable_paisa %> paisa</td><td><%= r.status %><% if(r.status==='prepared'){ %><form method="post" action="/admin/d7/settlements/<%= r.id %>/approve" class="mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-success">Approve (no payout)</button></form><% } %></td></tr><% }) %></tbody></table></div></main></body></html>
