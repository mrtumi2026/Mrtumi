<%- include('partials/head', { title: t('admin.menu.dashboard') }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>

<div class="content-page">
  <div class="content">
    <div class="db-wrap">
      <!-- Heading -->
      <div class="db-heading d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <h1><%= t('admin.dashboardHeading') %></h1>
          <p class="text-muted mb-0"><%= t('admin.dashboardSub') %> &bull; <%= fmt.date(new Date()) %></p>
        </div>
        <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2.5 py-1.5">
          <%= brand && brand.isPlaceholderLogo ? brand.placeholderBadge : siteSettings.site_name %>
        </span>
      </div>

      <!-- Quick Operational Action Cards -->
      <section aria-label="<%= t('admin.quickActionsTitle') %>" class="mb-3">
        <div class="row g-2">
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/admin/order/create" class="mt-quick-action-tile">
              <span aria-hidden="true">🧾</span><span><%= t('admin.posBtn') %></span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/admin/order/pending" class="mt-quick-action-tile">
              <span aria-hidden="true">⏳</span><span><%= t('admin.menu.pending') %> (<%= fmt.number(pendingOrders) %>)</span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/admin/products/create" class="mt-quick-action-tile">
              <span aria-hidden="true">➕</span><span><%= t('admin.menu.productCreate') %></span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/admin/inhouse-products/manage" class="mt-quick-action-tile">
              <span aria-hidden="true">📦</span><span><%= t('admin.menu.products') %> (<%= fmt.number(totalProducts) %>)</span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/admin/settings/manage" class="mt-quick-action-tile">
              <span aria-hidden="true">⚙️</span><span><%= t('admin.menu.generalSettings') %></span>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/" target="_blank" rel="noopener" class="mt-quick-action-tile">
              <span aria-hidden="true">🌐</span><span><%= t('admin.viewStore') %></span>
            </a>
          </div>
        </div>
      </section>

      <!-- Top Row: BulkSMSBD + BD Courier + Steadfast -->
      <div class="dash-top-row">
        <!-- BulkSMSBD Balance -->
        <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:38px;height:38px;border-radius:9px;background:#eff6ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.65 3.35 2 2 0 0 1 3.62 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 5.49 5.49l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 15.42z"/></svg>
            </div>
            <div>
              <span style="font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:#9ca3af;">BulkSMSBD Balance</span>
              <div style="display:flex;align-items:baseline;gap:8px;">
                <span id="sms-bal-val" style="font-size:20px;font-weight:700;color:#111827;letter-spacing:-.3px;">—</span>
                <span id="sms-bal-msg" style="font-size:12px;color:#9ca3af;">Click to check</span>
              </div>
            </div>
          </div>
          <button onclick="fetchSmsBalance()" id="sms-bal-btn" type="button"
            style="display:inline-flex;align-items:center;gap:6px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:500;color:#374151;cursor:pointer;">
            <svg id="sms-bal-ico" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.48-3.44"/></svg>
            Refresh
          </button>
        </div>

        <!-- BD Courier Plan -->
        <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:14px 20px;display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:10px;">
          <div style="display:flex;align-items:flex-start;gap:12px;flex:1;min-width:0;">
            <div style="width:38px;height:38px;border-radius:9px;background:#f0f7f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#243b22" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div style="min-width:0;">
              <span style="font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:#9ca3af;">BD Courier · My Plan</span>
              <div id="bd-plan-main" style="font-size:16px;font-weight:700;color:#111827;margin-top:2px;line-height:1.25;">—</div>
              <div id="bd-plan-detail" style="font-size:12px;color:#6b7280;margin-top:4px;line-height:1.45;white-space:pre-line;"></div>
            </div>
          </div>
          <button type="button" onclick="fetchBdCourierPlan()" id="bd-plan-btn"
            style="display:inline-flex;align-items:center;gap:6px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:500;color:#374151;cursor:pointer;align-self:center;">
            <svg id="bd-plan-ico" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.48-3.44"/></svg>
            Refresh
          </button>
        </div>

        <!-- Steadfast Courier -->
        <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:14px 20px;display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:10px;">
          <div style="display:flex;align-items:flex-start;gap:12px;flex:1;min-width:0;">
            <div style="width:38px;height:38px;border-radius:9px;background:#faf5ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div style="min-width:0;">
              <span style="font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:#9ca3af;">Steadfast Courier</span>
              <div id="sf-main" style="font-size:17px;font-weight:700;color:#111827;margin-top:2px;line-height:1.25;">—</div>
              <div id="sf-detail" style="font-size:12px;color:#6b7280;margin-top:4px;line-height:1.45;white-space:pre-line;"></div>
            </div>
          </div>
          <button type="button" onclick="fetchSteadfastWidget()" id="sf-btn"
            style="display:inline-flex;align-items:center;gap:6px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:500;color:#374151;cursor:pointer;align-self:center;">
            <svg id="sf-ico" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.48-3.44"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <!-- Traffic Source Breakdown -->
      <div style="background:#fff;border:1px solid #eaecf0;border-radius:12px;padding:18px 20px;margin-bottom:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:14px;">
          <div>
            <h4 style="font-size:14px;font-weight:700;color:#1a1f2e;margin:0;">Traffic Source</h4>
            <p style="font-size:11px;color:#9ca3af;margin:2px 0 0;">অর্ডার কোথা থেকে এসেছে &bull; মোট <%= totalOrders %> অর্ডার</p>
          </div>
          <span style="font-size:11px;color:#6b7280;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:4px 10px;">Auto-tracked</span>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(195px,1fr));gap:10px;">
          <% trafficSources.forEach(function(ts) {
               const barColor = ts.source === 'Facebook' ? '#1877F2' : (ts.source === 'Direct' ? '#6366f1' : '#64748b');
               const iconBg = ts.source === 'Facebook' ? '#1877F2' : (ts.source === 'Direct' ? '#6366f1' : '#64748b');
          %>
            <div style="background:#f9fafb;border:1px solid #eaecf0;border-radius:10px;padding:12px 14px;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <div style="display:flex;align-items:center;gap:8px;">
                  <span style="width:22px;height:22px;border-radius:6px;background:<%= iconBg %>;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;">
                    <% if (ts.source === 'Facebook') { %>f<% } else if (ts.source === 'Direct') { %>⌂<% } else { %>🌐<% } %>
                  </span>
                  <span style="font-size:12.5px;font-weight:600;color:#1a1f2e;"><%= ts.source %></span>
                </div>
                <span style="font-size:13.5px;font-weight:700;color:#111827;"><%= ts.count %></span>
              </div>
              <div style="background:#e5e7eb;border-radius:4px;height:5px;overflow:hidden;">
                <div style="height:100%;width:<%= ts.percent %>%;background:<%= barColor %>;border-radius:4px;"></div>
              </div>
              <span style="font-size:10.5px;color:#9ca3af;margin-top:4px;display:block;"><%= ts.percent %>%</span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- 4 Main Stat Cards -->
      <div class="stat-grid">
        <div class="sc">
          <div class="sc-ico" style="background:#eff6ff;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </div>
          <div>
            <div class="sc-label">Total Orders</div>
            <div class="sc-val"><%= totalOrders %></div>
            <div class="sc-note"><%= pendingOrders %> pending</div>
          </div>
        </div>

        <div class="sc">
          <div class="sc-ico" style="background:#f0fdf4;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div>
            <div class="sc-label">Total Revenue</div>
            <div class="sc-val">৳<%= Number(totalRevenue).toLocaleString('en-IN') %></div>
            <div class="sc-note"><%= deliveredCount %> delivered</div>
          </div>
        </div>

        <div class="sc">
          <div class="sc-ico" style="background:#fffbeb;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <div>
            <div class="sc-label">Pending Orders</div>
            <div class="sc-val"><%= pendingOrders %></div>
            <div class="sc-note">Need attention</div>
          </div>
        </div>

        <div class="sc">
          <div class="sc-ico" style="background:#fff1f2;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div>
            <div class="sc-label">Low Stock</div>
            <div class="sc-val"><%= lowStockCount %></div>
            <div class="sc-note">Below 10 units</div>
          </div>
        </div>
      </div>

      <!-- Today's Snapshot -->
      <div class="section-label">Today's Snapshot</div>
      <div class="snap-grid">
        <div class="sn">
          <div class="sn-top">
            <span class="sn-name">Orders</span>
            <span class="sn-badge" style="background:#eff6ff;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </span>
          </div>
          <div class="sn-val"><%= todayOrders %></div>
          <div class="sn-sub">Orders placed today</div>
        </div>

        <div class="sn">
          <div class="sn-top">
            <span class="sn-name">Revenue</span>
            <span class="sn-badge" style="background:#f0fdf4;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
          </div>
          <div class="sn-val">৳<%= Number(todayRevenue).toLocaleString('en-IN') %></div>
          <div class="sn-sub">Revenue today</div>
        </div>

        <div class="sn">
          <div class="sn-top">
            <span class="sn-name">Delivered</span>
            <span class="sn-badge" style="background:#f0fdf4;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
          </div>
          <div class="sn-val">৳<%= Number(todayDeliveredRev).toLocaleString('en-IN') %></div>
          <div class="sn-sub">Delivered revenue</div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="section-label">Quick Actions</div>
      <div class="qa-grid">
        <a href="/admin/products/create" class="qa">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Product
        </a>
        <a href="/admin/order/all" class="qa">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="2"/></svg>
          View Orders
        </a>
        <a href="/admin/categories/manage" class="qa">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Categories
        </a>
        <a href="/admin/inhouse-products/manage" class="qa">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          Products
        </a>
      </div>

      <!-- Charts Row -->
      <div class="chart-row">
        <div class="chart-box">
          <div class="chart-box-title">Order Trend</div>
          <div class="chart-box-sub">Last 7 days</div>
          <div id="trendChart"></div>
        </div>
        <div class="chart-box">
          <div class="chart-box-title">Order Status</div>
          <div class="chart-box-sub">All time breakdown</div>
          <div id="statusChart"></div>
        </div>
      </div>

      <!-- Products & Categories Two Column -->
      <div class="two-col">
        <div class="tbl-card">
          <div class="tbl-card-head">
            <h4>Products <span style="font-weight:400;color:#9ca3af;font-size:12px;">(<%= totalProducts %>)</span></h4>
            <a href="/admin/inhouse-products/manage" class="link-green">View all</a>
          </div>
          <div class="tbl-card-body">
            <table class="table clean mb-0">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Stock</th>
                </tr>
              </thead>
              <tbody>
                <% dashboardProducts.forEach(function(p) { %>
                  <tr>
                    <td>
                      <div style="display:flex;align-items:center;gap:10px;">
                        <img src="<%= p.image %>" class="p-thumb" alt="<%= p.name %>" />
                        <a href="/admin/products/edit/<%= p.id %>" class="text-dark text-decoration-none" style="font-weight:500;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;">
                          <%= p.name %>
                        </a>
                      </div>
                    </td>
                    <td style="color:#6b7280;"><%= p.category_name || '—' %></td>
                    <td style="font-weight:600;">৳<%= Number(p.new_price).toLocaleString('en-IN') %></td>
                    <td>
                      <span class="sb <%= p.stock < 10 ? 'sb-7' : 'sb-6' %>"><%= p.stock %></span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="tbl-card">
          <div class="tbl-card-head">
            <h4>Product Categories</h4>
            <a href="/admin/categories/manage" class="link-green">View all</a>
          </div>
          <div class="tbl-card-body">
            <% dashboardCategories.forEach(function(cat) { %>
              <div class="cat-item">
                <div class="cat-item-left">
                  <div class="cat-dot"></div>
                  <span><%= cat.name %></span>
                </div>
                <span class="cat-pill"><%= cat.product_count %></span>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Recent Orders -->
      <div class="tbl-card mb-4">
        <div class="tbl-card-head">
          <h4>Recent Orders</h4>
          <a href="/admin/order/all" class="link-green">View all</a>
        </div>
        <div class="tbl-card-body">
          <table class="table clean mb-0">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Invoice</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% recentOrders.forEach(function(o) { %>
                <tr>
                  <td style="font-weight:500;"><%= o.customer_name %></td>
                  <td style="color:#6b7280;">#<%= o.invoice_id %></td>
                  <td style="font-weight:600;">৳<%= Number(o.amount).toLocaleString('en-IN') %></td>
                  <td><span class="sb <%= o.badge_class %>"><%= o.status_label %></span></td>
                  <td style="color:#9ca3af;white-space:nowrap;"><%= String(o.created_at).slice(0, 10) %></td>
                  <td>
                    <a href="/admin/order/view/<%= o.id %>" class="btn btn-sm btn-outline-dark py-0 px-2" style="font-size:11.5px;">Process</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Finance Summary -->
      <div class="section-label">Finance Summary</div>
      <div class="fin-strip">
        <div class="fin-item">
          <div class="fin-item-label">Fund Balance</div>
          <div class="fin-item-val">৳<%= Number(fundBalance).toLocaleString('en-IN') %></div>
        </div>
        <div class="fin-item">
          <div class="fin-item-label">Total Expenses</div>
          <div class="fin-item-val">৳<%= Number(totalExpenses).toLocaleString('en-IN') %></div>
        </div>
        <div class="fin-item">
          <div class="fin-item-label">Today's Expenses</div>
          <div class="fin-item-val">৳<%= Number(todayExpenses).toLocaleString('en-IN') %></div>
        </div>
        <div class="fin-item">
          <div class="fin-item-label">Monthly Expenses</div>
          <div class="fin-item-val">৳<%= Number(monthlyExpenses).toLocaleString('en-IN') %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 7-Day Trend Area Chart
    new ApexCharts(document.querySelector('#trendChart'), {
      chart: { type: 'area', height: 210, toolbar: { show: false }, fontFamily: 'Inter, sans-serif' },
      series: [{ name: 'Orders', data: <%- JSON.stringify(trendData) %> }],
      xaxis: {
        categories: <%- JSON.stringify(trendLabels) %>,
        labels: { style: { fontSize: '11px', colors: '#9ca3af' } },
        axisBorder: { show: false },
        axisTicks: { show: false }
      },
      yaxis: { labels: { style: { fontSize: '11px', colors: '#9ca3af' } }, min: 0 },
      stroke: { curve: 'smooth', width: 2.2 },
      fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.25, opacityTo: 0.02, stops: [0, 100] } },
      colors: ['#243b22'],
      dataLabels: { enabled: false },
      grid: { borderColor: '#f3f4f6', strokeDashArray: 3 }
    }).render();

    // Order Status Donut Chart
    var sbLabels = <%- JSON.stringify(statusBreakdown.map(s => s.name)) %>;
    var sbSeries = <%- JSON.stringify(statusBreakdown.map(s => s.cnt)) %>;
    var sbColors = <%- JSON.stringify(statusBreakdown.map(s => s.color)) %>;

    new ApexCharts(document.querySelector('#statusChart'), {
      chart: { type: 'donut', height: 225, fontFamily: 'Inter, sans-serif' },
      labels: sbLabels.length ? sbLabels : ['No Orders'],
      series: sbSeries.length ? sbSeries : [0],
      colors: sbColors.length ? sbColors : ['#e5e7eb'],
      legend: { position: 'bottom', fontSize: '12px' },
      dataLabels: { enabled: false },
      plotOptions: {
        pie: {
          donut: {
            size: '68%',
            labels: {
              show: true,
              total: {
                show: true,
                label: 'Total',
                formatter: function(w) {
                  return w.globals.seriesTotals.reduce(function(a, b) { return a + b; }, 0);
                }
              }
            }
          }
        }
      }
    }).render();

    fetchSmsBalance();
    fetchBdCourierPlan();
    fetchSteadfastWidget();
  });

  function fetchSmsBalance() {
    var val = document.getElementById('sms-bal-val');
    var msg = document.getElementById('sms-bal-msg');
    val.textContent = '…';
    fetch('/admin/smsgeteway/balance')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.success) {
          val.textContent = parseFloat(d.balance).toLocaleString('en-BD', { minimumFractionDigits: 2 }) + ' tk';
          msg.textContent = 'Updated ' + new Date().toLocaleTimeString();
          msg.style.color = '#16a34a';
        } else {
          val.textContent = '<%= locale === "bn" ? "অনুপলব্ধ" : "Unavailable" %>';
          msg.textContent = d.message || '<%= locale === "bn" ? "লাইভ ডেটা পাওয়া যায়নি" : "Live data unavailable" %>';
          msg.style.color = '#b91c1c';
        }
      }).catch(function() {
        val.textContent = '<%= locale === "bn" ? "অনুপলব্ধ" : "Unavailable" %>';
        msg.textContent = '<%= locale === "bn" ? "লাইভ ডেটা পাওয়া যায়নি" : "Live data unavailable" %>';
        msg.style.color = '#b91c1c';
      });
  }

  function fetchBdCourierPlan() {
    var main = document.getElementById('bd-plan-main');
    var det = document.getElementById('bd-plan-detail');
    main.textContent = '…';
    fetch('/admin/bdcourier/my-plan')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.success && d.data) {
          main.textContent = d.data.plan_name;
          det.textContent = 'API কল (ব্যবহার): ' + d.data.api_calls + '\nনেক্সট ডিউ ডেট: ' + d.data.next_due_display;
        } else {
          main.textContent = '<%= locale === "bn" ? "অনুপলব্ধ" : "Unavailable" %>';
          det.textContent = d.message || '<%= locale === "bn" ? "লাইভ ডেটা পাওয়া যায়নি" : "Live data unavailable" %>';
        }
      }).catch(function() {
        main.textContent = '<%= locale === "bn" ? "অনুপলব্ধ" : "Unavailable" %>';
        det.textContent = '<%= locale === "bn" ? "লাইভ ডেটা পাওয়া যায়নি" : "Live data unavailable" %>';
      });
  }

  function fetchSteadfastWidget() {
    var main = document.getElementById('sf-main');
    var det = document.getElementById('sf-detail');
    main.textContent = '…';
    fetch('/admin/steadfast/dashboard-widget')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.success) {
          main.textContent = d.balance_display;
          det.textContent = 'ইন রিভিউতে: ' + d.in_review_count + ' টি পার্সেল\nকুরিয়ারে মোট (অ্যাপ): ' + d.courier_pending_orders + ' টি অর্ডার';
        } else {
          main.textContent = '<%= locale === "bn" ? "অনুপলব্ধ" : "Unavailable" %>';
          det.textContent = d.message || '<%= locale === "bn" ? "লাইভ ডেটা পাওয়া যায়নি" : "Live data unavailable" %>';
        }
      }).catch(function() {
        main.textContent = '<%= locale === "bn" ? "অনুপলব্ধ" : "Unavailable" %>';
        det.textContent = '<%= locale === "bn" ? "লাইভ ডেটা পাওয়া যায়নি" : "Live data unavailable" %>';
      });
  }
</script>

<%- include('partials/footer') %>
