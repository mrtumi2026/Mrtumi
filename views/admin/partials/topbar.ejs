      <!-- Topbar Start -->
      <header class="navbar-custom" role="banner">
        <div class="container-fluid">
          <ul class="list-unstyled topnav-menu float-end mb-0 d-flex align-items-center">
            <!-- Quick Order Search -->
            <li class="d-none d-md-flex align-items-center me-2">
              <form action="/admin/order/all" method="GET" class="d-flex" role="search">
                <label for="adminTopSearch" class="visually-hidden"><%= t('admin.searchMenuPlaceholder') %></label>
                <div class="input-group input-group-sm" style="width: 215px;">
                  <input
                    type="search"
                    id="adminTopSearch"
                    name="q"
                    class="form-control border-0"
                    style="background: rgba(255,255,255,0.13); color: #fff; border-radius: 20px 0 0 20px; padding-left: 14px;"
                    placeholder="<%= t('admin.searchMenuPlaceholder') %>"
                  />
                  <button
                    class="btn border-0"
                    type="submit"
                    aria-label="<%= t('common.search') %>"
                    style="background: rgba(255,255,255,0.2); color: #fff; border-radius: 0 20px 20px 0;"
                  >
                    <i data-feather="search" style="width:14px;height:14px;"></i>
                  </button>
                </div>
              </form>
            </li>

            <!-- Bilingual Language Switcher (`বাংলা | EN`) -->
            <li class="d-flex align-items-center px-1 me-1">
              <%- include('../../partials/lang-switch', { variant: 'dark' }) %>
            </li>

            <li class="dropdown d-none d-xl-inline-block">
              <a class="nav-link" data-toggle="fullscreen" href="#" aria-label="Fullscreen" title="Fullscreen">
                <i data-feather="maximize" class="noti-icon"></i>
              </a>
            </li>

            <li class="dropdown d-none d-lg-inline-block px-1">
              <span class="badge bg-success text-white px-2.5 py-1" title="<%= t('admin.liveSystemBadge') %>">
                <i data-feather="check-circle" style="width:12px;height:12px;" class="me-1"></i><%= t('admin.liveSystemBadge') %>
              </span>
            </li>

            <!-- Pending Orders Bell Dropdown -->
            <li class="dropdown notification-list topbar-dropdown">
              <a
                class="nav-link dropdown-toggle"
                data-bs-toggle="dropdown"
                href="#"
                role="button"
                aria-expanded="false"
                aria-label="<%= t('a11y.notifications') %> (<%= pendingOrdersCount || 0 %>)"
              >
                <i data-feather="bell" class="noti-icon"></i>
                <span class="badge bg-danger rounded-circle noti-icon-badge"><%= fmt.number(pendingOrdersCount || 0) %></span>
              </a>
              <div class="dropdown-menu dropdown-menu-end dropdown-lg">
                <div class="dropdown-item noti-title">
                  <h6 class="m-0 d-flex justify-content-between align-items-center fw-bold">
                    <span><%= t('admin.pendingOrdersTitle', { count: fmt.number(pendingOrdersCount || 0) }) %></span>
                    <a href="/admin/order/pending" class="text-success text-decoration-none"><small><%= t('common.viewAll') %></small></a>
                  </h6>
                </div>

                <div class="noti-scroll">
                  <% if (pendingOrdersList && pendingOrdersList.length) { %>
                    <% pendingOrdersList.forEach(function(po) { %>
                      <a href="/admin/order/view/<%= po.id %>" class="dropdown-item notify-item">
                        <div class="notify-icon">
                          <img src="/uploads/default/user.svg" class="img-fluid rounded-circle" alt="" />
                        </div>
                        <p class="notify-details"><%= po.customer_name %></p>
                        <p class="text-muted mb-0 user-msg">
                          <small>#<%= po.invoice_id %> &bull; <%= fmt.bdt(po.amount) %></small>
                        </p>
                      </a>
                    <% }) %>
                  <% } else { %>
                    <div class="p-3 text-center text-muted small"><%= t('admin.noPendingOrders') %></div>
                  <% } %>
                </div>

                <a href="/admin/order/pending" class="dropdown-item text-center text-primary notify-item notify-all">
                  <%= t('admin.viewAllOrders') %> →
                </a>
              </div>
            </li>

            <!-- Admin User Profile -->
            <li class="dropdown notification-list topbar-dropdown">
              <a class="nav-link dropdown-toggle nav-user me-0" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                <img src="<%= (adminUser && adminUser.avatar) || '/uploads/default/user.svg' %>" alt="<%= (adminUser && adminUser.name) || 'Admin' %>" class="rounded-circle" />
                <span class="pro-user-name ms-1 d-none d-sm-inline-block">
                  <%= (adminUser && adminUser.name) || 'Admin' %> <i class="fas fa-chevron-down ms-1" style="font-size:10px;"></i>
                </span>
              </a>
              <div class="dropdown-menu dropdown-menu-end profile-dropdown">
                <div class="dropdown-header noti-title">
                  <h6 class="text-overflow m-0"><%= (adminUser && adminUser.name) || 'Admin' %></h6>
                </div>
                <a href="/admin/dashboard" class="dropdown-item notify-item">
                  <i data-feather="airplay" style="width:15px;height:15px;" class="me-1"></i>
                  <span><%= t('admin.menu.dashboard') %></span>
                </a>
                <a href="/admin/settings/manage" class="dropdown-item notify-item">
                  <i data-feather="settings" style="width:15px;height:15px;" class="me-1"></i>
                  <span><%= t('admin.menu.generalSettings') %></span>
                </a>
                <% if (hasPermission('staff.manage')) { %>
                <a href="/admin/users/manage" class="dropdown-item notify-item">
                  <i data-feather="users" style="width:15px;height:15px;" class="me-1"></i>
                  <span><%= t('admin.menu.admins') %></span>
                </a>
                <% } %>
                <div class="dropdown-divider"></div>
                <form id="logout-form" action="/logout" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="dropdown-item notify-item text-danger border-0 bg-transparent w-100 text-start">
                    <i data-feather="log-out" style="width:15px;height:15px;" class="me-1"></i>
                    <span><%= t('admin.logout') %></span>
                  </button>
                </form>
              </div>
            </li>

            <li class="dropdown notification-list">
              <a href="javascript:void(0);" class="nav-link right-bar-toggle" aria-label="<%= t('admin.themeCustomizer') %>" title="<%= t('admin.themeCustomizer') %>">
                <i data-feather="sliders" class="noti-icon"></i>
              </a>
            </li>
          </ul>

          <!-- LOGO (Explicitly Marked Temporary Placeholder Until Official Owner Assets Arrive) -->
          <div class="logo-box">
            <a
              href="/admin/dashboard"
              class="logo logo-dark text-center"
              data-brand-asset-status="<%= (typeof brand !== 'undefined' && brand && brand.isPlaceholderLogo) ? 'temporary-placeholder' : 'custom' %>"
            >
              <span class="logo-lg">
                <img src="<%= siteSettings.logo_dark %>" alt="<%= siteSettings.site_name %>" height="42" />
              </span>
            </a>
            <a
              href="/admin/dashboard"
              class="logo logo-light text-center"
              data-brand-asset-status="<%= (typeof brand !== 'undefined' && brand && brand.isPlaceholderLogo) ? 'temporary-placeholder' : 'custom' %>"
            >
              <span class="logo-lg">
                <img src="<%= siteSettings.logo_light %>" alt="<%= siteSettings.site_name %>" height="42" />
              </span>
            </a>
          </div>

          <ul class="list-unstyled topnav-menu topnav-menu-left m-0">
            <li>
              <button
                class="button-menu-mobile"
                type="button"
                aria-label="<%= t('a11y.toggleSidebar') %>"
                aria-controls="sidebar-menu"
                aria-expanded="false"
              >
                <i data-feather="menu"></i>
              </button>
            </li>
            <li>
              <a class="nav-link" href="/" target="_blank" rel="noopener">
                <i data-feather="globe" style="width:16px;height:16px;"></i>
                <span><%= t('admin.viewStore') %></span>
              </a>
            </li>
            <li class="d-none d-lg-flex">
              <a class="nav-link" href="/vendor/dashboard" target="_blank" rel="noopener">
                <i data-feather="shopping-bag" style="width:15px;height:15px;"></i>
                <span><%= t('admin.vendorPortal') %></span>
              </a>
            </li>
            <li class="d-none d-lg-flex">
              <a class="nav-link" href="/reseller/dashboard" target="_blank" rel="noopener">
                <i data-feather="user-check" style="width:15px;height:15px;"></i>
                <span><%= t('admin.resellerPortal') %></span>
              </a>
            </li>
            <li class="d-none d-xl-flex">
              <a class="nav-link" href="/admin/order/create">
                <i data-feather="cpu" style="width:16px;height:16px;"></i>
                <span><%= t('admin.posBtn') %></span>
              </a>
            </li>
          </ul>
          <div class="clearfix"></div>
        </div>
      </header>
      <!-- end Topbar -->
