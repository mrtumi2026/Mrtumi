      <!-- Topbar Start -->
      <div class="navbar-custom">
        <div class="container-fluid">
          <ul class="list-unstyled topnav-menu float-end mb-0">
            <!-- Quick Order Search -->
            <li class="d-none d-md-flex align-items-center me-2">
              <form action="/admin/order/all" method="GET" class="d-flex">
                <div class="input-group input-group-sm" style="width: 210px;">
                  <input
                    type="text"
                    name="q"
                    class="form-control border-0"
                    style="background: rgba(255,255,255,0.12); color: #fff; border-radius: 20px 0 0 20px; padding-left: 14px;"
                    placeholder="Invoice / Phone খুঁজুন..."
                  />
                  <button class="btn border-0" type="submit" style="background: rgba(255,255,255,0.18); color: #fff; border-radius: 0 20px 20px 0;">
                    <i data-feather="search" style="width:14px;height:14px;"></i>
                  </button>
                </div>
              </form>
            </li>

            <li class="dropdown d-none d-lg-inline-block">
              <a class="nav-link" data-toggle="fullscreen" href="#" title="Fullscreen">
                <i data-feather="maximize" class="noti-icon"></i>
              </a>
            </li>

            <li class="dropdown d-none d-sm-inline-block px-2">
              <span class="badge bg-success text-white px-2.5 py-1" title="Full Read/Write Live Production Mode">
                <i data-feather="check-circle" style="width:12px;height:12px;" class="me-1"></i>লাইভ মোড
              </span>
            </li>

            <!-- Pending Orders Bell Dropdown -->
            <li class="dropdown notification-list topbar-dropdown">
              <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                <i data-feather="bell" class="noti-icon"></i>
                <span class="badge bg-danger rounded-circle noti-icon-badge"><%= pendingOrdersCount || 0 %></span>
              </a>
              <div class="dropdown-menu dropdown-menu-end dropdown-lg">
                <div class="dropdown-item noti-title">
                  <h6 class="m-0 d-flex justify-content-between align-items-center fw-bold">
                    <span>Pending Orders (<%= pendingOrdersCount || 0 %>)</span>
                    <a href="/admin/order/pending" class="text-success text-decoration-none"><small>View All</small></a>
                  </h6>
                </div>

                <div class="noti-scroll">
                  <% if (pendingOrdersList && pendingOrdersList.length) { %>
                    <% pendingOrdersList.forEach(function(po) { %>
                      <a href="/admin/order/view/<%= po.id %>" class="dropdown-item notify-item">
                        <div class="notify-icon">
                          <img src="/uploads/default/user.svg" class="img-fluid rounded-circle" alt="" />
                        </div>
                        <p class="notify-details"><%= po.customer_name %></p>
                        <p class="text-muted mb-0 user-msg">
                          <small>Invoice : #<%= po.invoice_id %> &bull; ৳<%= po.amount %></small>
                        </p>
                      </a>
                    <% }) %>
                  <% } else { %>
                    <div class="p-3 text-center text-muted small">কোনো পেন্ডিং অর্ডার নেই</div>
                  <% } %>
                </div>

                <a href="/admin/order/pending" class="dropdown-item text-center text-primary notify-item notify-all">
                  View all Pending Orders →
                </a>
              </div>
            </li>

            <!-- Admin User Profile -->
            <li class="dropdown notification-list topbar-dropdown">
              <a class="nav-link dropdown-toggle nav-user me-0" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                <img src="<%= (adminUser && adminUser.avatar) || '/uploads/default/user.svg' %>" alt="user-image" class="rounded-circle" />
                <span class="pro-user-name ms-1">
                  <%= (adminUser && adminUser.name) || 'Admin' %> <i class="fas fa-chevron-down ms-1" style="font-size:10px;"></i>
                </span>
              </a>
              <div class="dropdown-menu dropdown-menu-end profile-dropdown">
                <div class="dropdown-header noti-title">
                  <h6 class="text-overflow m-0">স্বাগতম, <%= (adminUser && adminUser.name) || 'Admin' %>!</h6>
                </div>
                <a href="/admin/dashboard" class="dropdown-item notify-item">
                  <i data-feather="airplay" style="width:15px;height:15px;" class="me-1"></i>
                  <span>Dashboard</span>
                </a>
                <a href="/admin/settings/manage" class="dropdown-item notify-item">
                  <i data-feather="settings" style="width:15px;height:15px;" class="me-1"></i>
                  <span>General Settings</span>
                </a>
                <a href="/admin/users/manage" class="dropdown-item notify-item">
                  <i data-feather="users" style="width:15px;height:15px;" class="me-1"></i>
                  <span>Admin Users</span>
                </a>
                <div class="dropdown-divider"></div>
                <form id="logout-form" action="/logout" method="POST">
                  <button type="submit" class="dropdown-item notify-item text-danger border-0 bg-transparent w-100 text-start">
                    <i data-feather="log-out" style="width:15px;height:15px;" class="me-1"></i>
                    <span>Logout</span>
                  </button>
                </form>
              </div>
            </li>

            <li class="dropdown notification-list">
              <a href="javascript:void(0);" class="nav-link right-bar-toggle" title="Theme Customizer">
                <i data-feather="sliders" class="noti-icon"></i>
              </a>
            </li>
          </ul>

          <!-- LOGO -->
          <div class="logo-box">
            <a href="/admin/dashboard" class="logo logo-dark text-center">
              <span class="logo-lg">
                <img src="<%= siteSettings.logo_dark || '/uploads/settings/logo.svg' %>" alt="Logo" height="44" />
              </span>
            </a>
            <a href="/admin/dashboard" class="logo logo-light text-center">
              <span class="logo-lg">
                <img src="<%= siteSettings.logo_light || '/uploads/settings/logo-light.svg' %>" alt="Logo" height="44" />
              </span>
            </a>
          </div>

          <ul class="list-unstyled topnav-menu topnav-menu-left m-0">
            <li>
              <button class="button-menu-mobile" type="button" aria-label="Toggle Menu">
                <i data-feather="menu"></i>
              </button>
            </li>
            <li>
              <a class="nav-link" href="/" target="_blank">
                <i data-feather="globe" style="width:16px;height:16px;"></i>
                <span>Visit Site</span>
              </a>
            </li>
            <li class="d-none d-lg-flex">
              <a class="nav-link" href="/vendor/dashboard" target="_blank" title="Open Seller / Vendor Portal">
                <i data-feather="shopping-bag" style="width:15px;height:15px;"></i>
                <span>Vendor Panel</span>
              </a>
            </li>
            <li class="d-none d-lg-flex">
              <a class="nav-link" href="/reseller/dashboard" target="_blank" title="Open Dropship / Reseller Portal">
                <i data-feather="user-check" style="width:15px;height:15px;"></i>
                <span>Reseller Panel</span>
              </a>
            </li>
            <li class="d-none d-xl-flex">
              <a class="nav-link" href="/admin/order/create">
                <i data-feather="cpu" style="width:16px;height:16px;"></i>
                <span>POS</span>
              </a>
            </li>
          </ul>
          <div class="clearfix"></div>
        </div>
      </div>
      <!-- end Topbar -->
