<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'bn' %>">
  <head>
    <meta charset="utf-8" />
    <meta name="pb-sid" content="<%= typeof sessionToken !== 'undefined' ? sessionToken : '' %>" />
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
    <title><%= typeof title !== 'undefined' ? title : (typeof t === 'function' ? t('admin.menu.dashboard') : 'Dashboard') %> — <%= siteSettings.site_name %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="shortcut icon" href="<%= siteSettings.favicon || '/uploads/brand/mrtumi-placeholder-favicon.svg' %>" />
    <script src="/frontEnd/js/pb-session.js"></script>

    <!-- Google Fonts: Hind Siliguri (Bangla) + Inter (UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <!-- Toastr & SweetAlert2 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- ApexCharts -->
    <link href="https://cdn.jsdelivr.net/npm/apexcharts@3.44.0/dist/apexcharts.css" rel="stylesheet" />
    <!-- Admin Shell + Mr. Tumi Shared Design System -->
    <link href="/backEnd/css/ubold-admin.css" rel="stylesheet" type="text/css" />
    <link href="/shared/css/mrtumi-design-system.css" rel="stylesheet" type="text/css" />
  </head>

  <body
    data-layout-mode="default"
    data-theme="light"
    data-layout-width="fluid"
    data-topbar-color="dark"
    data-menu-position="fixed"
    data-leftbar-color="dark"
    data-leftbar-size="default"
    data-sidebar-user="false"
    data-confirm-title="<%= typeof t === 'function' ? t('common.confirmDeleteTitle') : 'Are you sure?' %>"
    data-confirm-text="<%= typeof t === 'function' ? t('common.confirmDeleteText') : 'This record will be permanently removed.' %>"
    data-confirm-yes="<%= typeof t === 'function' ? t('common.confirmDeleteYes') : 'Yes, delete' %>"
    data-confirm-cancel="<%= typeof t === 'function' ? t('common.cancel') : 'Cancel' %>"
  >
    <a href="#mainContent" class="mt-skip-link"><%= typeof t === 'function' ? t('a11y.skipToContent') : 'Skip to main content' %></a>
    <div id="wrapper">
