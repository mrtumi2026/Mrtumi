<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="pb-sid" content="<%= typeof sessionToken !== 'undefined' ? sessionToken : '' %>" />
    <title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> - <%= siteSettings.site_name || 'ফল বাজার' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="shortcut icon" href="<%= siteSettings.favicon || '/uploads/settings/logo.svg' %>" />
    <script src="/frontEnd/js/pb-session.js"></script>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome & Material Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <!-- Toastr & SweetAlert2 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- ApexCharts -->
    <link href="https://cdn.jsdelivr.net/npm/apexcharts@3.44.0/dist/apexcharts.css" rel="stylesheet" />
    <!-- UBold / ফল বাজার Admin CSS -->
    <link href="/backEnd/css/ubold-admin.css" rel="stylesheet" type="text/css" />
  </head>

  <body
    data-layout-mode="default"
    data-theme="light"
    data-layout-width="fluid"
    data-topbar-color="dark"
    data-menu-position="fixed"
    data-leftbar-color="dark"
    data-leftbar-size="default"
    data-sidebar-user="false"
  >
    <div id="wrapper">
