<%- include('partials/head', { title: pageTitle }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>
<div class="content-page"><div class="content container-fluid py-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><h1 class="h3 mb-1"><%= pageTitle %></h1><p class="text-muted mb-0"><%= locale === 'en' ? 'MySQL-first product, stock ledger, supplier and purchase order workflows.' : 'MySQL-first পণ্য, স্টক লেজার, সরবরাহকারী ও পারচেজ অর্ডার ব্যবস্থাপনা।' %></p></div>
    <div class="d-flex gap-2"><a href="/admin/phase06/products/export.csv" class="btn btn-outline-success"><%= locale === 'en' ? 'Export product CSV' : 'পণ্য CSV রপ্তানি' %></a><a href="/admin/phase06/inventory.json" class="btn btn-outline-success">Inventory JSON</a></div>
  </div>
  <div class="alert alert-info"><strong><%= locale === 'en' ? 'Stock integrity:' : 'স্টক অখণ্ডতা:' %></strong> <%= locale === 'en' ? 'Product edits do not directly overwrite stock. Only opening stock (new products), ledger adjustments and confirmed purchase receipts change on-hand quantities. New purchase orders never add stock.' : 'পণ্য সম্পাদনা সরাসরি স্টক পরিবর্তন করে না। শুধু নতুন পণ্যের opening stock, লেজার adjustment ও নিশ্চিত purchase receipt স্টক পরিবর্তন করে। নতুন purchase order স্টক বাড়ায় না।' %></div>

  <section class="card shadow-sm mb-4" id="product-csv"><div class="card-header"><h2 class="h5 mb-0"><%= locale === 'en' ? 'Bulk product CSV update' : 'একাধিক পণ্যের CSV আপডেট' %></h2></div><div class="card-body">
    <p class="text-muted"><%= locale === 'en' ? 'Import updates existing products by unique SKU only. SKU and barcode are identity checks; barcode is read-only. Pricing/cost and catalog fields follow the existing product-edit validation. Stock, reservations, variants, image/media, approval and archive/status are never imported. Every row must be valid; one invalid row blocks the entire commit. Maximum 100 data rows and 1 MiB.' : 'ইমপোর্টে শুধু অনন্য SKU দিয়ে বিদ্যমান পণ্য আপডেট হয়। SKU ও বারকোড পরিচয় যাচাই; বারকোড পরিবর্তনযোগ্য নয়। মূল্য/ক্রয়মূল্য ও ক্যাটালগ ফিল্ড বিদ্যমান পণ্য-সম্পাদনার যাচাই অনুসরণ করে। স্টক, রিজার্ভেশন, ভ্যারিয়েন্ট, ছবি/মিডিয়া, অনুমোদন, আর্কাইভ/স্ট্যাটাস কখনো ইমপোর্ট হয় না। সব সারি বৈধ হতে হবে; একটি অবৈধ সারি সম্পূর্ণ কমিট আটকে দেয়। সর্বোচ্চ ১০০টি ডেটা সারি ও ১ MiB।' %></p>
    <form method="post" action="/admin/phase06/products/import/preview" class="vstack gap-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="form-label" for="product-csv-text"><%= locale === 'en' ? 'Paste exported product CSV' : 'রপ্তানি করা পণ্য CSV পেস্ট করুন' %></label>
      <textarea class="form-control font-monospace" id="product-csv-text" name="csv_text" rows="10" maxlength="1048576" required></textarea>
      <small class="text-muted"><%= locale === 'en' ? 'Required header: sku, barcode, name_bn, name_en, slug, product_type, category_id, brand_id, unit_label, regular_price_bdt, sale_price_bdt, cost_price_bdt, wholesale_price_bdt, wholesale_min_qty, low_stock_threshold, short_desc_bn, short_desc_en, description_bn, description_en. Preview is read-only; a separate confirmation is required to write.' : 'আবশ্যিক হেডার: sku, barcode, name_bn, name_en, slug, product_type, category_id, brand_id, unit_label, regular_price_bdt, sale_price_bdt, cost_price_bdt, wholesale_price_bdt, wholesale_min_qty, low_stock_threshold, short_desc_bn, short_desc_en, description_bn, description_en। প্রিভিউ শুধু যাচাই করে; লেখার জন্য আলাদা নিশ্চিতকরণ দরকার।' %></small>
      <div><button class="btn btn-outline-primary" type="submit"><%= locale === 'en' ? 'Validate and preview (no product changes)' : 'যাচাই ও প্রিভিউ (পণ্য পরিবর্তন হবে না)' %></button></div>
    </form>
  </div></section>

  <section class="card shadow-sm mb-4" id="products"><div class="card-header"><h2 class="h5 mb-0"><%= locale === 'en' ? 'Create Product' : 'নতুন পণ্য' %></h2></div><div class="card-body">
    <form method="post" action="/admin/phase06/products" class="row g-3" enctype="application/x-www-form-urlencoded">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-3"><label class="form-label" for="p-sku"><%= t('catalogAdmin.skuLabel') %> *</label><input class="form-control" id="p-sku" name="sku" maxlength="64" required></div>
      <div class="col-md-3"><label class="form-label" for="p-barcode"><%= t('catalogAdmin.barcodeLabel') %></label><input class="form-control" id="p-barcode" name="barcode" maxlength="64"></div>
      <div class="col-md-3"><label class="form-label" for="p-bn"><%= locale === 'en' ? 'Name (Bangla)' : 'পণ্যের নাম (বাংলা)' %> *</label><input class="form-control" id="p-bn" name="name_bn" maxlength="255" required></div>
      <div class="col-md-3"><label class="form-label" for="p-en"><%= locale === 'en' ? 'Name (English)' : 'পণ্যের নাম (ইংরেজি)' %></label><input class="form-control" id="p-en" name="name_en" maxlength="255"></div>
      <div class="col-md-3"><label class="form-label" for="p-slug">Slug *</label><input class="form-control" id="p-slug" name="slug" maxlength="191" required></div>
      <div class="col-md-3"><label class="form-label" for="p-type"><%= t('catalogAdmin.productTypeLabel') %></label><select class="form-select" id="p-type" name="product_type"><option value="grocery">Grocery</option><option value="gift">Gift</option><option value="perishable">Perishable</option><option value="service">Service</option></select></div>
      <div class="col-md-3"><label class="form-label" for="p-category"><%= locale === 'en' ? 'Category (optional)' : 'ক্যাটাগরি (ঐচ্ছিক)' %></label><select class="form-select" id="p-category" name="category_id"><option value=""><%= locale === 'en' ? 'No category' : 'ক্যাটাগরি নেই' %></option><% categories.forEach(function(c) { %><option value="<%= c.id %>"><%= c.name_bn %><%= c.name_en ? ` / ${c.name_en}` : '' %></option><% }) %></select></div>
      <div class="col-md-3"><label class="form-label" for="p-brand"><%= locale === 'en' ? 'Brand (optional)' : 'ব্র্যান্ড (ঐচ্ছিক)' %></label><select class="form-select" id="p-brand" name="brand_id"><option value=""><%= locale === 'en' ? 'No brand' : 'ব্র্যান্ড নেই' %></option><% brands.forEach(function(b) { %><option value="<%= b.id %>"><%= b.name_bn %><%= b.name_en ? ` / ${b.name_en}` : '' %></option><% }) %></select></div>
      <div class="col-md-3"><label class="form-label" for="p-regular"><%= locale === 'en' ? 'Regular price (BDT)' : 'নিয়মিত মূল্য (টাকা)' %></label><input class="form-control" id="p-regular" name="regular_price_bdt" inputmode="decimal" placeholder="0.00" required></div>
      <div class="col-md-3"><label class="form-label" for="p-sale"><%= locale === 'en' ? 'Sale price (BDT)' : 'বিক্রয় মূল্য (টাকা)' %></label><input class="form-control" id="p-sale" name="sale_price_bdt" inputmode="decimal" placeholder="0.00" required></div>
      <div class="col-md-3"><label class="form-label" for="p-cost"><%= locale === 'en' ? 'Cost price (BDT)' : 'ক্রয়মূল্য (টাকা)' %></label><input class="form-control" id="p-cost" name="cost_price_bdt" inputmode="decimal" placeholder="0.00" required></div>
      <div class="col-md-3"><label class="form-label" for="p-unit"><%= t('catalogAdmin.unitLabel') %></label><input class="form-control" id="p-unit" name="unit_label" value="1 pc" maxlength="50" required></div>
      <div class="col-md-3"><label class="form-label" for="p-stock"><%= t('catalogAdmin.openingStockLabel') %></label><input class="form-control" id="p-stock" name="opening_stock" type="number" min="0" step="1"></div>
      <div class="col-md-3"><label class="form-label" for="p-threshold"><%= t('catalogAdmin.lowStockThreshold') %></label><input class="form-control" id="p-threshold" name="low_stock_threshold" type="number" min="0" value="0"></div>
      <div class="col-md-3"><label class="form-label" for="p-wholesale"><%= locale === 'en' ? 'Wholesale price (BDT)' : 'পাইকারি মূল্য (টাকা)' %></label><input class="form-control" id="p-wholesale" name="wholesale_price_bdt" inputmode="decimal" value="0"></div>
      <div class="col-md-3"><label class="form-label" for="p-min"><%= locale === 'en' ? 'Wholesale MOQ' : 'পাইকারি ন্যূনতম পরিমাণ' %></label><input class="form-control" id="p-min" name="wholesale_min_qty" type="number" min="0" value="0"></div>
      <div class="col-md-6"><label class="form-label" for="p-image"><%= locale === 'en' ? 'Image URL (optional)' : 'ছবির URL (ঐচ্ছিক)' %></label><input class="form-control" id="p-image" name="image_url" type="url" maxlength="500"></div>
      <div class="col-md-6"><label class="form-label" for="p-short"><%= locale === 'en' ? 'Short description' : 'সংক্ষিপ্ত বিবরণ' %></label><input class="form-control" id="p-short" name="short_desc_bn" maxlength="2000"></div>
      <div class="col-12"><label class="form-label" for="p-desc"><%= locale === 'en' ? 'Description' : 'বিবরণ' %></label><textarea class="form-control" id="p-desc" name="description_bn" rows="3" maxlength="20000"></textarea></div>
      <div class="col-12"><button class="btn btn-success" type="submit"><%= t('catalogAdmin.addProduct') %></button></div>
    </form>
  </div></section>

  <section class="card shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0"><%= t('catalogAdmin.inventoryTitle') %></h2></div><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>SKU</th><th>Product</th><th><%= t('catalogAdmin.warehouseOnHand') %></th><th><%= t('catalogAdmin.warehouseReserved') %></th><th><%= t('catalogAdmin.warehouseAvailable') %></th><th><%= t('catalogAdmin.vendorOnHand') %></th><th><%= t('catalogAdmin.lowStockAlerts') %></th><th><%= locale === 'en' ? 'Actions' : 'কাজ' %></th></tr></thead><tbody>
  <% if (!inventory.length) { %><tr><td colspan="8" class="text-center text-muted py-4"><%= locale === 'en' ? 'No products yet.' : 'এখনও কোনো পণ্য নেই।' %></td></tr><% } %>
  <% inventory.forEach(function(p) { %><tr><td><%= p.sku %></td><td><%= locale === 'en' ? (p.name_en || p.name_bn) : (p.name_bn || p.name_en) %></td><td><%= p.stock_on_hand %></td><td><%= p.stock_reserved %></td><td><%= p.warehouse_available %></td><td><%= p.vendor_stock_on_hand %></td><td><%= Number(p.warehouse_available) <= Number(p.low_stock_threshold) ? (locale === 'en' ? 'LOW' : 'কম') : '—' %></td><td><a class="btn btn-sm btn-outline-primary" href="/admin/phase06/products/<%= p.id %>/edit"><%= locale === 'en' ? 'Edit' : 'সম্পাদনা' %></a></td></tr><% }) %>
  </tbody></table></div>
  <div class="card-body border-top"><h3 class="h6"><%= t('catalogAdmin.manualAdjustment') %></h3><form method="post" action="/admin/phase06/inventory/adjust" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-3"><label class="form-label" for="adj-product">Product</label><select class="form-select" id="adj-product" name="product_id" required><% products.forEach(function(p) { %><option value="<%= p.id %>"><%= p.sku %> — <%= p.name_bn %></option><% }) %></select></div><div class="col-md-2"><label class="form-label" for="adj-pool"><%= t('catalogAdmin.stockPool') %></label><select class="form-select" id="adj-pool" name="stock_pool"><option value="warehouse">Warehouse</option><option value="vendor">Vendor</option></select></div><div class="col-md-2"><label class="form-label" for="adj-qty"><%= t('catalogAdmin.qtyDelta') %></label><input class="form-control" id="adj-qty" name="qty_delta" type="number" step="1" required></div><div class="col-md-4"><label class="form-label" for="adj-reason"><%= t('catalogAdmin.reasonLabel') %></label><input class="form-control" id="adj-reason" name="reason" maxlength="255" required></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-warning" type="submit">Apply</button></div></form></div></section>

  <section class="card shadow-sm mb-4" id="suppliers"><div class="card-header"><h2 class="h5 mb-0"><%= t('catalogAdmin.suppliersTitle') %></h2></div><div class="card-body"><form method="post" action="/admin/phase06/suppliers" class="row g-2 mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-3"><label class="form-label">Supplier name *</label><input class="form-control" name="name" maxlength="191" required></div><div class="col-md-2"><label class="form-label">Supplier code</label><input class="form-control" name="supplier_code" maxlength="48"></div><div class="col-md-2"><label class="form-label">Company</label><input class="form-control" name="company" maxlength="191"></div><div class="col-md-2"><label class="form-label">Contact person</label><input class="form-control" name="contact_person" maxlength="191"></div><div class="col-md-2"><label class="form-label">Phone *</label><input class="form-control" name="phone" maxlength="32" required></div><div class="col-md-3"><label class="form-label">Email</label><input class="form-control" name="email" type="email" maxlength="191"></div><div class="col-md-6"><label class="form-label">Address</label><input class="form-control" name="address" maxlength="4000"></div><div class="col-md-2"><label class="form-label">Business ID</label><input class="form-control" name="tax_or_trade_id" maxlength="100"></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-success" type="submit"><%= t('catalogAdmin.addSupplier') %></button></div></form><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Code</th><th>Supplier</th><th>Company</th><th>Phone</th><th>Purchase orders</th><th>State</th><th>Outstanding units</th><th>Actions</th></tr></thead><tbody><% if (!suppliers.length) { %><tr><td colspan="8" class="text-muted text-center">No suppliers recorded.</td></tr><% } %><% suppliers.forEach(function(s) { %><tr><td><%= s.supplier_code || '—' %></td><td><%= s.name %></td><td><%= s.company || '—' %></td><td><%= s.phone %></td><td><%= s.purchase_count || 0 %></td><td><%= Number(s.status)===1 ? (locale==='en'?'Active':'সক্রিয়') : (locale==='en'?'Inactive':'নিষ্ক্রিয়') %></td><td><%= s.outstanding_qty || 0 %></td><td><a class="btn btn-sm btn-outline-primary" href="/admin/phase06/suppliers/<%= s.id %>/edit"><%= locale==='en'?'Edit':'সম্পাদনা' %></a></td></tr><% }) %></tbody></table></div></div></section>

  <section class="card shadow-sm mb-4" id="purchases"><div class="card-header"><h2 class="h5 mb-0"><%= t('catalogAdmin.purchasesTitle') %></h2></div><div class="card-body"><div class="alert alert-warning"><%= t('catalogAdmin.poDraftNote') %></div><form method="post" action="/admin/phase06/purchases" id="purchase-form" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="lines" id="purchase-lines"><div class="col-md-3"><label class="form-label">Supplier *</label><select class="form-select" name="supplier_id" required><% suppliers.forEach(function(s) { if(Number(s.status)===1) { %><option value="<%= s.id %>"><%= s.name %></option><% } }) %></select></div><div class="col-md-3"><label class="form-label">Reference (optional)</label><input class="form-control" name="reference_no" maxlength="64"></div><div class="col-md-2"><label class="form-label">Discount (BDT)</label><input class="form-control" name="discount_bdt" value="0"></div><div class="col-md-2"><label class="form-label">Charges (BDT)</label><input class="form-control" name="shipping_charge_bdt" value="0"></div><div class="col-md-2"><label class="form-label">Paid (BDT)</label><input class="form-control" name="paid_amount_bdt" value="0"></div><div class="col-12"><div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label">Product</label><select class="form-select" id="po-product"><% products.forEach(function(p) { %><option value="<%= p.id %>"><%= p.sku %> — <%= p.name_bn %></option><% }) %></select></div><div class="col-md-2"><label class="form-label">Ordered qty</label><input class="form-control" id="po-qty" type="number" min="1" step="1" value="1"></div><div class="col-md-2"><label class="form-label">Unit cost (BDT)</label><input class="form-control" id="po-cost" inputmode="decimal" value="0"></div><div class="col-md-3"><button type="button" class="btn btn-outline-secondary" id="po-add-line">Add line</button><span id="po-line-count" class="ms-2 small">0 lines</span></div></div></div><div class="col-12"><button class="btn btn-success" type="submit">Create Draft Purchase Order</button></div></form>
  <div class="table-responsive mt-3"><table class="table"><thead><tr><th>Reference</th><th>Supplier</th><th>State</th><th>Lines</th><th>Outstanding Qty</th><th>Total (paisa)</th></tr></thead><tbody><% if (!purchases.length) { %><tr><td colspan="6" class="text-center text-muted">No purchase orders.</td></tr><% } %><% purchases.forEach(function(p) { %><tr><td><%= p.reference_no %></td><td><%= p.supplier_name %></td><td><%= p.receive_status || p.status %></td><td><%= p.line_count || 0 %></td><td><%= p.outstanding_qty || 0 %></td><td><%= p.total_cost_paisa || Math.round(Number(p.total_cost || 0) * 100) %></td></tr><% }) %></tbody></table></div></div></section>

  <section class="card shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0"><%= locale === 'en' ? 'Recent Stock Movement Ledger' : 'সাম্প্রতিক স্টক মুভমেন্ট লেজার' %></h2></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>When</th><th>SKU</th><th>Pool</th><th>Movement</th><th>Delta</th><th>Balance</th><th>Reason</th></tr></thead><tbody><% ledger.slice(0,100).forEach(function(l) { %><tr><td><%= fmt.dateTime(l.created_at) %></td><td><%= l.sku %></td><td><%= l.stock_pool %></td><td><%= l.movement_type %></td><td><%= l.qty_delta %></td><td><%= l.balance_after %></td><td><%= l.reason %></td></tr><% }) %><% if (!ledger.length) { %><tr><td colspan="7" class="text-center text-muted">No ledger entries.</td></tr><% } %></tbody></table></div></section>
</div></div>
<script>
(function(){var lines=[];var add=document.getElementById('po-add-line');if(!add)return;add.addEventListener('click',function(){var id=document.getElementById('po-product').value;var qty=Number(document.getElementById('po-qty').value);var cost=document.getElementById('po-cost').value;if(!id||!Number.isSafeInteger(qty)||qty<1||!cost)return;lines.push({product_id:Number(id),ordered_qty:qty,unit_cost_bdt:String(cost)});document.getElementById('purchase-lines').value=JSON.stringify(lines);document.getElementById('po-line-count').textContent=lines.length+' line(s)';});document.getElementById('purchase-form').addEventListener('submit',function(e){if(!lines.length){e.preventDefault();alert('Add at least one product line.');}});}());
</script>
<%- include('partials/footer') %>
