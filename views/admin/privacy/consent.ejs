<%- include('../partials/head',{title:'Privacy consent configuration'}) %><%- include('../partials/topbar') %><%- include('../partials/sidebar') %><div class="content-page"><main class="content container-fluid py-3"><h1 class="h3">Optional consent configuration</h1><div class="alert alert-info">Only optional marketing and analytics consent can be enabled/disabled here. Essential order processing, support and accounting are not optional consent keys. No customer is opted in by changing this configuration.</div><a href="/admin/privacy/policies">Policy versions</a> · <a href="/admin/privacy/retention">Retention</a> · <a href="/admin/privacy/requests">Requests</a><% options.forEach(o=>{ %><form class="card card-body my-3 row g-3" method="post" action="/admin/privacy/consent/<%= o.consent_key %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="h5"><%= o.consent_key %></h2><div class="col-md-6"><label class="form-label">বাংলা label<input class="form-control" name="label_bn" maxlength="120" required value="<%= o.label_bn %>"></label></div><div class="col-md-6"><label class="form-label">English label<input class="form-control" name="label_en" maxlength="120" required value="<%= o.label_en %>"></label></div><div class="col-md-6"><label class="form-label">বাংলা বিবরণ<textarea class="form-control" name="description_bn" maxlength="500" required><%= o.description_bn %></textarea></label></div><div class="col-md-6"><label class="form-label">English description<textarea class="form-control" name="description_en" maxlength="500" required><%= o.description_en %></textarea></label></div><div class="col-md-4"><label class="form-label">Available to customers<select class="form-select" name="enabled"><option value="1" <%= Number(o.enabled)?'selected':'' %>>enabled</option><option value="0" <%= Number(o.enabled)?'':'selected' %>>disabled</option></select></label></div><button class="btn btn-primary col-auto">Save configuration</button></form><% }) %></main></div><%- include('../partials/footer') %>
