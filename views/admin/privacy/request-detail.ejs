<%- include('../partials/head',{title:'Privacy request review'}) %><%- include('../partials/topbar') %><%- include('../partials/sidebar') %><div class="content-page"><main class="content container-fluid py-3"><a href="/admin/privacy/requests">← Request queue</a><h1 class="h3 mt-2">Request #<%= request.id %> — <%= request.request_type %></h1><div class="alert alert-warning">Review only the necessary fields. Preserve invoices, order history, financial records and append-only audit evidence. No action here hard-deletes account/order rows.</div><section class="card card-body mb-3"><h2 class="h5">Customer / current request</h2><dl class="row"><dt class="col-sm-3">Customer ID</dt><dd class="col-sm-9"><%= request.customer_id %></dd><dt class="col-sm-3">Name</dt><dd class="col-sm-9"><%= request.customer_name %></dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9"><%= request.customer_phone %></dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9"><%= request.customer_email %></dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9"><%= request.status %></dd><dt class="col-sm-3">Submitted</dt><dd class="col-sm-9"><%= request.created_at %></dd><dt class="col-sm-3">Customer message</dt><dd class="col-sm-9"><%= request.customer_message %></dd><dt class="col-sm-3">Requested fields</dt><dd class="col-sm-9"><pre><%= request.requested_data_json||'—' %></pre></dd><dt class="col-sm-3">Reviewer</dt><dd class="col-sm-9"><%= request.reviewer_user_id||'—' %> · <%= request.reviewed_at||'—' %></dd><dt class="col-sm-3">Decision reason</dt><dd class="col-sm-9"><%= request.decision_reason||'—' %></dd></dl></section>
<% if(['pending','in_review'].includes(request.status)){ %><form class="card card-body row g-2 mb-3" method="post" action="/admin/privacy/requests/<%= request.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="h5">Review decision</h2><select class="form-select" name="decision" required><option value="in_review">Mark in review</option><option value="approve">Approve request</option><option value="reject">Reject request</option></select><textarea class="form-control" name="reason" maxlength="1000" required placeholder="Reviewer, evidence, decision and reason"></textarea><button class="btn btn-primary col-auto">Record review</button></form><% } %>
<% if(request.request_type==='correction'&&request.status==='approved'){const desired=request.requested_data||{};%><form class="card card-body row g-2 mb-3" method="post" action="/admin/privacy/requests/<%= request.id %>/apply-correction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="h5">Apply reviewed correction</h2><p class="small text-warning">For email/phone, verify identity/evidence manually before entering the corrected value. This action is audited and transactional.</p><% if(desired.name!==undefined){ %><div class="col-md-4"><label>Name<input class="form-control" name="name" value="<%= desired.name %>" required></label></div><% } %><% if(desired.email!==undefined){ %><div class="col-md-4"><label>Email<input class="form-control" type="email" name="email" value="<%= desired.email||'' %>"></label></div><% } %><% if(desired.phone!==undefined){ %><div class="col-md-4"><label>Phone<input class="form-control" name="phone" value="<%= desired.phone %>" required></label></div><% } %><textarea class="form-control" name="reason" maxlength="1000" required placeholder="Manual verification evidence / application reason"></textarea><button class="btn btn-success col-auto">Apply correction</button></form><% } %>
<% if(request.request_type==='deletion'&&request.status==='approved'){ %><form class="card card-body row g-2 mb-3" method="post" action="/admin/privacy/requests/<%= request.id %>/anonymize"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="h5">Explicit anonymization approval</h2><p class="small">This will disable the account and anonymize customer master/saved-address contact fields. It will preserve all orders/invoices, payment/financial evidence, the privacy request and append-only audit history. Confirm applicable retention/manual-review checks and record the reason below. No automatic purge is performed.</p><textarea class="form-control" name="reason" maxlength="1000" required placeholder="Reviewer and retention/legal-hold check; reason for irreversible action"></textarea><button class="btn btn-danger col-auto">Anonymize eligible account data</button></form><% } %>
</main></div><%- include('../partials/footer') %>
