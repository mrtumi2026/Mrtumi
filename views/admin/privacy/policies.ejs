<%- include('../partials/head',{title:'Privacy policy versions'}) %><%- include('../partials/topbar') %><%- include('../partials/sidebar') %><div class="content-page"><main class="content container-fluid py-3"><h1 class="h3">Privacy policy versions</h1><div class="alert alert-warning">Policy copy is operational information only. This system does not claim legal compliance. Qualified legal review is outstanding unless separately recorded with evidence. Published versions remain immutable; create a new draft for changes.</div><% if(current){ %><div class="alert alert-info">Current public version: <strong><%= current.version %></strong> · legal review: <%= current.legal_review_status %>. <a href="/privacy-policy" target="_blank" rel="noopener">View public policy</a></div><% } %><div class="d-flex gap-2 mb-3"><a class="btn btn-primary" href="/admin/privacy/policies/new">Create policy draft</a><a class="btn btn-outline-secondary" href="/admin/privacy/consent">Consent configuration</a><a class="btn btn-outline-secondary" href="/admin/privacy/retention">Retention</a><a class="btn btn-outline-secondary" href="/admin/privacy/requests">Privacy requests</a></div>
<% if(draft){ %><section class="card card-body mb-4"><h2 class="h5"><%= draft.status==='draft'?'Edit draft':'Published version (read only)' %> · <%= draft.version %></h2><form method="post" action="<%= draft.status==='draft'?'/admin/privacy/policies/'+draft.id:'/admin/privacy/policies/'+draft.id+'/review' %>" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(draft.status==='draft'){ %><div class="col-md-6"><label class="form-label">বাংলা শিরোনাম<input class="form-control" name="title_bn" maxlength="255" required value="<%= draft.title_bn %>"></label></div><div class="col-md-6"><label class="form-label">English title<input class="form-control" name="title_en" maxlength="255" required value="<%= draft.title_en %>"></label></div><div class="col-md-6"><label class="form-label">বাংলা নীতি<textarea class="form-control" name="content_bn" rows="16" maxlength="50000" required><%= draft.content_bn %></textarea></label></div><div class="col-md-6"><label class="form-label">English policy<textarea class="form-control" name="content_en" rows="16" maxlength="50000" required><%= draft.content_en %></textarea></label></div><button class="btn btn-primary col-auto">Save draft</button><% } else { %><p>Legal-review status: <strong><%= draft.legal_review_status %></strong><br><%= draft.legal_review_note %></p><div class="col-md-4"><select class="form-select" name="legal_review_status"><option value="not_reviewed">Not reviewed</option><option value="qualified_reviewed">Qualified legal review recorded</option><option value="changes_requested">Changes requested</option></select></div><div class="col-md-8"><input class="form-control" name="legal_review_note" maxlength="500" required placeholder="Reviewer/evidence note; do not state compliance without legal approval"></div><button class="btn btn-outline-primary col-auto">Record review status</button><% } %></form><% if(draft.status==='draft'){ %><form method="post" action="/admin/privacy/policies/<%= draft.id %>/publish" class="row g-2 mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-8"><input class="form-control" name="note" maxlength="500" placeholder="Publication / reviewer note"></div><button class="btn btn-success col-auto">Publish this version</button></form><% } %></section><% } %>
<section class="card card-body mb-4"><h2 class="h5"><%= draft?'Create another version':'Create a versioned draft' %></h2><form method="post" action="/admin/privacy/policies" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-4"><label class="form-label">Unique version<input class="form-control" name="version" maxlength="32" required placeholder="1.1"></label></div><div class="col-md-4"><label class="form-label">বাংলা শিরোনাম<input class="form-control" name="title_bn" maxlength="255" required></label></div><div class="col-md-4"><label class="form-label">English title<input class="form-control" name="title_en" maxlength="255" required></label></div><div class="col-md-6"><label class="form-label">বাংলা নীতি<textarea class="form-control" name="content_bn" rows="8" maxlength="50000" required></textarea></label></div><div class="col-md-6"><label class="form-label">English policy<textarea class="form-control" name="content_en" rows="8" maxlength="50000" required></textarea></label></div><button class="btn btn-primary col-auto">Save draft</button></form></section>
<section class="card card-body"><h2 class="h5">Policy versions</h2><div class="table-responsive"><table class="table"><thead><tr><th>Version</th><th>Bangla</th><th>English</th><th>Status</th><th>Legal review</th><th>Published</th><th></th></tr></thead><tbody><% policies.forEach(p=>{ %><tr><td><%= p.version %></td><td><%= p.title_bn %></td><td><%= p.title_en %></td><td><%= p.status %></td><td><%= p.legal_review_status %></td><td><%= p.published_at||'—' %></td><td><a href="/admin/privacy/policies/<%= p.id %>">Open</a></td></tr><% }) %></tbody></table></div><h3 class="h6 mt-3">Publication history</h3><ul><% history.forEach(h=>{ %><li><%= h.created_at %> · <%= h.action %> · v<%= h.version %> · <%= h.note %></li><% }) %></ul></section></main></div><%- include('../partials/footer') %>
