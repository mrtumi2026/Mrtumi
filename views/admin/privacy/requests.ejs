<%- include('../partials/head',{title:'Customer privacy requests'}) %><%- include('../partials/topbar') %><%- include('../partials/sidebar') %><div class="content-page"><main class="content container-fluid py-3"><h1 class="h3">Customer privacy requests</h1><div class="alert alert-warning">Access is restricted to privacy-review permission. No hard-delete operation exists. Rejection/cancellation is retained as history; account anonymization is a separate explicit reviewer action.</div><nav class="mb-3"><a href="/admin/privacy/policies">Policies</a> · <a href="/admin/privacy/consent">Consent</a> · <a href="/admin/privacy/retention">Retention</a></nav><form method="get" class="row g-2 mb-3"><div class="col-md-4"><select class="form-select" name="status"><option value="">All statuses</option><% ['pending','in_review','approved','rejected','cancelled','completed'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="col-md-4"><select class="form-select" name="type"><option value="">All request types</option><% ['access','correction','deletion','consent_withdrawal'].forEach(s=>{ %><option value="<%= s %>" <%= type===s?'selected':'' %>><%= s %></option><% }) %></select></div><div class="col-md-4"><button class="btn btn-outline-primary">Filter</button></div></form><div class="card card-body"><div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Customer ID</th><th>Type</th><th>Status</th><th>Message</th><th>Created</th><th></th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td>#<%= r.id %></td><td><%= r.customer_id %></td><td><%= r.request_type %></td><td><%= r.status %></td><td><%= r.customer_message %></td><td><%= r.created_at %></td><td><a href="/admin/privacy/requests/<%= r.id %>">Review</a></td></tr><% }) %></tbody></table></div></div></main></div><%- include('../partials/footer') %>
