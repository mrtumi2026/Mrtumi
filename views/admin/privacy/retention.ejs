<%- include('../partials/head',{title:'Privacy retention settings'}) %><%- include('../partials/topbar') %><%- include('../partials/sidebar') %><div class="content-page"><main class="content container-fluid py-3"><h1 class="h3">Retention periods</h1><div class="alert alert-danger"><strong>No automatic purge runs.</strong> A blank period remains manual-review-only. Changing this setting does not trigger deletion or anonymization. Order/invoice and financial evidence is preserved pending an approved records schedule; never use a retention value as automatic authorization.</div><a href="/admin/privacy/policies">Policies</a> · <a href="/admin/privacy/consent">Consent</a> · <a href="/admin/privacy/requests">Requests</a><% settings.forEach(s=>{ %><form class="card card-body row g-3 mt-3" method="post" action="/admin/privacy/retention/<%= s.category_key %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="h5"><%= s.category_key %></h2><div class="col-md-4"><label class="form-label">Retention days (blank = no automatic schedule)<input class="form-control" type="number" min="1" max="36500" name="retention_days" value="<%= s.retention_days==null?'':s.retention_days %>"></label></div><div class="col-md-4"><label class="form-label">Manual review required<select class="form-select" name="manual_review_required"><option value="1" <%= Number(s.manual_review_required)?'selected':'' %>>yes</option><option value="0" <%= Number(s.manual_review_required)?'':'selected' %>>no</option></select></label></div><div class="col-md-12"><label class="form-label">Retention note<textarea class="form-control" name="notes" maxlength="500"><%= s.notes %></textarea></label></div><button class="btn btn-primary col-auto">Save settings</button></form><% }) %></main></div><%- include('../partials/footer') %>
