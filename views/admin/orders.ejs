<%- include('partials/head', { title: pageTitle }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>

<div class="content-page">
  <div class="content">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <div>
        <h4 class="fw-bold mb-0"><%= pageTitle %> (<%= orders.length %>)</h4>
        <p class="text-muted small mb-0">অর্ডার প্রসেসিং, কুরিয়ার অ্যাসাইন এবং ইনভয়েস প্রিন্ট করুন</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/admin/order/create" class="btn btn-forest btn-sm">+ Create POS Order</a>
      </div>
    </div>

    <!-- Status Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-3">
      <a href="/admin/order/all" class="btn btn-sm <%= statusFilter === 'all' ? 'btn-dark' : 'btn-outline-secondary bg-white' %>">
        All (<%= statusCounts.all || orders.length %>)
      </a>
      <% statuses.forEach(function(st) { %>
        <a href="/admin/order/<%= st.slug %>" class="btn btn-sm <%= statusFilter === st.slug ? 'btn-dark' : 'btn-outline-secondary bg-white' %>">
          <%= st.name %> (<%= statusCounts[st.slug] || 0 %>)
        </a>
      <% }) %>
    </div>

    <div class="tbl-card">
      <!-- Search & Bulk Action Header -->
      <div class="tbl-card-head">
        <form action="/admin/order/bulk-action" method="POST" id="bulkOrderForm" class="d-flex flex-wrap gap-2 align-items-center">
          <select name="bulk_action" class="form-select form-select-sm" style="width: 220px;">
            <option value="">-- Bulk Action / Courier --</option>
            <option value="processing">Mark Processing</option>
            <option value="on-the-way">Mark On The Way</option>
            <option value="completed">Mark Completed (Delivered)</option>
            <option value="cancelled">Mark Cancelled</option>
            <option value="courier:Steadfast Courier">🚚 Send to Steadfast Courier</option>
            <option value="courier:Pathao Courier">🛵 Send to Pathao Courier</option>
            <option value="courier:RedX Courier">📦 Send to RedX Courier</option>
            <option value="delete">🗑️ Delete Selected</option>
          </select>
          <button type="submit" class="btn btn-sm btn-forest">Apply</button>
        </form>

        <form action="" method="GET" class="d-flex gap-2">
          <input type="text" name="q" value="<%= searchQuery %>" class="form-control form-control-sm" placeholder="Search Invoice, Name, Phone..." />
          <button type="submit" class="btn btn-sm btn-outline-dark">Search</button>
        </form>
      </div>

      <div class="tbl-card-body">
        <table class="table clean mb-0">
          <thead>
            <tr>
              <th><input type="checkbox" id="checkAllOrders" /></th>
              <th>Invoice</th>
              <th>Customer</th>
              <th>Address</th>
              <th>Amount</th>
              <th>Payment</th>
              <th>Courier</th>
              <th>Status</th>
              <th>Date</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (!orders.length) { %>
              <tr><td colspan="10" class="text-center py-4 text-muted">কোনো অর্ডার পাওয়া যায়নি।</td></tr>
            <% } %>
            <% orders.forEach(function(o) { %>
              <tr>
                <td>
                  <input type="checkbox" name="order_ids" value="<%= o.id %>" form="bulkOrderForm" class="order-row-cb" />
                </td>
                <td>
                  <a href="/admin/order/view/<%= o.id %>" class="fw-bold text-primary text-decoration-none">#<%= o.invoice_id %></a>
                  <div class="text-muted" style="font-size:11px;"><%= o.traffic_source || 'Direct' %></div>
                </td>
                <td>
                  <div class="fw-semibold"><%= o.customer_name %></div>
                  <div class="text-muted small">
                    <%= o.phone %>
                    <a href="/admin/manual-fraud-check?phone=<%= encodeURIComponent(o.phone) %>" class="ms-1 text-info text-decoration-none" title="Fraud Check">🛡️</a>
                  </div>
                </td>
                <td style="max-width: 190px;" class="text-truncate"><%= o.address %></td>
                <td class="fw-bold">৳<%= Number(o.amount).toLocaleString('en-IN') %></td>
                <td>
                  <span class="small"><%= o.payment_method %></span>
                  <% if (o.trx_id) { %><div class="badge bg-info-subtle text-info">Trx: <%= o.trx_id %></div><% } %>
                </td>
                <td>
                  <% if (o.courier_name) { %>
                    <span class="badge bg-light text-dark border"><%= o.courier_name %></span>
                    <div class="text-muted" style="font-size:10.5px;"><%= o.courier_tracking_id %></div>
                  <% } else { %>
                    <span class="text-muted small">—</span>
                  <% } %>
                </td>
                <td>
                  <form action="/admin/order/status-quick" method="POST" class="d-inline">
                    <input type="hidden" name="order_id" value="<%= o.id %>" />
                    <select name="status" class="form-select form-select-sm py-0 px-2" style="width:128px;font-size:12px;" onchange="this.form.submit()">
                      <% statuses.forEach(function(st) { %>
                        <option value="<%= st.slug %>" <%= o.status === st.slug ? 'selected' : '' %>><%= st.name %></option>
                      <% }) %>
                    </select>
                  </form>
                </td>
                <td class="text-muted small" style="white-space:nowrap;"><%= String(o.created_at).slice(0, 10) %></td>
                <td class="text-end" style="white-space:nowrap;">
                  <a href="/admin/order/view/<%= o.id %>" class="btn btn-sm btn-outline-primary py-1 px-2" title="View / Edit">
                    <i class="fas fa-eye"></i>
                  </a>
                  <a href="/admin/order/invoice/<%= o.id %>" target="_blank" class="btn btn-sm btn-outline-dark py-1 px-2" title="Print Invoice">
                    <i class="fas fa-print"></i>
                  </a>
                  <form action="/admin/order/delete/<%= o.id %>" method="POST" class="d-inline">
                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 delete-confirm" title="Delete">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('checkAllOrders').addEventListener('change', function() {
    var checked = this.checked;
    document.querySelectorAll('.order-row-cb').forEach(function(cb) { cb.checked = checked; });
  });
</script>

<%- include('partials/footer') %>
