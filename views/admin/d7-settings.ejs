<!doctype html><html lang="<%= isEn?'en':'bn' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>D7 settings</title><link rel="stylesheet" href="/shared/css/mrtumi-design-system.css"><link rel="stylesheet" href="/shared/css/d7-workflows.css"></head><body><main class="container py-4"><h1 class="h3">D7 customer and financial settings</h1><p><a href="/admin/d7/returns">Return reviews</a> · <a href="/admin/d7/settlements">Settlements</a></p><div class="alert alert-warning">Refund provider execution is disabled. COD refunds require verified destination data, which this system does not yet capture. This page configures eligibility only and does not send payments.</div><form method="post" action="/admin/d7/settings" class="card card-body mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="h5">Policy settings</h2><fieldset class="mb-3"><legend class="form-label">Pre-dispatch cancellation states</legend><% const eligible=JSON.parse(settings.d7_cancel_states||'["pending","confirmed","processing"]');['pending','confirmed','processing'].forEach(s=>{ %><label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="cancel_states_choice" value="<%= s %>" <%= eligible.includes(s)?'checked':'' %>><span class="form-check-label"><%= s %></span></label><% }) %></fieldset><label class="form-label" for="cancelJson">Cancellation states (JSON array)</label><input id="cancelJson" class="form-control mb-3" name="cancel_states" value='<%= JSON.stringify(eligible) %>' required><label class="form-label" for="days">Default standard return window (days)</label><input id="days" class="form-control mb-3" type="number" min="1" max="60" name="default_return_days" value="<%= settings.d7_default_return_days||7 %>" required><label class="form-label" for="hold">Settlement holding period (days)</label><input id="hold" class="form-control mb-3" type="number" min="0" max="180" name="settlement_hold_days" value="<%= settings.d7_settlement_hold_days||7 %>" required><label class="form-label" for="refundLimit">Refund approval threshold (paisa)</label><input id="refundLimit" class="form-control mb-3" type="number" min="0" name="refund_approval_limit_paisa" value="<%= settings.d7_refund_approval_limit_paisa||0 %>" required><fieldset class="mb-3"><legend class="form-label">Supported canonical payment methods</legend><label class="form-check"><input class="form-check-input" type="checkbox" name="cod_enabled" value="1" checked disabled><span class="form-check-label">Cash on delivery (COD)</span></label><small class="text-muted">Only COD is supported by canonical checkout; online providers are not configured or activated by this setting.</small></fieldset><button class="btn btn-primary align-self-start">Save policy</button></form><h2 class="h5">Category-specific standard return eligibility</h2><div class="table-responsive"><table class="table"><thead><tr><th>Category</th><th>Eligibility</th></tr></thead><tbody><% categories.forEach(category=>{ %><tr><td><%= category.name %></td><td><form method="post" action="/admin/d7/settings/categories/<%= category.id %>" class="d-flex gap-2 flex-wrap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select" name="eligible" aria-label="Eligible"><option value="0" <%= Number(category.eligible)?'':'selected' %>>Disabled / potentially perishable</option><option value="1" <%= Number(category.eligible)?'selected':'' %>>Eligible (non-perishable policy)</option></select><input class="form-control" type="number" min="1" max="60" name="window_days" value="<%= category.window_days %>" aria-label="Window days"><button class="btn btn-outline-primary">Save</button></form></td></tr><% }) %></tbody></table></div><h2 class="h5 mt-4">Per-vendor commissions</h2><div class="table-responsive"><table class="table"><tbody><% vendors.forEach(vendor=>{ %><tr><td><%= vendor.shop_name %></td><td><form method="post" action="/admin/d7/settings/vendors/<%= vendor.id %>/commission" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control" type="number" min="0" max="10000" name="commission_rate_bps" value="<%= vendor.commission_rate_bps %>" aria-label="Commission basis points"><button class="btn btn-outline-primary">Save</button></form></td></tr><% }) %></tbody></table></div></main><script>document.querySelector('form[action="/admin/d7/settings"]').addEventListener('submit',function(){const checked=[...this.querySelectorAll('input[type=checkbox][name=cancel_states_choice]:checked')].map(x=>x.value);const input=this.querySelector('#cancelJson');if(checked.length)input.value=JSON.stringify(checked);});</script></body></html>
