<%- include('partials/head', { title: locale === 'bn' ? 'অ্যাডমিন অডিট লগ' : 'Admin Audit Log' }) %>
<%- include('partials/topbar') %>
<%- include('partials/sidebar') %>
<div class="content-page"><div class="content">
  <div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="fw-bold"><%= locale === 'bn' ? 'অ্যাডমিন অডিট লগ' : 'Admin Audit Log' %></h4><p class="text-muted small"><%= locale === 'bn' ? 'শুধুমাত্র পঠনযোগ্য; লগ পরিবর্তন বা মুছে ফেলার কোনো অ্যাকশন নেই।' : 'Read-only history. No edit or delete actions are provided.' %></p></div></div>
  <div class="tbl-card"><div class="tbl-card-body"><div class="table-responsive"><table class="table clean"><thead><tr><th>ID</th><th>Actor</th><th>Action</th><th>Entity</th><th>Before</th><th>After</th><th>UTC time</th></tr></thead><tbody>
  <% if(!result.rows.length){ %><tr><td colspan="7" class="text-center text-muted">No audit records.</td></tr><% } %>
  <% result.rows.forEach(function(row){ %><tr><td><%= row.id %></td><td><%= row.actor_type %> #<%= row.actor_id || '—' %></td><td><%= row.action %></td><td><%= row.entity_type %> <%= row.entity_id || '' %></td><td><code><%= row.before_json || '—' %></code></td><td><code><%= row.after_json || '—' %></code></td><td><%= row.created_at %></td></tr><% }); %>
  </tbody></table></div></div></div>
  <nav class="mt-3 d-flex gap-2"><% if(result.page>1){ %><a class="btn btn-sm btn-outline-secondary" href="?page=<%= result.page-1 %>">Previous</a><% } %><span class="small text-muted align-self-center">Page <%= result.page %> · <%= result.total %> records</span><% if(result.page*result.limit<result.total){ %><a class="btn btn-sm btn-outline-secondary" href="?page=<%= result.page+1 %>">Next</a><% } %></nav>
</div></div>
<%- include('partials/footer') %>
