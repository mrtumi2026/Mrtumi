<%- include('partials/head', { title: isEn ? 'Order verification and advance policies' : 'অর্ডার OTP ও অগ্রিম পেমেন্ট নীতি' }) %><%- include('partials/topbar') %><%- include('partials/sidebar') %>
<div class="content-page"><div class="content container-fluid py-3"><h1 class="h3"><%=isEn?'Order verification and advance policies':'অর্ডার যাচাই ও অগ্রিম নীতি'%></h1><div class="alert alert-warning"><%=isEn?'OTP enablement does not send SMS. Configure and verify the SMS integration separately. Advance policy only calculates required amounts; payment confirmation must come from a verified provider.':'OTP চালু করলেই SMS পাঠানো হয় না। SMS integration আলাদাভাবে কনফিগার ও যাচাই করতে হবে। অগ্রিম নীতি শুধু প্রয়োজনীয় অঙ্ক গণনা করে; পেমেন্ট নিশ্চিতকরণ যাচাইকৃত provider থেকে আসতে হবে।'%></div>
<form method="post" action="/admin/phase08/settings" class="card card-body gap-4"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><fieldset><legend class="h5"><%=isEn?'OTP policy':'OTP নীতি'%></legend><label class="form-label"><%=isEn?'Mode':'অবস্থা'%><select class="form-select" name="otp_mode"><option value="off" <%=settings.otp_mode==='on'?'':'selected'%>>off</option><option value="on" <%=settings.otp_mode==='on'?'selected':''%>>on</option></select></label><div class="row g-2"><div class="col-md-4"><label class="form-label">Expiry (60–900 sec)<input class="form-control" name="otp_expiry_seconds" type="number" min="60" max="900" value="<%=settings.otp_expiry_seconds||300%>" required></label></div><div class="col-md-4"><label class="form-label">Max attempts<input class="form-control" name="otp_max_attempts" type="number" min="1" max="10" value="<%=settings.otp_max_attempts||5%>" required></label></div><div class="col-md-4"><label class="form-label">Cooldown (30–3600 sec)<input class="form-control" name="otp_cooldown_seconds" type="number" min="30" max="3600" value="<%=settings.otp_cooldown_seconds||60%>" required></label></div><div class="col-md-4"><label class="form-label">Max issue/hour<input class="form-control" name="otp_max_per_hour" type="number" min="1" max="10" value="<%=settings.otp_max_per_hour||5%>" required></label></div></div></fieldset>
<fieldset><legend class="h5"><%=isEn?'Advance payment':'অগ্রিম পেমেন্ট'%></legend><label class="form-label"><%=isEn?'Mode':'ধরন'%><select class="form-select" name="advance_payment_mode"><%['off','fixed','percent'].forEach(m=>{%><option value="<%=m%>" <%=settings.advance_payment_mode===m?'selected':''%>><%=m%></option><%})%></select></label><div class="row g-2"><div class="col-md-4"><label class="form-label"><%=isEn?'Value (paisa for fixed; whole percent otherwise)':'পরিমাণ (fixed হলে পয়সা; percent হলে পূর্ণ সংখ্যা)'%><input class="form-control" name="advance_payment_value" type="number" min="0" max="1000000000" value="<%=settings.advance_payment_value||0%>" required></label></div><div class="col-md-4"><label class="form-label">Minimum order (paisa)<input class="form-control" name="advance_min_order_paisa" type="number" min="0" value="<%=settings.advance_min_order_paisa||0%>" required></label></div><div class="col-md-4"><label class="form-label">Maximum order (paisa; blank = none)<input class="form-control" name="advance_max_order_paisa" type="number" min="0" value="<%=settings.advance_max_order_paisa||''%>"></label></div></div></fieldset><button class="btn btn-success col-auto"><%=isEn?'Save policy':'নীতি সংরক্ষণ'%></button></form></div></div><%-include('partials/footer')%>
