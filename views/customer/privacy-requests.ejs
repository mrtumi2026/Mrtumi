<%- include('../store/partials/header', { title: isEn ? 'Privacy and data rights' : 'গোপনীয়তা ও তথ্য অধিকার' }) %>
<main id="mainContent" class="container py-5" style="max-width:980px"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><h1 class="h3"><%= isEn?'Privacy and data rights':'গোপনীয়তা ও তথ্য অধিকার' %></h1><a href="/customer/account"><%= isEn?'Back to account':'অ্যাকাউন্টে ফিরুন' %></a></div>
<div class="alert alert-warning mt-3"><%= isEn?'Deletion is a manual-review request. Orders, invoices, financial records and audit evidence are not automatically deleted. Optional consent does not control essential order processing. Legal review of the published policy is outstanding.':'অ্যাকাউন্ট মুছে ফেলার অনুরোধে হাতে পর্যালোচনা হবে। অর্ডার, ইনভয়েস, আর্থিক রেকর্ড বা অডিট প্রমাণ স্বয়ংক্রিয়ভাবে মুছে যায় না। ঐচ্ছিক সম্মতি অর্ডার প্রক্রিয়াকে বন্ধ করে না। প্রকাশিত নীতির আইনি পর্যালোচনা বাকি।' %> · <a href="/privacy-policy"><%= isEn?'Policy':'নীতি' %> <%= policy.version %></a></div>
<section class="card card-body mt-3"><h2 class="h5"><%= isEn?'My data and policy history':'আমার তথ্য ও নীতি ইতিহাস' %></h2><p><a href="/customer/account/privacy/data"><%= isEn?'View/download my account data (JSON)':'আমার অ্যাকাউন্টের তথ্য দেখুন/ডাউনলোড করুন (JSON)' %></a></p><h3 class="h6"><%= isEn?'Policy versions acknowledged':'গৃহীত নীতি সংস্করণ' %></h3><ul><% acceptances.forEach(a=>{ %><li><%= a.policy_version %> · <%= a.accepted_at %></li><% }) %></ul><% if(!acceptances.some(a=>a.policy_version===policy.version)){ %><form method="post" action="/customer/account/privacy/accept-policy" class="my-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="policy_version" value="<%= policy.version %>"><label><input type="checkbox" name="acknowledged" value="yes" required> <%= isEn?'I have reviewed this published policy version':'আমি প্রকাশিত নীতির এই সংস্করণটি পর্যালোচনা করেছি' %></label><button class="btn btn-sm btn-outline-primary ms-2"><%= isEn?'Record policy acknowledgement':'নীতি স্বীকৃতি নথিভুক্ত করুন' %></button></form><% } %><h3 class="h6 mt-2"><%= isEn?'Optional consent status':'ঐচ্ছিক সম্মতির অবস্থা' %></h3><% options.forEach(option=>{const current=consents.find(c=>c.consent_key===option.key);%><div class="border rounded p-3 mb-2"><strong><%= option.label %></strong><p class="mb-2"><%= option.description %> · <%= current&&Number(current.granted)?(isEn?'Granted':'সম্মত'):(isEn?'Not granted':'সম্মতি নেই') %></p><form method="post" action="/customer/account/privacy/consents"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="consent_key" value="<%= option.key %>"><input type="hidden" name="action" value="<%= current&&Number(current.granted)?'withdraw':'grant' %>"><button class="btn btn-sm <%= current&&Number(current.granted)?'btn-outline-danger':'btn-outline-success' %>"><%= current&&Number(current.granted)?(isEn?'Withdraw optional consent':'ঐচ্ছিক সম্মতি প্রত্যাহার'):(isEn?'Grant optional consent':'ঐচ্ছিক সম্মতি দিন') %></button></form></div><% }) %><p class="small text-muted"><%= isEn?'Essential order, delivery, payment and support processing remains separate.':'অর্ডার, ডেলিভারি, পেমেন্ট ও সহায়তার অপরিহার্য প্রক্রিয়াকরণ আলাদা।' %></p><h3 class="h6 mt-3"><%= isEn?'Consent evidence history':'সম্মতির ইতিহাস' %></h3><ul><% history.forEach(event=>{ %><li><%= event.consent_key %> · <%= event.action %> · <%= event.policy_version %> · <%= event.created_at %></li><% }) %></ul></section>
<div class="row g-3 mt-1"><div class="col-lg-6"><form class="card card-body gap-2" method="post" action="/customer/account/privacy-requests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="request_type" value="correction"><h2 class="h5"><%= isEn?'Request a correction':'তথ্য সংশোধনের অনুরোধ' %></h2><input class="form-control" name="correct_name" maxlength="191" placeholder="<%= isEn?'Correct name (optional)':'সঠিক নাম (ঐচ্ছিক)' %>"><input class="form-control" name="correct_email" type="email" maxlength="191" placeholder="<%= isEn?'Correct email (optional)':'সঠিক ইমেইল (ঐচ্ছিক)' %>"><input class="form-control" name="correct_phone" maxlength="32" placeholder="<%= isEn?'Correct phone (optional; manually verified)':'সঠিক ফোন (ঐচ্ছিক; হাতে যাচাই হবে)' %>"><textarea class="form-control" name="customer_message" maxlength="1000" placeholder="<%= isEn?'Explain your request':'অনুরোধের ব্যাখ্যা' %>"></textarea><button class="btn btn-outline-primary"><%= isEn?'Submit correction request':'সংশোধন অনুরোধ জমা দিন' %></button></form></div><div class="col-lg-6"><form class="card card-body gap-2" method="post" action="/customer/account/privacy-requests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="request_type" value="deletion"><h2 class="h5"><%= isEn?'Request account deletion':'অ্যাকাউন্ট মুছে ফেলার অনুরোধ' %></h2><p class="small"><%= isEn?'This requests review; it does not delete the account. Approved anonymization is a separate, explicit reviewer action.':'এটি পর্যালোচনার অনুরোধ; এতে অ্যাকাউন্ট মুছে যাবে না। অনুমোদিত বেনামীকরণ আলাদা, স্পষ্ট reviewer action।' %></p><textarea class="form-control" name="customer_message" maxlength="1000" placeholder="<%= isEn?'Reason (optional)':'কারণ (ঐচ্ছিক)' %>"></textarea><button class="btn btn-outline-danger"><%= isEn?'Submit deletion request':'মুছে ফেলার অনুরোধ জমা দিন' %></button></form></div><div class="col-lg-6"><form class="card card-body gap-2" method="post" action="/customer/account/privacy-requests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="request_type" value="access"><h2 class="h5"><%= isEn?'Request a data-access review':'তথ্য দেখার পর্যালোচনা' %></h2><p><%= isEn?'Your available account export is linked above; submit this request if you need additional review.':'আপনার অ্যাকাউন্ট ডেটা উপরে দেখুন; অতিরিক্ত পর্যালোচনার জন্য এই অনুরোধ দিন।' %></p><button class="btn btn-outline-secondary"><%= isEn?'Submit access request':'তথ্য-প্রবেশ অনুরোধ' %></button></form></div><div class="col-lg-6"><form class="card card-body gap-2" method="post" action="/customer/account/privacy-requests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="request_type" value="consent_withdrawal"><h2 class="h5"><%= isEn?'Request consent withdrawal':'সম্মতি প্রত্যাহারের অনুরোধ' %></h2><select class="form-select" name="consent_key" required><% options.forEach(option=>{ %><option value="<%= option.key %>"><%= option.label %></option><% }) %></select><p class="small"><%= isEn?'Order processing remains available.':'অর্ডার প্রক্রিয়াকরণ চালু থাকবে।' %></p><button class="btn btn-outline-warning"><%= isEn?'Submit withdrawal request':'প্রত্যাহার অনুরোধ জমা দিন' %></button></form></div></div>
<section class="card card-body mt-4"><h2 class="h5"><%= isEn?'My privacy requests':'আমার গোপনীয়তা অনুরোধ' %></h2><div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th><%= isEn?'Request':'অনুরোধ' %></th><th><%= isEn?'Status':'অবস্থা' %></th><th><%= isEn?'Reason/response':'কারণ/উত্তর' %></th><th><%= isEn?'Created':'তৈরি' %></th><th></th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td>#<%= r.id %></td><td><%= r.request_type %></td><td><%= r.status %></td><td><%= r.decision_reason||r.customer_message %></td><td><%= r.created_at %></td><td><% if(r.status==='pending'){ %><form method="post" action="/customer/account/privacy-requests/<%= r.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-secondary"><%= isEn?'Cancel':'বাতিল' %></button></form><% } %></td></tr><% }) %></tbody></table></div></section></main>
<%- include('../store/partials/footer') %>
