<%- include('../store/partials/header', { title: isEn ? 'My account' : 'আমার অ্যাকাউন্ট' }) %>
<main id="mainContent" class="container py-4 py-md-5">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <h1 class="h3 mb-0"><%= isEn ? 'My account' : 'আমার অ্যাকাউন্ট' %></h1>
    <nav class="d-flex gap-2 flex-wrap" aria-label="<%= isEn ? 'Customer account' : 'কাস্টমার অ্যাকাউন্ট' %>">
      <a class="btn btn-outline-success" href="/customer/account/orders"><%= isEn ? 'Order history' : 'অর্ডারের ইতিহাস' %></a>
      <a class="btn btn-outline-info" href="/customer/account/returns"><%= isEn ? 'Return requests' : 'রিটার্ন অনুরোধ' %></a>
      <a class="btn btn-outline-primary" href="/customer/account/privacy-requests"><%= isEn ? 'Privacy & data rights' : 'গোপনীয়তা ও তথ্য অধিকার' %></a>
      <a class="btn btn-link" href="/customer/account/privacy/data"><%= isEn ? 'View my data' : 'আমার তথ্য দেখুন' %></a>
      <form method="post" action="/customer/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary" type="submit"><%= isEn ? 'Log out' : 'লগআউট' %></button></form>
    </nav>
  </div>

  <section class="card card-body mt-4" aria-labelledby="customer-profile-title">
    <h2 id="customer-profile-title" class="h5"><%= isEn ? 'Profile' : 'প্রোফাইল' %></h2>
    <dl class="row mb-3">
      <dt class="col-sm-3"><%= isEn ? 'Phone / login' : 'ফোন / লগইন' %></dt><dd class="col-sm-9"><%= profile.phone %> <span class="text-muted small">· <%= isEn ? 'Phone changes require a verified recovery channel.' : 'ফোন পরিবর্তনের জন্য যাচাইকৃত পুনরুদ্ধার মাধ্যম প্রয়োজন।' %></span></dd>
    </dl>
    <form method="post" action="/customer/account/profile" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-6"><label class="form-label" for="profileName"><%= isEn ? 'Name' : 'নাম' %></label><input class="form-control" id="profileName" name="name" required minlength="2" maxlength="191" autocomplete="name" value="<%= profile.name %>"></div>
      <div class="col-md-6"><label class="form-label" for="profileEmail"><%= isEn ? 'Email (optional)' : 'ইমেইল (ঐচ্ছিক)' %></label><input class="form-control" type="email" id="profileEmail" name="email" maxlength="191" autocomplete="email" value="<%= profile.email || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="profileCurrentPassword"><%= isEn ? 'Confirm with current password' : 'বর্তমান পাসওয়ার্ড দিয়ে নিশ্চিত করুন' %></label><input class="form-control" type="password" id="profileCurrentPassword" name="current_password" required autocomplete="current-password"></div>
      <div class="col-12"><button class="btn btn-success" type="submit"><%= isEn ? 'Save profile' : 'প্রোফাইল সংরক্ষণ' %></button></div>
    </form>
  </section>

  <section class="card card-body mt-4" aria-labelledby="password-title">
    <h2 id="password-title" class="h5"><%= isEn ? 'Change password' : 'পাসওয়ার্ড পরিবর্তন' %></h2>
    <p class="small text-muted"><%= isEn ? 'Changing your password signs out other active sessions.' : 'পাসওয়ার্ড বদলালে অন্য সক্রিয় সেশনগুলো বন্ধ হবে।' %></p>
    <form method="post" action="/customer/account/password" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-4"><label class="form-label" for="currentPassword"><%= isEn ? 'Current password' : 'বর্তমান পাসওয়ার্ড' %></label><input class="form-control" type="password" id="currentPassword" name="current_password" required autocomplete="current-password"></div>
      <div class="col-md-4"><label class="form-label" for="newPassword"><%= isEn ? 'New password (10–72 characters)' : 'নতুন পাসওয়ার্ড (১০–৭২ অক্ষর)' %></label><input class="form-control" type="password" id="newPassword" name="new_password" required minlength="10" maxlength="72" autocomplete="new-password"></div>
      <div class="col-md-4"><label class="form-label" for="confirmPassword"><%= isEn ? 'Confirm new password' : 'নতুন পাসওয়ার্ড নিশ্চিত করুন' %></label><input class="form-control" type="password" id="confirmPassword" name="confirm_password" required minlength="10" maxlength="72" autocomplete="new-password"></div>
      <div class="col-12"><button class="btn btn-outline-primary" type="submit"><%= isEn ? 'Change password' : 'পাসওয়ার্ড পরিবর্তন করুন' %></button></div>
    </form>
  </section>

  <p class="mt-4"><a href="/contact"><%= isEn ? 'Contact support or submit a complaint' : 'সহায়তায় যোগাযোগ বা অভিযোগ জমা দিন' %></a></p>
  <section class="mt-5" aria-labelledby="address-title">
    <h2 id="address-title" class="h5"><%= isEn ? 'Saved addresses' : 'সংরক্ষিত ঠিকানা' %></h2>
    <% if (!addresses.length) { %><div class="alert alert-light border"><%= isEn ? 'No saved addresses yet. Add one below or enter an address at checkout.' : 'এখনও কোনো ঠিকানা নেই। নিচে যোগ করুন অথবা চেকআউটে ঠিকানা লিখুন।' %></div><% } %>
    <div class="row g-3">
      <% addresses.forEach((a) => { %>
        <div class="col-12 col-lg-6"><article class="card h-100"><div class="card-body">
          <div class="d-flex justify-content-between gap-2"><h3 class="h6"><%= a.label %></h3><% if (a.is_default) { %><span class="badge text-bg-success"><%= isEn ? 'Default' : 'ডিফল্ট' %></span><% } %></div>
          <p class="mb-3"><%= a.recipient_name %> · <%= a.recipient_phone %><br><%= [a.street_address, a.upazila, a.district, a.division].filter(Boolean).join(', ') %></p>
          <details><summary class="btn btn-sm btn-outline-primary d-inline-block"><%= isEn ? 'Edit address' : 'ঠিকানা সম্পাদনা' %></summary>
            <form method="post" action="/customer/account/addresses/<%= a.id %>" class="row g-2 mt-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-sm-4"><label class="form-label small" for="label<%= a.id %>"><%= isEn ? 'Label' : 'লেবেল' %></label><input class="form-control" id="label<%= a.id %>" name="label" maxlength="64" value="<%= a.label %>"></div>
              <div class="col-sm-8"><label class="form-label small" for="recipient<%= a.id %>"><%= isEn ? 'Recipient' : 'প্রাপকের নাম' %></label><input class="form-control" id="recipient<%= a.id %>" name="recipient_name" required maxlength="191" value="<%= a.recipient_name %>"></div>
              <div class="col-sm-6"><label class="form-label small" for="phone<%= a.id %>"><%= isEn ? 'Phone' : 'ফোন' %></label><input class="form-control" id="phone<%= a.id %>" name="recipient_phone" type="tel" required value="<%= a.recipient_phone %>"></div>
              <div class="col-sm-6"><label class="form-label small" for="division<%= a.id %>"><%= isEn ? 'Division' : 'বিভাগ' %></label><input class="form-control" id="division<%= a.id %>" name="division" required maxlength="80" value="<%= a.division %>"></div>
              <div class="col-sm-6"><label class="form-label small" for="district<%= a.id %>"><%= isEn ? 'District' : 'জেলা' %></label><input class="form-control" id="district<%= a.id %>" name="district" required maxlength="80" value="<%= a.district %>"></div>
              <div class="col-sm-6"><label class="form-label small" for="upazila<%= a.id %>"><%= isEn ? 'Upazila' : 'উপজেলা' %></label><input class="form-control" id="upazila<%= a.id %>" name="upazila" maxlength="80" value="<%= a.upazila || '' %>"></div>
              <div class="col-12"><label class="form-label small" for="street<%= a.id %>"><%= isEn ? 'Street address' : 'বিস্তারিত ঠিকানা' %></label><textarea class="form-control" id="street<%= a.id %>" name="street_address" required maxlength="2000" rows="2"><%= a.street_address %></textarea></div>
              <div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="is_default" value="1" id="default<%= a.id %>" <%= a.is_default ? 'checked' : '' %>><label class="form-check-label" for="default<%= a.id %>"><%= isEn ? 'Make default' : 'ডিফল্ট করুন' %></label></div>
              <div class="col-12"><button class="btn btn-sm btn-success" type="submit"><%= isEn ? 'Save changes' : 'পরিবর্তন সংরক্ষণ' %></button></div>
            </form>
          </details>
          <div class="d-flex gap-2 mt-3">
            <% if (!a.is_default) { %><form method="post" action="/customer/account/addresses/<%= a.id %>/default"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-success" type="submit"><%= isEn ? 'Set as default' : 'ডিফল্ট করুন' %></button></form><% } %>
            <form method="post" action="/customer/account/addresses/<%= a.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" type="submit"><%= isEn ? 'Remove' : 'মুছুন' %></button></form>
          </div>
        </div></article></div>
      <% }) %>
    </div>
  </section>

  <section class="mt-5" aria-labelledby="new-address-title">
    <h2 id="new-address-title" class="h5"><%= isEn ? 'Add address' : 'নতুন ঠিকানা' %></h2>
    <form method="post" action="/customer/account/addresses" class="card card-body row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-4"><label class="form-label" for="newLabel"><%= isEn ? 'Label' : 'লেবেল' %></label><input class="form-control" id="newLabel" name="label" maxlength="64" placeholder="<%= isEn ? 'Home' : 'বাসা' %>"></div>
      <div class="col-md-8"><label class="form-label" for="newRecipient"><%= isEn ? 'Recipient name' : 'প্রাপকের নাম' %></label><input class="form-control" id="newRecipient" name="recipient_name" required maxlength="191" autocomplete="name"></div>
      <div class="col-md-6"><label class="form-label" for="newPhone"><%= isEn ? 'Recipient phone' : 'প্রাপকের ফোন' %></label><input class="form-control" id="newPhone" name="recipient_phone" type="tel" required autocomplete="tel" placeholder="01XXXXXXXXX"></div>
      <div class="col-md-6"><label class="form-label" for="newDivision"><%= isEn ? 'Division' : 'বিভাগ' %></label><input class="form-control" id="newDivision" name="division" required maxlength="80"></div>
      <div class="col-md-6"><label class="form-label" for="newDistrict"><%= isEn ? 'District' : 'জেলা' %></label><input class="form-control" id="newDistrict" name="district" required maxlength="80"></div>
      <div class="col-md-6"><label class="form-label" for="newUpazila"><%= isEn ? 'Upazila' : 'উপজেলা' %></label><input class="form-control" id="newUpazila" name="upazila" maxlength="80"></div>
      <div class="col-12"><label class="form-label" for="newStreet"><%= isEn ? 'Street address' : 'বিস্তারিত ঠিকানা' %></label><textarea class="form-control" id="newStreet" name="street_address" required maxlength="2000" rows="2" autocomplete="street-address"></textarea></div>
      <div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="is_default" value="1" id="defaultNew"><label class="form-check-label" for="defaultNew"><%= isEn ? 'Make default' : 'ডিফল্ট ঠিকানা করুন' %></label></div>
      <div class="col-12"><button class="btn btn-success" type="submit"><%= isEn ? 'Save address' : 'ঠিকানা সংরক্ষণ' %></button></div>
    </form>
  </section>
</main>
<%- include('../store/partials/footer') %>
