<%- include('../store/partials/header', { title }) %>
<main class="container py-5" style="max-width:560px"><h1 class="h3 mb-4"><%= title %></h1>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<form method="post" action="<%= title.toLowerCase().includes('login') || title.includes('লগইন') ? '/customer/login' : '/customer/register' %>" class="card card-body gap-3">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if (!title.toLowerCase().includes('login') && !title.includes('লগইন')) { %><label><%= isEn ? 'Full name' : 'পূর্ণ নাম' %><input class="form-control" name="name" required minlength="2" maxlength="191" autocomplete="name"></label><label><%= isEn ? 'Email (optional)' : 'ইমেইল (ঐচ্ছিক)' %><input class="form-control" name="email" type="email" maxlength="191" autocomplete="email"></label><input type="hidden" name="privacy_policy_version" value="<%= policyVersion || '' %>"><div class="form-check"><input class="form-check-input" type="checkbox" id="privacyNotice" name="privacy_notice_acknowledged" value="yes" required><label class="form-check-label" for="privacyNotice"><%= isEn ? 'I have read the privacy notice' : 'আমি গোপনীয়তা নীতিটি পড়েছি' %> · <a href="/privacy-policy" target="_blank" rel="noopener"><%= isEn ? 'View policy' : 'নীতি দেখুন' %></a></label></div><% } %>
<label><%= isEn ? 'Bangladesh mobile number' : 'বাংলাদেশি মোবাইল নম্বর' %><input class="form-control" name="phone" type="tel" required autocomplete="tel" placeholder="01XXXXXXXXX"></label>
<div>
  <div class="d-flex justify-content-between align-items-center mb-1">
    <label class="mb-0"><%= isEn ? 'Password' : 'পাসওয়ার্ড' %></label>
    <% if (title.toLowerCase().includes('login') || title.includes('লগইন')) { %>
      <a href="/customer/recovery" class="small text-primary text-decoration-none"><%= isEn ? 'Forgot password?' : 'পাসওয়ার্ড ভুলে গেছেন?' %></a>
    <% } %>
  </div>
  <input class="form-control" name="password" type="password" required minlength="10" maxlength="72" autocomplete="<%= title.toLowerCase().includes('login') || title.includes('লগইন') ? 'current-password' : 'new-password' %>">
</div>
<button class="btn btn-success" type="submit"><%= title %></button></form>
<p class="mt-3 d-flex justify-content-between flex-wrap gap-2">
  <a href="<%= title.toLowerCase().includes('login') || title.includes('লগইন') ? '/customer/register' : '/customer/login' %>"><%= isEn ? 'Switch between login and registration' : 'লগইন / নিবন্ধন' %></a>
  <% if (title.toLowerCase().includes('login') || title.includes('লগইন')) { %>
    <a href="/customer/recovery" class="text-secondary small"><%= isEn ? 'Password recovery' : 'পাসওয়ার্ড পুনরুদ্ধার' %></a>
  <% } %>
</p></main>
<%- include('../store/partials/footer') %>
