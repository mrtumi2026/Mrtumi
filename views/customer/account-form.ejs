<%- include('../store/partials/header', { title }) %>
<main class="container py-5" style="max-width:560px"><h1 class="h3 mb-4"><%= title %></h1>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<form method="post" action="<%= title.toLowerCase().includes('login') || title.includes('লগইন') ? '/customer/login' : '/customer/register' %>" class="card card-body gap-3">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if (!title.toLowerCase().includes('login') && !title.includes('লগইন')) { %><label><%= isEn ? 'Full name' : 'পূর্ণ নাম' %><input class="form-control" name="name" required minlength="2" maxlength="191" autocomplete="name"></label><label><%= isEn ? 'Email (optional)' : 'ইমেইল (ঐচ্ছিক)' %><input class="form-control" name="email" type="email" maxlength="191" autocomplete="email"></label><% } %>
<label><%= isEn ? 'Bangladesh mobile number' : 'বাংলাদেশি মোবাইল নম্বর' %><input class="form-control" name="phone" type="tel" required autocomplete="tel" placeholder="01XXXXXXXXX"></label>
<label><%= isEn ? 'Password' : 'পাসওয়ার্ড' %><input class="form-control" name="password" type="password" required minlength="10" maxlength="72" autocomplete="<%= title.toLowerCase().includes('login') || title.includes('লগইন') ? 'current-password' : 'new-password' %>"></label>
<button class="btn btn-success" type="submit"><%= title %></button></form>
<p class="mt-3"><a href="<%= title.toLowerCase().includes('login') || title.includes('লগইন') ? '/customer/register' : '/customer/login' %>"><%= isEn ? 'Switch between login and registration' : 'লগইন / নিবন্ধন' %></a></p><p class="small text-muted"><%= isEn ? 'Password recovery is not available until a verified notification channel is configured.' : 'যাচাইকৃত নোটিফিকেশন মাধ্যম চালু না হওয়া পর্যন্ত পাসওয়ার্ড পুনরুদ্ধার উপলব্ধ নয়।' %></p></main>
<%- include('../store/partials/footer') %>
