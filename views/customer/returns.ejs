<%- include('../store/partials/header', { title: isEn ? 'Return requests' : 'রিটার্ন অনুরোধ' }) %><main class="container py-5"><h1 class="h3"><%= isEn?'Return requests':'রিটার্ন অনুরোধ' %></h1><div class="table-responsive"><table class="table"><thead><tr><th>#</th><th><%= isEn?'Order':'অর্ডার' %></th><th><%= isEn?'Claim':'দাবি' %></th><th><%= isEn?'Reason':'কারণ' %></th><th><%= isEn?'Status':'অবস্থা' %></th></tr></thead><tbody><% returns.forEach(row=>{ %><tr><td><%= row.id %></td><td><%= row.invoice_no %></td><td><%= row.claim_type %></td><td><%= row.reason %></td><td><%= row.status %></td></tr><% }) %></tbody></table></div></main><%- include('../store/partials/footer') %>
