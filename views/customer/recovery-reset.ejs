<%- include('../store/partials/header', { title: isEn ? 'Reset password' : 'পাসওয়ার্ড রিসেট করুন' }) %>
<main id="mainContent" class="container py-5" style="max-width:560px">
  <div class="mb-4">
    <a href="/customer/login" class="text-decoration-none small">← <%= isEn ? 'Back to login' : 'লগইনে ফিরুন' %></a>
    <h1 class="h3 mt-2"><%= isEn ? 'Reset password' : 'পাসওয়ার্ড রিসেট করুন' %></h1>
    <p class="text-muted small">
      <%= isEn
        ? 'If you opened a password link, the code is already filled in. Otherwise enter the code you received. Then choose a new password.'
        : 'পাসওয়ার্ড লিংক থেকে এলে কোডটি আগেই বসানো থাকবে। না হলে আপনার পাওয়া কোডটি লিখুন। তারপর নতুন পাসওয়ার্ড দিন।' %>
    </p>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger" role="alert"><%= error %></div>
  <% } %>

  <form method="post" action="/customer/recovery/reset" class="card card-body gap-3 shadow-sm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% if (!prefilledToken || /^[0-9]{6}$/.test(prefilledToken)) { %>
    <div>
      <label for="recoveryPhone" class="form-label fw-semibold"><%= isEn ? 'Mobile number (needed with a 6-digit SMS code)' : 'মোবাইল নম্বর (৬ সংখ্যার SMS কোড দিলে লাগবে)' %></label>
      <input id="recoveryPhone" class="form-control" name="phone" type="tel" maxlength="20" autocomplete="tel" placeholder="01XXXXXXXXX" value="<%= (typeof prefilledPhone !== 'undefined' && prefilledPhone) || '' %>">
    </div>
    <% } %>

    <div>
      <label for="recoveryToken" class="form-label fw-semibold">
        <%= isEn ? 'Recovery code' : 'রিকভারি কোড' %>
      </label>
      <input
        id="recoveryToken"
        class="form-control"
        name="recovery_token"
        type="text"
        required
        maxlength="160"
        autocomplete="off"
        value="<%= prefilledToken || '' %>"
        placeholder="<%= isEn ? 'Enter your recovery code' : 'আপনার রিকভারি কোডটি লিখুন' %>"
      >
      <div class="form-text">
        <%= isEn
          ? 'Each code works only once and expires (SMS code 10 minutes, email code 20 minutes, customer care link 24 hours).'
          : 'প্রতিটি কোড একবারই কাজ করে এবং মেয়াদ আছে (SMS কোড ১০ মিনিট, ইমেইল কোড ২০ মিনিট, কাস্টমার কেয়ারের লিংক ২৪ ঘণ্টা)।' %>
      </div>
    </div>

    <div>
      <label for="newPassword" class="form-label fw-semibold">
        <%= isEn ? 'New password (10–72 characters)' : 'নতুন পাসওয়ার্ড (১০–৭২ অক্ষর)' %>
      </label>
      <input
        id="newPassword"
        class="form-control"
        name="password"
        type="password"
        required
        minlength="10"
        maxlength="72"
        autocomplete="new-password"
      >
    </div>

    <div>
      <label for="confirmPassword" class="form-label fw-semibold">
        <%= isEn ? 'Confirm new password' : 'নতুন পাসওয়ার্ড নিশ্চিত করুন' %>
      </label>
      <input
        id="confirmPassword"
        class="form-control"
        name="confirm_password"
        type="password"
        required
        minlength="10"
        maxlength="72"
        autocomplete="new-password"
      >
    </div>

    <button class="btn btn-success" type="submit">
      <%= isEn ? 'Set new password' : 'নতুন পাসওয়ার্ড সংরক্ষণ করুন' %>
    </button>
  </form>

  <p class="mt-3 d-flex justify-content-between flex-wrap gap-2">
    <a href="/customer/recovery" class="small text-decoration-none">
      <%= isEn ? 'Request a new recovery code' : 'নতুন রিকভারি কোডের অনুরোধ করুন' %>
    </a>
    <a href="/customer/login" class="small text-secondary text-decoration-none">
      <%= isEn ? 'Return to login' : 'লগইনে ফিরুন' %>
    </a>
  </p>
</main>
<%- include('../store/partials/footer') %>
