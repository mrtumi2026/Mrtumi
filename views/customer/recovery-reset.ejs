<%- include('../store/partials/header', { title: isEn ? 'Reset password' : 'পাসওয়ার্ড রিসেট করুন' }) %>
<main id="mainContent" class="container py-5" style="max-width:560px">
  <div class="mb-4">
    <a href="/customer/login" class="text-decoration-none small">← <%= isEn ? 'Back to login' : 'লগইনে ফিরুন' %></a>
    <h1 class="h3 mt-2"><%= isEn ? 'Reset password' : 'পাসওয়ার্ড রিসেট করুন' %></h1>
    <p class="text-muted small">
      <%= isEn
        ? 'Enter the recovery code delivered to your verified phone or email and set a new secure password.'
        : 'আপনার যাচাইকৃত ফোন বা ইমেইলে প্রাপ্ত রিকভারি কোডটি লিখুন এবং নতুন পাসওয়ার্ড সেট করুন।' %>
    </p>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger" role="alert"><%= error %></div>
  <% } %>

  <form method="post" action="/customer/recovery/reset" class="card card-body gap-3 shadow-sm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div>
      <label for="recoveryToken" class="form-label fw-semibold">
        <%= isEn ? 'Recovery code' : 'রিকভারি কোড' %>
      </label>
      <input
        id="recoveryToken"
        class="form-control"
        name="recovery_token"
        type="text"
        required
        maxlength="160"
        autocomplete="off"
        value="<%= prefilledToken || '' %>"
        placeholder="<%= isEn ? 'Enter your recovery code' : 'আপনার রিকভারি কোডটি লিখুন' %>"
      >
      <div class="form-text">
        <%= isEn
          ? 'Codes expire after 20 minutes and can only be used once.'
          : 'কোডের মেয়াদ ২০ মিনিট এবং এটি শুধুমাত্র একবার ব্যবহারযোগ্য।' %>
      </div>
    </div>

    <div>
      <label for="newPassword" class="form-label fw-semibold">
        <%= isEn ? 'New password (10–72 characters)' : 'নতুন পাসওয়ার্ড (১০–৭২ অক্ষর)' %>
      </label>
      <input
        id="newPassword"
        class="form-control"
        name="password"
        type="password"
        required
        minlength="10"
        maxlength="72"
        autocomplete="new-password"
      >
    </div>

    <div>
      <label for="confirmPassword" class="form-label fw-semibold">
        <%= isEn ? 'Confirm new password' : 'নতুন পাসওয়ার্ড নিশ্চিত করুন' %>
      </label>
      <input
        id="confirmPassword"
        class="form-control"
        name="confirm_password"
        type="password"
        required
        minlength="10"
        maxlength="72"
        autocomplete="new-password"
      >
    </div>

    <button class="btn btn-success" type="submit">
      <%= isEn ? 'Set new password' : 'নতুন পাসওয়ার্ড সংরক্ষণ করুন' %>
    </button>
  </form>

  <p class="mt-3 d-flex justify-content-between flex-wrap gap-2">
    <a href="/customer/recovery" class="small text-decoration-none">
      <%= isEn ? 'Request a new recovery code' : 'নতুন রিকভারি কোডের অনুরোধ করুন' %>
    </a>
    <a href="/customer/login" class="small text-secondary text-decoration-none">
      <%= isEn ? 'Return to login' : 'লগইনে ফিরুন' %>
    </a>
  </p>
</main>
<%- include('../store/partials/footer') %>
