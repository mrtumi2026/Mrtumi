<%- include('../store/partials/header', { title: isEn ? 'Account recovery' : 'অ্যাকাউন্ট পুনরুদ্ধার' }) %>
<main id="mainContent" class="container py-5" style="max-width:680px">
  <div class="mb-4">
    <a href="/customer/login" class="text-decoration-none small">← <%= isEn ? 'Back to login' : 'লগইনে ফিরুন' %></a>
    <h1 class="h3 mt-2"><%= isEn ? 'Account recovery' : 'অ্যাকাউন্ট পুনরুদ্ধার' %></h1>
  </div>

  <% if (submitted) { %>
    <div class="alert alert-success card card-body border-success gap-2 shadow-sm" role="status">
      <h2 class="h5 alert-heading mb-1">
        <%= isEn ? 'Recovery request processed' : 'রিকভারি অনুরোধ প্রক্রিয়াধীন' %>
      </h2>
      <p class="mb-1">
        <%= isEn
          ? 'If an active account matches this information, a recovery code has been sent. Check your SMS or email. If nothing arrives, call customer care with your invoice number.'
          : 'এই তথ্যের সাথে কোনো সক্রিয় অ্যাকাউন্ট থাকলে রিকভারি কোড পাঠানো হয়েছে। SMS বা ইমেইল দেখুন। কিছু না এলে ইনভয়েস নম্বর নিয়ে কাস্টমার কেয়ারে ফোন করুন।' %>
      </p>
      <p class="small text-muted mb-3">
        <%= isEn
          ? 'Each code works once. An SMS code has 6 digits and lasts 10 minutes (3 codes per hour); an email code lasts 20 minutes.'
          : 'প্রতিটি কোড একবারই কাজ করে। SMS কোড ৬ সংখ্যার, মেয়াদ ১০ মিনিট (ঘণ্টায় সর্বোচ্চ ৩ বার); ইমেইল কোডের মেয়াদ ২০ মিনিট।' %>
      </p>
      <div>
        <a href="/customer/recovery/reset" class="btn btn-primary">
          <%= isEn ? 'Enter Recovery Code & Reset Password' : 'রিকভারি কোড দিন ও পাসওয়ার্ড রিসেট করুন' %>
        </a>
      </div>
    </div>
  <% } else if (!status || !status.enabled) { %>
    <div class="alert alert-warning card card-body border-warning gap-3 shadow-sm" role="region" aria-label="<%= isEn ? 'How to recover your account' : 'অ্যাকাউন্ট যেভাবে ফিরে পাবেন' %>">
      <h2 class="h5 alert-heading mb-0"><%= isEn ? 'Call customer care to recover your account' : 'অ্যাকাউন্ট ফিরে পেতে কাস্টমার কেয়ারে ফোন করুন' %></h2>
      <p class="mb-0"><%= isEn ? 'Automatic recovery by SMS or email is not available right now. Tell us your invoice number or registered mobile number. After checking, we will send a password link to your mobile number.' : 'এখন SMS বা ইমেইলে স্বয়ংক্রিয় পুনরুদ্ধার চালু নেই। আমাদের আপনার ইনভয়েস নম্বর বা নিবন্ধিত মোবাইল নম্বর বলুন। যাচাই করে আমরা আপনার মোবাইল নম্বরে পাসওয়ার্ড লিংক পাঠাব।' %></p>
      <% const carePhone = (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.site_phone) || ''; %>
      <% if (carePhone) { %><p class="mb-0"><a class="btn btn-success" href="tel:<%= carePhone %>"><%= isEn ? 'Call' : 'ফোন করুন' %>: <%= carePhone %></a></p><% } %>
      <div class="d-flex gap-2 flex-wrap pt-2">
        <a class="btn btn-outline-primary" href="/contact"><%= isEn ? 'Contact us' : 'যোগাযোগ করুন' %></a>
        <a class="btn btn-outline-secondary" href="/customer/login"><%= isEn ? 'Return to login' : 'লগইনে ফিরুন' %></a>
      </div>
    </div>
  <% } else { %>
    <% if (error) { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/customer/recovery" class="card card-body gap-3 shadow-sm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <% if (status.availableChannels && status.availableChannels.length > 1) { %>
        <div>
          <label class="form-label fw-semibold"><%= isEn ? 'Recovery channel' : 'পুনরুদ্ধারের মাধ্যম' %></label>
          <div class="d-flex gap-4">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="channel" id="channelPhone" value="phone" checked>
              <label class="form-check-label" for="channelPhone"><%= isEn ? 'SMS (Mobile)' : 'এসএমএস (মোবাইল)' %></label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="channel" id="channelEmail" value="email">
              <label class="form-check-label" for="channelEmail"><%= isEn ? 'Email' : 'ইমেইল' %></label>
            </div>
          </div>
        </div>
      <% } else if (status.availableChannels && status.availableChannels.includes('phone')) { %>
        <input type="hidden" name="channel" value="phone">
        <div class="text-muted small">
          <%= isEn ? 'A 6-digit code (OTP) will be sent by SMS to the account mobile number.' : 'অ্যাকাউন্টের মোবাইল নম্বরে SMS-এ ৬ সংখ্যার কোড (OTP) পাঠানো হবে।' %>
        </div>
      <% } else { %>
        <input type="hidden" name="channel" value="email">
        <div class="text-muted small">
          <%= isEn ? 'Recovery code will be delivered to your verified email address.' : 'আপনার যাচাইকৃত ইমেইল ঠিকানায় রিকভারি কোড পাঠানো হবে।' %>
        </div>
      <% } %>

      <div>
        <label for="recoveryIdentifier" class="form-label fw-semibold">
          <%= isEn ? 'Registered Mobile Number or Email' : 'নিবন্ধিত মোবাইল নম্বর বা ইমেইল' %>
        </label>
        <input
          id="recoveryIdentifier"
          class="form-control"
          name="identifier"
          type="text"
          required
          maxlength="191"
          autocomplete="username"
          placeholder="01XXXXXXXXX"
        >
        <div class="form-text">
          <%= isEn
            ? 'For mobile, enter an 11-digit Bangladesh number (e.g. 017XXXXXXXX).'
            : 'মোবাইলের জন্য ১১ ডিজিটের নম্বর লিখুন (যেমন: 017XXXXXXXX)।' %>
        </div>
      </div>

      <button class="btn btn-success" type="submit">
        <%= isEn ? 'Send recovery code' : 'রিকভারি কোড পাঠান' %>
      </button>
    </form>

    <p class="mt-3 d-flex justify-content-between flex-wrap gap-2">
      <a href="/customer/recovery/reset" class="small text-decoration-none">
        <%= isEn ? 'Already have a code? Reset password' : 'ইতিমধ্যে কোড পেয়েছেন? পাসওয়ার্ড রিসেট করুন' %>
      </a>
      <a href="/customer/login" class="small text-secondary text-decoration-none">
        <%= isEn ? 'Return to login' : 'লগইনে ফিরুন' %>
      </a>
    </p>
  <% } %>
</main>
<%- include('../store/partials/footer') %>
