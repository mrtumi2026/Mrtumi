<%- include('../store/partials/header', { title: (isEn ? 'Invoice ' : 'ইনভয়েস ') + order.invoice_no }) %>
<main id="mainContent" class="container py-4 py-md-5">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4"><div><a href="/customer/account/orders/<%= order.id %>" class="text-decoration-none">← <%= isEn ? 'Order details' : 'অর্ডারের বিবরণ' %></a><h1 class="h3 mt-2"><%= isEn ? 'Customer invoice' : 'কাস্টমার ইনভয়েস' %></h1></div><p class="mb-0 text-muted"><%= isEn ? 'Use your browser print option to save a copy.' : 'কপি সংরক্ষণ করতে ব্রাউজারের প্রিন্ট অপশন ব্যবহার করুন।' %></p></div>
  <article class="card card-body">
    <div class="d-flex justify-content-between flex-wrap gap-3 border-bottom pb-3"><div><strong><%= isEn ? 'Mr. Tumi Grocery & Gift' : 'মি. তুমি গ্রোসারি ও গিফট' %></strong><p class="mb-0"><%= isEn ? 'Customer copy' : 'কাস্টমার কপি' %></p></div><dl class="row mb-0"><dt class="col-auto"><%= isEn ? 'Invoice' : 'ইনভয়েস' %></dt><dd class="col-auto"><%= order.invoice_no %></dd><dt class="col-auto"><%= isEn ? 'Date' : 'তারিখ' %></dt><dd class="col-auto"><%= order.dateLabel %></dd></dl></div>
    <section class="row py-3"><div class="col-md-6"><h2 class="h6"><%= isEn ? 'Customer' : 'কাস্টমার' %></h2><p><%= order.customer_name %><br><%= order.customer_phone %></p></div><div class="col-md-6"><h2 class="h6"><%= isEn ? 'Delivery address' : 'ডেলিভারি ঠিকানা' %></h2><p><%= [order.shipping_address, order.upazila, order.district, order.division].filter(Boolean).join(', ') %></p></div></section>
    <% if (items.length) { %><div class="table-responsive"><table class="table align-middle"><thead><tr><th><%= isEn ? 'Item' : 'পণ্য' %></th><th><%= isEn ? 'Options' : 'বিকল্প' %></th><th><%= isEn ? 'Qty' : 'পরিমাণ' %></th><th><%= isEn ? 'Unit price' : 'একক মূল্য' %></th><th class="text-end"><%= isEn ? 'Line total' : 'সর্বমোট' %></th></tr></thead><tbody><% items.forEach((item) => { %><tr><td><%= item.product_name %></td><td><%= [item.size_label,item.color_label].filter(Boolean).join(' / ') || '—' %></td><td><%= item.qty %></td><td><%= item.unitPriceLabel %></td><td class="text-end"><%= item.lineTotalLabel %></td></tr><% }) %></tbody></table></div><% } else { %><p class="text-muted"><%= isEn ? 'No item detail is available for this legacy order.' : 'এই পুরোনো অর্ডারের পণ্যের বিবরণ পাওয়া যায়নি।' %></p><% } %>
    <dl class="row justify-content-end"><dt class="col-7 col-md-3"><%= isEn ? 'Subtotal' : 'সাবটোটাল' %></dt><dd class="col-5 col-md-2 text-end"><%= order.subtotalLabel %></dd><dt class="col-7 col-md-3"><%= isEn ? 'Discount' : 'ছাড়' %></dt><dd class="col-5 col-md-2 text-end"><%= order.discountLabel %></dd><dt class="col-7 col-md-3"><%= isEn ? 'Delivery' : 'ডেলিভারি' %></dt><dd class="col-5 col-md-2 text-end"><%= order.shippingLabel %></dd><dt class="col-7 col-md-3 border-top pt-2"><strong><%= isEn ? 'Total' : 'সর্বমোট' %></strong></dt><dd class="col-5 col-md-2 text-end border-top pt-2"><strong><%= order.totalLabel %></strong></dd></dl>
    <p class="small text-muted border-top pt-3 mb-0"><%= isEn ? 'This invoice is available only in the signed-in owner account. Payment/refund status remains subject to the order record.' : 'এই ইনভয়েস কেবল সাইন-ইন করা মালিকের অ্যাকাউন্টে পাওয়া যায়। পেমেন্ট/রিফান্ডের অবস্থা অর্ডার রেকর্ড অনুযায়ী।' %></p>
  </article>
</main>
<%- include('../store/partials/footer') %>
